function sync_full_two_filename_to_origin($abs_source , $abs_target, $server = 'dbrqx.com' , $user = 'composer' , $key_name = 'id_ecdsa.pub')
{

// $source = __DIR__;
//$target = "/target/dir";

// $cmd='rsync -avz -e "ssh -oPort=60022" ' . $abs_source . ' ' . $user . '@' . $server . ':' . $abs_target ; 
// print ($cmd . $br)			;
// print_r(exec($cmd)); 

$config = array(
	'remote_origin'	=> true, 
    'delete_from_target' => false, 
    'ssh' => array(
        'host' => trim($server), 
        'port' => 60022, 
        'username' => $user, 
        'public_key' => '/home/' . $user . '/.ssh/' . $key_name
    )
);

$rsync = new Rsync($config);

// change options programatically
$rsync->setFollowSymlinks(false);

$rsync->sync(trim($abs_source), trim($abs_target));	
	
}


