function sync_full_one_filename($abs_source , $server = 'dbrqx.com' , $user = 'composer' , $key_name = 'id_ecdsa.pub')
{
// A ===> B	
sync_full_two_filename($abs_source , $abs_source, $server , $user , $key_name ) ; 
}

function sync_full_one_filename_to_origin($abs_source , $server = 'dbrqx.com' , $user = 'composer' , $key_name = 'id_ecdsa.pub')
{
// A <=== B	
sync_full_two_filename_to_origin($abs_source , $abs_source, $server , $user , $key_name ) ; 
}

