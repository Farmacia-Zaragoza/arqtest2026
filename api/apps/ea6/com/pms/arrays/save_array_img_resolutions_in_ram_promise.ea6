var 	cons 						= 	require("/brqx/base/rcode/es6/com/libs/general/constants.ess"							);


function save_array_img_resolutions_in_ram(data_and_error = '' , t = '' )
{
  const promise = new Promise(function (resolve, reject) {

	t.save_array_img_resolutions_in_ram()
	  // Caso de exito
    resolve(t)
    if (!t) 
    {
	    reject(new Error('Problema con el objeto properties pasado '))
    }
  })
  
  return promise
	  
} // End function



module.exports.save_array_img_resolutions_in_ram = save_array_img_resolutions_in_ram
