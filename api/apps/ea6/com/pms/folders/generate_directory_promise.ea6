// - d-generate_directory_promise- 				: 	Generate current path information
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

var 	cons 						= 	require("/brqx/base/rcode/es6/com/libs/general/constants.ess"							);

const 	fs 							= 	require(	'fs'																		),
		path 						= 	require(	'path'																		),
		recursive 					= 	require(	'/brqx/base/react/zcommon/node_modules/recursive-readdir-sync'				),
		sort 						= 	require(	'/brqx/base/react/zcommon/node_modules/sort-array'							),
		readdirp 					= 	require(	'/brqx/base/react/zcommon/node_modules/readdirp'							),
		echo	 					= 	require(	'/brqx/base/react/zcommon/node_modules/node-echo'							),
		mat							=	require(	cons.JS_BASE + 'com/libs/string/match.es6'							),
		url			 				= 	require( 	cons.JS_BASE + 'com/libs/string/url.es6'								),
		rs							= 	require(	'/brqx/base/react/zcommon/node_modules/fs-readdir-promise'					);


function generate_directory_promise(data_and_error, t)
{
  const promise = new Promise(function (resolve, reject) {

	process.on('unhandledRejection', (err, p) => {
	  console.log('An unhandledRejection occurred')
	  console.log('Rejected Promise:' + p )
	  console.log('Rejection:' + err )
	})


	if ( fs.existsSync(t.path) &&   fs.lstatSync(t.path).isDirectory() ) 
	{		
		// REVISAR ITERATOR

		t.p('Generate_Type ' + t.type)

		let url_base_path = url.url_with_bar(t.u.site_url + t.path_pointer)
		
		// t.p('AN72_url_path ' + t.u.site_url + ' pointer ' +  t.path_pointer)

		let arr_files = Array()
		let arr_names = Array()
		
		// OJO AQUI OBTENEMOS LA RUTA COMPLETA - EN PHP CREO QUE SOLO LOS FICHEROS

		// Change to async - promises

		// /mnt/ssd/brqx/base/react/node/			
		// t.p('RUN ASYNC ' + t.u.site_path)

		// CHANGE TO ASYNC ----------------------------------------------------------
		rs(t.path)
		.then(   function(files) 
		  {
			// ASYNC BLOCK - fulfilled case
			// This no se puede usar pues entiende que es este objeto
			var elemento		=	''
			var arr_files		=	Array()

			// 1.Add files to arr_files
			for(var pos in files) 
			{
				elemento = files[pos]
				let full_elemento = t.path_pointer + '/' + elemento 

				// /mnt/ssd/brqx/base/react/node/photos/1600x1200/transportes_lucas_rivera_gondolas_transport_truck_madrid_spain_2017_-_0139_1600x1200.jpg	
				// console.log('E_a72 : ' + full_elemento )
	
			 	arr_names.push(	elemento	) 									
			 	arr_files.push(	full_elemento	) 									
			}


			// 2.Sort array
			arr_files = arr_files.sort()


			// 3. Iterate array
			for(var pos in arr_files) 
			{

				elemento = arr_names[pos]

				// elemento = path.basename(arr_files[pos])
				// :elem 130808_-_Boca_Do_Inferno

				let base_path = t.path + elemento 								
				
				//cica.dbrqx.com/imgs/path
				
				let url_path  = url_base_path + elemento								 

				// t.p('an72_url_path ' + url_path)								

				// PENDIENTE
				// No tiene sentido sin un path - es mas para cica aqui los elementos estan completos
				let ideal_elem = mat.match_word(elemento) 								

				
				let title_str 							=	''								


				let arr_ide_current = ideal_elem.split(",");

				// Array ideales
				for (var elem of Object.values(arr_ide_current))
				{
			
					if(!( elem in t.arr['ide'] ))
						t.arr['ide'].push(	'' + elem	)								
					title_str+=  elem + ' '											
				}

				t.arr['tit'].push( title_str ) 														

				// Sabemos que existe										
				if ( fs.existsSync(base_path) &&   
					 fs.lstatSync(base_path).isFile() ) 
				{
					is_there_contents = true  
	
					// El tipo es el nombre del fichero (linea_menu)
					// Iteramos cada archivo  linea_menu
					// FILes - FIles Sructure - File url
					t.arr['fil'].push(	'' + elemento	)					
					t.arr['fis'].push(	base_path		)					
					t.arr['fur'].push(	url_path		)					

					t.num_files++											
				}
				else
				{
					is_there_contents = true  

					// t.p('E1 - elem 	' + elemento)						
					// t.p('C1 - base path ' + base_path)					

					t.arr['fol'].push(	'' + elemento	)					
					t.arr['fos'].push(	base_path		)							
					
					t.num_folders++										
				}
			
			} // End For		
		
			t.p('01_End_Async_block ' + t.type)
		}) // End then - Async block ----------------------------------------------------------
		.catch(  function(error) {
		    console.error("something exploded", error);

		// Promise.all(p).then(function(results) 

  	    });
		
		t.p('01_Promises working')
	} // End If

    resolve(t)
    if (!t) 
    {
		// Aqui igual hay que gestionar datos del objeto		
	    reject(new Error('Problema al generar directorio'))
    }
  })
  
  return promise

	  
} // End function

module.exports.generate_directory_promise = generate_directory_promise