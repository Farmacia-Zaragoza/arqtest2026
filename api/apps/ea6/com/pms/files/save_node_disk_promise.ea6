var 	cons 						= 	require("/brqx/base/rcode/es6/com/libs/general/constants.ess"							);

const 	fs 							= 	require(	'fs'																		),
		path 						= 	require(	'path'																		),
		recursive 					= 	require(	'/brqx/base/react/zcommon/node_modules/recursive-readdir-sync'				),
		sort 						= 	require(	'/brqx/base/react/zcommon/node_modules/sort-array'							),
		readdirp 					= 	require(	'/brqx/base/react/zcommon/node_modules/readdirp'							),
		echo	 					= 	require(	'/brqx/base/react/zcommon/node_modules/node-echo'							),
		mat							=	require(	path.join(JS_BASE, 'com/libs/string/match.es6'))),
		url			 				= 	require( 	path.join(JS_BASE, 'com/libs/string/url.es6'))),
		rs							= 	require(	'/brqx/base/react/zcommon/node_modules/fs-readdir-promise'					),
		run  						= 	require(	path.join(JS_BASE, 'com/pms/folders/generate_directory_promise.ea6')));	


function save_node_disk_promise(t)
{
	if ((t.arr['nfo']['generate_disk'] == false	)  ||
		(t.special_reload_disk('FS')  				)	)
	{				
		// Aqui hay que chequear la barra

		// t.p('RELOAD_SITE_PATH1 ' + t.u.site_path)  
		
		if (t.u.site_path.substr(-1) != '/' )   t.u.site_path += '/'					

		// t.p('RELOAD_SITE_PATH2 ' + t.s.img_relative_url_folder)  
					
		t.path +=  t.u.site_path 									

		if (t.path.substr(-1) != '/' )   t.path += '/'					

		t.path +=  t.s.img_relative_url_folder									

		if (t.path.substr(-1) != '/' )   t.path += '/'					
																			
		// /ssd/home/ser/zd/main/es/zdom/emp/flat/zd_main_flat/es/photos/2048x1536/
		// t.p('Flat_Path ' + t.path) 																				 

		t.path_pointer		=	t.s.img_relative_url_folder																				

		
		// Llamamos aqui a la promesa
		
		var data_and_error = '' 
		
		run.generate_directory_promise(data_and_error, t)
		.then(function () 
		{
			t.p('Promises_Preparing ' + t.type)
					
			t.arr['img'] 					= 	t.arr['fur']																

		 	t.load_child_details()			 									

			t.prepare_properties()
			t.prepare_specific_child_properties()
			t.prepare_array_properties()


			
			t.if_is_correct_save_all()								

			t.p('Promises_Prepared ' + t.type)
		
		})		

	}
	  
} // End function

module.exports.save_node_disk_promise = save_node_disk_promise