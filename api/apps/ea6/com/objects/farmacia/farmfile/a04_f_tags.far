//-------------------------------------------------------------------------------------
// Lang Store - Manage phrases 
//-------------------------------------------------------------------------------------
// INHERITANCE LINE:
//-------------------------------------------------------------------------------------
// (farmupdate) < (farmfolder) < (farmprocess) (farmtags) < (farmtranslate) < (farmarray) < (farmfile) 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// - [generate_sub_files]	: Generate independent subfiles for prospect 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--


class farmtags extends farmprocessline {

	public 		$n						=	'farmtags::'										;

            

	public function process_farma_tags($sep_ext_blank	=	"")
	{
		$old_n = $this->n ; $this->n = 'farmtags::'											;
		$old_m = $this->m ; $this->m = 'generate_sub_files:'									;

		$tags_updated=false;

		foreach ($this->arr_vlineas as $pos => $TAG_LINE )
		{
		
			$this->process_line_tags($TAG_LINE ) ; 

		}
		
		$this->m = $old_m ; $this->n = $old_n 														;

	}

	public function process_line_tags($TAG_LINE = '')
	{
		$old_n = $this->n ; $this->n = 'farmtags::'											;
		$old_m = $this->m ; $this->m = 'process_line_tags:'									;

		// NUM_CODE is TAG TYPE
		
		$line_len=strlen($TAG_LINE);
		
		if ($line_len >1 )
		{
	
			for ($c = 0 ; $c < strlen($TAG_LINE) ; $c++)	$arr[] = $TAG_LINE[$c] ; // [STRING TO ARRAY]  
				
			$new_line			=	"";
			
			$tag_name			=	"";
			$start_tag_phase	=	false;
			$end_tag_phase		=	false;
			
			$tag_start			=	"[";
			$tag_end			=	"]";
	
			$is_tag_part		= 	false;

			// Variables for word recognition			
			$spaces 			= 	''		;			$phrase				=	''		;			$word				= 	''		;
			$word_started 		=	false	;
			
			foreach ($arr as $pos => $crc)
			{
			
			    // Lo primero que miramos es si ha llegado al final del tag
			    // Algoritmo
			    // 1-Iterar cada letra
			    // 2-Hasta que llega INICIO_TAG    
			    // 3-Iterar cada letra hasta END_TAG
			    
			    // Hola es un [
			    // Hola es un [TAG
			    // Hola es un [TAG]
			        
			    if ($crc == $tag_end)
			    {
			        //Iniciamos el reconocimiento de tags
			        $start_tag_phase=false;
			        $end_tag_phase=true;
			    }
			    
			        
			    if ($start_tag_phase)
			    {
			        $tag_name.=$crc;    
			    }
			
			    if ($end_tag_phase)
			    {
					
					$this->arr_properties[]			=	"arr_t_" . 			$this->NUM_CODE 	. $this->sep_lines  . $tag_name;
					$this->add_tax_term($tag_name); 
					
					// Aqui habria que comprobar que realmente es un TAG. Tenemos una funcion abajo para ello
			        $tag_name="";
			        $end_tag_phase=false;
			        $tags_updated=true;
			    }
			
			    if ($crc == $tag_start)
			    {
			        //Iniciamos el reconocimiento de tags
			        $start_tag_phase=true;
			        $tag_name="";
			    }
			
				// Word processing		

				if (preg_match($this->sep_multi_preg, $crc) )
				{

					if ( $word_started )
					{
//								print 'pos -es palabra - ' . $pos . ' crc -' . $word . '-' . $this->lr ;
						$trimmed_line	=	dash_clean_with_feed($word) ; 

						// Comprobar que es un tag o no y actuar

						if ($this->is_tag_term($trimmed_line, $is_tag_part) )
						{
							// Insertarlo en el array de tags
							$this->arr_properties[]			=	"arr_t_" . 			$this->NUM_CODE 	. $this->sep_lines  . $trimmed_line;
							$this->add_tax_term($trimmed_line); 

							$word_started = false 														;
							$phrase = '' ; 
						}					
						elseif ($is_tag_part )
						{
							$phrase 			.= 	$word												;

							if (is_tag_term($phrase, $is_tag_part) )
							{
								$this->arr_properties[]			=	"arr_t_" . 			$this->NUM_CODE 	. $this->sep_lines  . $phrase;
								$this->add_tax_term($phrase); 

							}
							else
							{
								$phrase .= $spaces 															;
								$word 	= ''																;
								$spaces = ''																;	 
								// En cuanto encuentre un separador la frase termina
								$word_started = false 														;
							}
						}
					}
					else		
					{
						// En cuanto encuentre un separador la frase termina
						$word_started = false 														;

						$phrase .= $crc 															;
			
//						print 'pos -es separador - ' . $pos . ' crc -' . $crc . '-' . $this->lr ;
					}			

				}		
				elseif (preg_match($this->sep_spaces_preg, $crc) )
				{ 
					if ($word_started )
					{
//					print 'pos -es palabra - ' . $pos . ' crc ' . $word . $lr ;
						$spaces .= ' '																;
					}
					else 
					{
						$phrase .= ' ' 																;
						$spaces = '' 																;
					}
//					print 'pos -es espacio - ' . $pos . ' crc ' . $crc . $this->lr ;
				}
				else 
				{
					// es un caracter
					$word .= $spaces 																;
					$word .= $crc																	;
					$spaces = '' 																	;
					
					$word_started = true 															;
					
//					print 'pos -es caracter - ' . $pos . ' crc ' . $crc . $this->lr ;
				}
				    
		    }
		} // End Foreach 

		// Comprobacion para las palabras que terminan con la frase
		if ( $word_started )
		{
//								print 'pos -es palabra - ' . $pos . ' crc -' . $word . '-' . $this->lr ;
			$trimmed_line	=	dash_clean_with_feed($word) ; 

			// Comprobar que es un tag o no y actuar

			if ($this->is_tag_term($trimmed_line, $is_tag_part) )
			{
				// Insertarlo en el array de tags
				$this->arr_properties[]			=	"arr_t_" . 			$this->NUM_CODE 	. $this->sep_lines  . $trimmed_line;
				$this->add_tax_term($trimmed_line); 

				$word_started = false 														;
				$phrase = '' ; 
			}					
			elseif ($is_tag_part )
			{
				$phrase 			.= 	$word												;

				if ($this->is_tag_term($phrase, $is_tag_part) )
				{
					$this->arr_properties[]			=	"arr_t_" . 			$this->NUM_CODE 	. $this->sep_lines  . $phrase;
					$this->add_tax_term($phrase); 
				}
				else
				{
					$phrase .= $spaces 															;
					$word 	= ''																;
					$spaces = ''																;	 
					// En cuanto encuentre un separador la frase termina
					$word_started = false 														;
				}
			}
		}				
		$this->m = $old_m ; $this->n = $old_n 														;

	}

	protected function add_tax_term($tag = '', $tag_type = '')
	{
		$old_n = $this->n ; $this->n = 'farmtags::'											;
		$old_m = $this->m ; $this->m = 'add_tax_term:'									;
		// Debe insertar el tag en el fichero de tag del tipo indicado
		// La idea es mantener un listado actual de todos los posibles tags

		$sep_space= " ";    
		$sep_point= ".";    
		$sep_underscore= "_";    
		
		// Change point by spaces and make Upcae
		$point_str=str_replace($this->sep_point, $this->sep_space, $tag );
		$ucase_str=locale_str_ucase($point_str);
		$under_str=str_replace($this->sep_space, $this->sep_dash, $ucase_str );
		
		//Ahora toca arreglar los raros
		
		$tags_solve_a=str_replace("_A_","_a_", $under_str);
		
		$tags_solve_de=str_replace("_De_","_de_", $tags_solve_a);
		
		$tags_in=$tags_solve_de;
		
		//Solo debe insertar el tag si no existe

		// Igual es un array multi idioma
		$arr_lines = file($this->full_categories_section_file)									;
	
		uniq_sort_add_line ($arr_lines , $tags_in) 													;
				
		create_full_filename_with_array(	$this->full_categories_section_file							, 
											$arr_lines)													;
				
		$this->m = $old_m ; $this->n = $old_n 														;
	
	}

	// [PHP_56] Ojo paso de parametro Php 5.6
	
	protected function is_tag_term($tag = '',  &$tag_part = false)
	{
		$old_n = $this->n ; $this->n = 'farmtags::'											;
		$old_m = $this->m ; $this->m = 'is_tag_term:'									;
		// Igual tag_type no hace falta puesto que va cambiando el fichero de categorias en razon a la seccion
		$exist_in_array = false ; 
		
		if ( (is_file ($this->full_categories_section_file )) and ($tag != '' ))  
		{
			$arr_lines = file($this->full_categories_section_file)									;
	
			// HABRIA QUE COMPROBAR BIEN ESTOS METODOS
	
			if (count($arr_lines) > 0 )
			{
			// Devuelve si la expresion existe en el array
				$exist_in_array = in_array($arr_lines, $tag)											;
	
			// Devuelve si la cadena indicada es parte de una expresion del array
				$tag_part  = preg_grep ('/^' . $tag . '(\w+)/i', $arr_lines);
			}
		}
		$this->m = $old_m ; $this->n = $old_n 														;

		return $exist_in_array ; 
	}

};

?>