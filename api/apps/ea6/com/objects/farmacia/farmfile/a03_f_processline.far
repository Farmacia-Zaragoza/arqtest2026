//-------------------------------------------------------------------------------------
// Lang Store - Manage phrases 
//-------------------------------------------------------------------------------------
// INHERITANCE LINE:
//-------------------------------------------------------------------------------------
// (farmupdate) < (farmfolder) < (farmprocess) < (farmtags) < (farmprocessline ) < (farmarray) < (farmfile) 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// - d-process_line-	: Process every line checking sub sections 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--


class farmprocessline extends farmtranslate {

	public 		$n						=	'farmprocessline::'										;
            
	public function process_line()
	{
		$old_n = $this->n ; $this->n = 'farmprocessline::'											;
		$old_m = $this->m ; $this->m = 'process_line:'									;


	    // Imput line sin punto
	    $INPUT_LINE = strtoupper (
	    	dash_clean ( 
	    	utf8_clean_for_file (
	    	strtolower_utf8( (get_first_clean_occurence($this->LINE,':') ) ) ) ));

    	// $this->p ('S ' . $INPUT_LINE . $this->lr)										; // [PR_DISABLED]

		$this->LINE = dash_clean ($this->LINE ) ; 
	    
	    if ( $INPUT_LINE == "ACCION Y MECANISMO" )
	    {
	        $this->SUBCODE="accion_y_mecanismo";
	        $this->NUM_CODE="01";
	    }
	    elseif ( $INPUT_LINE == "ANALISIS CLINICOS" )
	    {
	    	// $this->p ('S1 ' . $INPUT_LINE . $this->lr)										; // [PR_DISABLED]
	        $this->SUBCODE="analisis_clinicos";
	        $this->NUM_CODE="02";
	    }   
	    elseif ( $INPUT_LINE == "CONSEJOS AL PACIENTE" )
	    {
	        $this->SUBCODE="consejos_al_paciente";
	        $this->NUM_CODE="03";
	    }
	    elseif ( $INPUT_LINE == "CONSIDERACIONES ESPECIALES" )
	    {
	        $this->SUBCODE="consideraciones_especiales";
	        $this->NUM_CODE="04";
	    }
	    elseif ( $INPUT_LINE == "CONTRAINDICACIONES" )
	    {
	        $this->SUBCODE="contraindicaciones";
	        $this->NUM_CODE="05";
	    }
	    elseif ( $INPUT_LINE == "EMBARAZO" )
	    {
	        $this->SUBCODE="embarazo";
	        $this->NUM_CODE="06";
	    }
	    elseif ( $INPUT_LINE == "FARMACOCINETICA" )
	    {
	        $this->SUBCODE="farmacocinetica";
	        $this->NUM_CODE="07";
	    }
	    elseif ( $INPUT_LINE == "INDICACIONES" )
	    {
	        $this->SUBCODE="indicaciones";
	        $this->NUM_CODE="08";
	    }
	    elseif ( $INPUT_LINE == "INTERACCIONES" )
	    {   
	        $this->SUBCODE="interacciones";
	        $this->NUM_CODE="09";
	    }
	    elseif ( $INPUT_LINE == "NORMAS PARA LA CORRECTA ADMINISTRACION" )
	    {   
	        $this->SUBCODE="normas_correcta_administracion";
	        $this->NUM_CODE="10";
	    }
	    elseif ( $INPUT_LINE == "POSOLOGIA" )
	    {
	        $this->SUBCODE="posologia";
	        $this->NUM_CODE="11";
	    }
	    elseif ( $INPUT_LINE == "POSOLOGIA EN INSUFICIENCIA HEPATICA" )
	    {
	        $this->SUBCODE="posologia_en_insuficiencia_hepatica";
	        $this->NUM_CODE="12";
	    }
	    elseif ( $INPUT_LINE == "POSOLOGIA EN INSUFICIENCIA RENAL" )
	    {
	        $this->SUBCODE="posologia_en_insuficiencia_renal";
	        $this->NUM_CODE="13";
	    }   
	    elseif ( $INPUT_LINE == "PRECAUCIONES" )
	    {
	        $this->SUBCODE="precauciones";
	        $this->NUM_CODE="14";
	    }       
	    elseif ( $INPUT_LINE == "EFECTOS SOBRE LA CONDUCCION" )    
	    {
	        $this->SUBCODE="efectos_conduccion";
	        $this->NUM_CODE="15";
	    }       
	    elseif ( $INPUT_LINE == "REACCIONES ADVERSAS" )
	    {
	        $this->SUBCODE="reacciones_adversas";
	        $this->NUM_CODE="16";
	    }
	    elseif ( $INPUT_LINE == "SOBREDOSIS" )
	    {
	        $this->SUBCODE="sobredosis";
	        $this->NUM_CODE="17";
	    }
	    elseif ( $INPUT_LINE == "REFERENCIAS BIBLIOGRAFICAS" )
	    {
	        $this->SUBCODE="referencias_bibliograficas";
	        $this->NUM_CODE="18";
	    }
	    elseif ( $INPUT_LINE == "FECHA DE APROBACION/REVISION DE LA FICHA" )
	    {
	        $this->SUBCODE="fecha_aprobacion";
	        $this->NUM_CODE="20";
	    }       
	//    elseif ( preg_match("LABORATORIO FARMACÉUTICO(.*)", $INPUT_LINE ) )
	    elseif ( $INPUT_LINE == "LABORATORIO FARMACEUTICO" )
	    {
	        $this->SUBCODE="laboratorio_farmaceutico";
	        $this->NUM_CODE="21";
	    }
	    elseif ( $INPUT_LINE == "COMPOSICION POR UNIDAD" )
	    {
	    //	$this->p ('X ' . $INPUT_LINE . $this->lr)				; // [PR_DISABLED]
	    	
	        $this->SUBCODE="composicion_unidad";
	        $this->NUM_CODE="22";
	    }
	    elseif ( $INPUT_LINE == "COMPOSICION POR ML." )
	    {
	        $this->SUBCODE="composicion_por_ml";
	        $this->NUM_CODE="23";
	    }
	    elseif ( $INPUT_LINE == "PRESENTACION" )
	    {
	        $this->SUBCODE="forma_farmaceutica";
	        $this->NUM_CODE="24";
	    }
	    elseif ( $INPUT_LINE == "USO EN PACIENTES CON INTOLERANCIA ALIMENTARIA" )
	    {
	        // Tag Parafarmacia
	        $this->SUBCODE="intolerancia_alimentaria";
	        $this->NUM_CODE="25";
	    }
	    elseif ( $INPUT_LINE == "CONSERVACION Y CADUCIDAD" )
	    {
	        // Tag Parafarmacia
	        $this->SUBCODE="conservacion_caducidad";
	        $this->NUM_CODE="26";
	    }
	    elseif ( $INPUT_LINE == "INGREDIENTES" )
	    {
	        // Tag Parafarmacia
	        $this->SUBCODE="ingredientes";
	        $this->NUM_CODE="27";
	    }
	    elseif ( $INPUT_LINE == "ANÁLISIS MEDIO" )
	    {
	        // Tag Parafarmacia
	        $this->SUBCODE="analisis_medio";
	        $this->NUM_CODE="28";
	    }
	    elseif ( $INPUT_LINE == "ENERGIA" )
	    {
	        // Tag Parafarmacia
	        $this->SUBCODE="energia";
	        $this->NUM_CODE="29";
	    }
	    elseif ( $INPUT_LINE == "PRECAUCIONES Y ADVERTENCIAS" )
	    {
	        // Tag Parafarmacia
	        $this->SUBCODE="precacuciones_advertencias";
	        $this->NUM_CODE="30";
	    }
	    elseif ( $INPUT_LINE == "ALERGIA AL LATEX" )
	    {
	        // Tag Parafarmacia - Pnales
	        $this->SUBCODE="alergia latex";
	        $this->NUM_CODE="31";
	    }
	    elseif ( $INPUT_LINE == "FORMA DE UTILIZACION" )
	    {
	        // Tag Parafarmacia - Pnales
	        $this->SUBCODE="forma_utilizacion";
	        $this->NUM_CODE="32";
	    }
	    elseif ( $INPUT_LINE == "PROPIEDADES" )
	    {
	        // Tag Parafarmacia - Pnales
	        $this->SUBCODE="propiedades";
	        $this->NUM_CODE="33";
	    }
	    elseif ( $INPUT_LINE == "ACCION Y DESCRIPCION" )
	    {
	        // Tag Parafarmacia - Pnales
	        $this->SUBCODE="accion_descripcion";
	        $this->NUM_CODE="34";
	    }
	    elseif ( $INPUT_LINE == "FUNCION" )
	    {
	        // Tag Parafarmacia - Pnales
	        $this->SUBCODE="funcion";
	        $this->NUM_CODE="35";
	    }
	    elseif ( $INPUT_LINE == "USO EN CONDICIONES ESPECIALES" )
	    {
	        // En este caso no deseamos guardar nada
	        $this->SUBCODE="";
	        $this->NUM_CODE="";
	    }
	    elseif ( $INPUT_LINE == "USO EN ALERGIAS" )
	    {
	        // En este caso no deseamos guardar nada
	        $this->SUBCODE="";
	        $this->NUM_CODE="";
	    }
	    elseif ( $INPUT_LINE == "INFORMACION NUTRICIONAL" )
	    {
	        // En este caso no deseamos guardar nada
	        $this->SUBCODE="";
	        $this->NUM_CODE="";
	    }


		$this->m = $old_m ; $this->n = $old_n 														;

	}



};

?>