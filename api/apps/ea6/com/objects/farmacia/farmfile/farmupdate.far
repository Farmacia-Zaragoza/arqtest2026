// Spc - Cica_d05 - Home - Index_06 - v0_0_1
//-------------------------------------------------------------------------------------
// Lang Store - Manage phrases 
//-------------------------------------------------------------------------------------
// INHERITANCE LINE:
//-------------------------------------------------------------------------------------
// (farmupdate) < (farmfolder) <  (farmprocess) < (farmtags) < (farmtranslate) < (farmarray) < (farmfile) 
//              < (storebase)
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// - [create]   	  		: Create sub-file prospect related 
// - [update]   	  		: Update sub-file prospect related 
// - [create_update]   	  	: Create and update sub-file prospect related 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--


class farmupdate extends farmfolder {

	public 		$n						=	'farmupdate::'											;

            
    public function __construct (	$langs			=	''											, 
    								$folder_base 	= 	'/brqx/base/farm'							)	  
    {   
		if ($langs != '' )		$this->langs			=	$langs									;
		$this->folder_base		=	$folder_base													;

		if (substr($this->folder_base, -1) != '/' )   $this->folder_base .= '/'						;

    }

	public function create()
	{
		$old_m = $this->m ; $this->m = 'create:'													;
		$old_n = $this->n ; $this->n = 'farmupdate::'												;

	// 1. Crea el fichero
	// 2. Busca / Actualiza cadenas en BD de idiomas

		create_lan_file(	$this->folder_es_path ,	$this->file_name	)							;
	
		foreach ($this->arr_langs as $slang)
		{
			$this->folder_full_path	=	
				$this->folder_base . $this->parent . $this->sep .  $slang . $this->sep . $this->input_code_div;
	
			// Folder /brqx/base/farm/PROSPECTOS/en/712/786 File 13-posologia_en_insuficiencia_renal.txt
			// $this->p($slang .  " Folder " . $this->folder_full_path . ' File ' .  $this->file_name . $this->lr );
			create_lan_file($this->folder_full_path	, $this->file_name)								;
	
			// embarazo en /brqx/lnk/lang/one_word/LANGS/en/e/em/emb.word
			$this->translate($slang)														;
		
		} // End Foreach

		$this->m = $old_m ; $this->n = $old_n 														;
				
	}

	public function update() 
						
	{
		$old_m = $this->m ; $this->m = 'update:'													;
		$old_n = $this->n ; $this->n = 'farmupdate::'												;
	// /brqx/base/farm/PROSPECTOS/es/712786

		#-Create Spanish file
		update_lan_file(	$this->folder_es_path													,
							$this->file_name														, 
							$this->LINE																);
	
		foreach ($this->arr_langs as $slang)
		{
			$this->folder_full_path	=	
				$this->folder_base . $this->parent . $this->sep .  $slang . $this->sep . $this->input_code_div;

			// Switch to test every section
			if (	$this->NUM_CODE != '002' 	) 
			{
			
				$this->translate($slang)													;
			
				// solo actualizamos el fichero si se ha traducido bien / Existe la linea
				if ( ($this->is_translated) and ($this->TRANS_LINE != '' ) ) 
				{
					// $this->p($slang .  " Fold " . $this->folder_full_path . ' File ' .  $this->file_name . ' L ' . $this->TRANS_LINE .  $this->lr );
	
					update_lan_file(	$this->folder_full_path 										, 
										$this->file_name												, 
										$this->TRANS_LINE												);
					
				}
			}
		}

		$this->m = $old_m ; $this->n = $old_n 														;
	}

	public function create_update()
	{
		$old_m = $this->m ; $this->m = 'create_update:'												;
		$old_n = $this->n ; $this->n = 'farmupdate::'												;

	#-Create Spanish file
		create_update_lan_file(	$this->folder_es_path												, 
								$this->file_name													,	
								$this->LINE)														;
	
		foreach ($this->arr_langs as $slang)
		{
		// Tenemos ya la iteracion de los idiomas
			$this->folder_full_path	=	
					$this->folder_base . $this->parent . $this->sep .  $slang . $this->sep . $this->input_code_div;
		
			// Folder:/brqx/base/farm/PROSPECTOS/en/712/786
			// $this->p('Folder:' . $this->folder_full_path . $this->lr)		; 		
			// Obtiene la linea de la BD de lineas ya traducidas o marca para traducir
	
			$this->translate($slang)													;
			// Solo actualizamos el fichero si se ha traducido la linea y si la linea no es vacia
			if ( ($this->is_translated) and ($this->TRANS_LINE != '' ) ) 
			{
				create_update_lan_file(	$this->folder_full_path										, 
										$this->file_name											,
										$this->TRANS_LINE											);
			}
		} // End Foreach

		$this->m = $old_m ; $this->n = $old_n 														;
	}

};

?>