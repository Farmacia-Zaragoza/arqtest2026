// Methods:
//-------------------------------------------------------------------------------------
// - d-character_review-   				: Review if is a guion
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--


class tr_crc_review extends tr_process_word {

	public 		$n							=	'tr_crc_review::'										;
	
	
	protected function caracter_review($crc = '')
	{
		$old_m = $this->m ; $this->m 				= 'caracter_review:'								;
		$old_n = $this->n ; $this->n 				= 'tr_crc_review::' 							;

		// --==--==--==--==--==--==--  D- ES UN CARACTER. ES PARTE DE UNA PALABRA --==--==--==--==--==--==--==--==- 
		// C- ES UN CARACTER
		// Caso :  Se recomienda (29) 
		// Interferencia analítica: Reducción: ácido 5-hidroxi indolacético'
		// ___________*_____________

		$this->word 					.= $this->chars_before_words										;
		$this->word 					.= $this->chars_between_words										;
		$this->word						.= $crc																;

		// Si el espacio es parte de la palabra no hay que insertarlo en la frase
		
		$this->chars_before_words 		= ''																;
		$this->chars_between_words 		= ''																;
		$this->chars_after_words		= ''																;
		
		$this->word_started 			= true 																;

		$this->end_of_word 				= false 															;

	}
	

};


?>