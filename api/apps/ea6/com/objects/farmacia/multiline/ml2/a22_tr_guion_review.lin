// Methods:
//-------------------------------------------------------------------------------------
// - d-guion_review-   				: Review if is a guion
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--


class tr_guion_review extends tr_number_review {

	public 		$n							=	'tr_guion_review::'										;
	
            

	protected function guion_review($crc = '', $type = 'read')
	{
		$old_m = $this->m ; $this->m 				= 'guion_review:'								;
		$old_n = $this->n ; $this->n 				= 'tr_guion_review::' 							;

		//--==--==--==--==--==--==--  A- ES UN GUION. PUEDE SER PARTE DE UNA PALABRA --==--==--==--==--==--==--
	 
		// No se ha iniciado la palabra - se inserta a al frase y punto
		// Hay caracteres antes - indicara final de palabra

		// $this->p('G[' . $crc . ']' . $this->lr)		;
		if ( $this->word_started )
		{
		// $this->p('G1[' . $crc . ']' . $this->lr)		;
			if ($this->chars_between_words == '')
			{
				// $this->p('G2[' . $crc . ']' . $this->lr)		;
				// El guion es parte de la palabra
				$this->word 						.= $this->chars_before_words							;
				$this->word 						.= $this->chars_between_words							;
				$this->word 						.= $crc																;
			}
			else 
			{
				// el guion indicara fin de palabra y de frase
				$this->chars_after_words		.= $crc					;
				$this->process_word($type) 								;
			}
			
		}	
		else
		{
			$this->chars_before_words 		.= $crc 										;
		}						
		
	}


};


?>