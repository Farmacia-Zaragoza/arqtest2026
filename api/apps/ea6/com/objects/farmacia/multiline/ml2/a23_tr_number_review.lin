// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// - d-number_review-   				: Review if is a number
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--


class tr_number_review extends tr_symbol_review {

	public 		$n							=	'tr_number_review::'										;
	

	protected function number_review ($crc = '', $type = 'read')
	{
		$old_m = $this->m ; $this->m 				= 'symbol_review:'								;
		$old_n = $this->n ; $this->n 				= 'tr_number_review::' 							;

	//--==--==--==--==--==--==--  B- ES UN NUMERO. NO SIEMPRE INDICA FINAL DE PALABRA --==--==--==--==--==--==-- 
	// [CIRUGIA]. Se recomienda suspender la administración de AAS al menos 5-7 días antes de una intervención quirúrgica
	// Interferencia analítica: Reducción: ácido 5-hidroxi indolacético'

		if ( $this->word_started )
		{
			// $this->p($crc .' :-:Bef-' . $this->chars_before_words . ':-:Btw-' . $this->chars_between_words . $this->lr ) ; 

			$this->word 						.= $this->chars_before_words							;
			$this->word 						.= $this->chars_between_words							;
			$this->word							.= $crc													;
			
			$this->chars_before_words			=	''													;
			$this->chars_between_words			=	''													;
		}
		else		
		{
			// A2.NUMERO CON PALABRA NO INICIADA.  Cambio lo vamos a tratar como parte de una palabra
			// Caso : ; 5-hydroxy indoleacetic acid
			// _______*____________________
			$this->word 					.= $this->chars_before_words							;
			$this->word 					.= $this->chars_between_words										;
			$this->word						.= $crc																;
	
			// Si el espacio es parte de la palabra no hay que insertarlo en la frase
			
			$this->chars_between_words 		= ''																;
			$this->chars_after_words		= ''																;
			
			$this->word_started 			= true 																;
		}			

	}



};


?>