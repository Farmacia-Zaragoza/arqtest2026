// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// - d-update_multi_line_with_one_line-		: Make update for full multi lines (ES@@LA)
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

class tr_update_ml_with_one_line extends tr_update_ml_with_two_lines {

	public 		$n						=	'tr_update_ml_with_one_line::'								;
	

	// Internal
	// Linea ya en formato con arrobas
	protected function update_multi_line_with_one_line(	
												$full_line 	= '' 						, 
												$force 		= false 					, 
												$lang 		= ''						)
	{
		$old_m = $this->m ; $this->m = 'update_multi_line_with_one_line::'						;
		$old_n = $this->n ; $this->n = 'tr_update_ml_with_one_line::'									;

		if ($full_line != '' )
		{
 			$this->update_lang_type ($lang )											;
			if ($force 			  ) $this->force_update	= $force						;

			$split_arr 		= 	preg_split($this->sep_lang_expr, $full_line)			;
	
			$arr_len		=	count($split_arr)-1										;


			if ($arr_len >0) 
			{

				$this->multi_line_es 	=	$split_arr[0]								;	 			
				$this->multi_line_lan	=	$split_arr[1] 								;
				$this->line 			=	$this->multi_line_es 						;

				$this->check_multi($this->multi_line_es 		)						; 
				$this->check_multi_lan($this->multi_line_lan	)   					;

				if ( $this->is_multi_line and $this->is_multi_line_lan )  
				{
					$this->prepare_arrays() 											;			
		
					$this->process_arrays()												;			
				}

				$this->is_multi_line 		= $this->is_multiline($this->multi_line_es)	;

				$this->some_is_multi_line = ( $this->is_multi_line ) 				;

				if ( $this->some_is_multi_line )
				{  
//					$this->p('Oje Multiline' . $this->multi_line_es . $this->lr)	; // [PR_DISABLED]		
					$this->folder_db_path = '/brqx/lnk/lang/complex_phrases'		;
		
				}
		
				$this->update_current_multi()										;

				$this->folder_db_path = '/brqx/lnk/lang/phrases'					;

			}
		}
		$this->m = $old_m; $this->n = $old_n 										;
	}

};


?>