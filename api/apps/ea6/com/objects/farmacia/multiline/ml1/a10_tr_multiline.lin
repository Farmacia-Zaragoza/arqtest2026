class multiline extends tr_multi_read {

	public 		$n						=	'multiline::'							;
            
    public function __construct (	$lang			=	'en' 						,
    								$folder_path 	= 	'/brqx/lnk/lang/phrases'	, 
    								$db_file_name 	= 	'word'						)	  
    {   

		$this->db_file_name			=	$db_file_name 									;
		$this->update_lang_type	( $lang )												;
		
		if ($this->folder_db_path == '')	$this->folder_db_path	= $folder_path 		;

	    $this->folder_current_path	=	getcwd()										;

		$this->sep_lang_expr =	"/[" . $this->sep_lang . "]+/"							;
	
		// $this->update_lang_type()														;

		// Get php version 5.2 (52) - 5.6 (56)		
		$this->php_version = str_replace(".","",substr(phpversion(), 1,3))				; 			

    }

};


?>