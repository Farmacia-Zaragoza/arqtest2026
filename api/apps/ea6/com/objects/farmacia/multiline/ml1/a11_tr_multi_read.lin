//-------------------------------------------------------------------------------------
// Lang Store - Read / Search multi strings  
//-------------------------------------------------------------------------------------
// INHERITANCE LINE: [DEEP LEVEL : 03]
//-------------------------------------------------------------------------------------
// (multiline) < (multilineitf) < (multicomplex) < (multisearch) < (multiupdate) < (multibase) 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// - -d-multi_read-   				: Read/search an expresion in multi line and in inner lines
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--


class tr_multi_read extends tr_line_review {

	public 		$n						=	'tr_multi_read::'										;
	

	protected function multi_read(		$es_line 	= ''										, 
										$lang 		= ''										)
	{
		$old_m = $this->m ; $this->m 				= 'multi_read:'								;
		$old_n = $this->n ; $this->n 				= 'tr_multi_read::' 							;

		// 1. Intentamos buscar la cadena entera
		// 2. Si no se encuentra buscaremos inteligentemente
		if ($es_line != '')
		{
			$is_translated 		= true															;
			$search_msg			=	''															;
			$full_search_msg			=	''													;
			$translated_phrase 			= 	''													;

			// $this->p('T1 -[' . $es_line  . ']-' . $this->lr)										; //[PR_DISABLED]		

			// Replace multiple spaces - dashes - external - internal
			$es_line	=	dash_clean_with_feed($es_line)										;
		

			// $this->p('T2 -[' . $es_line  . ']-' . $this->lr)										; //[PR_DISABLED]		

			// si llamamos a read hacemos un bucle. Queremos un read simple
			$this->store_or_search_multi_line	=	true 										;			
			// Process for READ / SEARCH
			$this->process_multi_complex_read($es_line)													;
			$this->store_or_search_multi_line	=	false 										;			

//			$this->p('Tran3 ' . $this->is_translated . $this->lr)								; //[PR_DISABLED]		
//			if (!$this->is_translated and ('A' == 'B') )
			
			if (!$this->is_translated )
			{		

				// $this->p('Inner translation ' . $es_line . $this->lr ) ; // [PR_DISABLED]		
				// No la ha encontrado. eliminamos cadena not_found
				$this->translated_line = ''																;

				// Si no lo ponemos a true nunca va a ser correcta la traduccion
				$this->is_translated  	= true 															;

				if ($this->check_multi($es_line) )
				{
					// $this->p('Entr ' . $es_line .  $this->lr ) ; // [PR_DISABLED]
	
		 			$this->update_lang_type ($lang )													;

					// Call to line review - Will Generate translated_phrase
					$this->is_translated	= 	$this->line_review($es_line)		;
					$this->search_msg		=	$search_msg												;
			
					$this->translated_line 	= 	$this->translated_phrase										;

				}
			}
		}

		$this->m = $old_m; $this->n = $old_n 																;
	}

};


?>