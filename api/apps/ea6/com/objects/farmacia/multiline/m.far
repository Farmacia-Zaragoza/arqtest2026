// Methods:
//-------------------------------------------------------------------------------------
// - d-update_full_line-  	  	: Update database with a full line translated
// - d-update- 					: Update database with two expresions ES and LAN 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
	

class multiline extends multilineitf {
	public 		$n						=	'multiline::'							;
            
    public function __construct (	$lang			=	'en' 						,
    								$folder_path 	= 	'/brqx/lnk/lang/phrases'	, 
    								$db_file_name 	= 	'word'						)	  
    {   

		$this->db_file_name			=	$db_file_name 									;
		$this->update_lang_type	( $lang )												;
		
		if ($this->folder_db_path == '')	$this->folder_db_path	= $folder_path 		;

    }

	// Linea ya en formato con arrobas
	public function update_multiline_with_one_line(	
										$full_line  	= '' 				, 
										$force 			= false 			, 
										$lang 			= ''				)
	{
		$old_m = $this->m ; $this->m	= 	'update_full_line:'									;
		$old_n = $this->n ; $this->n	=	'multiline::'											;

		if ($this->is_multiline($full_line))	
		{
//			$this->p('Actu M ' . $full_line . $this->lr)								; // [PR_DISABLED]
			$this->update_multi_line_with_one_line($full_line, $force , $lang) 		;
		}
		else
		{
//			$this->p('Actu S ' . $full_line . $this->lr)								; // [PR_DISBLED]
			$this->update_full_simple_line($full_line, $force , $lang) 		;
		}
		$this->m = $old_m ; $this->n = $old_n 													;
	}

	// Linea ya en formato con arrobas
	public function update_multiline_with_two_lines(	
							$multi_line_es  			= '' 				, 
							$multi_line_lan  			= ''  				, 
							$force 						= false				, 
							$lang 						= ''				)
	{
		$old_m = $this->m ; $this->m	= 	'update:'											;
		$old_n = $this->n ; $this->n	=	'multiline::'										;

		if ($this->is_multiline($multi_line_es) or 
			$this->is_multiline($multi_line_lan)	)
			$this->update_multi_line_with_two_lines(	
										$multi_line_es						, 
										$multi_line_lan						, 
										$force 								, 
										$lang								);
		else
			$this->update_simple_line(	$multi_line_es						, 
										$multi_line_lan						, 
										$force 								,  
										$lang								);

		$this->m = $old_m ; $this->n = $old_n 													;
	}

};

