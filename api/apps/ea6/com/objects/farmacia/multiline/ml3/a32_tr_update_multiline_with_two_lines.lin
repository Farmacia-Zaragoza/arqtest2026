// - d-tr_update_multiline_with_two_lines-  	  	: Update database with a full line translated
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
	

class tr_update_multiline_with_two_lines extends tr_update_current_multi {

	public 		$n						=	'tr_update_multiline_with_two_lines::'							;
            
	// External method
	// Linea ya en formato con arrobas
	public function update_multiline_with_two_lines(	
							$multi_line_es  			= '' 				, 
							$multi_line_lan  			= ''  				, 
							$force 						= false				, 
							$lang 						= ''				)
	{
		$old_m = $this->m ; $this->m	= 	'update:'											;
		$old_n = $this->n ; $this->n	=	'tr_update_multiline_with_two_lines::'										;

		if ($this->is_multiline($multi_line_es) or 
			$this->is_multiline($multi_line_lan)	)
			$this->update_multi_line_with_two_lines(	
										$multi_line_es						, 
										$multi_line_lan						, 
										$force 								, 
										$lang								);
		else
			$this->update_simple_line(	$multi_line_es						, 
										$multi_line_lan						, 
										$force 								,  
										$lang								);

		$this->m = $old_m ; $this->n = $old_n 													;
	}

};


?>