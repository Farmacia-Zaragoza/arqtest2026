// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
	

class tr_update_multiline_with_one_line extends tr_update_multiline_with_two_lines {

	public 		$n						=	'tr_update_multiline_with_one_line::'							;
            
	// External method
	// Linea ya en formato con arrobas
	public function update_multiline_with_one_line(	
										$full_line  	= '' 				, 
										$force 			= false 			, 
										$lang 			= ''				)
	{
		$old_m = $this->m ; $this->m	= 	'update_multiline_with_one_line:'									;
		$old_n = $this->n ; $this->n	=	'tr_update_multiline_with_one_line::'											;

		if ($this->is_multiline($full_line))	
		{
//			$this->p('Actu M ' . $full_line . $this->lr)								; // [PR_DISABLED]
			$this->update_multi_line_with_one_line($full_line, $force , $lang) 		;
		}
		else
		{
//			$this->p('Actu S ' . $full_line . $this->lr)								; // [PR_DISBLED]
			$this->update_full_simple_line($full_line, $force , $lang) 		;
		}
		$this->m = $old_m ; $this->n = $old_n 													;
	}


};


?>