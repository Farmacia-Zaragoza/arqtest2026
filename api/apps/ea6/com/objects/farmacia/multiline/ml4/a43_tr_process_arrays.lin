//-------------------------------------------------------------------------------------
// Lang Store - Manage phrases 
//-------------------------------------------------------------------------------------
// INHERITANCE LINE: [DEEP LEVEL : 04]
//-------------------------------------------------------------------------------------
// (multiline) < (multilineitf) < (multicomplex) < (multisearch) < (multiupdate) < (multibase) 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// - -d-process_arrays-				: Process every line using arrays 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

class tr_process_arrays extends tr_update_ml_with_one_line {

	public 		$n						=	'tr_process_arrays::'						;
	
	
	protected function process_arrays()
	{
		$old_m = $this->m ; $this->m 				= 'process_arrays:'										;
		$old_n = $this->n ; $this->n 				= 'tr_process_arrays' 								;
		// La idea es procesar las frases internamente para tener un mayor grado de actualizacion
		// Pero esto no se puede hacer si los separadores no son exactamente los mismos pues provocaria inconsistencias

		$this->l 				=	new transline($this->lang)							;		

		// Si no tienen los mismos limitadores no es logico procesarlos internamente
		// Ej : multiline::Line adhesivo_cutaneo,_tejido_de_malla,_hidrogel,_adhesivo_integral,_lamina_de_espuma_y_pelicula_limitante_adhesiva@@
		//                 Skin adhesive, mesh fabric, hydrogel integral adhesive foam sheet and adhesive film limiting
		// multiline::ES 5
		// multiline::LAN 3

		$this->p("E " . count ($this->arr_multi) . ' L ' . count($this->arr_multi_lan) .  $this->lr )	; // [PR_ENABLED]
				
		if ( (count ($this->arr_multi)) == ( count ($this->arr_multi_lan) ) )			
		{
			
			foreach ($this->arr_multi as $pos => $line)
			{
				$trim_es  = trim($this->arr_multi[$pos])								;
				$trim_lan = trim($this->arr_multi_lan[$pos])							;
	
				$linea		= $trim_es 	. $this->sep_lang . $trim_lan 					;
				$trim_line	= trim($linea) 												;
	
				// $this->p("E " . $trim_es . ' L ' . $trim_lan .  $this->lr )			; // [PR_DISABLED]
				// $this->p("Lin " . $trim_line .  $this->lr )							; // [PR_DISABLED]
	
				$this->ml = new multiline($this->lang)									;
				$this->ml->update_full_line($trim_line, $this->force_update)			;			
	
			}
		}
		$this->m = $old_m ;$this->n = $old_n ; 
	}


};


?>