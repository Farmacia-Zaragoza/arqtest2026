//class fnode extends getset {

class tr_check_multi extends trb_strings {

	public 		$n						=	'tr_check_multi::'							;



	public function check_multi($multi_line	= '')
	{
		$old_m = $this->m ; $this->m = 'check_multi'													;
		$old_n = $this->n ; $this->n = 'tr_check_multi' 														;

		// Check - generate line array (arr_multi)  and enable switch
		$this->is_multi_line 	= 	false																;

		if ($this->is_multiline($multi_line) )
		{
			$this->multi_line_es 	= 	$multi_line														;

			$this->line				=	$this->multi_line_es 											;
			$this->arr_multi 		= 	preg_split(		$this->sep_multi_preg							, 
														$this->multi_line_es							);

			
			$this->is_multi_line 	= 	true															;
		}

		$this->m = $old_m ; $this->n = $old_n 															; 
		return $this->is_multi_line 																	;
	}

	public function check_multi_lan($multi_line	= '')
	{
		$old_m = $this->m ; $this->m = 'check_multi_lan'												;
		$old_n = $this->n ; $this->n = 'tr_check_multi' 														;

		// Check - generate line array (arr_multi)  and enable switch
		$this->is_multi_line_lan 	= 	false															;

		if ($this->is_multiline($multi_line) )
		{
			$this->multi_line_lan = $multi_line															;

			$this->arr_multi_lan 	= 	preg_split(		$this->sep_multi_preg	, 
														$this->multi_line_lan							);
		
			$this->is_multi_line_lan 	= 	true														;
		}

		$this->m = $old_m ; $this->n = $old_n 															; 
		return $this->is_multi_line_lan 																;
	}

};


?>