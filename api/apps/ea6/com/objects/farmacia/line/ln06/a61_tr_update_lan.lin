// Methods:
//-------------------------------------------------------------------------------------
// - [update_lan]				  	: Update a file for LAN
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

class tr_update_lan extends tr_update_es {

	public 		$n						=	'tr_update_lan::'							;

	protected function update_lan()
	{
		$old_m = $this->m ; $this->m = 'update_lan:'									;
		$old_n = $this->n ; $this->n = 'tr_update_lan::'								;

		
		update_full_filename($this->full_lang_file	,	$this->dual_line)				;
		
		//3. Si se ha actualizado el fichero hay que ordenarlo
		
		$this->arr_vlineas = file($this->full_lang_file)								; 

//		$this->p('Fichero' . $this->full_lang_file . $this->lr)		; // [PR_DISABLED]			

		// Hay que afrontar distintas versiones de php. Por ejemplo en el paso de parametros por referencia
		// Podemos comprobarlo previamente. La funcion puede ser la misma pero el paso de parametros no
		trans_sort($this->arr_vlineas)													; // For [Php_56]

//		trans_sort(&$this->arr_vlineas)													; // For [Php_52]
				
		//Save the serialized array to a text file.
		file_put_contents($this->full_lang_file, $this->arr_vlineas)					;

		$this->updated = true 															; 

		$this->m = $old_m	;$this->n = $old_n 											;
	}

};


?>