// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

class tr_create_update_es extends tr_update_check {

	public 		$n						=	'tr_create_update_es::'							;

            
	protected function create_update_es()
	{
		$old_m = $this->m ; $this->m = 'create_update_es:'								;
		$old_n = $this->n ; $this->n = 'tr_create_update_es::'								;

		create_update_full_filename($this->full_lang_file_es,$this->dual_line_es)		;

		$this->updated = true 															; 

		$this->m = $old_m ; $this->n = $old_n 											;
	}


};


