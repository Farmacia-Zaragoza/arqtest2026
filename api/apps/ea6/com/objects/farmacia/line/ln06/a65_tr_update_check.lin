//            < (langlinebase) 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// - d-update_check_lan-   	  : Check, search and update for ES
// - d-update_check_es-		  : Check, search and update for LAN
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

class tr_update_check extends tr_check_multi {

	public 		$n						=	'tr_update_check::'							;


	protected function update_check_lan()
	{
		$old_m = $this->m ; $this->m = 'update_check_lan:'							;
		$old_n = $this->n ; $this->n = 'tr_update_check::'								;

		// si no existe la carpeta la creamos
		if (!is_dir($this->lang_folder_path))
		{
		//  echo 'mkdir(' . $this->lang_folder_path . ')-' . $this->lr				;
		    mkdir($this->lang_folder_path,0775,true)								;
		}	

//		print $this->n . 'Pos' . strpos($this->lang_line, "�") .   $this->lr ;

		if ( !is_file($this->full_lang_file)  )
		{
//			print $this->n . 'LAN - Generando fichero nuevo ' . $this->dual_line .  ' en  ' . $this->lang  . $this->lr ;
			
			$this->create_update_lan();
		}
		elseif ( (!$this->search()) or $this->force_update )
		{
			// -Si no existe actualizar el fichero
			// En este caso existe fichero y es una cadena nueva
		
//			print $this->n . 'LAN - Actualizar ' . $this->part_line .  ' en  ' . $this->lang . $this->lr ;
		
			// Actualiza fichero de BD de idiomas
		
			$this->update_lan()														;
		 
		} // End If
		$this->m = $old_m; $this->n = $old_n 										;
	}
	// Actualiza el diccionario con la cadena indicada si no existe previamente
	protected function update_check_es()
	{
		$old_m = $this->m ; $this->m = 'update_check_es:'							;
		$old_n = $this->n ; $this->n = 'tr_update_check:'								;
		// si no existe la carpeta la creamos
		if (!is_dir($this->lang_folder_path_es))
		{
		//  echo 'mkdir(' . $this->lang_folder_path . ')-' . $this->lr				;
		    mkdir($this->lang_folder_path_es,0775,true)								;
		}	

		// Comprobar caracteres raros

//		print $this->n . 'ES - Generando fichero nuevo ' . $this->full_lang_file_es . $this->lr ;
		
		if ( !is_file($this->full_lang_file_es)  )
		{
//			print $this->n . 'ES - Generando fichero nuevo ' . $this->full_lang_file_es .  ' en  ' . $this->base_lang  . $this->lr ;
			
			$this->create_update_es()												;
		
		}
		elseif ( (!$this->search_es()) or $this->force_update )
		{
			// -Si no existe actualizar el fichero
			// En este caso existe fichero y es una cadena nueva
		
//			print $this->n . 'ES - Actualizar ' . $this->part_line .  ' en  ' . $this->base_lang  . $this->lr ;
		
		//	do_translate($SLINE,$TRANS_LINE ,$slang)								;
		
			// Actualiza fichero de BD de idiomas

			$this->update_es()														;
		 
		} // End If
		
		$this->m = $old_m; $this->n = $old_n 										;
			
	}

};


?>