class tr_create_update_lan extends tr_create_update_es {

	public 		$n						=	'tr_create_update_lan::'							;

            

	protected function create_update_lan()
	{
		$old_m = $this->m ; $this->m = 'create_update_lan:'								;
		$old_n = $this->n ; $this->n = 'tr_create_update_lan::'								;
	
//		$this->p('Html: ' . $html_string . ' Unicode : ' . $this->dual_line . $this->lr)		; // [PR_ENABLED]

		create_update_full_filename($this->full_lang_file,$this->dual_line)				;

		$this->updated = true 															; 

		$this->m = $old_m ; $this->n = $old_n 											;
	}


};


