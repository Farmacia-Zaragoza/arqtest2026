//-------------------------------------------------------------------------------------
// Lang Store - Manage phrases  [Level 0 ]
//-------------------------------------------------------------------------------------
// Engine de busqueda y actualizacion de expresiones en castellano o en el idioma que se defina como base
//-------------------------------------------------------------------------------------
// INHERITANCE LINE: [DEEP LEVEL : 06]
//-------------------------------------------------------------------------------------
// (langline) < (langlineitf) < (langreadline) < (langlinees) < (langupdateline) < (langsearchline)
//            < (langlinebase) 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// - d-load-   	  		: Load a line to translate 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

class tr_load extends tr_prepare {

	public 		$n						=	'tr_load::'												;


	// Parece que prepara los datos
	protected function load($line	=	'')
	{
		// Llama a check  - Define las letras - Llama a Prepare
	
		$old_m = $this->m ;	$this->m 	= 	'load:'														;
		$old_n = $this->n ;	$this->n	=	'tr_load::'											;

		if ($line != '')	$this->line = $line															;

		// Ha pasado ya antes
		// $this->p('Line B ' . $this->line ); // [PR_DISABLED]

		// Check empty string and number of words
		if ( ( $this->check()					) OR 
			$this->store_or_search_multi_line 	)
		{

			// Replace multiple inner spaces 
			$this->line = dash_clean_with_feed($this->line)												;

			// Ha pasado ya antes
  		    // $this->p('LA ' . $this->line .   $this->lr 			); // [PR_DISABLED]

			// Line already processed in multi line read - DUDA DE SI HAY QUE EJECUTARLO O NO 
			// $this->process_multi_complex($this->line) 	; $this->line = $this->processed_complex_word ;  

			// $this->p('LP ' . $this->line .   $this->lr 			); // [PR_DISABLED]

			$this->original_line 		=	$this->line 													;
			
			//Las lineas las guardamos sin espacios y en minusculas
			$this->lower_line			=	str_replace(' ', '_', 	$this->original_line		)			;

			//Linea sin acentos ni caracteres raros. Ideal para indexar. Mirar con idiomas raros
 			$this->dash_line_for_file	=	strtolower_utf8_clean_for_file($this->lower_line)			; 
 			$this->dash_line_for_line	=	strtolower_utf8_clean_for_line($this->lower_line)			; 

			
			// Rename special characters - accents to eacute and so on 
			$html_string = utf32_encode ($this->original_line , '01')									;
			
			$this->dual_line_es 		=	
				$this->dash_line_for_line . $this->sep_lang . $html_string 								;

			// Evitamos las lineas con dos puntos

			$this->one_letter			=	one_letter    ( substr($this->dash_line_for_file,0,1) 		);  // Dos primeras letras
	
			$this->two_letters			=	two_letters   ( substr($this->dash_line_for_file,0,2) 		);  // Dos primeras letras
	
			$this->three_letters		=	three_letters ( substr($this->dash_line_for_file,0,3) 		);  // Tres primeras letras

//			print 'Dash line   :  ' .  $this->dash_line_for_line 			. '-' . $this->lr			;
//			print 'Dash line   :  ' .  $this->dash_line_for_file 			. '-' . $this->lr			;

//			print 'One Letter   :  ' . $this->one_letter 			. '-' . $this->lr					;
//			print 'Two Letters  :  ' . $this->two_letters 			. '-' . $this->lr					;
//			print 'Three Letters:  ' . $this->three_letters			. '-' . $this->lr					;
		}

		$this->prepare()																				;	

		$this->m = $old_m ; $this->n = $old_n 															;
	}
	

};

?>