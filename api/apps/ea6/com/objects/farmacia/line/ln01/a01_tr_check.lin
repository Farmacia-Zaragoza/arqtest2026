<?php 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Translation Line Check Class  [V.0.1.8]  (2017-05-18)
// Brqx Group - Agile Farmacia Zaragoza Methodology
// Spc - Cica_d05 - Home - Index_06 - v0_0_1
//-------------------------------------------------------------------------------------
// Lang Store - Manage phrases  [Level 0 ]
//-------------------------------------------------------------------------------------
// Engine de busqueda y actualizacion de expresiones en castellano o en el idioma que se defina como base
//-------------------------------------------------------------------------------------
// INHERITANCE LINE: [DEEP LEVEL : 06]
//-------------------------------------------------------------------------------------
// (langline) < (langlineitf) < (langreadline) < (langlinees) < (langupdateline) < (langsearchline)
//            < (langlinebase) 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// - [check]		  	: Check empty lines
// - [check_line]		: Run check passing a line
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

class tr_check extends tr_load {

	public 		$n						=	'tr_check::'												;


	public function check($site_replace = '')
	{
		// Check if is multiline

		$old_m = $this->m ; $this->m 	= 	'check:'													;
		$old_n = $this->n ; $this->n	=	'tr_check::'												;

		// Is not used yet
		if ($site_replace != '') $this->site_replace = $site_replace 									;  

		$this->line_check 	= false																		; 

		if ($this->line != '')
		{

						
			if ($this->site_replace != '' )
					$this->folder_db_path 	= 
						str_replace(	'phrases'														, 
										$this->site_replace .'_phrases'									, 
										$this->folder_db_path											);				

			$this->is_multi_line		= 	$this->is_multiline($this->line) 							;
			$this->is_multi_line_lan	=	$this->is_multiline($this->lang_line)						;

//			$this->p('Bool Es' . $this->is_multi_line . ' LAN ' . $this->is_multi_line_lan . $this->lr )		; // [PR_DISABLED]

			$this->none_is_multi_line	= 	
					(!$this->is_multi_line and !$this->is_multi_line_lan )								; // !(A or B) = !A and !B
			
			// Aqui solo entra si ninguna es multi line
			if ($this->none_is_multi_line )
			{

				// $this->p('CHEKING_CHEK')																		;
				
//				$this->p(' MLine ' . $this->line . ' Folder ' . $this->folder_db_path .  $this->lr ); // [PR_DISABLED]
				
				// Si la linea son numeros o elementos especiales ni se traduce ni se almacena
				
				if ( 
				   ( eregi("^([0-9]|[\.|\,|\:|\;|\'|\"])+([\.|,|\'|\"|+|-|\<|\>|\*|\ |_|\%])*([0-9])*$",$this->line) ) 
				   and  
				   ( preg_match('/[^\x20-\x7f]/', $this->line) ) )
 					// Report line status check to avoid empty lines			
				{
 						$this->line_check = false														;
//						$this->p('Incorrect line' . $this->line . $this->lr )							; // [PR_DISABLED]
						return $this->line_check ;		 
				}
				else
				{
					// Report line status check to avoid empty lines			
					$this->line_check = true															; 

					$num_words = str_word_count($this->line) 											;

					// $this->p('Word_Es-' . $this->line . '- Num -' . $num_words)		; // [PR_DISABLED]
					// $this->p('Before_change ' . $this->folder_db_path )									;
					
					// Nunca debe reemplazar complex aqui

					if ( ($num_words < 5) AND 
					   ($this->folder_db_path != '/brqx/lnk/lang/complex_phrases') ) 
					{

					// Ojo con los acentos y caracteres raros los traduce como palabras multiples						
					switch ($num_words) 
					    {
					    case 1:
							$this->folder_db_path 	= 
									str_replace('phrases', 'one_word'		, 	$this->folder_db_path	);				
					    case 2:
							$this->folder_db_path 	= 
									str_replace('phrases', 'two_words'		, 	$this->folder_db_path	);				
					    case 3:
							$this->folder_db_path 	= 
									str_replace('phrases', 'three_words'	, 	$this->folder_db_path	);				
					    case 4:
							$this->folder_db_path 	= 
									str_replace('phrases', 'four_words'		, 	$this->folder_db_path	);				
					    }				
				
						// El caso por defecto no funciona bien

						
						
					} // End If

					// $this->p('Before Entering_to_change ' . $num_words)												;
					
					if  ( $num_words > 4)
					{
						// $this->p('Entering_to_change')												;
						$this->folder_db_path 	= '/brqx/lnk/lang/phrases/'							;
					}							

					// $this->p('Db_Folder_path-' . $this->folder_db_path )		; // [PR_DISABLED]

				}
			}

		}

		$this->m = $old_m ; $this->n = $old_n 															;
		return $this->line_check 																		; 
	}

	// Same than check but passing a line
	public function check_line($line)
	{
		$this->line 			= $line 																;
		return $this->check()																			;
	}

	
};

?>