// Esta clase aun no funciona. no recuerdo
class transline extends tr_check {
	

	public 		$n						=	'transline::'			;

            
    public function __construct (	$lang			=	'en' 						,
    								$folder_path = '/brqx/lnk/lang/phrases'	, 
    								$db_file_name 	= 'word')	  
    {   
		$this->db_file_name			=	$db_file_name 						;

		$this->update_lang_type	( $lang )												;
		
		if ($this->folder_db_path == '')	$this->folder_db_path	= $folder_path 		;

	    $this->folder_current_path	=	getcwd()										;

		$this->sep_lang_expr =	"/[" . $this->sep_lang . "]+/"							;
	
		// $this->update_lang_type()														;

		// Get php version 5.2 (52) - 5.6 (56)		
		$this->php_version = str_replace(".","",substr(phpversion(), 1,3))				; 			
		
    }

	// Queda pendiente revisar este metodo
	public function read_and_translate($phrase = '' , $lang = 'en')
	{
		if ($phrase == '' ) $phrase = $this->line 			;

		$this->load($phrase, $lang)							;
		
		// si no existe la carpeta la creamos
		if (!is_dir($this->lang_folder_path))
    			echo 'mkdir(' . $this->lang_folder_path . $this->lr								;
				//echo "Actualizando " . $full_file_name . $lf;	

		$TRANS_LINE_TO_WRITE="";

		// si no existe el fichero lo creamos tambien
		if (!is_file($this->full_lang_file))
		{
			//	echo "Caso 1 : Fichero no existe : Hay que traducir" . $lf;
			// Son lineas con el formato esp@@idioma
		
			// Aqui tenemos que considerar tanto la linea que guardamos como la linea que traducimos e imprimimos en el fichero
			// Por lo que tendremos dos DUAL LINES o bien dos TRANS_LINES
			
			$this->part_line	=	get_first_clean_occurence($this->line	,	$this->sep_end_line	,	$this->endpart_line);
		
			print 'TRADUCIR ' . $this->part_line .  ' en  ' . $this->lang . $this->lr;

			##	do_translate($SLINE,$TRANS_LINE ,$slang)							;
						
			$TRANS_LINE_TO_WRITE	= 	$this->translated_line	. $this->endpart_line;
				
			$this->dual_line		=	$this->dash_line_for_line . $this->sep_lang . $this->translated_line;
				
			echo "Linea dual : " . $this->translated_line . $this->lr;
				
				// Crea y actualiza fichero de BD de idiomas

				
			//	create_update_full_filename($FULL_LANG_FILE,$DUAL_LINE);

		}
		elseif ($this->search() )
		{
			//2. Debe hacer una busqueda a ver si existe la frase
			// -Si existe recuperarla - en la variable TRANS_LINE
			print 'Linea encontrada ' . $this->translated_line .  ' en  ' . $lang ;
			
		}				
		else 
		{
			// -Si no existe actualizar el fichero
			// En este caso existe fichero y es una cadena nueva
		
		//	echo "Caso 3: Fichero existe Hay que traducir al ser nueva cadena" . $lf;
			$this->part_line =get_first_clean_occurence($this->line, $this->sep_end_line, $this->endpart_line)	;
		
			print 'TRADUCIR ' . $this->part_line .  ' en  ' . $lang ;
		
		//	do_translate($SLINE,$TRANS_LINE ,$slang)							;

			$TRANS_LINE_TO_WRITE	= 	$this->translated_line	. $this->endpart_line;
			
			$this->dual_line		=	$this->dash_line_for_line . $this->sep_lang . $this->translated_line;
		
			// Actualiza fichero de BD de idiomas

			//update_full_filename($this->full_lang_file,$this->dual_line);
		
			//3. Si se ha actualizado el fichero hay que ordenarlo
		
			$this->arr_vlineas = file($this->full_lang_file); 
//		    usort($this->arr_vlineas, "strcasecmp");	
		
			//Save the serialized array to a text file.
//			file_put_contents($this->full_lang_file, $this->arr_vlineas);
		 
		} // End If
		
		
	}

	public function read_pending($phrase = '' , $lang = 'en')
	{
		$this->m		=	'read'							;

		$this->p('Readding)'); 

		if ($phrase == '' ) $phrase = $this->line 			;

		if ($phrase != '' )
		{
			
			$this->load($phrase, $lang)							;

			$this->p('Folder_path ' . $this->lang_folder_path)			;
			if (is_dir($this->lang_folder_path))
			{

				if (is_file($this->full_lang_file))
				{
					if ($this->search() )
					{
					//2. Debe hacer una busqueda a ver si existe la frase
					// -Si existe recuperarla - en la variable TRANS_LINE
					print $this->n . 'Linea encontrada ' . $this->translated_line .  ' en  ' . $lang . $this->lr;
					}			
					else 
					{
					print $this->n . 'Linea no encontrada ' . $this->translated_line .  ' en  ' . $lang  . $this->lr;
					}
				}
				else 
				{
					print $this->n . 'No existe fichero ' . $this->full_lang_file . $this->lr  ;
				}
			}
			else 
			{
			print $this->n . 'No existe la carpeta ' . $this->lang_folder_path . $this->lr  ;
			}
		}
		else 
		{
		print $this->n . 'Linea a buscar vacia ' . $this->line .  $this->lr;

		 
		} // End If
		
	}


};


?>