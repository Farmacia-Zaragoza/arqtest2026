//-------------------------------------------------------------------------------------
// (langline) < (langlineitf) < (multicomplex) < (langreadline) < (langlinees) < (langupdateline) < (langsearchline)
//            < (langlinebase) 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// - d-update_simple_line- 				: Update from two lines 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

class tr_update_simple_line extends tr_update_full_line {

	// Lang Line Interface to Inheritance
	public 		$n						=	'tr_update_simple_line::'						;

            
	// 

	// Actualiza el diccionario con la cadena indicada si no existe previamente
	public function update_simple_line(		$es_line 		= '' 									, 
											$lang_line 		= '' 									, 
											$force 			= false 								, 
											$lang 			= ''									)
	{
		$old_m = $this->m ; $this->m = 'update_simple_line:'										;
		$old_n = $this->n ; $this->n = 'tr_update_simple_line::'												;
	
		// Deben pasarse las dos expresiones y no admitimos expresiones vacias
		if (($es_line != '' ) and ($lang_line != '' ) ) 
		{
 			$this->update_lang_type ($lang )														;
			if ($force 			  ) $this->force_update	= $force									;

			if ($this->lang 		!= '' ) 
			{			
				$this->lang_line	=	$lang_line 													;
				$this->line			=	$es_line 													;

				$this->utf8_lang_line   = 	
						iconv("UTF-8", "UTF-8//IGNORE", $this->lang_line ) 							;

				$len_es_line			= 	strlen($this->line)										;
				$len_lang_line			= 	strlen($this->lang_line)								;
				$len_utf8_line			= 	strlen($this->utf8_lang_line)							;

				// Segundo check - No admitimos expresiones vacias
				if ( ($len_es_line > 0 ) and ($len_lang_line > 0 ) )
				{

				// Tercer check - No admitimos caracteres no UTF8 como ?
					if ($len_utf8_line == $len_lang_line  )
					{
						$this->load()																;

						// Replace multiple spaces and dashes
						$trimmed_line		= 	dash_clean_with_feed ($this->lang_line 				);

						$html_string 		= 	utf32_encode($trimmed_line, $this->lang_type		); // [PHP_56]


						$this->dual_line 	=	
								$this->dash_line_for_line . $this->sep_lang . $html_string 			;
						
						$this->update_check_es()													; // Update spanish db
						
						$this->update_check_lan()													; // Update lan db
					}
				}
			}
		}

		$this->m	= $old_m ;	$this->n	= $old_n 												;
	}

};



?>