// -d-updateforce_full_line- 	: Update from one line forced 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
class tr_update_full_line extends tr_update {

	public 		$n						=	'tr_update_full_line::'								;


	// Linea ya en formato con arrobas
	public function updateforce_full_line(	$full_line 		= '' 							, 
										$force 				= true							,  
										$lang 				= ''							)
	{
		// en line never store multi lines
		if ($this->is_not_multiline($full_line))
		{
			if ( $force ) $this->force_update = $force 									; 
			$this->update_full_simple_line($full_line, $lang) 							;
			// Call to 
		}
	}

	// Linea ya en formato con arrobas
	public function update_full_line(	$full_line 		= '' 							, 
										$force 			= false							,  
										$lang 			= ''							)
	{
		// en line never store multi lines
		if ($this->is_not_multiline($full_line))
		{
			if ( $force ) $this->force_update = $force 									; 
			$this->update_full_simple_line($full_line, $lang) 							;
			// Call to 
		}
	}

};


?>