//-------------------------------------------------------------------------------------
// Lang Store - Manage phrases 
//-------------------------------------------------------------------------------------
// INHERITANCE LINE: [DEEP LEVEL : 01]
//-------------------------------------------------------------------------------------
// (langline) < (langlineitf) < (multicomplex) < (langreadline) < (langlinees) < (langupdateline) < (langsearchline)
//            < (langlinebase) 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// - d-update_full_simple_line-   		: Update from one line
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

class tr_update_full_simple_line extends tr_update_simple_line {

	// Lang Line Interface to Inheritance
	public 		$n						=	'tr_update_full_simple_line::'						;


	// Linea ya en formato con arrobas
	public function update_full_simple_line(	$full_line 		= '' 				, 
												$force 			= false				, 
												$lang 			= ''				)
	{
		$old_m = $this->m ; $this->m	= 	'update_full_simple_line:'				;
		$old_n = $this->n ; $this->n	=	'langlineitf::'							;

		if ($full_line != '' )
		{
			$this->m = 'update_full_simple_line:'									;
//			$this->p('Upd LAN ' . $full_line	. $this->lr ); // [PR_DISABLED]

			$this->update_lang_type($lang) 											;

			if ($force 			  ) $this->force_update	= $force					;

			$split_arr = preg_split($this->sep_lang_expr, $full_line)				;		
	
			$arr_len=count($split_arr)-1											;

			// Primer check - Deben pasarse las dos expresiones
			if ($arr_len >0) 
			{
				$this->original_line 	=	$split_arr[0]							; 			
				$this->lang_line		=	$split_arr[1] 							;

				// Needed to check if we have not UTF/UNICODE chars
				$this->utf8_lang_line   = 	
						iconv("UTF-8", "UTF-8//IGNORE", $this->lang_line ) 			;

				$this->line 			= 	$this->original_line 					;				

				$len_es_line			= 	strlen($this->original_line)			;

				$len_lang_line			= 	strlen($this->lang_line)				;
				$len_utf8_line			= 	strlen($this->utf8_lang_line)			;

				// Segundo check - No admitimos expresiones vacias
				if ( ($len_es_line > 0 ) and ($len_lang_line > 0 ) )
				{

				// Tercer check - No admitimos caracteres no UTF8 como ?
					if ($len_utf8_line == $len_lang_line  )
					{
//						$this->p('Before load ' . $this->original_line . $this->lr ); // [PR_DISABLED]

						$this->load($this->original_line)											;
	
						// Replace multiple spaces
						$trimmed_line	=	dash_clean_with_feed($this->lang_line)					;
						

						// Crear una function que reciva el tipo de lenguaje y el texto y te devuelva la expresion o codificada o decodificada

						// Casos 
						// for langs it - pt - fr - de - 
						// for langs hi - ja - zh
						$html_string = 
								utf32_encode($trimmed_line, $this->lang_type)						;
							
						$this->dual_line 		=	
								$this->dash_line_for_line . $this->sep_lang . $html_string 			;
		
//						$this->p('Dual ' . $this->dual_line    .  ' en idioma -' . $this->lang 		.  '-' . $this->lr ); // [PR_DISABLED]
//						$this->p('DuES ' . $this->dual_line_es .  ' en idioma -' . $this->base_lang .  '-' . $this->lr ); // [PR_DISABLED]
		
						// Debe actualiar solo si no es word - two_words or three_words
		
						$this->update_check_es()													; // Update ES db checking first 
						
						$this->update_check_lan()													; // Update LAN db checking first
					}
				}
			}
		}
		$this->m	= $old_m ;		$this->n	= $old_n 											;
	}


};



?>