//            < (langlinebase) 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// - d-read_simple_es_line- 			: Read / Search expresion in es for ES DB
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--


class tr_read_simple_es_line extends tr_read_simple_line_lan {

	public 		$n						=	'tr_read_simple_es_line::'														;


	public function read_simple_es_line($phrase = '')
	{
		$old_m = $this->m ; $this->m = 'read_simple_es_line:'															;
		$old_n = $this->n ; $this->n = 'tr_read_simple_es_line::'																	;

		// Lee una expresion en esp con traducion disponible
		if ($phrase == '' ) $phrase = $this->line 																		;


		if ($phrase != '' )
		{

			if ($this->is_multiline($phrase) )
					$this->folder_db_path = '/brqx/lnk/lang/complex_phrases'											;

			// Replace multiple spaces - dashes - external - internal
			$phrase=dash_clean_with_feed($phrase)																		;

			$this->load($phrase)																						;

			// $this->p('Folder_read_es_after_load ' . $this->lang_folder_path_es );
		
			if (is_dir($this->lang_folder_path_es))
			{

				if (is_file($this->full_lang_file_es))
				{
					if ($this->search_es() )
					{
					//2. Debe hacer una busqueda a ver si existe la frase
					// -Si existe recuperarla - en la variable TRANS_LINE
					
						$this->translated_line = same_as($this->line_es, $phrase)						;
						$this->s('Linea encontrada ' . $this->line_es .  ' en  ' . $this->base_lang 		);
					}			
					else 
					{
						$this->s('Linea no encontrada ' . $this->line_es .  ' en  ' . $this->base_lang 		);
					}
				}
				else 
				{
					$this->s('No existe fichero ' . $this->full_lang_file 									);
				}
			}
			else 
			{
				$this->s('No existe la carpeta ' . $this->lang_folder_path_es 								);
			}
		}
		else 
		{
				$this->s('Linea a buscar vacia ' . $this->line 												);
		 
		} // End If
		
		$this->m = $old_m ; $this->n = $old_n 																; 
	}

};


?>