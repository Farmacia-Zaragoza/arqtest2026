//            < (langlinebase) 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// - d-read_simple_line- 			  	: Read / Search expresion in es for LAN DB
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--


class tr_read_simple_line extends tr_read_simple_es_line {

	public 		$n						=	'tr_read_simple_line::'														;

            

	public function read_simple_line($phrase = '' )
	{
		$old_m = $this->m ; $this->m = 'read_simple_line:'													;
		$old_n = $this->n ; $this->n = 'langreadling::'														;

		// Lee una expresion en esp con traducion disponible
		if ($phrase == '' ) $phrase = $this->line 															;

		$this->translated_line ='not_found'																	;
		$this->is_translated   = false 																		; 

		if ($phrase != '' )
		{

			// Replace multiple spaces - dashes - external - internal
			// $this->p('Buscando_Frase: ' . $phrase ) ; // [PR_DISABLED]

			// Replace multiple spaces - dashes - external - internal
			$phrase		=	dash_clean_with_feed($phrase)													;

			// Aqui no lo puedo saber pues no conozco la expresion que estoy buscando
			// Por tanto solo puedo contemplar que sea en castellano

			$this->is_multi_line	   = 	$this->is_multiline ($phrase)									;
			$this->both_are_multi_line = 	( $this->is_multi_line ) ;

			if ($this->both_are_multi_line)
					$this->folder_db_path = '/brqx/lnk/lang/complex_phrases'								;

			//$this->p('Folder_read_es_before_load ' . $this->folder_db_path );


			$this->load($phrase)											;	
			// Call to check - prepare																;

			// $this->p('RSL: ' . $this->full_lang_file . ' Phrs : ' . $phrase . ' #' .  $this->lr ); // [PR_DISABLED]
		
			if (is_dir($this->lang_folder_path))
			{
				if (is_file($this->full_lang_file))
				{
					// $this->p('Existe_Carpet_y_Fichero: ' . $this->full_lang_file); // [PR_DISABLED]

					if ($this->search() )
					{
						$this->is_translated   = true 															; 
					//2. Debe hacer una busqueda a ver si existe la frase
					// -Si existe recuperarla - en la variable TRANS_LINE
						// same_as ( STR_IN , MODEL )
						$this->translated_line = same_as($this->translated_line, $phrase)						;

						// $this->p('Linea encontrada ' . $this->translated_line .  ' en idioma ' . $this->lang	);

						// change p x s for debug
						$this->s('Linea encontrada ' . $this->translated_line .  ' en idioma ' . $this->lang	);
					}			
					else 
					{
						$this->is_translated   	= false 														; 
						$this->s('Linea no encontrada ' . $this->line .  ' en idioma ' . $this->lang			);
					}
				}
				else 
				{
					$this->s('No existe fichero ' . $this->full_lang_file 										);
				}
			}
			else 
			{
				$this->s('No existe carpeta ' . $this->lang_folder_path 										);
			}
		}
		else 
		{
				$this->s('Linea a buscar vacia ' . $this->line 													);
		} // End If

		$this->m = $old_m ; $this->n = $old_n 																	; 
	}


};


?>