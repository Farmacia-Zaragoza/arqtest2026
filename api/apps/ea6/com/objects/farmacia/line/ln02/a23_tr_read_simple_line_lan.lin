class tr_read_simple_line_lan extends tr_multicomplex {

	public 		$n						=	'tr_read_simple_line_lan::'														;
            
	// De momento esta funcion no se puede usar puesto que la estructura solo esta pensada para idioma base
	public function read_simple_line_lan($phrase_lan = '')
	{
		$old_m = $this->m ; $this->m = 'read_simple_line_lan:'														;
		$old_n = $this->n ; $this->n = 'tr_read_simple_line_lan::'																;

		if ($phrase_lan == '' ) $phrase_lan = $this->line 															;

		if ($phrase_lan != '' )
		{
			$phrase_lan		=	dash_clean_with_feed($phrase_lan)													;

			// esto no podemos cambiarlo puesto que cuando buscamos en castellano no sabemos como sera
//			if ($this->is_multiline($phrase_lan) )
//					$this->folder_db_path = '/brqx/lnk/lang/complex_phrases'							;

			$this->load($phrase_lan)																				;
		
			if (is_dir($this->lang_folder_path))
			{

				if (is_file($this->full_lang_file))
				{
					if ($this->search_lan() )
					{
					//2. Debe hacer una busqueda a ver si existe la frase
					// -Si existe recuperarla - en la variable TRANS_LINE
						$this->s('Linea encontrada ' . $this->translated_line .  ' en idioma -' . $lang .  '-'		);
					}			
					else 
					{
						$this->s('Linea no encontrada ' . $this->translated_line .  ' en idioma -' . $lang .  '-'	);
						// Disabling printing not found
					}
				}
				else 
				{
					$this->s('No existe fichero ' . $this->full_lang_file	)										;
				}
			}
			else 
			{
				$this->s('No existe carpeta ' . $this->lang_folder_path )											;
			}
		}
		else 
		{
			$this->s('Linea a buscar vacia ' . $this->line) 														;
		 
		} // End If
		
		$this->m = $old_m ; $this->n = $old_n 																; 
	}


};


?>