$GLOBALS['supermenu']	=	'/brqx/base/rcode/v56/gen/v0_0_1/'									;
$PHP_VER = 'v52'																				;										

include_once '/brqx/base/rcode/' . $PHP_VER . '/spc/cica_d05/home/index06/v0_0_1/rphp/z_translate.lib' ;


class langfolder extends storebase {

	public 		$n						=	'langfolder::'							;
	
	public 		$folder 															;
	
	// File object
	public	$f																		;
	
	public  $langdir																;

	public $updated		= 'false'													;
            
    public function __construct (	$lang			=	'en'						,
    								$create_inner 	= 	false 						, 
    							 	$folder_path 	= 	'/brqx/lnk/lang/phrases'	,
    							 	$db_file_name 	= 	'word'						)	  
    {   
		$this->db_file_name			=	$db_file_name 								;
		$this->update_lang_type($lang )  											;

		// Path for translate db
		if ($folder_path != '')	$this->folder_db_path	= $folder_path 				;
		
		parent::__construct()														;

	}


	public function update(		$folder		= '' 									, 
								$lang 		= '' 									, 
								$force 		= false 								, 
								$base_lang 	= '' 									)
	{
		$old_m = $this->m ; $this->m = 'update:'									;
		$old_n = $this->n ; $this->n = 'langfolder::'								;

		// Load file in structure to update or to translate (soon)

		$this->update_lang_type($lang )  											;
		if ($base_lang 	!= '' ) $this->base_lang 	= 	$base_lang					;
		if ($force )			$this->force_update	=	$force 						;

//		print $this->n . 'Folder ' . $this->folder 		. $this->lr								;

		if ( ($folder != '' ) and (is_dir($folder))  ) 
		{
			$dir = opendir($folder)																;

			print $this->n . 'Folder In ' . $folder 		. $this->lr							;

			$this->f = new langfile($this->lang)												;

   			$base_full_path=	$folder	; 
			if (substr($base_full_path, -1) != '/' )   $base_full_path .= '/'					;

 			// $ffs = scandir($dir); // scandir is not recursive

			// Best method for recursive
			$di = new RecursiveDirectoryIterator(	$base_full_path								,
													RecursiveDirectoryIterator::SKIP_DOTS		);
			$it = new RecursiveIteratorIterator($di)											;

			foreach($it as $elemento) 
			{
				if (!is_dir($elemento) )
				{
					// langfolder::Elem /brqx/base/lang/temp/en/a/ad/adq.word
//						print $this->n . 'Elem ' . $elemento .  $this->lr							;
//						$basename = basename ($elemento)											;
//						if ($basename == 'adh.word')
//						{
//							print $this->n . 'Base ' . $basename .  $this->lr						;
						$this->f->update($elemento)													;
//						}
				}
			}
		}
	}
}
