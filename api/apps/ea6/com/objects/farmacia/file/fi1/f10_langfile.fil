class langfile extends tr_file_update {

	public 		$n						=	'tr_langfile::'						;
	
            
    public function __construct (	$lang			= 'en'						,
    								$folder_path 	= '/brqx/lnk/lang/phrases'	, 
    								$db_file_name 	= 'word'					)	  
    {   
		$this->db_file_name			=	$db_file_name 							;
		$this->update_lang_type ($lang)											;
		// Path for translate db
		if ($folder_path != '')	$this->folder_db_path	= $folder_path 			;

		// $this->p ( 'Before Generating LAng '.  $lang . ' ==> ' . $this->lang)												;
		
		// parent::__construct();

		// $this->p ( 'After Generating LAng '.  $lang . ' ==> ' . $this->lang)												;
		
		$this->l 				=	new multiline($this->lang)						;		
					
		$this->ml 				=	new multiline($this->lang)						;		
		
	}


};


