// *anode_load > Anodes > Definitions 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// - d-generate_one_level_directory- 				: 	Generate current path information
// - d-generate_recursive_directory-				: 	Generate recursive information
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

var 	cons 						= 	require("/brqx/base/rcode/es6/com/libs/general/constants.ess"							);

const 	{ anode_loadanypos } 		= 	require(	path.join(JS_BASE, 'com/objects/drupal/anode/an7/an73_loadanypos.es6'),
		fs 							= 	require(	'fs'																		),
		path 						= 	require(	'path'																		),
		recursive 					= 	require(	'/brqx/base/react/zcommon/node_modules/recursive-readdir-sync'				),
		sort 						= 	require(	'/brqx/base/react/zcommon/node_modules/sort-array'							),
		readdirp 					= 	require(	'/brqx/base/react/zcommon/node_modules/readdirp'							),
		echo	 					= 	require(	'/brqx/base/react/zcommon/node_modules/node-echo'							),
		mat							=	require(	path.join(JS_BASE, 'com/libs/string/match.es6'),
		url			 				= 	require( 	path.join(JS_BASE, 'com/libs/string/url.es6'));



class anode_load extends anode_loadanypos {

	constructor()
	{            
		super()
		this.n						= 'an72_load::'										    		
	}

	// REVIEW : https://ourcodeworld.com/articles/read/420/how-to-read-recursively-a-directory-in-node-js

	// ------------------------------- GENERATE_ONE_LEVEL_DIRECTORY ------------------------------- 
	generate_one_level_directory()
	{
		// Aqui ya conocemos el path
		this.m	=	'generate_one_level_directory'									
		this.n						= 'an72_load::'										    		
		
		// this.p('YYY_Before_isdir ' + this.path)								
		// /ssd/myr/img_base_resolution/2013/Portugal/b02_Lisboa/	

		if ( fs.existsSync(this.path) &&   fs.lstatSync(this.path).isDirectory() ) 
		{		
			// REVISAR ITERATOR


			let url_base_path = url.url_with_bar(this.u.site_url + this.path_pointer)
			
			// this.p('AN72_url_path ' + this.u.site_url + ' pointer ' +  this.path_pointer)

			let arr_files = Array()
			let arr_names = Array()
			
			// OJO AQUI OBTENEMOS LA RUTA COMPLETA - EN PHP CREO QUE SOLO LOS FICHEROS

			let files = fs.readdirSync(this.path)   // No Recursive
			
			// let files = recursive(this.path) 	// Recursive 

			// photos/1600x1200
			// this.p ('POINTER ' + this.path_pointer )

			// this.p ('PATH ' + this.u.site_path		)

			for (var elemento of Object.values(files)) 
			{
			
				// Not Recursive 
				// transportes_lucas_rivera_gondolas_transport_truck_madrid_spain_2017_-_0139_1600x1200.jpg
			
				// Rcursive
				// /mnt/ssd/brqx/base/react/zcommon/apps/photos/1600x1200/transportes_lucas_rivera_gondolas_transport_truck_madrid_spain_2017_-_0002_1600x1200.jpg
				
				// Site URL is used in PHP
				// this.p('SITE_URL ' + this.u.site_url )									
			
				let full_elemento = this.u.site_path + this.path_pointer + '/' + elemento 

				// this.p('E_a72 : ' + full_elemento )
	
			 	arr_names.push(	elemento	) 									
			 	arr_files.push(	full_elemento	) 									
	
			}

			arr_files = arr_files.sort()

			// /mnt/ssd/brqx/base/react/zcommon/apps/photos/1600x1200/
			// this.p('Base_path ' + this.path + '  - L ' + arr_files.length )								
			

			for(pos in arr_files) 
			{

				elemento = arr_names[pos]

				// elemento = path.basename(arr_files[pos])
				// :elem 130808_-_Boca_Do_Inferno

				let base_path = this.path + elemento 								
				
				//cica.dbrqx.com/imgs/path

				
				let url_path  = url_base_path + elemento								 

				// this.p('an72_url_path ' + url_path)								

				// PENDIENTE
				// No tiene sentido sin un path - es mas para cica aqui los elementos estan completos
				let ideal_elem = mat.match_word(elemento) 								

				// E1 - elem 130809_-_Albufeira_-_Playa_do_Paneco
				// C1 - base path /ssd/myr/base_resolution/2013/Portugal/b02_Lisboa/130809_-_Albufeira_-_Playa_do_Paneco
				// this.p('E1 - elem ' + elemento)																	
				// this.p('C1 - base path ' + base_path)																	
				// this.p('U1 - url path ' + url_path)																	
				
				// Tenemos una cadena de terminos ideales que hay que procesar e insertar en el array de ideales ide
				// this.p('E1 - elem ' + elemento + ' Ideal : ' + ideal_elem)			

				// Array de ideales

				// Componemos el titulo con los ideales de cada foto
				// Igual tambien podemos poner la ruta actual
				
				let title_str 							=	''								


				let arr_ide_current = ideal_elem.split(",");


				// REVISAR FOREACH

				for (var elem of Object.values(arr_ide_current))
				{
			
					if(!( elem in this.arr['ide'] ))
						this.arr['ide'].push(	'' + elem	)								
					title_str+=  elem + ' '											
				}

				this.arr['tit'].push( title_str ) 														

				// Sabemos que existe										
				if ( fs.existsSync(base_path) &&   
					 fs.lstatSync(base_path).isFile() ) 
				{
					this.is_there_contents = true  
	
					// El tipo es el nombre del fichero (linea_menu)
					// Iteramos cada archivo  linea_menu
					// FILes - FIles Sructure - File url
					this.arr['fil'].push(	'' + elemento	)					
					this.arr['fis'].push(	base_path		)					
					this.arr['fur'].push(	url_path		)					

					this.num_files++											
				}
				else
				{
					this.is_there_contents = true  

					// this.p('E1 - elem 	' + elemento)						
					// this.p('C1 - base path ' + base_path)					

					this.arr['fol'].push(	'' + elemento	)					
					this.arr['fos'].push(	base_path		)							
					
					this.num_folders++										
				}
					
			} // End Foreach
			
			
		} // End If
		
	}


	  
}

exports.anode_load = anode_load