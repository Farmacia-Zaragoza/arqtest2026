// *anode_if_is_correct_save_properties > Anodes > Definitions 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Class: c-anode_if_is_correct_save_properties-
//-------------------------------------------------------------------------------------
// Methods:
//-------------------------------------------------------------------------------------
// - d-if_is_correct_save_properties_ram- 		: 	Save properties without check
// - d-if_is_correct_save_properties_disk-		:   Save code without check
// - d-is_correct_to_reload_type-				:   Return if is correct for reload (for compositions)
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

var 	cons 				= 	require("/brqx/base/rcode/ea6/com/libs/general/constants.ess"								);

const 	{ anode_if_is_correct_save_language_properties } 	= 
						require(	path.join(JS_BASE, 'com/objects/drupal/anode/an3/an35_if_is_correct_save_language_properties.es6'));

		run					= require(	path.join(JS_BASE, 'com/pms/files/save_properties_promise.es6'));


class anode_if_is_correct_save_properties extends anode_if_is_correct_save_language_properties {
            
    constructor()
    {        
		super()
		this.n	=	'an34_if_is_correct_save_properties::'											
	}											

	if_is_correct_save_all_properties()
	{
		this.m			= 	'if_is_correct_save_all_properties'												
		this.n			=	'an34_if_is_correct_save_properties::'											

		// this.p('Saving_all_properties ' + this.short_type + ' ' + this.type)													

		this.if_is_correct_save_properties_disk() 												

		//this.p('Saved_all_DISK_properties ' + this.arr['properties'].length)													

		this.if_is_correct_save_properties_ssd() 													

		//this.p('Saved_all_SSD_properties ' + this.arr['properties'].length)													

		this.if_is_correct_save_properties_ram() 													

		//this.p('Saved_all_properties ' + this.arr['properties'].length)													

		this.if_is_correct_sync_properties_to() 															

	}

	if_is_correct_save_all_code()
	{
		this.m			= 	'if_is_correct_save_all_code'												
		this.n			=	'an34_if_is_correct_save_properties::'											

		// this.p('Saving_all_code ' + this.code.length)													

		// Vamos a implementar un reload para code 
		this.if_is_correct_save_code_disk() 														
		
		// /ram/home/ser/zd/main/es/zdom/per/pelona/zd_main_cica/es/cache/cica.dbrqx.com/anonymous/peloncita/fnode/node/cica_slider/human/a/node

		// SEARCH RESULTS are PROPERTIES

		//this.p('Saving_ssd ' + this.code.length)													
		
		this.if_is_correct_save_code_ssd() 													

		//this.p('Saving_ram ' + this.code.length)													

		this.if_is_correct_save_code_ram() 													

		this.if_is_correct_sync_code_to() 															

	}


	if_is_correct_save_all()
	{
		this.m			= 	'if_is_correct_save_all'												
		this.n			=	'an34_if_is_correct_save_properties::'											

		// this.p('Saving_all_props ' + this.short_type)													

		// Vamos a tratarlo como una promesa, pues nos da igual cuando se cumpla

		var t = this
		var data_and_error = ''

		// PROMESAS EN PARALELO

		if (this.b.type_have_properties)
			run.save_properties_promise(data_and_error,t)
			.then(function () {} ) 

//			this.if_is_correct_save_all_properties() 												

		// this.p('Saving_all_code ' + this.short_type)													
		if (this.b.type_have_code)
			run.save_code_promise(data_and_error,t)
			.then(function () {} ) 

//			this.if_is_correct_save_all_code() 													
		
	
	}


	// ------------------------------ IF_IS_CORRECT_SAVE_PROPERTIES_RAM ------------------------------ 
	if_is_correct_save_properties_ram()
	{
		this.n	=	'an34_if_is_correct_save_properties::'											
		this.m	=	'if_is_correct_save_properties_ram'

		// Cuando grabar las propiedades
		let ready_to_save = false 		 
		
		// 2. Disk   - cuando se indique
		if ( !this.arr['nfo']['generate_or_reload_properties_ram'] ) 
		{	
				this.only_save_properties_to_ram()						
				// this.p('Save_Properties_RAM  ' + this.type  +  ' P ' +  this.ssd_alias_path )  
											
		}
	}

	// ------------------------------ IF_IS_CORRECT_SAVE_PROPERTIES_SSD ------------------------------ 
	if_is_correct_save_properties_ssd()
	{
		this.n	=	'an34_if_is_correct_save_properties::'											
		this.m	=	'if_is_correct_save_properties_ssd'

		// Cuando grabar las propiedades
		let ready_to_save = false 		 
		
		// 2. Disk   - cuando se indique
		if ( !this.arr['nfo']['generate_or_reload_properties_ssd'] ) 
		{	
				this.only_save_properties_to_ssd()						
				// this.p('Save_Properties_SSD  ' + this.type  +  ' P ' +  this.ssd_alias_path )  
											
		}
	}

	// ------------------------------ IF_IS_CORRECT_SAVE_PROPERTIES_DISK ------------------------------ 
	if_is_correct_save_properties_disk()
	{
		this.n	=	'an34_if_is_correct_save_properties::'											
		this.m	=	'if_is_correct_save_properties_disk'

		// Cuando grabar las propiedades
		let ready_to_save = false 		 

		// this.p('Grabando_Disk ' + this.type + ' ' + this.short_type )								 		
		// 2. Disk   - cuando se indique
		if (( this.arr['nfo']['generate_or_reload_properties_disk'] == false ) && 
			( this.b.type_human									    == false ) 	)					 
		{	
				// Sync
				// this.p('Grabando_Diskdd ' )								 		
				this.only_save_properties_to_disk()						
											
		}
	}

	// ------------------------------ IF_IS_CORRECT_SAVE_CODE_RAM ------------------------------ 
	if_is_correct_save_code_ram()
	{
		this.n	=	'an34_if_is_correct_save_properties::'											
		this.m	=	'if_is_correct_save_code_ram'

		// Cuando grabar las propiedades
		let ready_to_save = false 		 

		
		if ( !this.arr['nfo']['generate_or_reload_code_ram'] ) 
		{	
			// this.p('Saving Code ' + strlen (this.code))					
			// this.p('Saving Path ' + this.ssd_alias_code_path)					

			this.only_save_alias_code_to_ram()						
											
		}
	}


	if_is_correct_save_code_ssd()
	{
		this.m	=	'if_is_correct_save_code_ssd'
		this.n	=	'an34_if_is_correct_save_properties::'											

		// Cuando grabar las propiedades
		let ready_to_save = false 		 
		
		// 2. Disk   - cuando se indique
		if ( !this.arr['nfo']['generate_or_reload_code_ssd'] ) 
		{	
			if (this.b.type_have_ascii_code)
				this.only_save_ascii_code_to_ssd()						
			else										
				this.only_save_code_to_ssd()						
		}
	}

	if_is_correct_save_code_disk()
	{
		this.m	= 'if_is_correct_save_code_disk'			
		this.n	=	'an34_if_is_correct_save_properties::'											

		// Cuando grabar las propiedades
		let ready_to_save = false 		 
		
		//this.p('Saving_disk')								
		
		// 2. Disk   - cuando se indique
		if ( !this.arr['nfo']['generate_or_reload_code_disk'] ) 
		{	
			// this.p('Saving_saving_disk ' +  ' - ' + this.load_from_disk_path_code )						
			
			if (this.b.type_have_ascii_code)
			{
				// this.p('ASCII_CODE ' + ' - ' + this.load_from_disk_path_code ) 		
				this.only_save_ascii_code_to_disk()						
			}
			else
			{
				// this.p('NORMAL_CODE ' + ' - ' + this.load_from_disk_path_code ) 		
				this.only_save_code_to_disk()						
			}								
		}
	}


	// FUnction for Compositions
	is_correct_to_reload_type()
	{
		this.m			=	'is_correct_to_reload_type'					
		this.n			=	'an34_if_is_correct_save_properties::'											


		if ( 
		   ( this.loaded 					== 'no_generated'			) ||
  		   ( this.c.ram				 	== 'reload'					) ||
		   ( this.c.url					== 'reload'	 				) ||
           ( this.is_reload_type_ram()								)	
		   ) 
			{
				return true														
			}	
		return ( false && this.b.site_cache )							 		
	}
	  
}

exports.anode_if_is_correct_save_properties = anode_if_is_correct_save_properties