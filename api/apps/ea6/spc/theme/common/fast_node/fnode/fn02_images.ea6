// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Node Js Truck - Fn02 Images Class  [V.0.1.7]  (2016-11-24)
// Brqx Group - Agile Farmacia Zaragoza Methodology
// Spc - Cica_d05 - Home - Index_06 - v0_0_1
//-------------------------------------------------------------------------------------
// Fast node load - Replace Mysql connections
//-------------------------------------------------------------------------------------
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// - build_data   	  : Build html final code for object
// - build_node       : Load all drupal node details
// - create_div_NN    : Create div_NN   dhtml object
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

const 	{ fnode } 			= require(	path.join(JS_BASE, 'com/objects/drupal/node/fnode.es6'),
		{ cbool }			= require( 	path.join(JS_BASE, 'com/objects/drupal/bool/b01_bool.es6'),
		{ in01_path } 		= require(	path.join(JS_BASE, 'spc/theme/peloncita/fast_node/inode/in01_path.es6'),
		empty 				= require(	'is_empty'								);

class fn02_images extends fnode {

    constructor (   fnode	=	''		)
	{
		super()
		this.n 							=	'fn02_images_truck::'

		this.fnode						=	fnode

		this.u							=	this.fnode.u

		this.b							= 	new cbool()

		this.s 							=	this.u.s
		this.c 							=	this.u.c


		this.b.copy (this.s.b)

		this.type									=	'image_structure'
		this.short_type							=	'IMS'


		this.stype 								=	'images'				 // Subtype
		this.type_name							=	this.type + this.stype + '_' + this.name


		this.b.type_user						=	false			 // Different content if is anonymous
		this.b.type_common						=	true
		this.b.type_human						= 	false 			 // if is dat file never will be erased on disk
		this.b.type_translation					= 	false			 // Auto translate contents - Hay que revisarlo
		this.b.type_translated					= 	false			 // Allow multiple contents for many languages
		this.b.type_ssl							=	true			 // If have urls

		this.b.type_have_taxonomy				=	false
		this.b.type_have_code					=	false
		this.b.type_have_properties				=	true
		this.b.type_have_specific_properties	=	true


		//iml - IMage List
		this.change				=	'/' + this.type + '/' + this.stype + '/'

		// SSL_DEPENDENT - El contenido sera el mismo para cualquier idioma - Pero distinto por urls o ssl

		let uri_to_use		= 	this.u.slash_ideal_uri

		if (this.u.slash_ideal_uri.substr(0,1) == '/' )		uri_to_use = this.u.slash_ideal_uri.substr(1)


		// Tipo dependiente de SSL - Independiente del idioma y de la url

		this.suffix					=	this.stype			 + '_' + this.u.ssl_page
		this.suffix_disk			=	this.suffix
		this.suffix_lang			=	this.suffix_disk

		// this.suffix_lang			=	this.suffix 			 + '_' .	this.s.lang

		// Is not used
   		this.suffix_code 			= 	this.suffix_lang + '.'  + 'code'



		// Method for disk load and to generate and save content
		this.generate_load_from_disk_path()

		// Este tipo no tiene codigo

		// rat : Ratio - res : Resolution - oim : Original Image - tit : Titulo
		// res : REsolution X substring  - ori : ORIentation

		var arrays_line = 'rat res rex tit oim ori let qty img-type'


		// this.p('Truck_arrays_line_' + arrays_line)

		// Desktop HI LO - Mobile HI LO

		// Truck Images
		// 909x682 1818x1364 564x423 1128x846 193x145 386x296 153x115 306x230 512x682 1024x1366 317x423 634x846 114x152 228x296 92x123 184x245
		// A Ratina Desktop 1 - 2  -- Ratina Mobile 1 - 2

		// H SLIDER -- ratina1 desktop:	ratina2 desktop: ratina1 mobile: ratina2 mobile: 1128x846
		//			   909x682 			1818x1364 		 564x423		 1128x846

       	// V SLIDER -- ratina1 desktop: ratina2 desktop: ratina1 mobile: ratina2 mobile:
		// 		       512x682			 1024x1366		  317x423		  634x846


		this.arr['let'][this.s.img_base_resolution]		=	'xx'

		let horizontal_slider_resolutions		=	'0909x0682 1818x1364 0564x0423 1128x0846 '
		this.arr['let']['0909x0682']		=	'sh0'
		this.arr['let']['1818x1364']		=	'sh1'
		this.arr['let']['0564x0423']		=	'sh2'
		this.arr['let']['1128x0846']		=	'sh3'

		// C
		let horizontal_carousel_resolutions 	= 	'0193x0145 0386x0290 0153x0115 0306x0230 '
		this.arr['let']['0193x0145']		=	'ch0'
		this.arr['let']['0386x0290']		=	'ch1'
		this.arr['let']['0153x0115']		=	'ch2'
		this.arr['let']['0306x0230']		=	'ch3'

		// B
		let vertical_slider_resolutions 		= 	'0512x0682 1024x1366 0317x0423 0634x0846 '
		this.arr['let']['0512x0682']		=	'sv0'
		this.arr['let']['1024x1366']		=	'sv1'
		this.arr['let']['0317x0423']		=	'sv2'
		this.arr['let']['0634x0846']		=	'sv3'

		// D
		let vertical_carousel_resolutions 		= 	'0114x0152 0228x0296 0092x0123 0184x0245'
		this.arr['let']['0114x0152']		=	'cv0'
		this.arr['let']['0228x0296']		=	'cv1'
		this.arr['let']['0092x0123']		=	'cv2'
		this.arr['let']['0184x0245']		=	'cv3'

		// this.p('Content ' + this.arr['let']['0193x0145'])



	    // resolutions_to_generate	= '1820x1002 1414x778 0910x0501 0707x0389'
		let resolutions_to_generate			=
				horizontal_slider_resolutions  + horizontal_carousel_resolutions
		resolutions_to_generate			+=
				vertical_slider_resolutions  + vertical_carousel_resolutions

		this.arr['res'] = resolutions_to_generate.split(' ')

		var res_line	= ''
		var img_line	= ''


		// Inode to use it --. REVIEW LANGS
		this.inode	=	new in01_path(	this.fnode								,
										resolutions_to_generate					)


		for (var pos in this.arr['res'] )
		{
			let res					 = this.arr['res'][pos]
			let res_substr 			 =  res.substr(0,2)
			res_line				+=	'r' + res_substr + ' '
			this.arr['rex'].push(  	res_substr	)
		}

		// Aqui el inode debe estar generado

		// rim - rur ...

		for (var posi in this.inode.arr['mty'])
		{
			var type			=	this.inode.arr['mty'][posi]
			// 2048 - 1024
			for (var res of Object.values(this.arr['res']))
			{
				// Old : Elem sim Index si20
				// New : sia0 sia1 sia2 sia3
				// img_res_substr 	= 	substr(res,0,2)
				let img_res_substr		=	this.arr['let'][res]

				let index = type.substr(0,2)  + img_res_substr
				img_line += index + ' '
			}

		}
		arrays_line = res_line + img_line + arrays_line

		// this.p('Arr_LINE ' + arrays_line)

		this.arr['types'] = arrays_line.split(' ')

		if (this.s.load == 'drupal')
		{
			this.run_from_drupal()
			// create_paths - get_current_properties
		}
		else
		{
			this.run_from_disk()
			// create_paths - get_current_properties_from_disk
		}

    }

    get_child_properties(prop, value) {
	// Tenemos un metodo comun para todos los tipos con title - type - path y los arrays
	// Luego cada tipo tendra un ajuste como este

            if 	   ( prop 		== "v_name"				)		this.name							=	value
			else if ( prop 		== "v_type"				)		this.view_type					=	value
			else if ( prop 		== "v_args"				)		this.args							=	value
			else if ( prop 		== "v_leng"				)		this.length						=	value
			else if ( prop 		== "v_node"				)		this.node_id						=	value
    }


	load_child_details()
	{
		// this.p('RELOAD_IMAGE_STRUCTURE')

		// Si no hay cache debe regnerarlos siempre
		if ((this.s.load == 'drupal')  			||
		   (
		    (!this.b.site_cache )			 	||
			(this.special_reload_ram('IMS')  ) 	||
			(this.special_reload_disk('IMS') )
		   )									  )
		{

			// this.p('Before_foreach_IMAGES ' + this.fnode.arr['img'].length )

			let cont = 0


			// 139
			// this.p('Images_Len ' + this.fnode.arr['img'].length )

			if (!empty(this.fnode.arr['img']))
			for (var slide_num in this.fnode.arr['img'])
			{
				var img_name			=	this.fnode.arr['img'][slide_num]

				cont++

				if (this.b.max_elems) if (cont > this.s.max_elems_limit) break

				// Correct
				// http://flat.dbrqx.com/photos/2048x1536/venta_piso_espana_madrid_guadarrama_flat_sale_2017_-_140000_euros_0048_2048x1536.jpg
				// this.p('[' + cont + '] '  + img_name)

				this.arr['oim'].push( 		img_name 						)

				this.arr['ori'].push(  		this.inode.orientation				)

				let tit	=	this.fnode.arr['tit'][slide_num]

				// Image node

				// http://flat.dbrqx.com/ph..536.jpg 1820x1002 1414x778 0910x0501 0707x0389
				// this.p('Before_to_call ' + cont + '  '. basename(img_name))

				this.inode.reload_contents(img_name)


				// this.p('[' + cont + '] '  + this.inode.arr['mty'].length )

				// Image arrays : SIm  SUr SFo SFu RIm RUr RFo RFu

				for (var posi in this.inode.arr['mty'] )
				{
					var type			=	this.inode.arr['mty'][posi]


					// this.p('Arr_Type ' + type)
					for (var resolution in this.inode.arr[type])
					{
						var elem			=	this.inode.arr[type][resolution]
						// Elem sim Index si20
						//index = type  + substr(resolution,0,1) + 	substr(resolution,-1,1)

						let img_res_substr		=	this.arr['let'][resolution]

						let index = type.substr(0,2)  + img_res_substr

						// if (index === 'such1')
						// 	this.p('Index ' + index + ' Value ' +  this.inode.arr[type][resolution].length )
						//  sim/s
						// fn02_images::Elem /ssd/flat/2048x1536/venta_piso_espana_madrid_guadarrama_flat_sale_2017_-_140000_euros_0048_2048x1536.jpg Index sim/s
						this.arr[index].push( 	this.inode.arr[type][resolution]	)
					}

				}

				// Relation - Ratio
				this.arr['rat'].push(  		this.inode.relation 		)

				this.arr['qty'].push(  		this.inode.quality 			)

				this.arr['img-type'].push(  this.inode.img_type 		)

				// Title
				this.arr['tit'].push(  		tit							)

			}
		}

	}

}

exports.fn02_images = fn02_images
