// - d-fnode_promise-  				: Fnode promise function 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

function fn03_site_common_promise(data_and_error = '' , t = '' ) {
  const promise = new Promise(function (resolve, reject) {

	if (t.s.load == 'drupal')
	{
		t.run_from_drupal()															
	}
	else 
	{
		// t.p('RUNNING_EXTERNAL ' + t.type + ' L ' + t.s.load)
		t.run_from_disk()
	}
	  // Caso de exito
    resolve(t)
    t.name ='Gugugugu'
    
    if (!t) 
    {
		// Aqui igual hay que gestionar datos del objeto		
	    reject(new Error('Problema con el objeto fnode pasado '))
    }
  })
  
  return promise
          
}

module.exports.fn03_site_common_promise = fn03_site_common_promise