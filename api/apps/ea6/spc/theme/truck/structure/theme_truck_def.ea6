const 	{ theme_truck }			= require(	path.join(JS_BASE, 'spc/theme/truck/structure/theme_truck.ea6'));


function theme_truck_def(data_and_error = '' , t = '') {
  const promise = new Promise(function (resolve, reject) {

	t.thm = new theme_truck(		t.pg		,
	   								t.u		)

	t.p('TRUCK_CREATED')
	  // Caso de exito
    resolve(t)
    if (!t)
    {
		// Aqui igual hay que gestionar datos del objeto
	    reject(new Error('Problema con la definicion del objeto theme '))
    }
  })

  return promise

}

module.exports.theme_truck_def = theme_truck_def
