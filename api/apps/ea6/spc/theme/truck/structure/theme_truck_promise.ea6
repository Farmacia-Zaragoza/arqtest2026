const 	{ pn01_simple } 	= 	require(	path.join(JS_BASE, 'spc/theme/truck/fast_node/pnode/pn01_simple.ea6'),
		run					= 	require(	path.join(JS_BASE, 'spc/theme/truck/structure/run_theme_truck.ea6'));


function theme_truck_promise(data_and_error = '' , t = '') {
  const promise = new Promise(function (resolve, reject) {

	// Contiene promesas
	//run.theme_truck(this.thm)

	  // Caso de exito
    resolve(t)
    if (!t)
    {
		// Aqui igual hay que gestionar datos del objeto
	    reject(new Error('Problema con la definicion del objeto theme '))
    }
  })

  return promise

}

module.exports.theme_truck_promise = theme_truck_promise
