const	echo 					= 	require(	'node-echo'												),
		{ theme_structure }		= 	require( 	cons.JS_BASE  + 'com/objects/drupal/theme/t01_structure.es6'			),
		{ fn01_flat } 			= 	require(	cons.JS_BASE  + 'spc/theme/common/fast_node/fnode/fn01_flat.ea6'		),
		{ fn02_images } 		= 	require(	cons.JS_BASE  + 'spc/theme/common/fast_node/fnode/fn02_images.ea6'		),

		{ fn01_lang_common } 	= 	require(	cons.JS_BASE  + 'spc/theme/common/fast_node/fnode/fn01_lang_common.ea6'	),
		{ fn11_links_common } 	= 	require(	cons.JS_BASE  + 'spc/theme/truck/fast_node/fnode/fn11_links_common.ea6'	),
		{ fn12_links_lang }   	= 	require(	cons.JS_BASE  + 'spc/theme/truck/fast_node/fnode/fn12_links_lang.ea6'	),
		{ fn21_phone_common }	= 	require(	cons.JS_BASE  + 'spc/theme/truck/fast_node/fnode/fn21_phone_common.ea6' ),
		{ fn22_phone_lang } 	= 	require(	cons.JS_BASE  + 'spc/theme/truck/fast_node/fnode/fn22_phone_lang.ea6' 	),
		{ fn23_site_lang }      = 	require(	cons.JS_BASE  + 'spc/theme/truck/fast_node/fnode/fn23_site_lang.ea6'  	),

		{ fy01_cookies } 	    = 	require(	cons.JS_BASE  + 'spc/theme/common/fast_node/fnode/fy01_cookies.ea6'		),
		{ fn31_cookies }      	= 	require(	cons.JS_BASE  + 'spc/theme/truck/fast_node/fnode/fn31_cookies.ea6'		),

		{ fn32_cookies_links }  = 	require(	cons.JS_BASE  + 'spc/theme/truck/fast_node/fnode/fn32_cookies_links.ea6'),

		{ cbool }				= 	require( 	cons.JS_BASE  + 'com/objects/drupal/bool/b01_bool.es6'					),
		{ categories }			= 	require( 	cons.JS_BASE  + 'com/objects/categories/categories.es6'					),
		{ contents }			= 	require( 	cons.JS_BASE  + 'com/objects/categories/contents.es6'					);


class theme_truck extends theme_structure {

	constructor(pg, u)
	{
		super()
		this.n 							= 	"thm_truck::"
		this.m							=	'constructor'
		this.pg 						= pg
		this.u 							= u
		this.s 							= this.u.s
		this.c 							= this.u.c
		this.b 							= new cbool()

		this.b.copy(this.s.b)

		var fnode 						= new fn01_flat(this.u, "middle")

		this.arr['fnode']['file_list'] = fnode

		// 139 - 0.4s
		// this.p('Num_imgs ' + this.arr['fnode']['file_list'].arr['img'].length	)

		// this.p('BEFORE_IMAGES')

		var fnode_images = new fn02_images(fnode)


		this.arr['fnode']['image_list'] = fnode_images

		// 139 - 4s
		// this.p('Num_imgl ' + this.arr['fnode']['image_list'].arr['oim'].length	)

		if (this.b.page_cookies )
		{
			this.p('COOOKIES_PAGE_OJHITO')

			// Yaml cookies file
			this.arr['fyode']['cookies'] 			= 	new fy01_cookies(this.u)


			// Dat cookies file
			this.arr['fnode']['cookies'] 			= 	new fn31_cookies(this.u)

			// Dat cookies file
			this.arr['fnode']['cookies_links'] 		= 	new fn32_cookies_links(this.u)
		}

		// this.p('AFTER_IMAGES')
		var fnode_common = new fn11_links_common(this.u, "footer")


		// this.p('AFTER_LINKS_COMMON')
		this.arr['fnode']['link_list_common'] = fnode_common
		this.arr['fnode']['link_list_lang'] = new fn12_links_lang(fnode_common, "footer")

		var fnode_flags = new fn01_lang_common(this.u, "footer")
		this.arr['fnode']['flag_list'] = fnode_flags

		fnode_common = new fn21_phone_common(this.u, "footer")
		this.arr['fnode']['email_phone_common'] = fnode_common
		this.arr['fnode']['email_phone_lang'] = new fn22_phone_lang(fnode_common, "footer")

		var fnode_site = new fn23_site_lang(this.u)
		this.arr['fnode']['site_info_lang'] = fnode_site

//		this.p('END_THEME')

		this.u.cat = new categories()
		this.u.cot = new contents(this.s.folder_dat)
	}

}

exports.theme_truck = theme_truck
