// Methods:
//-------------------------------------------------------------------------------------
// - d-fnode_promise-  				: Fnode promise function 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

function pn01_simple_promise(data_and_error = '' , t = '' ) {
  const promise = new Promise(function (resolve, reject) {

	process.on('unhandledRejection', (err, p) => {
	  console.log('An unhandledRejection occurred')
	  console.log('Rejected Promise:' + p )
	  console.log('Rejection:' + err )
	})

	if (t.s.load == 'drupal')
	{
		t.run_from_drupal()															
	}
	else 
	{
		// no vale, hay que separar el metodo entero
		// 1.Crea las rutas para la consulta
		t.check_common_and_create_paths()					
		// File : an01_anode.obj

		// 2. Si existe el fichero recupera las propiedades ( methodo del hijo )
		//    Si no existe lo genera

		// Revisa si existen los ficheros o si hay que recargar
		t.generate_object_info() 												 

		// Si hay codigo sale exitoso. Sino entra

		let we_dont_have_code_ready_to_use = true  


		// 1. Intentamos obtener el codigo si no han dicho reload
		if (t.b.type_have_code)
		{ 
			//t.p('TYPE_HAVE_CODE ' + t.type)

			we_dont_have_code_ready_to_use = t.dont_exist_and_get_ram_code()  				
		}


		if (we_dont_have_code_ready_to_use		)
		{
			 t.p('002_After_check_code ' + t.type + '  '   +	t.short_type + '  ' +  t.code.length )						

			if (t.b.type_have_properties)
			{
		        if ( t.if_exist_properties_ram_reload_contents()		) 	
		        {
					t.load_dat_contents()
					
		        } // End if
		        else
				{


			        if ( t.if_exist_properties_ssd_reload_contents()		) 	
			        {
			
						// Load current object properties
						t.load_dat_contents()
						
			        } // End if
			        else
					{
						// t.p('getting_disk ' + t.type + '  ' + t.short_type)														
						// 1. Intentamos pillar las propiedades de ram si se dedide
						// 2. Si no se decide o no hay fichero lo intentamos desde disco
						t.get_current_properties_disk() 															
			
					}

				}

			
			}
			t.p('AFTER_ASYNC')  
			
		}	

	}
	  // Caso de exito
	  
	// el problema es que la resolvemos siempre y habria que esperar a las otras promesas
    resolve(t)
    if (!t) 
    {
		// Aqui igual hay que gestionar datos del objeto		
	    reject(new Error('Problema con el objeto fnode pasado '))
    }
  })
  
  return promise
          
}

module.exports.pn01_simple_promise = pn01_simple_promise