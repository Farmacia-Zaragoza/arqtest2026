const 	{ pn01_simple } 	= 	require(	path.join(JS_BASE, 'spc/theme/truck/fast_node/pnode/pn01_simple.ea6'));


function pn01_simple_def(data_and_error = '' , t = '') {
  const promise = new Promise(function (resolve, reject) {

	t.pnode = new pn01_simple(t.u)

	console.log('A_Created_Structure - Se imprime y aun se esta ejecutando el primer paso')

	  // Caso de exito
    resolve(t)
    if (!t)
    {
		// Aqui igual hay que gestionar datos del objeto
	    reject(new Error('Problema con la definicion del objeto fnode pasado '))
    }
  })

  return promise

}

module.exports.pn01_simple_def = pn01_simple_def
