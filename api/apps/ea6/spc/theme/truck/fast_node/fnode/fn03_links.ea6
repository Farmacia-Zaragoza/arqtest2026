//-------------------------------------------------------------------------------------
// Fast node load - Replace Mysql connections
//-------------------------------------------------------------------------------------
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// - d-get_child_properties-  				: Get specific child properties 
// - d-load_child_details-    				: Recover from drupal child properties
// - d-prepare_specific_child_properties- 	: Prepare properties to save in array
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

const	{ fnode } 			= require(	path.join(JS_BASE, 'com/objects/drupal/node/fnode.es6'))),
		{ cbool }			= require( 	path.join(JS_BASE, 'com/objects/drupal/bool/b01_bool.es6')));

// Para poder extender debe haberse incluido antes
class fn03_links extends fnode {

           
    constructor (   u					=	''				, // 02. U object
					page_position		=	''				, // 07. Position id
					stype				=	'flat_links'	) // 08. Node Type  
    {   

		super()
		this.n 							=	'fn03_links::'			

		this.page_position				=	page_position 										

		this.u 							=	u 													
		
		this.s							=	this.u.s											

		this.b							= 	new cbool()
		this.b.copy (this.s.b)													
		

    	this.type						=	'links_structure'					 // Type for structures			
		this.short_type					=	'LKS'						
    	
    	
		// String fnode / node / cica_recuerdo
		this.ftype 						=	'fnode'															// Fast node type
		this.stype 						=	stype															// Node subtype			
		this.type_name					=	this.stype 													
		

		this.b.type_human						= 	true 										 // if is dat file never will be erased on disk

		this.b.type_common						=	true										
		this.b.type_have_taxonomy				=	false 										
		this.b.type_have_code					=	false										
		this.b.type_have_properties				=	true										
		this.b.type_have_specific_properties	=	true										

		this.b.type_synced						= 	true 										

		// this.p('Sync_servers ' + this.u.sync_server_to + ' F ' + this.u.sync_server_from)

		// Type path adjustment

		// fnode / file_structure
		this.change								=	
						'/' + this.ftype + '/' + this.type + '/' 	

		let base_common = 'common_'																
		let lang_common = '' 																			


		if (this.b.site_multilang) 
			lang_common	= base_common + this.u.lang_site + '_'

   		this.suffix		= 	base_common + this.stype										

   		this.suffix_lang	= 	lang_common + this.stype										


   		this.suffix_disk 	= 	this.suffix													

   		this.suffix_code 	= 	this.suffix + '_' + this.u.ssl_page + '.' + 'code'		


		// Links information url - title - target - extended TeXt
		arrays_line = 'url tit tar txt lines'   
		this.arr['types'] = arrays_line.split (' ') 	 


		// Method for disk load and to generate and save content
		this.generate_load_from_disk_path()													

		//  /brqx/pers/drupal/v50/fnode/flat/fnode/links_structure/common_flat_links
		// efile_lines@flat_details
		
		// No tiene codigo - Es un tipo humano
		// this.p('0L_Links_LOAD ' + this.load_from_disk_path)								
		// this.p('0L_Links_LANG ' + this.load_from_disk_lang)								
		// this.p('0L_Links_CODE ' + this.load_from_disk_path_code)								
		
		// /brqx/pers/drupal/v50/fnode/flat/fnode/links_structure/common_flat_links
		// /brqx/pers/drupal/v50/fnode/flat/fnode/links_structure/common_flat_links_ssl.code

		if (this.s.load == 'drupal')
		{
			this.run_from_drupal()															
		}
		else 
		{
			this.run_from_disk()																
		}
		// this.p('RAM_Links ' + this.ram_alias_path			)										
		// this.p('RAM_Licod ' + this.ram_alias_code_path			)										

		// /ram/home/ser/zd/main/es/zdom/emp/flat/zd_main_flat/es/cache/ssl/flat.dbrqx.com/anonymous/flat/fnode/links_structure/human/common/common_flat_links
		// /ram/home/ser/zd/main/es/zdom/emp/flat/zd_main_flat/es/cache/ssl/flat.dbrqx.com/anonymous/flat/fnode/links_structure/human/common/common_flat_links_ssl.code

    }

    get_child_properties(prop, value) {   

		// Tenemos un metodo comun para todos los tipos con title - type - path y los arrays
		// Pendiente de revisar	

			if ( 	 prop 	== "ntype"					)		this.node_type					=	value			
			else if ( prop 	== "stype"					)		this.stype						=	value			
			else if ( prop 	== "num_links"				)		this.num_links					=	value			
			else if ( prop 	== "cookies_msg_01"			)		this.cookies_msg_01				=	value			
			else if ( prop 	== "cookies_msg_02"			)		this.cookies_msg_02				=	value			
			else if ( prop 	== "cookies_msg_uri"		)		this.cookies_msg_uri				=	value			
			else if ( prop 	== "cookies_msg_uritext"	)		this.cookies_msg_uritext			=	value			
			else if ( prop 	== "header_msg"				)		this.header_msg					=	value			
			else if ( prop 	== "extended_msg"			)		this.extended_msg					=	value			
			else if ( prop 	== "description"			)		this.description					=	value			
			else if ( prop 	== "descriptions"			)		this.descriptions					=	value			
			else if ( prop 	== "efile"					)		this.efile							=	value			

    }


	prepare_specific_child_properties()
	{
		this.arr['properties'].push(	"num_links" 		 + this.sep  + this.num_links				)			
		this.arr['properties'].push(	"cookies_msg_01" 	 + this.sep  + this.cookies_msg_01			)
		this.arr['properties'].push(	"cookies_msg_02" 	 + this.sep  + this.cookies_msg_02			)
		this.arr['properties'].push(	"cookies_msg_uri" 	 + this.sep  + this.cookies_msg_uri			)
		this.arr['properties'].push(	"cookies_msg_uritext"  + this.sep  + this.cookies_msg_uritext	)
		this.arr['properties'].push(	"header_msg" 		 + this.sep  + this.header_msg				)
		this.arr['properties'].push(	"extended_msg" 		 + this.sep  + this.extended_msg			)	
		this.arr['properties'].push(	"description" 		 + this.sep  + this.description				)
		this.arr['properties'].push(	"descriptions" 		 + this.sep  + this.descriptions			)	
		this.arr['properties'].push(	"efile" 			 + this.sep  + this.efile					)
		
	}
  
}

exports.fn03_links = fn03_links