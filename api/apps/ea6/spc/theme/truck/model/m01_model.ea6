var 		cons 					= 	require(	"/brqx/base/rcode/es6/com/libs/general/constants.ess"			);

const 		{ model_run_mongo } 	= 	require(	path.join(JS_BASE, 'spc/theme/truck/model/m02_run_mongo.ea6'))),
			echo 					= 	require(	'node-echo'									);


class model extends model_run_mongo
{
	constructor( pmt = '' )
	{
		// Pasamos la request
		super(pmt)

		// RUN --> PROCESS
	}

	async run_options()
	{
		if ( this.b.ready_to_load )
		{
			if (this.b.mongo_cache)
			// Async method
				await this.run_mongo()
			else
				await this.run_disk()
		}
		else
			await this.run_psimple()

// 		return await this.code
	}


} // end Class

exports.model = model
