// Methods:
//-------------------------------------------------------------------------------------
// - d-manage_front-         : Manage front page
// - d-recover_front-        : Recover front page when we did a change
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

var   cons                  =   require(  "/brqx/rcode/es7/com/agen/constants.es7" )

const   { uri_process_commands }    =   require(  cons.JS_TYP7  + 'uri/u06_process_commands.es7'        )

class uri_front extends uri_process_commands {

  constructor()
  {
    super()    
    this.n                  =   'uri_front::'        
  }

  manage_front()
  {
    // Assign a front string to an empty uri for file generation
    // Convierte cualquier uri en front
    // Lo que no se es la gestion multi lang
    
    this.old_dash_uri       =  this.dash_uri
    this.old_slash_uri      =  this.slash_uri

    this.old_uri            =  this.uri
    this.old_page_command   =  this.page_command

    this.p('Manging_FRONT_Why_URI ' + this.old_slash_uri + '   ' + this.uri + ' : ' + this.s.ms.exception )

    // A. FRONT PAGE
    this.dash_uri           =  'front'                           // Main home
    // This could to change with language
    this.uri                =   'front'                          
    
    this.compouri           =  ''                            

    // Clean anchors
    this.s.cs.anchor_name   =  ''
    this.s.cs.anchor        =  ''

    // Clean flags
    this.b.anchor_page      =  false

    // Hemos cargado un nuevo lang pero aqui aun no lo conoce
    //

    // this.s.lang             =   this.s.ms.default_lang
    // this.s.ms.lang          =   this.s.ms.default_lang
    // this.s.cs.lang          =   this.s.ms.default_lang

    // this.p('U04_Actualizamos lang de ' +  this.s.lang)    

    if (this.b.page_multi_language)
      this.dash_url         =   this.dash_domain + this.dash_port + '_' + this.s.lang + '_' + this.dash_uri  
    else
      this.dash_url         =   this.dash_domain + this.dash_port +  this.dash_uri  

    // this.p('Managing_front_lang ' + this.dash_url )                    
     // truck_dbrqx_com_https_front

    // Aqui front es un product
    this.b.page_front       =  true                           

    // Debemos definirlas pues las usamos para la generacion de paths
    this.slash_ideal_uri    =   this.uri                         
    this.dash_ideal_uri     =   this.uri       

    // Si es front no debe tener argumentos
    this.page_iargs         = ''

//    this.s.robot            =  'human'
    
    this.s.cs.page_type	    =  'content'    
    this.s.cs.lang          =  this.s.ms.default_lang

    
    this.page_command       =  'blanc'
    this.s.cs.page_name     =  'front'
    this.s.cs.teaser_type	=  'full'        

    this.s.cs.loadtype      =  'page'
    this.s.cs.position      =  '20'    
    this.s.cs.page          =  '0'    

    this.s.cs.position_norm = this.get_next_level(this.s.cs.position)
    this.s.cs.page_norm     = this.get_next_level(this.s.cs.page)
    

  }
    
  
  recover_front()
  {
    this.dash_uri           =  this.old_dash_uri
    this.uri                =  this.old_uri

    this.slash_ideal_uri    =  this.uri                         
    this.dash_ideal_uri     =  this.dash_uri       

    this.page_command       =  this.old_page_command    
    
  }

}

exports.uri_front = uri_front