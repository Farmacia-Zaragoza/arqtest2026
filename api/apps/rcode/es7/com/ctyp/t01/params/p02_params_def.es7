var   cons     =   require(  "/brqx/rcode/es7/com/agen/constants.es7"            )

const   { printlog }         =   require(  cons.JS_TYP7  + 'logs/printlog.es7'   )

class params_def extends printlog {
  constructor() {
	super()
	this.n 					= 	"params_defs::"
		
	this.req				= 	''
	this.cache      		= 	false
	this.lang 				= 	false
	this.trans 				= 	false
	this.sync 				= 	false
	this.live 				= 	false
	this.lang_uri 			= 	true
	this.is_robot 			= 	false

	this.nocode 			= 	false
	this.max_elems 			= 	false

	this.live_op			=	''			// scripts | minimized | inline

	this.default_lang		=	'es'			// 
	this.max_articles	    =	'10'			// 
		
	this.robot				=	'human'		// Humans | Robot pages
	this.slan				=	'n'			// No Multilanguage
	this.env				=	'dev'		// Dev environment				


    this.branch             =   'arq'       // Architecture Branch
    this.prod               =   'drupal'    // Architecture Product

    // Site to get properties - Fnode
	this.site			    =	'truck'

    this.comm_positions     =   '0 2 4 5'
    this.spec_positions     =   '0 2 5'

    // Site to generate Cache
	this.cached_site	    =	'truck'

	this.base_path			=	'/brqx/'

	this.run_path			=	''

  }

//-------------------------------------------------------------------------------------

  copy(pmt) {
		
	this.req				= 	pmt.req           // 01. Request
	this.cache      		= 	pmt.cache         // 02. Cache
	this.lang 				= 	pmt.lang
	this.trans 				= 	pmt.trans
	this.sync 				= 	pmt.sync
	this.live 				= 	pmt.live
	this.lang_uri 			= 	pmt.lang_uri
	this.is_robot 			= 	pmt.is_robot
	this.live_opt			=	pmt.live_opt

	this.nocode 			= 	pmt.nocode
	this.max_elems 			= 	pmt.max_elems

	this.default_lang		=	pmt.default_lang
	this.allowed_lang		=	pmt.allowed_lang

    this.max_articles       = 	pmt.max_articles				// 16

	this.env                =	pmt.env

	this.robot              =	pmt.robot

	this.slan               =	pmt.slan

    this.pg                 =	pmt.pg

	this.branch			    =	pmt.branch
	this.prod  		        =	pmt.prod
   
    this.comm_positions     =   pmt.comm_positions
    this.spec_positions     =   pmt.spec_positions
   
	this.site			    =	pmt.site
	this.cached_site	    =	pmt.cached_site

	this.images_site	    =	pmt.images_site

	this.base_path			=	pmt.base_path
	this.run_path			=	pmt.run_path


  }
	
	
}

exports.params_def = params_def