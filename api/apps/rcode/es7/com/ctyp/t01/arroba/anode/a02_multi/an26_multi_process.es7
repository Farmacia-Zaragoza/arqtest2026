// Methods:
//-------------------------------------------------------------------------------------
//- d-main_multi_position_process-       : Process from main file only specific position
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
//-------------------------------------------------------------------------------------
// Inheritance Line : 
//-------------------------------------------------------------------------------------
// AnoMultiLoad > AnoMultiProcess > AnoRunPosition
// @Anode >  ...
//-------------------------------------------------------------------------------------
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--


var    cons            =   require(  "/brqx/rcode/es7/com/agen/constants.es7"           )

const  { anode_run_position }  =   require(  cons.JS_TYP7  + 'arroba/anode/a03_position/an32_run.es7'              )

class anode_multi_process extends anode_run_position {
  constructor()  
  {
    super()

    this.n                        = "anode_multi_process::"
  }

  
  //---------------------------------------------------------------------------------------------    
  // Load 0 (site) 2(regions) and 5 (langs) 
  main_multi_position_process(positions    = '0 2 5'             )
  {

    // this.p('Positions passed ' + positions )
    let a_positions = positions.split(' ')

    for (var pos in a_positions) 
    {
    	this.s.cs.position = a_positions[pos]
    	// this.p('a04_Ano_Loadding ' + pos +  ' ' + this.s.position)
    	
		this.main_position_process()
    }
  	
  }

  
}

exports.anode_multi_process = anode_multi_process