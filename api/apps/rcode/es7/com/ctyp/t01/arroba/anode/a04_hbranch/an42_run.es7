// Class:
//-------------------------------------------------------------------------------------
// -c-anode_run_hierarchical-
//-------------------------------------------------------------------------------------
// Methods:
//-------------------------------------------------------------------------------------
//- d-run_hierarchical_load-       : Load from main hierarchical structure
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
//-------------------------------------------------------------------------------------
// Inheritance Line : 
//-------------------------------------------------------------------------------------
// AnoRunHierar > AnoHieraMainLoad > AnoHieraMainProcess >AnoRunPosition
// @Anode >  ...
//-------------------------------------------------------------------------------------
// Execution Line : 
//-------------------------------------------------------------------------------------
// run_hierarchical_load > main_hierarchical_load >
//-------------------------------------------------------------------------------------

//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

var   cons                  =   require(  "/brqx/rcode/es7/com/agen/constants.es7"         )

const   { anode_hierarchical_main_process } =   require( cons.JS_TYP7  + 'arroba/anode/a04_hbranch/an46_hierarchical_main_process.es7'  )

class anode_run_hierarchical extends anode_hierarchical_main_process {
  constructor()  
  {
    super()

    this.n                  =   "anode_run_hierarchical::"
  }


  //---------------------------------------------------------------------------------------------  
  // Tenemos un nivel Mas : Multipage
  // @Format : Articulos - Positions - Pages
  run_hierarchical_load()
  {
    this.m = 'run_hierarchical_load'

    // 1. Cargamos la informacion del idioma principal (ingles)
    let before_lang       =   this.s.ms.lang
    
    let local_founded     = false

    // es - es
    // this.p('an42_runhier ms: ' + this.s.ms.lang + ' cs: ' + this.s.cs.lang  )

    if ( this.b.language_already_loaded == false  )
    {
       this.s.ms.lang           =   'en'
       this.s.cs.lang           =   this.s.ms.lang    
    
       this.main_hierarchical_process()    
       
       // Si se ha encontrado la rama, la ponemos a false para que busque en el otro idioma
       if (this.b.found_breadcrumb)     
       { 
         this.b.found_breadcrumb = false
         local_founded = true
       }
    }
    

    this.s.ms.lang             =   before_lang
    this.s.cs.lang             =   this.s.ms.lang    
    
    if ( this.s.ms.lang != 'en' )
    {
      this.p('j02_jnod_Loading ES hiera ' + this.s.ms.lang )
      this.main_hierarchical_process()    
      if (this.b.found_breadcrumb || this.b.found_breadcrumb_lang )     
         local_founded = true
    }
    
    this.b.found_breadcrumb = local_founded
  }

  
}

exports.anode_run_hierarchical = anode_run_hierarchical