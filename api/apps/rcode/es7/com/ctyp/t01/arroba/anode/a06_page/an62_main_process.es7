var    cons             =   require(  "/brqx/rcode/es7/com/agen/constants.es7"  )

const  { anode_page_load }   =   require(  cons.JS_TYP7  + 'arroba/anode/a06_page/an64_page_load.es7'   ),
       { idx_pointers } =   require(  cons.JS_TYP7  + 'logs/idx_pointers.es7'        );

class anode_main_page_process extends anode_page_load {
  constructor()  
  {
    super()
    this.n                        = "anode_main_page_process::"
  }

  //---------------------------------------------------------------------------------------------  
  // Procesa Solo la primera posicion y la primera pagina
  main_page_process(   index           = 'main'    , 
                       current_subpath = ''        )
  {
    var idx = new idx_pointers(index)
    this.arroba_attribs(idx,this.s.cs.position )
    
    // this.p('an62_mp_Cat Lang : ' + this.item )
  
    current_subpath  = 'l' +  this.dhild

    //// this.p('an62_jnod_Pos: ' + this.s.position + ' Cat : ' + this.item + ' Child: ' + this.child)

    if ( this.child == "yes" )
    {
      // this.p('Cat Lang : ' + this.s.lang + ' Cat '  + this.item + ' Pat: ' + current_subpath)
      this.page_load(this.s.ms.lang , current_subpath)
    }

  }
  

}

exports.anode_main_page_process = anode_main_page_process