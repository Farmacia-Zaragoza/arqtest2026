var   cons                        =   require(  "/brqx/rcode/es7/com/agen/constants.es7"         )

const  { anode_gindex_main_load }  =   require(  cons.JS_TYP7  + 'arroba/gindex/a_main/g01_idx_load.es7'      )

class anode_run_index_page extends anode_gindex_main_load {
  constructor()  
  {
    super()

    this.n                  =   "anode_run_index_page::"
  }

  // Este es distinto pues carga un fichero de indice y no genera arroba
  run_index_load(positions = '')
  {
    // ESTE METODO VALDRIA PARA UNA BUSQUEDA
    // this.p('an72_GENERATING_CACHE IDX ' + this.s.cs.lang + ' ' + this.s.cs.cache_path)
    // Este ya tiene la estructura para busqueda
    // this.generate_array_from_file( this.s.ms.main_lang,  this.s.cs.cache_path )

// 1. Cargamos la informacion del idioma principal (ingles)
    let before_lang       =   this.s.ms.lang

    // en - en
    // this.p('an72_langs_check ms: ' + this.s.ms.lang + ' cs: ' + this.s.cs.lang  )
    

    if ( this.b.language_already_loaded == false  )
    {
       this.s.ms.lang           =   'en'
       this.s.cs.lang         =   this.s.ms.lang    
    
       this.main_index_page_load()    
       
       // this.p('an72_FOUNDED_TYPE ' + this.s.cs.founded_type)
    }

    this.s.ms.lang           =   before_lang
    this.s.cs.lang         =   this.s.ms.lang    
    
    if ( this.s.ms.lang != 'en' )
    {
      // this.p('j72_jnod_Loading ES')
      // FALTA PREPARAR ESTOS METODOS
      
      this.main_index_page_load()    
    }
 
  }
  
}

exports.anode_run_index_page = anode_run_index_page