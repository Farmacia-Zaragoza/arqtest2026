// Devuelve verdadero si la cadena contiene numeros
function hasNumber(myString) {
  return /\d/.test(myString);
}

// Devuelve verdadero si la cadena termina en numero Ej: b009
function endswithNumber(myString) {
  return  /[0-9]$/.test(myString);
}

module.exports.hasNumber           = hasNumber
module.exports.endswithNumber      = endswithNumber
