// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

var     cons               =   require(  "/brqx/rcode/es7/com/agen/constants.es7"         )

const   { arqkb_no_cache } =   require(  cons.JS_ARQ7  + 'kb/arqkb/model/arqkb_nocache_launcher.es7' ),
        { arqkb_cache }    =   require(  cons.JS_ARQ7  + 'kb/arqkb/model/arqkb_cache_launcher.es7'),
        { printlog }       =   require(  cons.JS_TYP7  + 'logs/printlog.es7'                       );

class arqkb extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                 =  'arqkb::'

    if (pmt.cache)      this.model           = new arqkb_cache(    pmt  )
    else                this.model           = new arqkb_no_cache( pmt  )
  } 

} // end Class

exports.arqkb = arqkb
