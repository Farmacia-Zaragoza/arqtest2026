var     cons                =   require(  "/brqx/base/rcode/es7/com/agen/constants.es7"         )

const   { tjson_comm }      =   require(  cons.JS_SPC7  + 'acomm/json/j04/j02_tjson_comm.es7'   ),
        { theme_html }      =   require(  cons.JS_SPC7  + 'vitolas/html/h04/h01_theme_html.es7' ),
        { arroba_jtype }    =   require(  cons.JS_SPC7  + 'vitolas/json/j03/j01_arroba_type.es7');

class theme_json extends tjson_comm
{
  constructor(arroba = '')
  {
    super(arroba)
    this.n                  =   "theme_json::"

    this.jcontent           =   new arroba_jtype(this.arroba)
    
    this.generate_content_json()
       
    this.thmhtml            =   new theme_html(this.arroba)
    this.code               =   this.thmhtml.code

  } 

} // end Class

exports.theme_json = theme_json