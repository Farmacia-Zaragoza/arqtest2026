// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

var     cons              =   require(  "/brqx/rcode/es7/com/agen/constants.es7"         )

const   { meto_no_cache } =   require(  cons.JS_PYC7  + 'meto/meto/model/meto_nocache_launcher.es7' ),
        { meto_cache }    =   require(  cons.JS_PYC7  + 'meto/meto/model/meto_cache_launcher.es7'),
        { printlog }      =   require(  cons.JS_TYP7  + 'logs/printlog.es7'                       );

class meto extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                =  'meto::'

    if (pmt.cache)      this.model          = new meto_cache(    pmt  )
    else                this.model          = new meto_no_cache( pmt  )
  } 

} // end Class

exports.meto = meto
