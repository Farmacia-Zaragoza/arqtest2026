var    cons                 =   require( "/brqx/rcode/es7/com/agen/constants.es7"          )

const   { common_react }  =   require( cons.JS_ACO7  + 'html/h01/main/rea/common_react.es7' )          ,		
		{ scripts_react }	=	require( cons.JS_ACO7  + 'html/h01/main/rea/scripts_react.es7');					


class body_react extends common_react  {

  constructor (     container						)
  {   
		super(container)

		this.n							=	'bdy_arqdru::'		
  }

  //-------------------------------------------------------------------------------------

  create_scripts()
  {
		// Here we have two options
		// Scripts links for dev environment
		// Script tag for live environment

