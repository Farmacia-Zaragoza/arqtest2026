var    cons                  =  require(  "/brqx/rcode/es7/com/agen/constants.es7"          )

const  { deep_link_base } = require(	cons.JS_ACO7 + 'html/h01/deep/styles/deep_link_base.es7')		


class deep_link_react extends deep_link_base {

  constructor(thm) {

	super(thm)
	this.n = 'deep_link_react::'
  }

    //   <link rel="stylesheet" href="http://seo.vbrqx.com/dev/static/booklet/jquery.booklet.latest.css"
	create_booklet_style(path_pmt = 'dev/static/booklet/', css_name = 'jquery.booklet.latest.css') 
	{

		// this.link_jquery.rel			 	=  'preload'
		// this.link_01.onload		 		=  	"this.rel='stylesheet'"
		// this.link_02.as = 'style'

		this.link_02.type = 'text/css'
		this.link_02.rel = 'stylesheet'

		this.link_02.href =
			this.thm.s.cs.http_domainbar + path_pmt + css_name

		this.link_02.pcreate()

		this.code += this.link_02.code
	}
  

     create_seo_styles()
    {
      this.create_booklet_style()
    }

  
  build_data() 
  {

    if (this.s.b.robot_page)
	  this.create_robot()     
    else
    {    
	  //this.create_googlefonts()

	  //this.create_bootstrap()

        switch (this.thm.s.ms.site)
        {
         case "seo":	
             this.create_fontawesome()
             this.create_seo_styles()
           break
         case "social":	
           this.create_fontawesome()
           break
        }
        
        
      if (this.thm.s.cs.style_engine == "materialize" )
      {
      	this.p('STYLE_MATERIALIZE')
	    //this.create_materialize()

      }

	  this.create_theme()

	  this.create_style('dev/static/css/' , 'main.css')
    }
		// Ok [18-05-05]
    // this.p('Code_lnk02_link : >' + this.code ) 											
  } // End method

} // End class

exports.deep_link_react = deep_link_react
