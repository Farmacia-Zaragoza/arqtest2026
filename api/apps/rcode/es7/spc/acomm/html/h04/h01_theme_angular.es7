var     cons                =   require(  "/brqx/rcode/es7/com/agen/constants.es7"        )

const  { printlog }             =   require(  cons.JS_TYP7  + 'logs/printlog.es7'                  ),
       { arroba_htype_angular } =   require(  cons.JS_ACO7  + 'html/h03/h01_arroba_htype_angular.es7' );

class theme_angular extends printlog
{
  constructor(container = '')
  {
    super()
    this.n                  =   "theme_angular::"

    this.container          =   container

    // Generate common html file
    // Lo mismo hay que ver si existe el fichero
    // si existe hay que obtenerlo y devolverlo
    this.hcontent           =   new arroba_htype_angular(this.container)

    this.code               =   this.hcontent.htype.hobject.code

  } 


} // end Class

exports.theme_angular = theme_angular