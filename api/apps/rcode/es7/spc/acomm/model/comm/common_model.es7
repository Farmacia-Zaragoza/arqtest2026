//-------------------------------------------------------------------------------------
// Objects : 
// comm - spec - content
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
//-------------------------------------------------------------------------------------
// Used Entities : 
//-------------------------------------------------------------------------------------
// e-container-         : Arroba container
//-------------------------------------------------------------------------------------
// Methods:
//-------------------------------------------------------------------------------------
//- d-run_comm_model-  : Carga el modelo para todas la paginas
//- d-run_spec_model-  : Carga el modelo especifico
//- d-copy_model-      : Copia un modelo de arroba
//- d-cache_model-     : Ejecuta el site con cache
//- d-check_logo_data- ; Check Logo Information
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
//-------------------------------------------------------------------------------------
// Inheritance Line : 
//-------------------------------------------------------------------------------------
// Comm_Model > Index_fast > Index
// @Model > @Index > @Log
//-------------------------------------------------------------------------------------
// Run Line : 
//-------------------------------------------------------------------------------------
// Cache_Model > No_Cache_Launcher 
// @CacheModel > @Launcher
//-------------------------------------------------------------------------------------

//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--


var     cons              =   require(  "/brqx/rcode/es7/com/agen/constants.es7"            )

const   { index_fast }    =   require(  cons.JS_TYP7  + 'fire/index_fast.es7'               ),
        { container }     =   require(  cons.JS_TYP7  + 'container/c01_cont.es7'            ),
        { arroba_mcomm }  =   require(  cons.JS_TYF7  + 'a01_load/mcomm/m01_arroba_comm.es7'),
        { arroba_scomm }  =   require(  cons.JS_TYF7  + 'a01_load/scomm/s01_arroba_comm.es7'),
        fs                =   require(  'fs'                                                ),
		gfc  			  =   require(  cons.JS_LIB7  + 'file/get_file_code.es7' 	        );

class common_model extends index_fast
{
  constructor(pmt = '' )
  {

    super(  pmt )

    // Debemos definirla por la visibilidad de la variable
    
    // Si tenemos 3 clases : c > b > a
    // El argumento c.arg debe existir en a para poder usarse en un metodo de a
    
//    this.uspc             =  ''

    this.arroba           =  new container()

    this.acomm            =  new container()

    // Gestion de uris de robot
    this.robot_uri_management()

    // this.p('arqdru_noche_robot X ' + this.s.b.robot_page )

    this.n                =  'common_model::'
  }

  //---------------------------------------------------------------------------------------------  

  check_logo_data()
  {
  	let logo_data_check = false

    //site_path :  /mnt/ssd/brqx/run/react/arq/kb/arqkb
  	
  	let logo_file         = this.s.ms.images_path + this.s.ms.logo_mobile.substr(2)
    if (!fs.existsSync(logo_file) )  logo_data_check = true  	
  	if (logo_data_check) this.p('CHECK_MOBILE_LOGO ' +  logo_file)
  	
  	logo_file         = this.s.ms.images_path + this.s.ms.logo_tablet.substr(2)
    if (!fs.existsSync(logo_file) )  logo_data_check = true  	
  	if (logo_data_check) this.p('CHECK_TABLET_LOGO ' +  logo_file)

  	logo_file         = this.s.ms.images_path + this.s.ms.logo_desktop.substr(2)
    if (!fs.existsSync(logo_file) )  logo_data_check = true  	
  	if (logo_data_check) this.p('CHECK_DESKTOP_LOGO ' +  logo_file)

  	logo_file         = this.s.ms.images_path + this.s.ms.logo_4k.substr(2)
    if (!fs.existsSync(logo_file) )  logo_data_check = true  	
  	if (logo_data_check) this.p('CHECK_4k_LOGO ' +  logo_file)
  	
  }


  //-------------------------------------------------------------------------------------

  cache_model()
  {
    // this.p('acache ali ' + this.uspc.c.s.cs.cache_alias)
    // this.p('acache sum ' + this.uspc.c.s.cs.cache_sum)

    // Si es robot cache sum si esta siendo generado solo con la fecha

    if (!this.b.cache)
    {
       // Si no hay cache debe regenerarse todo
       this.no_cache_launcher_code()
    }    	
    else if (gfc.no_zero(this.uspc.c.s.cs.cache_sum))
    {    	
       // Hay cache y existe el fichero de cache
       this.p('Getting-Cached-Code ' + this.uspc.c.s.cs.cache_path)
       this.code = gfc.get_file_code(this.uspc.c.s.cs.cache_path)    	
       //this.p('ardrmod_getting_code ' + this.code.length)       
    }
    else 
    {
       this.p('Enter-In-No_Cache')

       // Pueden existir aliases
      if (gfc.no_zero(this.uspc.c.s.cs.cache_alias))
      {
        // this.p('acache_Hay alias')
        this.code = gfc.get_file_code(this.uspc.c.s.cs.cache_alias)
      }
      else
      {    	
        // Hay cache y no existe el fichero 
        this.no_cache_launcher_code()
      }
          	
    }
 	
  }


  //-------------------------------------------------------------------------------------

  copy_model()
  {
    this.arroba.copy( this.comm)
    this.acomm.copy(  this.comm)

    // this.p('arqdru_main_cat' + this.comm.j.arr['en']['jmain'][0])
    // this.p('arqdru ' + this.acomm.s.cs.cache_url )
  }

//-------------------------------------------------------------------------------------
  
  run_comm_model() 
  {
    this.m         = 'run_comm_model'

    // this.arroba.u.gen_url_structure()
    // this.acomm.u = this.arroba.u 

    // El problema es que aqui aun no sabemos el path
    // ----------------------------------------------------------------------------------
    // this.p('arqdru comm  NOLOSABEMOS Before RUNGEN ' + this.commjson.s.cs.cache_path )

    // this.p('rcm_Slangs an22 ' +  ' ' + this.uspc.s.cs.lang )
    
    this.commjson.rungen()
    // Call to process_array_and_generate_json_file ( Call to rungen and later to rungen_json)

    // this.p('arqdru comm  YALOSABEMOS ' + this.commjson.s.cs.cache_path )
    // this.p('arqdru Fa ' + this.commjson.s.cs.cache_url )
    // this.p('comm_mod_LANG_A2  ' + this.uspc.s.ms.lang)


    // Hay que averiguar donde lo hemos puesto content

    this.arroba.copy_uri(this.uspc)

    
    this.check_logo_data()

    // Ok
    // this.p('comm_mod_LANG_A3  ' + this.arroba.s.ms.lang)
    // this.p('comm_model_URI an22 ' + this.arroba.u.dash_uri + '   ' + this.arroba.u.uri )

    // COMMON URL MANAGEMENT
    this.arroba.s.ms.j_comm_path           = this.commjson.s.cs.cache_path  
    this.arroba.s.ms.j_comm_url            = this.uspc.s.cs.http_domainbar + this.commjson.s.cs.cache_url
    
    // Recargamos estructura. No generamos Json 
    // Necesitamos recupèrar la estructura ya generada
    // A PARTIR DE AQUI ES SPEC - habra que pasar las posiciones por parametro

    // this.p('arqdru_Before_generate_gcomm')
    // Aqui tenemos el problema. Lo perdemos todo

    // this.p('comm_model_BEFORE_WRONG_LANG _Starting langs an22' + '  ' + this.arroba.s.ms.lang )
   
    // this.p('comm_model_BEFORE_WRONG_LANG _Starting to manage spec an22' +  '   '  + this.s.ms.spec_positions )
    // Carga Multiples posiciones

    this.gcomm    =  new arroba_mcomm(this.arroba , this.s.ms.spec_positions)        

    // Hay que averiguar donde lo hemos puesto content - Desde luego esta mal

    // Social Articles
    // this.p('warmod_bef_For A ' + this.arroba.s.ms.lang +  '  '  +  this.gcomm.a.getkey( 'en' , 'i012v000' , 0 ) )

    // this.p('comm_mod_LANG_A5  ' + this.gcomm.arroba.s.ms.lang)

    this.arroba.copy( this.gcomm)

    // this.p('comm_mod_LANG_A6  ' + this.arroba.s.ms.lang)

    // this.p('warmod_bef_For B ' + this.arroba.s.ms.lang +  '  '  +  this.arroba.a.getkey( 'en' , 'i012v000' , 0 ) )
  }

//-------------------------------------------------------------------------------------

  run_spec_model() 
  {

    this.m               = 'run_spec_model'

    // this.p('Before_to_call To Specjson' )      
    this.specjson.rungen()
    // Create jnodetype - rungen_json

    // Checking arroba content
    // this.arroba.arr = this.specjson.a.arr
    
    this.arroba.s.ms.j_spec_path         = this.specjson.s.cs.cache_path
    this.arroba.s.ms.j_spec_url          = this.uspc.s.cs.http_domainbar + this.specjson.s.cs.cache_url


  } 

} // end Class

exports.common_model = common_model
