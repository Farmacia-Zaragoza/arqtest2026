    this.index        =   this.arr[this.s.ms.main_lang]['dmain'][this.pos]

    // jn20_cat articles
    // this.p('jn20_cat ' + this.cat)

    // this.k.save_header(this.cat)      

    // Esta ya generandose el fichero. Aqui habria que igual filtrar las palabras de busqueda primero

    
    // De momento no es un JSON

