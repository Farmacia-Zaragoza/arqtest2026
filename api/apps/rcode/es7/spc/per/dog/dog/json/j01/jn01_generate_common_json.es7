var     cons                         =   require(  "/brqx/rcode/es7/com/agen/constants.es7"            );

const   { jn02_process_site }   =   require(  cons.JS_PER7  + 'dog/dog/json/j02/jn02_jnode_process_site.es7' )

class jn01_common_json extends jn02_process_site {
           
  constructor (arroba = '' ) 
  {   
    super(arroba)
    
    this.n                  =   'common_json::'
  }

  //---------------------------------------------------------------------------------------------
  process_array_and_generate_json_file()
  {
    this.m                  =   'process_json'

    // this.p('jn01-Generating_NO_LLEGA ' + this.j.full_path + ' Lang ' + this.s.ms.main_lang )

    this.j.save_top()      

    // A.SITE            -- > 0  

    this.generate_common_site_sep()

    // B.REGIONS         -- > 2

    this.generate_common_regions_sep()

    // C.SYMBOLS         -- > 4

    this.generate_common_symbols_sep()

    // D.LANGS           -- > 5

    this.generate_common_langs_sep()

    // E.DIAMOND LANGS   -- > 15
    // Is a simple diamond 

    this.generate_common_langs_sep(15)

    // F.COOKIES         -- > 16
    this.generate_common_cookies()

      // this.p('Grabando Final')
