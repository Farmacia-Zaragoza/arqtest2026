// Methods:
//-------------------------------------------------------------------------------------
//- d-create_jnode_type-       : Genera el objeto Jonde Type
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { arroba_jtype_comm } =   require(  path.join(JS_ACO7, 'json/j03/j01_arroba_jtype_comm.es7')),
       { jnode_type }        =   require(  path.join(JS_PYC7, 'war/war/json/j02/jn01_jnode_type.es7')),
	     gfc  			           =   require(  path.join(JS_LIB7, 'file/get_file_code.es7'));


class arroba_jtype_war extends arroba_jtype_comm {
  constructor(    arroba           ,
                  passed_type = 'comm' )
  {
    super(arroba, passed_type)
    this.n                  =   "arroba_jtype_war::"
  }

  //---------------------------------------------------------------------------------------------

  // Con conetent siempre debe generarse
  create_jnode_type_content()
  {
    this.m                  =   "create_jnode_type_content"
    // Generate Cache path
    this.gen()

    this.m                  =   "create_jnode_type_content"

    // /brqx/pers/cache/war/uritype/comm/policy/nohuman/nouser/nocode/notrans/nosync/
    //  es_position_6_json.json
    // this.p('j01_arroba_gencont ' + this.s.cs.cache_path )

      // GENERAMOS JNODE
      // this.p('j02_JnodeNotCAche')
    // Con content se genera siempre

    this.jtype            =   new jnode_type( this.arroba      )

    this.jtype.manage_switch_page_type()
  }


  //---------------------------------------------------------------------------------------------

  create_jnode_type()
  {
    this.m                  =   "create_jnode_type"
    // Generate Cache path
    this.gen()

    this.m                  =   "create_jnode_type"

    // /brqx/pers/cache/war/uritype/comm/policy/nohuman/nouser/nocode/notrans/nosync/
    //  es_position_6_json.json
    // this.p('j01_arroba_gen ' + this.s.cs.cache_path )

      // GENERAMOS JNODE
      // this.p('j02_JnodeNotCAche')
    // Se debe generar si no hay cache ( correcto)
    // Se debe generar si no existe el fichero o tiene un size no adecuado o el directorio ( esta fallando )

    if (!this.b.cache || gfc.zero(this.s.cs.cache_path) )
    {
      // this.p('j01_arroba_type_Debe entrar aqui')
      this.jtype            =   new jnode_type( this.arroba      )
      this.jtype.manage_switch_page_type()

    }
  }
}

exports.arroba_jtype_war = arroba_jtype_war
