// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { war_no_cache }    =   require(  path.join(JS_PYC7, 'war/war/model/war_nocache_launcher.es7') ),
        { war_cache }       =   require(  path.join(JS_PYC7, 'war/war/model/war_cache_launcher.es7'),
        { printlog }        =   require(  path.join(JS_TYP7, 'logs/printlog.es7'));

class war extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                =  'war::'

    if (pmt.cache)      this.model          = new war_cache(    pmt  )
    else                this.model          = new war_no_cache( pmt  )
  }

} // end Class

exports.war = war
