define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { common_html } 			= 	require(path.join(JS_ACO7, 'html/h01/main/common_html.es7'))
		const { hea01_head_war } = require(path.join(JS_PYC7, 'war/war/html/h01/main/hea01_war.es7'))
		const { bdy01_body_war } = require(path.join(JS_PYC7, 'war/war/html/h01/main/bdy01_war.es7'))

class htm01_html_war extends common_html  {

    constructor (     container						)
	{
    	super(				container	)

        this.n                  =   "htm01_html_war::"
    }

	//<head>
    create_head()
    {
		// External Head
		this.head_01	=
				new hea01_head_war(this.container)	// Drupal theme structure

//		this.content			+=  '<HEAD>HOLA</HEAD>' //this.head_01.code
		this.code			+=  this.head_01.code
			}

    create_body()
    {
		// External Div
		this.body_01	=
				new bdy01_body_war( this.container )	// Drupal theme structure

//		this.content			+=  '<BODY>HOLA</BODY>'  //this.body_01.code
		this.code				+=  this.body_01.code
	}
}

exports.htm01_html_war = htm01_html_war

