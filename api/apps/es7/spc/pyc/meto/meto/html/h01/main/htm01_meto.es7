const { JS_TYP7  } = require(path.join(process.cwd(),'api/apps/paths.js'));

const  { common_html } 			= 	require(	cons.JS_ACO7 + 'html/h01/main/common_html.es7'			      ),
		{ hea01_head_meto }	= 	require(	cons.JS_PYC7 + 'meto/meto/html/h01/main/hea01_meto.es7'		),
		{ bdy01_body_meto }	= 	require(	cons.JS_PYC7 + 'meto/meto/html/h01/main/bdy01_meto.es7'		);


class htm01_html_meto extends common_html  {

    constructor (     container						)
	{
    	super(				container	)

        this.n                  =   "htm01_html_meto::"
    }

	//<head>
    create_head()
    {
		// External Head
		this.head_01	=
				new hea01_head_meto(this.container)	// Drupal theme structure

//		this.content			+=  '<HEAD>HOLA</HEAD>' //this.head_01.code
		this.code			+=  this.head_01.code
			}

    create_body()
    {
		// External Div
		this.body_01	=
				new bdy01_body_meto( this.container )	// Drupal theme structure

//		this.content			+=  '<BODY>HOLA</BODY>'  //this.body_01.code
		this.code				+=  this.body_01.code
	}


}

exports.htm01_html_meto = htm01_html_meto
