var   cons                  =   require(  "/brqx/rcode/es7/com/agen/constants.es7"         )

const 	{ typejson_array }	= 	require(	cons.JS_OBJ     + 'json/typejson_array.es6'						);

class arrjson_site extends typejson_array {
	constructor(file_name = '') 
	{
		super(file_name)
		
		this.n 				= 	"arrjson_site ::"
	}


	managespecifictype(part = false)
	{

	   switch(this.type){

			case "search":
				this.add_index(					this.index		)
				this.add_type(					this.type		)
				this.add_element( 		'name' , this.hover	)		
				// this.add_element( 		'hover' , this.hover	)		
				if (part)
					this.add_element( 	'clink'	, this.link		)
				else
					this.add_lastelement( 	'clink'	, this.link		)
				
				break;

			default:
				this.managecommontype(part)
		}
	}

}


exports.arrjson_site  = arrjson_site 