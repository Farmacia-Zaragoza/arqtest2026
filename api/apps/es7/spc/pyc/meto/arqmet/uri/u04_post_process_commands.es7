const { JS_TYP7  } = require(path.join(process.cwd(),'api/apps/paths.js'));

const { site_sure_commands } =   require( cons.JS_PYC7 + 'meto/arqmet/uri/u05_sure_commands.es7' )


class post_process_commands extends site_sure_commands
{
  constructor(site = '' , ir = '' )
  {
    super(  site, ir )
    this.n                  =   "post_process_commands::"
  }


//---------------------------------------------------------------------------------------------
  // This method depends of site
  post_process_commands()
  {

     this.m                    = 'manage_commands'

     // this.p('u02_sc_Comando para analizar: ' + this.page_command)

     switch(this.page_command)
     {
      // Specific Post Process
      case "specificforpage":
        this.b.page_product       =   true
        this.s.cs.page_name       =   'product'
        break;

      default:

        this.post_process_common_commands()
    }

  }

} // end Class

exports.post_process_commands = post_process_commands
