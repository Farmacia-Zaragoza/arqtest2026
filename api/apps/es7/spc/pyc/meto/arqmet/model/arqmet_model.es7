// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { arqmet_no_cache } =  require(path.join(JS_PYC7, 'meto/arqmet/model/arqmet_nocache_launcher.es7'))
        const { arqmet_cache } = require(path.join(JS_PYC7, 'meto/arqmet/model/arqmet_cache_launcher.es7'))
        const { printlog } = require(path.join(JS_TYP7, 'logs/printlog.es7'))

class arqmet extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                 =  'arqmet::'

    if (pmt.cache)
      this.model           = new arqmet_cache(    pmt  )
    else
      this.model           = new arqmet_no_cache( pmt  )
  }

} // end Class

exports.arqmet = arqmet

