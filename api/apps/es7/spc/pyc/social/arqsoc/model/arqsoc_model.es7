// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { arqsoc_no_cache } =  require(  path.join(JS_PYC7, 'social/arqsoc/model/arqsoc_nocache_launcher.es7'),
        const { arqsoc_cache }   =  require(  path.join(JS_PYC7, 'social/arqsoc/model/arqsoc_cache_launcher.es7')  ),
        const { printlog }       =  require(  path.join(JS_TYP7, 'logs/printlog.es7'));

class arqsoc extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                 =  'arqsoc::'

    if (pmt.cache)
      this.model           = new arqsoc_cache(    pmt  )
    else
      this.model           = new arqsoc_no_cache( pmt  )
  }

} // end Class

exports.arqsoc = arqsoc
