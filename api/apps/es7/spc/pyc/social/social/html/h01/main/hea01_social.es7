const  { common_head } 			= 	require(path.join(JS_ACO7, 'html/h01/main/common_head.es7'))
        const { lnk01_link_social } = require(path.join(JS_PYC7, 'social/social/html/h01/main/lnk01_link_social.es7'))
        const { met01_meta_social } = require(path.join(JS_PYC7, 'social/social/html/h01/main/met01_meta_social.es7'))

class hea01_head_social extends common_head  {

  constructor (     arroba                )
  {

    super(          arroba  )

    this.n              =  'hea01_head::'

  }

  //   <div id="logo">
  create_metas()
  {
    // External Metas

    this.meta_01          =  new met01_meta_social( this.arroba  )

    this.content          +=  this.meta_01.code
  }

  create_links()
  {
    // External links
      this.link_01          =  new lnk01_link_social(this.arroba)

    this.content          +=  this.link_01.code
  }

}

exports.hea01_head_social = hea01_head_social

