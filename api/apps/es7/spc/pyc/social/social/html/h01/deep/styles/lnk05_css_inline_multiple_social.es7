define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const 	{ getset } 			= 	require(	path.join(JS_BASE, 'com/objects/html/getset.es6'));
		const { html_style } 		= 	require(	path.join(JS_BASE, 'com/objects/html/html_style.es6'));
		scpf				= 	require( 	path.join(JS_BASE, 'com/libs/file/full_path/level_02/save_code_properties_filename.es6'));


class lnk05_css_inline_social extends getset  {

    constructor (     thm	              						)
    {

		let 	tag_name				=	'style'
		super( tag_name )

		this.n							=	'lnk05_css_inline_social::'
		this.m							=	'constructor'

		this.thm						=	thm

		this.link_code_path				=	''

		this.lnk01						=	new html_style('style')

 		this.lnk01.charset				=	"utf-8"
 		this.lnk01.type					=	"text/css"

		this.build_data()

    }


	// <link rel="stylesheet" href="fontawesome_v57_min.css"></head>
    create_fontawesome()
    {

		let css_name 					=	'fontawesome_v57_min.css'

		this.link_code_path				=
				this.thm.s.ms.site_path + '/fassets/css/' + css_name

		this.p('SITE_PATH ' + this.link_code_path )

		this.lnk01.content				=	scpf.file_get_code(this.link_code_path)
		this.lnk01.pcreate()

		// this.p ('CHECK_STYLE_01 ' + this.lnk01.code)

		this.code						+=	this.lnk01.code

	}


	// <link rel="stylesheet" href="styles.821fc87c884b09994238.css"></head>
    create_style()
    {

		let css_name 					=	'styles.css'

		this.link_code_path				=
				this.thm.s.ms.site_path + '/dev/' + css_name

		this.p('SITE_PATH ' + this.link_code_path )

		this.lnk01.content				=	scpf.file_get_code(this.link_code_path)
		this.lnk01.pcreate()

		// this.p ('CHECK_STYLE_01 ' + this.lnk01.code)

		this.code						+=	this.lnk01.code

	}

    create_theme()
    {

		let css_name 					=	'theme.css'

		this.link_code_path				=
				this.thm.s.ms.site_path + '/dev/assets/' + css_name

		this.p('SITE_PATH ' + this.link_code_path )

		this.lnk01.content				=	scpf.file_get_code(this.link_code_path)
		this.lnk01.pcreate()

		// this.p ('CHECK_STYLE_01 ' + this.lnk01.code)

		this.code						+=	this.lnk01.code

	}

    build_data()
    {

		// this.create_googlefonts()

		this.create_fontawesome()

		this.create_theme()

		this.create_style()

		// Ok [17-11-02]
		// this.p('Code : >' + this.code )

    }

}

exports.lnk05_css_inline_social = lnk05_css_inline_social
