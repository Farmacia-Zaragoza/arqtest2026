define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const { post_process_commands } =   require(path.join(JS_PYC7, 'social/social/uri/u04_post_process_commands.es7'))


class site_uri_manage_commands extends post_process_commands
{
  constructor(site = '' , ir = '' )
  {
    super(  site, ir )
    this.n                  =   "site_uri_manage_commands::"
  }

// architect/ricardocabellotorres  -> article XX
//---------------------------------------------------------------------------------------------
  // This method depends of site
  manage_commands()
  {

     this.m                    = 'manage_commands'

     this.start_position_array       =   this.start_position_array + 1

     // this.p('u02_Comando para analizar A: ' + this.page_command      )

     this.manage_common_commands()

    // this.p('u02_AFTER page_name: ' + this.s.cs.page_name)

    // Manage and sort arguments
    // Hasta este punto no se conoce dash_sub_query
    this.process_commands()

    this.m                    = 'manage_commands'

    // this.p('u02_b_sc_page_name: ' + this.page_name)

    // Aqui ya se ha generado la uri en su totalidad
    this.post_process_commands()

    // this.p('u01_site_uri_Comando para analizar B: ' + this.page_command + ' ' + this.slash_sub_query)


    // This method will assure command is right for page
    this.sure_commands()

    // this.p('u02_c_sc_page_name: ' + this.page_name)

  }

} // end Class

exports.site_uri_manage_commands = site_uri_manage_commands
