define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { tjson_comm }          =   require(  path.join(JS_ACO7, 'json/j04/comm/j02_tjson_comm.es7'),
        { theme_react }         =   require(  path.join(JS_ACO7, 'html/h04/h02_theme_react.es7'),
        { arroba_jtype_social } =   require(  path.join(JS_PYC7, 'social/social/json/j03/j01_arroba_type.es7'));

class theme_json extends tjson_comm
{
  constructor(arroba = '')
  {
    super(arroba)
    this.n                  =   "theme_json::"

    // this.p('j02_thmjson_HERE_Page_type ' + this.arroba.s.cs.page_type )

    this.jcontent           =   new arroba_jtype_social(this.arroba , 'content')

    this.manage_index_json_page()

    this.generate_content_json()

    // Aqui podemos ajustar el contenido para hacer un listado con las busquedas

    // Con cache , aun no se ha generado la arroba
    this.thmhtml            =   new theme_react(this.arroba)

    this.code               =   this.thmhtml.code

  }

} // end Class

exports.theme_json = theme_json
