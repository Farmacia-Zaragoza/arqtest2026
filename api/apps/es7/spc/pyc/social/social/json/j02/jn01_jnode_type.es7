global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			);

const _mod_safe_1 = require(path.join(global.JS_ACO7, 'json/j02/jn01_jnode_type_comm.es7'); const jnode_type_comm = _mod_safe_1.jnode_type_comm || _mod_safe_1;)
       const _mod_safe_2 = require(path.join(global.JS_ACO7, 'json/j01/n02_social/jn01_generate_common_json.es7'); const jn01_common_json = _mod_safe_2.jn01_common_json || _mod_safe_2;)
       const _mod_safe_3 = require(path.join(global.JS_ACO7, 'json/j01/n02_social/jn11_generate_spec_json.es7'); const jn11_spec_json = _mod_safe_3.jn11_spec_json || _mod_safe_3;)
       const _mod_safe_4 = require(path.join(global.JS_ACO7, 'json/j01/n02_social/jn03_generate_product_json.es7'); const jn03_product_social_json = _mod_safe_4.jn03_product_social_json || _mod_safe_4;)

class jnode_type extends jnode_type_comm {

  constructor (arroba = '')
  {
    super(arroba)
    this.n                  =   'jn01_jnode_type::'

    // Print PATH for JSONS ( Comm - Spec )
    // this.p('jn01_type_Page ' + this.s.cs.page_type + ' Pt ' + this.s.cs.cache_path)
  }

  manage_switch_page_type()
  {

    // Print PATH for JSONS ( Comm - Spec )
    this.p('jn01_type_Page ' + this.s.cs.page_type + ' Pt ' + this.s.cs.cache_path)
    this.p('jn01_type_PageName ' + this.s.cs.page_name)

    switch(this.s.cs.page_type)
    {
      case "spec"   : this.jobject          =   new jn11_spec_json(this.arroba)   ;      break;
      case "comm"   : this.jobject          =   new jn01_common_json(this.arroba) ;      break;
      case "content": this.manage_switch_page_name() ;          break;
    }
  }

  manage_switch_page_name()
  {

    this.p('jn01_jnosocial name DBG ' + this.s.cs.page_name)
    switch(this.s.cs.page_name)
    {
      case "product":  this.jobject   =   new jn03_product_social_json(this.arroba) ;  break;

      case "front":    this.jobject   =   new jn03_product_social_json(this.arroba) ;  break;

      // case "list":     this.jobject   =   new jn06_list_json(this.arroba) ;  break;

      default:
        this.manage_switch_page_name_common()

    }

  }

}

exports.jnode_type = jnode_type


module.exports = jnode_type;
module.exports.jnode_type = jnode_type;
