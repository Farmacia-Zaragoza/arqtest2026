class site_model extends common_model
{
  constructor(pmt = '' )
  {
    super(  pmt )
    this.n                =  'site_model::'
  }

  run_site()
  {

    // Generate common json file
    this.commjson         =   new arroba_jtype_social(this.acomm  ,'comm')
    this.run_comm_model()

    // Generate spec json file
    this.specjson         =   new arroba_jtype_social(this.arroba , 'spec')
    this.run_spec_model()

    // Intenta el idiomja actual pero como no existe carga el ingles
    // Necesitamos que se genere el idioma por defecto tambien
    // this.p('ark_model_First Alias**JA ' + this.specjson.gethash_keylang( 'i000v005' , 1 ) )

    // Aqui lo que hay que hacer es ver si es front page
    // Solo en este caso tiene sentido mirar alias
    // El problema va a venir con la cache

    // this.p('ardru_tras_spec_antes ' + this.b.page_could_be_alias)

    if (this.b.page_could_be_alias)
    {
      this.uspc.manage_lang_aliases(this.arroba)
    }

    // La conocemos
    // this.p('Arq_tras_spec Old Uri ' + this.arroba.u.uri  )
    // En este punto si es un alias conocido no del idioma actual
    // se debera cargar dicho alias y generar la url correspondiente

    // this.p('arq_model_page C ' + this.arroba.s.cs.page +  ' Lang ' + this.arroba.s.cs.lang )

    this.thmdata          =   new theme_data(this.arroba)

    this.code             =   this.thmdata.code

  }

} // end Class

exports.site_model = site_model


module.exports = site_model;
module.exports.site_model = site_model;
