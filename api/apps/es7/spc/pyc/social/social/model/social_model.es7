// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			);

const   { social_no_cache } =   require(path.join(global.JS_PYC7, 'social/social/model/social_nocache_launcher.es7'))
        const { social_cache } = require(path.join(global.JS_PYC7, 'social/social/model/social_cache_launcher.es7'))
        const { printlog } = require(path.join(global.JS_TYP7, 'logs/printlog.es7'))

class social extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                =  'social::'

    if (pmt.cache)      this.model          = new social_cache(    pmt  )
    else                this.model          = new social_no_cache( pmt  )
  }

}

exports.social = social

