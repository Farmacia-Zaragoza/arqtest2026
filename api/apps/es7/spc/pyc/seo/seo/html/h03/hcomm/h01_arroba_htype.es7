const { JS_TYP7  } = require(path.join(process.cwd(),'api/apps/paths.js'));

const  { hcomm_struc }      =   require(  cons.JS_PYC7  + 'seo/seo/html/h03/hcomm/h02_struc.es7')

class arroba_htype extends hcomm_struc {
  constructor(    container  )
  {
    super()

    this.n                  =   "arroba_hcomm::"
    this.m                  =   "cons"

    // arrobasite pasado
    this.container          =   container

    this.s					=   this.container.s
    this.b					=   this.container.b

    this.htype              =   ''

    // common type
    this.s.cs.uri           =   'uritype'

    this.s.cs.comm          =   'comm'

    // Are html auto generated
    this.s.cs.sub           =   'hdata'
    this.s.cs.ext           =  'hdata'

    this.s.b.type_ssl       =   true

    // this.p('s01_passsed_type ' + this.s.t_sub)

    // Generate Cache path
    this.gen()

    // Genera ficheros de control
    this.generate_cache_summary_structure()

    // Genera pagina html
    this.run_cache_to_generate_html()

  }

}

exports.arroba_htype = arroba_htype
