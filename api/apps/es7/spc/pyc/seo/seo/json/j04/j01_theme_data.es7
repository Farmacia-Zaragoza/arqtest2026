var     cons                =   require(  "/brqx/rcode/es7/com/agen/constants.es7"        )

const  { tdata_comm }       =   require(  cons.JS_ACO7  + 'json/j04/comm/j01_tdata_comm.es7'  ),
       { theme_json }       =   require(  cons.JS_PYC7  + 'seo/seo/json/j04/j02_theme_json.es7'  ) ;

class theme_data extends tdata_comm
{
  constructor(arroba = '')
  {
    super(arroba)
    this.n                  =   "theme_data::"

    this.manage_index_data_page()
   
     
    this.thmjson            =  new theme_json(this.acontent.arroba)

    this.code               =  this.thmjson.code

  } 

} // end Class

exports.theme_data = theme_data