//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
//-------------------------------------------------------------------------------------
// Used Entities :
//-------------------------------------------------------------------------------------
// Json_function     : Generate Json Functions
//-------------------------------------------------------------------------------------
// jn01_common_json - jn11_spec_json - jn03_product_json
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
