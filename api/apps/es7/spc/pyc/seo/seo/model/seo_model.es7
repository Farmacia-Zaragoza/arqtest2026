// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { seo_no_cache }    =   require(  path.join(JS_PYC7, 'seo/seo/model/seo_nocache_launcher.es7') ),
        { seo_cache }       =   require(  path.join(JS_PYC7, 'seo/seo/model/seo_cache_launcher.es7')),
        { printlog }        =   require(  path.join(JS_TYP7, 'logs/printlog.es7'));

class seo extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                =  'seo::'

    if (pmt.cache)      this.model          = new seo_cache(    pmt  )
    else                this.model          = new seo_no_cache( pmt  )
  }

} // end Class

exports.seo = seo
