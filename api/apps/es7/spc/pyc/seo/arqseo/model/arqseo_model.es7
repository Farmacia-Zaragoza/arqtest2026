// Must to be unique

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { arqseo_no_cache } =  require(path.join(JS_PYC7, 'seo/arqseo/model/arqseo_nocache_launcher.es7'))
        const { arqseo_cache } = require(path.join(JS_PYC7, 'seo/arqseo/model/arqseo_cache_launcher.es7'))
        const { printlog } = require(path.join(JS_TYP7, 'logs/printlog.es7'))

class arqseo extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                 =  'arqseo::'

    if (pmt.cache)
      this.model           = new arqseo_cache(    pmt  )
    else
      this.model           = new arqseo_no_cache( pmt  )
  }

} // end Class

exports.arqseo = arqseo

