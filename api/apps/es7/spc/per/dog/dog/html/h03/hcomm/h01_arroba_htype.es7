define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			)))

const  { hcomm_struc }      =   require(  path.join(JS_PER7, 'dog/dog/html/h03/hcomm/h02_struc.es7'))),
       { cache_site }       =   require(  path.join(JS_TYP7, 'site/s10_cache_site.es7'))),
        fs 					= require(	'fs'																						),
		scpf 				= require(  path.join(JS_BASE, 'com/libs/file/full_path/level_02/save_code_properties_filename.es6')));

class arroba_htype extends hcomm_struc {
  constructor(    container  )
  {
    super()

    this.n                  =   "arroba_hcomm::"
    this.m                  =   "cons"

    // arrobasite pasado
    this.container          =   container

    this.s					=   this.container.s
    this.b					=   this.container.b

    this.htype              =   ''

    // common type
    this.s.cs.uri           =   'uritype'

    this.s.cs.comm          =   'comm'

    // Are html auto generated
    this.s.cs.sub           =   'hdata'
    this.s.cs.ext           =  'hdata'

    this.s.b.type_ssl    = true

    // this.p('s01_passsed_type ' + this.s.t_sub)

    // Generate Cache path
    this.gen()

    this.generate_cache_summary_structure()

    this.run_cache_to_generate_html()

    // No se genera sumario si se ejecutan los jsons
    // Lod jsons deben ser accesibles

  }

}

exports.arroba_htype = arroba_htype
