// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { site_model }    =   require(path.join(JS_PER7, 'dog/dog/model/site_model.es7'))
        const { site_uri } = require(path.join(JS_ACO7, 'uri/n02/u01_site_uri.es7'))
        const { site_mcomm } = require(path.join(JS_TYF7, 'a01_load/mcomm/m02_site_comm.es7'))

class dog_no_cache extends site_model
{
  constructor(pmt = '' )
  {

    super(  pmt )

    this.n                =  'dog_no_cache::'

    var pos = this.strpos(this.ir.uri, "rest")

    if (pos !== false)
    {
      // creo que runreste es comun a cualquiera
      this.p('nocache_launcher - rest call')
      this.run_rest()
    }
    else
      this.run_method()
  }

  //---------------------------------------------------------------------------------------------

  run_method()
  {

	// Necesito mejorar el modelo. El sistema de cache no es optimo
	// Necesito crear un sistema que sea capaz de encontrar el tipo de pagina

    //1. Multi Position EN - Por defecto 0 2 5
    // Specific final comm : '0 2 4 5 11 12 14 15 16'
    this.comm              =  new site_mcomm(this.s, this.s.ms.comm_positions)
    this.copy_model()

    // Aqui ya lo conoce
    // this.p('arq_model_page X0 ' + this.comm.s.cs.page +  ' Lang ' + this.comm.s.cs.lang )

    //2. URI SPECIFIC VERSION FOR ARQDRU - WILL MANAGE REAL COMMANDS
    // Usando fast uri no funciona
    this.uspc             =   new site_uri( this.comm.s   ,
                                              this.ir       )

    // Copiamos el dominio para generar los robot
    // No copiamos nada más para mantener intacta la estructura comun
    this.acomm.s.cs.http_domainbar = this.comm.s.cs.http_domainbar

    this.run_site()

  }

} // end Class

exports.dog_no_cache = dog_no_cache
