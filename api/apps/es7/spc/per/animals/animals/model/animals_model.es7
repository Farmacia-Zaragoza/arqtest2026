// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

var     cons                =   require(  "/brqx/rcode/es7/com/agen/constants.es7"         )

const   { animals_no_cache } =   require(  cons.JS_PER7  + 'animals/animals/model/animals_nocache_launcher.es7' ),
        { animals_cache }    =   require(  cons.JS_PER7  + 'animals/animals/model/animals_cache_launcher.es7'),
        { printlog }         =   require(  cons.JS_TYP7  + 'logs/printlog.es7'                       );

class animals extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                =  'animals::'

    if (pmt.cache)      this.model          = new animals_cache(    pmt  )
    else                this.model          = new animals_no_cache( pmt  )
  } 

} // end Class

exports.animals = animals
