// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { animals_no_cache } =   require(  path.join(JS_PER7, 'animals/animals/model/animals_nocache_launcher.es7') ),
        { animals_cache }    =   require(  path.join(JS_PER7, 'animals/animals/model/animals_cache_launcher.es7')),
        { printlog }         =   require(  path.join(JS_TYP7, 'logs/printlog.es7'));

class animals extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                =  'animals::'

    if (pmt.cache)      this.model          = new animals_cache(    pmt  )
    else                this.model          = new animals_no_cache( pmt  )
  }

} // end Class

exports.animals = animals
