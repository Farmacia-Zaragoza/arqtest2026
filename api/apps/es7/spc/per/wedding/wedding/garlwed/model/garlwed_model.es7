// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const { garlwed_no_cache } = require(  path.join(JS_PER7, 'wedding/garlwed/model/garlwed_nocache_launcher.es7')),
      { garlwed_cache }    = require(  path.join(JS_PER7, 'wedding/garlwed/model/garlwed_cache_launcher.es7')  ),
      { printlog }         = require(  path.join(JS_TYP7, 'logs/printlog.es7'));

class garlwed extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                 =  'garlwed::'

    if (pmt.cache)      this.model           = new garlwed_cache(    pmt  )
    else                this.model           = new garlwed_no_cache( pmt  )
  }

} // end Class

exports.garlwed = garlwed
