// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

const { JS_TYP7  } = require(path.join(process.cwd(),'api/apps/paths.js'));

const   { wedding_no_cache } =   require(  cons.JS_PER7  + 'wedding/wedding/model/wedding_nocache_launcher.es7' ),
        { wedding_cache }    =   require(  cons.JS_PER7  + 'wedding/wedding/model/wedding_cache_launcher.es7'),
        { printlog }         =   require(  cons.JS_TYP7  + 'logs/printlog.es7'                       );

class wedding extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                =  'wedding::'

    if (pmt.cache)      this.model          = new wedding_cache(    pmt  )
    else                this.model          = new wedding_no_cache( pmt  )
  }

} // end Class

exports.wedding = wedding
