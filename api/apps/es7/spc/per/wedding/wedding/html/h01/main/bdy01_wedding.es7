define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const 	{ html_style } 		 = 	require(	path.join(JS_BASE, 'com/objects/html/html_style.es6'));
		const { svg_style } 		 = 	require(	path.join(JS_BASE, 'com/objects/html/svg_style.es6'));
		const { scr01_js_wedding } = 	require(	path.join(JS_PER7, 'wedding/wedding/html/h01/main/scr01_js_wedding.es7'));
		const { ifnojs }	 		 = 	require(	path.join(JS_BASE, 'com/objects/html/ifnojs.es6'));
		minify 				 = 	require(	'html-minifier'									).minify;


class bdy01_body_wedding extends html_style  {

    constructor (     container						)
    {
		let tag_type					=	'body'
		super(tag_type)

		this.n							=	'bdy_wedding::'
        this.tag_type     				= 	'body'


		this.container					=	container
		this.s                          =   container.s
		this.u                          =   container.u


		// Tenemos que tener como un mapa del site
		this.container.map					= 	'body/'


		// Common Json
		this.line_comm					=	this.container.s.ms.j_comm_line
		this.line_spec					=	this.container.s.ms.j_spec_line
		this.line_cont 				    =	this.container.s.ms.j_cont_line

        // Switch para las paginas del chequeo de los jsons
        this.only_json_page             =   this.container.s.b.only_json_page

		this.result_comm				=	this.container.s.ms.j_comm_ck
		this.result_spec				=	this.container.s.ms.j_spec_ck
		this.result_cont 				=	this.container.s.ms.j_cont_ck

		this.jpath_comm	   	       		=	this.container.s.ms.j_comm_url
		this.jpath_spec				    =	this.container.s.ms.j_spec_url
		this.jpath_cont 				=	this.container.s.ms.j_cont_url

        this.div_01                     =   new html_style('div')

    	this.scripts_01					=	''

		this.ifnojs						=	new ifnojs()

		this.approot					=	new html_style('app-root')

		this.pmtscr						=	new html_style('script')

		// this.p('Domain Check SSL :'  + this.thm.u.http_domainbar)

		this.drift_code					=	this.container.s.os.drift

		// External object
		this.script_to_load				=	''

        //this.p('bdy_01_results ' + this.result_comm  + '  ' +  this.result_spec + '  ' +  this.result_cont )


        var jsons_ok                    =   this.result_comm && this.result_spec && this.result_cont

        // Sera false si hay que generar jsons
        if (jsons_ok && !this.only_json_page)
			this.build_data_ok()
		else
			this.build_json_wrongs()

    }


	//   <app-root></app-root>
	create_approot()
	{

		this.approot.content				=		''

		this.approot.pcreate()

		this.content					+=		this.approot.code
	}


  	create_div()
    {
		this.div_01.id					=	'root'

        // this.p('Bdy01_Loading_Data_Type ' + this.container.s.cs.page_name)

		this.div_01.data_type			=	this.container.s.cs.page_name


//		let common_json					=	'https://farma.vbrqx.com/ang/json/common.json'
//		let lang_common_json			=	'https://farma.vbrqx.com/ang/json/langs/en/common.json'

		this.div_01.data_comm		    =	this.jpath_comm

		this.div_01.data_spec 		    =	this.jpath_spec

		this.div_01.data_content 		=	this.jpath_cont


		// this.div_01.data_content 		=	this.jpath_cont

		this.div_01.pcreate()
		this.content					+=	this.div_01.code
	}


  	create_scripts()
    {
		// Here we have two options
		// Scripts links for dev environment
		// Script tag for live environment

  		this.scripts_01		=
  				new scr01_js_wedding(	this.container	)

		this.content			+=	this.scripts_01.code
	}

    // <!--[if lt IE 8]>
    //        <p class="weddingupgrade">You are using an <strong>outdated</strong> wedding. Please <a href="http://browsehappy.com/">upgrade your wedding</a> to improve your experience.</p>
    // <![endif]-.

  	create_ifnojs()
    {
		// External links
		this.ifnojs.ifno_complex_mode_02('8' , 'lt' , '<p class="garlandupgrade">You are using an <strong>outdated</strong> wedding. Please <a href="http://browsehappy.com/">upgrade your wedding</a> to improve your experience.</p>'  	)

		this.content 			+= 	this.ifnojs.code
	}



    build_json_wrongs()
    {
        this.p('bdy01_arq BUILDING WRON JSON' )

        this.div_01.content      = this.line_comm
        this.div_01.pcreate()
		this.content 			+= this.div_01.code

        this.div_01.content      = this.line_spec
        this.div_01.pcreate()
		this.content 			+= this.div_01.code

        this.div_01.content      = this.line_cont
        this.div_01.pcreate()
		this.content 			+= 	this.div_01.code

		this.pcreate()

        // this.p('bdy01_arq ' +  this.content)

    }

    build_data_ok()
    {
	// Structure
	// [FB] [CONTAINER] [SCRIPTS] [SERVER_FOOTER]
		this.content			=	''

		this.create_ifnojs()

		this.create_div()

		this.create_scripts()


		// FINISH BUCLE data-array content

		// Manage Json


		// PENDING

		this.pcreate()


		// Ok [18-02-02]
		// this.p('bdy01:cod ' + this.code)

		this.p('bdy01:codl_BODY ' + this.code.length)

    }

}

exports.bdy01_body_wedding = bdy01_body_wedding
