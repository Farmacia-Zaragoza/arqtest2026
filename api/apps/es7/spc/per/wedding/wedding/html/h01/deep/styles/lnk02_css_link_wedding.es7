define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const { getset } = require(path.join(JS_BASE, 'com/objects/html/getset.es6'))
	const { html_style } = require(path.join(JS_BASE, 'com/objects/html/html_style.es6'))

class lnk02_css_link_wedding extends getset {

	constructor(thm) {

		super()

		this.n = 'lnk02_css_as_link_wedding::'
		this.m = 'constructor'

		this.thm = thm

		this.link_01 = new html_style('link')

		this.link_02 = new html_style('link')

		this.build_data()

	}

	create_googlefonts() {

		this.link_01.rel = 'stylesheet'
		this.link_01.type 			= 'text/css'
		// this.link_01.as 			= 'style'

		let url_awesome = 'https://fonts.googleapis.com/css?family=Roboto:300,400,500'

		this.link_01.href = url_awesome

		// this.link_01.href				=
		//	this.thm.u.http_domainbar + 'r_cassets/libs/css/fontawesome/' + css_name

		this.link_01.pcreate()

		this.code += this.link_01.code
	}

	create_fontawesome() {
		let css_name = 'all.css'

		this.link_01.rel = 'stylesheet'
		this.link_01.type 			= 'text/css'
		this.link_01.as 			= 'style'

//		this.link_01.integrity		=
//			"sha384-lZN37f5QGtY3VHgisS14W3ExzMWZxybE1SJSEsQp9S+oqd12jhcu+A56Ebc1zFSJ"
//		this.link_01.crossorigin	=	'anonymous'

		let url_awesome = 'https://use.fontawesome.com/releases/v5.7.2/css/'

		this.link_01.href = url_awesome + css_name

		// this.link_01.href				=
		//	this.thm.u.http_domainbar + 'r_cassets/libs/css/fontawesome/' + css_name

		this.link_01.pcreate()

		this.code += this.link_01.code
	}

	create_bootstrap() {
		let css_name = 'bootstrap.min.css'

		this.link_01.rel = 'stylesheet'
		this.link_01.type 			= 	'text/css'
		// this.link_01.as 			= 	'style'
		this.link_01.crossorigin	=	'anonymous'
		this.link_01.integrity		=
				"sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T"

		let url_bootstrap = 'https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/'

		this.link_01.href =	url_bootstrap + css_name

		this.link_01.pcreate()

		this.code += this.link_01.code
	}

	// <link rel="stylesheet" href="styles.821fc87c884b09994238.css"></head>
	create_style() {

		// this.link_jquery.rel			 	=  'preload'

		// this.link_01.onload		 		=  	"this.rel='stylesheet'"

		this.link_02.type = 'text/css'
		// this.link_02.as = 'style'
		this.link_02.rel = 'stylesheet'

		let css_name = 'main.css'

		let path_pmt = 'dev/static/css/'

		this.link_02.href =
			this.thm.s.cs.http_domainbar + path_pmt + css_name

		this.link_02.pcreate()

		this.code += this.link_02.code
	}

	create_theme() {

		// this.link_jquery.rel			 	=  'preload'

		// this.link_01.onload		 		=  	"this.rel='stylesheet'"

		this.link_02.type = 'text/css'
		// this.link_02.as = 'style'
		this.link_02.rel = 'stylesheet'

		let css_name = 'theme.css'

		let path_pmt = 'dev/assets/'

		this.link_02.href =
			this.thm.s.cs.http_domainbar + path_pmt + css_name

		this.link_02.pcreate()

		this.code += this.link_02.code
	}

	build_data() {

		this.create_bootstrap()

		this.create_theme()

		this.create_style()

		// Ok [18-05-05]
		// this.p('Code_lnk02_link : >' + this.code )

	} // End method

} // End class

exports.lnk02_css_link_wedding = lnk02_css_link_wedding

