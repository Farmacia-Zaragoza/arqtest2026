// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { funcs_no_cache } =   require(  path.join(JS_ARQ7  , 'funcs/funcs/model/funcs_nocache_launcher.es7'),
        { funcs_cache }    =   require(  path.join(JS_ARQ7  ,'funcs/funcs/model/funcs_cache_launcher.es7'),
        { printlog }        =   require(  path.join(JS_TYP7  , 'logs/printlog.es7'                       ));

class funcs extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                 =  'funcs::'

    if (pmt.cache)
      this.model           = new funcs_cache(    pmt  )
    else
      this.model           = new funcs_no_cache( pmt  )
  }

} // end Class

exports.funcs = funcs
