        const { arrjson_site }             =   require(  path.join(JS_AQD7  , 'arqdru/json/j00/jn11_arrjson_site.es7'  ));

class jn02_process_site extends jn01_robot_process {

  constructor (arroba = '' )
  {
    super(arroba)
    this.n                  =   'jn02_process_site::'

    this.process_robot_page()

  }

  //---------------------------------------------------------------------------------------------

  generate_json_objects()
  {
    this.j                  =  new objjson_site(this.s.cs.cache_path)
    this.k                  =  new arrjson_site(this.s.cs.cache_path)
  }

}

exports.jn02_process_site = jn02_process_site
