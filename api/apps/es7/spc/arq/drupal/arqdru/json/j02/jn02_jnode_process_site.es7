define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { jn01_robot_process }       =   require(  path.join(JS_ACO7  , 'json/j02/jn01_jnode_robot_process.es7'));
