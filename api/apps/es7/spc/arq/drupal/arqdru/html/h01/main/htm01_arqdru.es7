const path = require('path');
global.JS_ACO7 = path.join(global.ROOT, 'api/apps/es7/spc/acomm/');

// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Node JS Html Div Class  [V.0.0.1]  (2018-08-05)
