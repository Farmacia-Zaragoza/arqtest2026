// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { arqdru_no_cache } =   require(  path.join(JS_AQD7  , 'arqdru/model/arqdru_nocache_launcher.es7'),
        { arqdru_cache }    =   require(  path.join(JS_AQD7  , 'arqdru/model/arqdru_cache_launcher.es7'),
        { printlog }        =   require(  path.join(JS_TYP7  , 'logs/printlog.es7'                      ));

class arqdru extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                =  'arqdru::'

    if (pmt.cache)        this.model          = new arqdru_cache(    pmt  )
    else                  this.model          = new arqdru_no_cache( pmt  )
  }
} // end Class

exports.arqdru = arqdru
