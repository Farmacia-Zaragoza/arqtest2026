class site_uri_manage_commands extends post_process_commands
{
  constructor(site = '' , ir = '' )
  {
    super(  site, ir )
    this.n                  =   "site_uri_manage_commands::"
  }

  //---------------------------------------------------------------------------------------------
  manage_commands()
  {

     this.m                    = 'manage_commands'

     this.start_position_array       =   this.start_position_array + 1

     // this.p('u02_Alias para analizar A: ' + this.page_command      )
     // La primera vez no va a conocer los alias
     // La siguiente si
     // Esto va a desaparecer pues se va a comprobar a nivel de estructura

        // llega blanc
     this.manage_common_commands()

     // this.p('u02_AFTER page_name: ' + this.s.cs.page_name)

     // aqui tiene que actuar

     // Solo se puede manejar una vez sino entramos en un bucle

     // Manage and sort arguments
