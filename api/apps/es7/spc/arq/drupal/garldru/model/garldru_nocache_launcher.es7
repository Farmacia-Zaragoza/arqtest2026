class garldru_no_cache extends site_model
{
  constructor(pmt = '' )
  {

    super(  pmt )

    this.n                =  'garldru_no_cache::'

    this.run_method()
  }

  run_method()
  {

    //1. Multi Position EN - Por defecto 0 2 5
    // Specific final comm - '0 2 4 5 15 16'
    this.comm              =  new site_mcomm(this.s, this.s.ms.comm_positions)
    this.copy_model()

    //2. URI SPECIFIC VERSION FOR ARQDRU - WILL MANAGE REAL COMMANDS
