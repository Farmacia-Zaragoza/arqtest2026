define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { site_model }      =   require(  path.join(JS_ARQ7  , 'kb/arqkb/model/site_model.es7'),
        { fast_uri }        =   require(  path.join(JS_ARQ7  , 'kb/arqkb/uri/u10_fast_uri.es7'),
        { site_mcomm }      =   require(  path.join(JS_TYF7  , 'a01_load/mcomm/m02_site_comm.es7'));

class arqkb_cache extends site_model
{
  constructor(pmt = '' )
  {
    super(  pmt )

    // this.pmt = new params()
    // this.pmt.copy (pmt)

    this.pmt = pmt

    this.n                =  'arqdru::'

	// Necesito mejorar el modelo. El sistema de cache no es optimo
	// Necesito crear un sistema que sea capaz de encontrar el tipo de pagina

    if (this.b.cache)
      this.uspc         = new fast_uri(this.s, this.ir)

    // this.p('arqdru_cache_Ready to choose : ' + this.b.cache )

    // Common Cache method
    this.cache_model()

  }

  //---------------------------------------------------------------------------------------------

  // NO CACHE CODE
  no_cache_launcher_code()
  {
      // NO CACHE CODE
      //-------------------------------------------------------------------------------------
      // Para mañana --> hay que saber los jsons que esta usando cada pagina
      // Si son accesibles y que contenido tiene

      //this.p('arq_che_page PASO_A01 ' + this.s.cs.page_type +  ' nAM ' + this.s.cs.page_name )

      this.comm              =  new site_mcomm(this.s, this.s.ms.comm_positions)

      //this.p('arq_che_page X02 ' + this.comm.s.cs.page_type +  ' nAM ' + this.comm.s.cs.page_name )
      this.copy_model()

      this.run_site()

  }

} // end Class

exports.arqkb_cache = arqkb_cache
