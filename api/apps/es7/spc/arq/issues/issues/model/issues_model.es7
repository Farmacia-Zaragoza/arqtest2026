// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { issues_no_cache } =   require(  path.join(JS_ARQ7  , 'issues/issues/model/issues_nocache_launcher.es7' ));
        const { issues_cache } = require(  path.join(JS_ARQ7  , 'issues/issues/model/issues_cache_launcher.es7'));
        const { printlog } = require(  path.join(JS_TYP7  , 'logs/printlog.es7'                       ));

class issues extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                 =  'issues::'

    if (pmt.cache)      this.model           = new issues_cache(    pmt  )
    else                this.model           = new issues_no_cache( pmt  )
  }

} // end Class

exports.issues = issues

