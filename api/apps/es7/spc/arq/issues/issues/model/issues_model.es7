//-------------------------------------------------------------------------------------
// Inheritance Line :
//-------------------------------------------------------------------------------------
// Site_Model > Printlog
// @Forker > @Log
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
//-------------------------------------------------------------------------------------
// Used Entities :
//-------------------------------------------------------------------------------------
// e-issues_no_cache-  : Arqdru no cache launcher
// e-issues_cache-     : Arqdru cache launcher
//-------------------------------------------------------------------------------------
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

const { JS_TYP7  } = require(path.join(process.cwd(),'api/apps/paths.js'));

const   { issues_no_cache } =   require(  cons.JS_ARQ7  + 'issues/issues/model/issues_nocache_launcher.es7' ),
        { issues_cache }    =   require(  cons.JS_ARQ7  + 'issues/issues/model/issues_cache_launcher.es7'),
        { printlog }        =   require(  cons.JS_TYP7  + 'logs/printlog.es7'                       );

class issues extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                 =  'issues::'

    if (pmt.cache)      this.model           = new issues_cache(    pmt  )
    else                this.model           = new issues_no_cache( pmt  )
  }

} // end Class

exports.issues = issues
