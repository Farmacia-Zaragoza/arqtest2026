define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { printlog }     =   require( path.join(JS_TYP7  , 'logs/printlog.es7'),
	   const { common_hnode } = 	require( path.join(JS_ACO7 , 'html/h01/main/comm/common_hnode.es7'),
       const { htm_angular }  =   require( path.join(JS_ACO7  , 'html/h01/main/ang/htm_angular.es7'  ));


class hnode_type_angular extends printlog {

  constructor (container = '')
  {
    super()
    this.n                   =   'hnode_type_angular::'

    this.container           =   container
    this.s                   =   this.container.s
    this.u                   =   this.container.u
    this.hobject             =   ''


    // this.p('jntype_Page ' + this.u.page_name + ' P ' + this.s.cache_path)

    // Print Hdata path
    // this.p('Hnode_Page Cache: ' + this.s.cs.cache_path)
    // this.p('Hnode_Page Alias: ' + this.s.cs.cache_alias)

    this.hnode               =   new common_hnode(this.container)


    // Aqui podemos gestionar los tipos rest
    // LLega indefinido - Aun no se esta gestionando

    // Transformamos el tipo de search en list para angular
    switch(this.hnode.s.cs.page_name)
    {
      // Special change to manage search  as a list
      case "search":
        this.hnode.s.cs.page_name = 'list'
        break;;
    }

    // Option to have equal space pages in our sites
    if (this.s.cs.page_format == "equal")
    {
        this.p('EqualPage')
        this.hnode.s.cs.page_name = 'e-' + this.hnode.s.cs.page_name

    }

    // Esta parte esta pendiente
    switch(this.s.page_type)
    {
        case "html":

          this.hobject          =   new htm_angular(this.hnode)
          break;

        case "rest":
          // this.p('jn01_type_Rest_generation')
          // this.h          =   new h02_rest(this.arroba)
          break;

        default:

          // this.p('Running_-_Html_-_arqdru')
          this.hobject          =   new htm_angular(this.hnode)
          break;

    }

    // Call to hnode
    this.hobject.process_and_generate_html_file()

    // this.p(this.hobject.code)

  }


}

exports.hnode_type_angular = hnode_type_angular
