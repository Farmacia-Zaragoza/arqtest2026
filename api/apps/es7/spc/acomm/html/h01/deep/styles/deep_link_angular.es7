class deep_link_angular extends deep_link_base {

  constructor(thm) {

	super(thm)
	this.n = 'deep_link_angular::'
  }


  build_data()
  {

    if (this.s.b.robot_page)
	  this.create_robot()
    else
    {
	  this.create_googlefonts()
	  this.create_fontawesome()

	  this.create_loading()

	  this.create_theme()

	  this.create_style('dev/','styles.css')
    }
