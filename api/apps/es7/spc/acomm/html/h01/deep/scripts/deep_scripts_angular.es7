const  { deep_scripts_base } =   require(  path.join(global.JS_ACO7 , 'html/h01/deep/scripts/deep_scripts_base.es7'   ) )


class deep_scripts_angular extends deep_scripts_base {

	constructor(thm) {

		super(thm)

		this.n = 'deep_scripts_angular::'
	}


	//[S_01] <script src="http://arqdru.vbrqx.com/dev/cassets/js/jquery-3.3.11.min.js"></script>
	//[S_01]<script src="https://code.jquery.com/jquery-3.3.11.min.js" integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8="
	//    crossorigin="anonymous"></script>

	create_jquery() {
		let js_name = 'jquery.min.js'

		// this.script_01.defer = 'defer'

		this.script_01.integrity	= 	"sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8="
		this.script_01.crossorigin	=	'anonymous'

		this.script_01.src =
			"https://code.jquery.com/jquery-3.3.1.min.js"
		// this.thm.u.http_domainbar + 'r_cassets/libs/js/jquery/' + js_name

		this.script_01.pcreate()

		this.code += this.script_01.code
	}

	//[S_02] <script type="text/javascript" src="polyfills.js"></script>
	create_es2015polyfills(path_pmt = 'dev/' , js_name = 'es2015-polyfills.js') {
		this.script_01.async = ''

		this.script_01.defer = ''

		this.script_01.integrity = ''

		this.script_01.crossorigin = ''

		this.script_01.nomodule 	= 'nomodule'

		this.script_01.src =
			this.thm.s.cs.http_domainbar + path_pmt + js_name

		this.script_01.pcreate()

		this.code += this.script_01.code
	}



	build_data(path_pmt = 'dev/')
	{
		this.create_jquery()

		this.create_common(path_pmt,'runtime.js')
		this.create_es2015polyfills(path_pmt)

		this.create_common(path_pmt,'polyfills.js')
		this.create_common(path_pmt,'scripts.js')

		this.create_common(path_pmt,'main.js')

		// Ok [18-06-17]
		// this.p('js_scripts_Code : >' + this.code )

	}

}

exports.deep_scripts_angular = deep_scripts_angular

