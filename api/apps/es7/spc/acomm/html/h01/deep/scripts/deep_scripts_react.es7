define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { deep_scripts_base } =   require(  path.join(JS_ACO7 , 'html/h01/deep/scripts/deep_scripts_base.es7'  ) )


class deep_scripts_react extends deep_scripts_base {

	constructor(thm) {

		super(thm)

		this.n = 'deep_scripts_react::'

	}


	//[S_01] <script src="http://social.vbrqx.com/dev/cassets/js/jquery-3.3.11.min.js"></script>
	//[S_01]<script src="https://code.jquery.com/jquery-3.3.11.min.js" integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8="
	//    crossorigin="anonymous"></script>

	create_jquery() {
		let js_name = 'jquery.min.js'

		// this.script_01.defer = 'defer'

		this.script_01.integrity	= 	"sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo"
		this.script_01.crossorigin	=	'anonymous'

		this.script_01.src =
			"https://code.jquery.com/jquery-3.3.1.slim.min.js"
		// this.thm.u.http_domainbar + 'r_cassets/libs/js/jquery/' + js_name

		this.script_01.pcreate()

		this.code += this.script_01.code
	}

    create_booklet_jquery(path_pmt             = 'dev/static/booklet/' ,
                                            js_name                = 'jquery-2.1.0.min.js' )
    {

        this.script_01.async = ''

		this.script_01.integrity = ''

		this.script_01.crossorigin = ''

		this.script_01.defer = ''

		this.script_01.src =
			this.thm.s.cs.http_domainbar + path_pmt + js_name

		this.script_01.pcreate()

		this.code += this.script_01.code
	}

    create_booklet_easing(path_pmt             = 'dev/static/booklet/' ,
                                            js_name                = 'jquery.easing.1.3.js' )
    {
      this.create_booklet_jquery(path_pmt, js_name)
    }

    create_booklet_latest(path_pmt             = 'dev/static/booklet/' ,
                                            js_name                = 'jquery.booklet.latest.min.js' )
    {
      this.create_booklet_jquery(path_pmt, js_name)
    }

    create_booklet_init(path_pmt             = 'dev/static/booklet/' ,
                                       js_name                = 'init.js' )
    {
      this.create_booklet_jquery(path_pmt, js_name)
    }

    create_seo_scripts()
    {
      this.create_booklet_jquery()
      this.create_booklet_easing()
      this.create_booklet_latest()
      this.create_booklet_init()
    }
	create_bootstrap() {
		let js_name = 'bootstrap.min.js'

		// this.script_01.defer = 'defer'

// 		this.script_01.integrity	= 	"sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM"
		this.script_01.crossorigin	=	'anonymous'

		this.script_01.src =
			"https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/" + js_name
		// this.thm.u.http_domainbar + 'r_cassets/libs/js/jquery/' + js_name

		this.script_01.pcreate()

		this.code += this.script_01.code
	}

	create_popper() {
		let js_name = 'popper.min.js'

		// this.script_01.defer = 'defer'

		this.script_01.integrity	= 	"sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1"
		this.script_01.crossorigin	=	'anonymous'

		this.script_01.src =
			"https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/" + js_name
		// this.thm.u.http_domainbar + 'r_cassets/libs/js/jquery/' + js_name

		this.script_01.pcreate()

		this.code += this.script_01.code
	}

	//[S_01]<script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.6.0/slick.min.js"></script>
	create_slick() {
		let js_name = 'slick.min.js'

		// this.script_01.defer = 'defer'


		this.script_01.integrity	= 	""
		this.script_01.src =
			"https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.6.0/slick.min.js"
		// this.thm.u.http_domainbar + 'r_cassets/libs/js/slick/' + js_name

		this.script_01.pcreate()

		this.code += this.script_01.code
	}



	build_data(path_pmt = 'dev/static/js/')
	{
        this.p('deep_react DBG ' + this.thm.s.ms.site)

        switch (this.thm.s.ms.site)
        {
         case "seo":
           this.p("No jquery")
           this.create_seo_scripts()
		   //this.create_jquery()
		   // this.create_popper()
           break
         case "social":
		   this.create_bootstrap()
		   break
        }

		this.create_common(path_pmt,'chunk.js')

		this.create_common(path_pmt,'main.js')


		// Ok [18-06-17]
		// this.p('js_scripts_Code : >' + this.code )

	}

}

exports.deep_scripts_react = deep_scripts_react

