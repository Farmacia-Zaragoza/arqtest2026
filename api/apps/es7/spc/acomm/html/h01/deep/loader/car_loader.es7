// Class:c-scr01_js_truck-
// ------------------------------------------------------------------------------------
// Methods:
// ------------------------------------------------------------------------------------
// - create_common  	 		: Build html final code for object
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const { html_style } 	=  require(	path.join(JS_TYP7 , 'html/style/html_style.es7'		)	  )


class car_loader extends html_style {

	constructor(thm) {

		let tag_type 				= 	"div"

		super(tag_type)
		this.n = 'car_loader::'
		this.m = 'constructor'

        this.id             =  "loadingContainer"

		this.thm = thm

		this.div_01 = new html_style('div')

		this.div_01.class = "loading-window"
		this.div_02 = new html_style('div')
		this.div_02.class = "car"

		this.div_03 = new html_style('div')

		this.span_01 = new html_style('div')

		this.build_data()
	}

    create_div_03(class_name = '')
    {
      this.div_03.class =class_name
      this.div_03.pcreate()

      this.div_02.content += this.div_03.code

    }



    create_div_02_a()
    {
      this.create_div_03("strike")
      this.create_div_03("strike strike2")
      this.create_div_03("strike strike3")
      this.create_div_03("strike strike4")
      this.create_div_03("strike strike5")
      this.create_div_03("car-detail spoiler")
      this.create_div_03("car-detail back")
      this.create_div_03("car-detail center")
      this.create_div_03("car-detail center1")
      this.create_div_03("car-detail front")
      this.create_div_03("car-detail wheel")
      this.create_div_03("car-detail wheel wheel2")

      this.div_02.pcreate()

      this.div_01.content += this.div_02.code

    }

    create_div_02_b()
    {
       this.div_02.class   = "text"
       this.div_02.content = ''
       this.create_span_01()
       this.create_span_02()

       this.div_02.pcreate()

       this.div_01.content += this.div_02.code
    }

//          <span
// Loading</span
// <span class="dots"
// ...</span

    create_span_01()
    {
      // TRANSLATE TEXT
      this.span_01.content = "Loading"

      this.span_01.pcreate()

      this.div_02.content += this.span_01.code

    }

    create_span_02()
    {
      this.span_01.class   = "dots"
      this.span_01.content = "..."

      this.span_01.pcreate()

      this.div_02.content += this.span_01.code

    }

    create_div_01()
    {
    	this.create_div_02_a()

    	this.create_div_02_b()

    	this.div_01.pcreate()

    	this.content = this.div_01.code

    }


	build_data()
	{
		this.content = ""

		this.create_div_01()

		this.pcreate()

		//Ok [20-01-13]
		// this.p('car_loader > ' +  this.code)

	}

}

exports.car_loader = car_loader

