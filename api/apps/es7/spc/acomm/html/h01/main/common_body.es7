define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const 	{ html_style } 					= 	require(	path.join(JS_BASE 	, 	'com/objects/html/html_style.es6'	)			);
		const { ifnojs } = require(	path.join(JS_BASE 	, 	'com/objects/html/ifnojs.es6'			)		);

class common_body extends html_style  {

    constructor (     container						)
    {
		let tag_type					=	'body'
		super(tag_type)

		this.n							=	'common_body::'
        this.tag_type     				= 	'body'

		this.container					=	container
		this.s                          =   container.s
		this.u                          =   container.u

		// Tenemos que tener como un mapa del site
		this.container.map					= 	'body/'

		// Common Json

        this.div_01                     =   new html_style('div')

    	this.scripts_01					=	''

		this.ifnojs						=	new ifnojs()

		this.approot					=	new html_style('app-root')

		this.pmtscr						=	new html_style('script')

		// this.p('Domain Check SSL :'  + this.thm.u.http_domainbar)

		this.drift_code					=	this.container.s.os.drift

		// External object
		this.script_to_load				=	''

        //this.p('bdy_01_results ' + this.result_comm  + '  ' +  this.result_spec + '  ' +  this.result_cont )

        // Sera false si hay que generar jsons
        if (this.container.jsons_ok)
			this.build_data_ok()
		else
			this.build_json_wrongs()

    }

	//   <app-root></app-root>
	create_approot()
	{

		this.approot.content				=		''

		this.approot.pcreate()

		this.content					+=		this.approot.code
	}

    // <!--[if lt IE 8]>
    //        <p class="arqdruupgrade">You are using an <strong>outdated</strong> arqdru. Please <a href="http://browsehappy.com/">upgrade your arqdru</a> to improve your experience.</p>
    // <![endif]-.

  	create_ifnojs()
    {
		// External links
		this.ifnojs.ifno_complex_mode_02('8' , 'lt' , '<p class="garlandupgrade">You are using an <strong>outdated</strong> arqdru. Please <a href="http://browsehappy.com/">upgrade your arqdru</a> to improve your experience.</p>'  	)

		this.content 			+= 	this.ifnojs.code
	}

    build_json_wrongs()
    {
        this.p('bdy01_arq BUILDING WRON JSON' )

        this.div_01.content      = this.container.line_comm
        this.div_01.pcreate()
		this.content 			+= this.div_01.code

        this.div_01.content      = this.container.line_spec
        this.div_01.pcreate()
		this.content 			+= this.div_01.code

        this.div_01.content      = this.container.line_cont
        this.div_01.pcreate()
		this.content 			+= 	this.div_01.code

		this.pcreate()

        // this.p('bdy01_arq ' +  this.content)

    }

}

// Pendiente 2026 - Cambio quitando html-minifier
async function procesarHtml(htmlSucio) {
  try {
    // 2. Ejecuta la minificación de forma asíncrona
    const htmlMinificado = await minify(htmlSucio, {
      collapseWhitespace: true,
      removeComments: true,
      minifyJS: true,
      minifyCSS: true
    });

    return htmlMinificado;
  } catch (error) {
    console.error('Error minificando HTML:', error);
    return htmlSucio; // Devuelve el HTML original si falla
  }
}

exports.common_body = common_body
