define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { common_body }      =   require( path.join(JS_ACO7  , 'html/h01/main/comm/common_body.es7' ) )


class common_react extends common_body  {

  constructor (     container            )
  {
    super(container)
    this.n               =  'common_react::'
  }

  //-------------------------------------------------------------------------------------

  create_div()
  {
    this.div_01.id           =  'root'

        // this.p('Bdy01_Loading_Data_Type ' + this.container.s.cs.page_name)

    this.div_01.data_type    =  this.container.s.cs.page_name

    this.div_01.data_comm    =  this.container.jurl_comm

    this.div_01.data_spec    =  this.container.jurl_spec

    this.div_01.data_content =  this.container.jurl_cont


    // this.div_01.data_content     =  this.jpath_cont

    this.div_01.pcreate()
    this.content            +=  this.div_01.code
  }

    //-------------------------------------------------------------------------------------

  build_data_ok()
  {
  // Structure
  // [FB] [CONTAINER] [SCRIPTS] [SERVER_FOOTER]
    this.content      =  ''

    this.create_ifnojs()

    this.create_div()

    this.create_scripts()

    this.create_a_robot()

    this.pcreate()

    // Ok [18-02-02]
    // this.p('bdy01:cod ' + this.code)

    //this.p('bdy01:codl_BODY ' + this.code.length)

  }

}

exports.common_react = common_react

