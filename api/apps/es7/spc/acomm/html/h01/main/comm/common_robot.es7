// - create_spec  	 : Create Spec robot code
// - create_content  : Create Content robot code
// - build_data_ok   : build data for robot
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			);

const _mod_safe_1 = require(  path.join(global.JS_ACO7  , 'html/h01/main/comm/common_body.es7'  ); const common_body = _mod_safe_1.common_body || _mod_safe_1;);
        const sctf = require( 	path.join(global.JS_LIB7 	, 'file/save_code_to_file.es7'   ));

class common_robot extends common_body  {

    constructor (     container						)
    {
		super(container)

		this.n							=	'common_robot::'
        // Aqui no tenemos jsons
	    this.build_data_ok()

    }

    //---------------------------------------------------------------------------------------------
    create_comm()
    {
		this.script_code_path				=  	this.container.jpath_comm
		this.p('SITE_PATH_COMM ' + this.script_code_path )
		this.content			+=		sctf.file_get_code(this.script_code_path)
	}

    //---------------------------------------------------------------------------------------------
    create_spec()
    {
		this.script_code_path				=  	this.container.jpath_spec
		this.p('SITE_PATH_SPEC ' + this.script_code_path )
		this.content			+=		sctf.file_get_code(this.script_code_path)
	}

    //---------------------------------------------------------------------------------------------
    create_content()
    {
		this.script_code_path				=  	this.container.jpath_cont
		this.p('SITE_PATH_CONT ' + this.script_code_path )
		this.content			+=		sctf.file_get_code(this.script_code_path)
	}

    //---------------------------------------------------------------------------------------------

    build_data_ok()
    {
	// Structure
	// [FB] [CONTAINER] [SCRIPTS] [SERVER_FOOTER]
		this.content			=	''

        this.create_comm()

        this.create_spec()

        this.create_content()

		this.pcreate()

		// Ok [18-02-02]
		// this.p('bdy01:cod ' + this.code)

		// this.p('rbt02:codl_BODY ' + this.code)

    }

}

exports.common_robot = common_robot


module.exports = common_robot;
module.exports.common_robot = common_robot;
