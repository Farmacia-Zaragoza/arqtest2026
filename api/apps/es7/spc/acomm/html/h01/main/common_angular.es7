global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			);

const   { common_body }     =   require( path.join(global.JS_ACO7  , 'html/h01/main/common_body.es7' ) )


class common_angular extends common_body  {

  constructor (     container            )
  {
    super(container)

    this.n              =  'common_angular::'

  }

  //-------------------------------------------------------------------------------------
  //   <app-root></app-root>
  create_approot()
  {

    this.approot.content        =    ''

    this.approot.pcreate()

    this.content          +=    this.approot.code
  }


  //-------------------------------------------------------------------------------------
    // <script>
    // window.APP_DATA = {
    //  activeLang: "spanish",
    //  key: 'value'
  create_parameter_scripts()
  {

    // this.p(this.thm.jnode.load_from_disk_url_code)

//    let common_json          =  'https://arqdru.vbrqx.com/ang/json/common.json'
//    let lang_common_json      =  'https://arqdru.vbrqx.com/ang/json/langs/en/common.json'

    this.pmtscr.content        =  'window.APP_DATA = {'

    this.pmtscr.content        +=  'lang: "' + this.container.s.ms.lang  +'",'
    this.pmtscr.content        +=  'currency: 1,'

    // Common for any page - for any lang
    // common_json:       " common.json",
    this.pmtscr.content        +=  'comm_json: "' + this.jurl_comm + '",'

    // Common for home page - for any lang
    //spec_json:          " front.json",
    this.pmtscr.content        +=  'spec_json: "' + this.jurl_spec + '",'

    this.pmtscr.content        +=  'content_json: "' + this.jurl_cont + '",'

    // Common for any page - for en (specific lang)
    // lang_common_json:  " en/common.json",

    this.pmtscr.content        +=  'page: {'

       this.p('HOMEPAGE - is the ' + this.container.s.cs.page_name)
    this.pmtscr.content        +=  'type: "' + this.container.s.cs.page_name +  '"'


    this.pmtscr.content        +=  ' } }'


    this.pmtscr.pcreate()

    this.content          +=  this.pmtscr.code
  }

  //-------------------------------------------------------------------------------------

  build_data_ok()
  {
    this.content      =  ''

    this.create_ifnojs()

    this.create_approot()

        // Disabled while I generate search
    this.create_parameter_scripts()

    this.create_scripts()


    this.pcreate()

    // Ok [18-02-02]
    // this.p('bdy01:cod ' + this.code)
    // this.p('bdy01:codl_BODY ' + this.code.length)

    }
}

exports.common_angular = common_angular

