// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			);

const _mod_safe_1 = require(	path.join(global.JS_TYP7 , 'html/style/html_style.es7'			); const html_style = _mod_safe_1.html_style || _mod_safe_1;   );
      const _mod_safe_2 = require(  path.join(global.JS_TYP7 , 'html/style/ifnojs.es7'         ); const ifnojs = _mod_safe_2.ifnojs || _mod_safe_2;   );

class common_head extends html_style  {

  constructor (     arroba                )
  {
    let tag_type         =   'head'

    super(          tag_type  )

    this.tag_type             =   'head'
    this.n              =  'common_head::'

    this.meta_01          =  ''

    this.link_01          =  ''

     // Cnode objects

    this.compo_head          =  ''

    this.arroba            =  arroba

    this.s					=   this.arroba.s

    this.b                  =   this.arroba.b

    // Head can't have tame
    this.tame            =  ''

    this.ifnojs            =  new ifnojs()

    this.title_01          =  new html_style('title')

    this.base_01          =  new html_style('base')

    if (this.s.b.robot_page)
      this.build_data()
    else
    {
      if (this.arroba.jsons_ok)
        this.build_data()
      else
        this.build_json_head()
    }
  }

//  <title>Welcome to CICA</title>
    create_title()
    {
    // Lang_Ok [17_07_07]
    // this.p('Title ' . this.thm.site_title)

    this.title_01.content      =  this.arroba.s.ms.site_title
    this.title_01.pcreate()

    this.content          +=  this.title_01.code
  }

//  <title>Welcome to CICA</title>
    create_base()
    {
    // Lang_Ok [17_07_07]
    // this.p('Title ' . this.thm.site_title)

    this.base_01.href        =  this.arroba.s.cs.http_domainbar
    this.base_01.pcreate()

    this.content          +=  this.base_01.code
  }

  // <!--[if lt IE 9]>
    //        <script src="js/vendor/html5-3.6-respond-1.4.2.min.js"></script>
    //     <![endif]-.
    create_ifnojs()
    {
    // External links
    this.ifnojs.ifno_complex_mode_02('9' , 'lt' ,
        '<script src="js/vendor/html5-3.6-respond-1.4.2.min.js"></script>'  )

    this.content += this.ifnojs.code
  }

  build_json_head()
  {
      this.pcreate()
  }

  build_data()
  {

      this.create_metas()
      this.create_title()
      this.create_base()
      this.create_links()
      this.create_ifnojs()

      this.pcreate()
  }

}

exports.common_head = common_head


module.exports = common_head;
module.exports.common_head = common_head;
