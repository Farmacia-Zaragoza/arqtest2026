define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { printlog }          =  require(  path.join(JS_TYP7  , 'logs/printlog.es7'             ))

class common_hnode extends printlog  {

    constructor (     container						)
	{
    	super()

        this.n                  =   "common_hnode::"

        this.container          =   container

        this.s					=   this.container.s

        this.b                  =   this.container.b

		// Common Json
		this.line_comm			=	this.container.s.ms.j_comm_line
		this.line_spec			=	this.container.s.ms.j_spec_line
		this.line_cont 			=	this.container.s.ms.j_cont_line

        // Switch para las paginas del chequeo de los jsons
        this.only_json_page     =   this.container.s.b.only_json_page

		this.jurl_comm	   	    =	this.container.s.ms.j_comm_url
		this.jurl_spec			=	this.container.s.ms.j_spec_url
		this.jurl_cont 			=	this.container.s.ms.j_cont_url

		this.jpath_comm	   	    =	this.container.s.ms.j_comm_path
		this.jpath_spec			=	this.container.s.ms.j_spec_path
		this.jpath_cont 		=	this.container.s.ms.j_cont_path


        this.result_comm        =  this.container.s.ms.j_comm_ck
        this.result_spec        =  this.container.s.ms.j_spec_ck
        this.result_cont        =  this.container.s.ms.j_cont_ck

        this.p('chnode_results ' + this.result_comm  + '  ' +  this.result_spec + '  ' +  this.result_cont )

        var jsons_ok            =  this.result_comm && this.result_spec && this.result_cont

        this.jsons_ok            = jsons_ok && !this.only_json_page
    }
}

exports.common_hnode = common_hnode
