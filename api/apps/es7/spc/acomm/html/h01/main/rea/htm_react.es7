var    cons             =   require(  "/brqx/rcode/es7/com/agen/constants.es7"          )

const  { common_html } 	= 	require(	cons.JS_ACO7 + 'html/h01/main/comm/common_html.es7'			), 		
	   { head_react }	= 	require(	cons.JS_ACO7 + 'html/h01/main/rea/head_react.es7'	),					
	   { body_react }	= 	require(	cons.JS_ACO7 + 'html/h01/main/rea/body_react.es7'	);					


class htm_react extends common_html  {

    constructor (     container						)
	{
        let tag_type     			= 	'html'
    	super(				container	)			

        this.n                  =   "htm_react::"
    }
    
	//<head>
    create_head()
    {
		// External Head
		this.head_01	=	
				new head_react(this.container)	// Drupal theme structure

//		this.content			+=  '<HEAD>HOLA</HEAD>' //this.head_01.code					
		this.code			+=  this.head_01.code					
			}		

    create_body()
    {
		// External Div
		this.body_01	=	
				new body_react( this.container )	// Drupal theme structure

//		this.content			+=  '<BODY>HOLA</BODY>'  //this.body_01.code					
		this.code				+=  this.body_01.code					
	}		

}

exports.htm_react = htm_react