define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { common_link }       =   require(  path.join(JS_ACO7 , 'html/h01/main/comm/common_link.es7'     )   );
       const { deep_link_react } = require(  path.join(JS_ACO7 , 'html/h01/deep/styles/deep_link_react.es7'  )      );

class links_react extends common_link  {

  constructor (     thm                    )
  {

    super(thm)

    this.n              =  'lnk01_link_arqdru::'
  }

  build_data()
  {
    this.create_favicon()

    this.link_to_load     =   new deep_link_react(this.thm)

    this.code             +=   this.link_to_load.code
  }

}

exports.links_react = links_react

