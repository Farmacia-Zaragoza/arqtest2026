var    cons                  =   require(  "/brqx/rcode/es7/com/agen/constants.es7"          )

const  { common_link }       =   require(  cons.JS_ACO7 + 'html/h01/main/comm/common_link.es7'        ),
       { deep_link_react } =   require(  cons.JS_ACO7 + 'html/h01/deep/styles/deep_link_react.es7'        );

class links_react extends common_link  {
 
  constructor (     thm                    )
  {   

    super(thm)                              

    this.n              =  'lnk01_link_arqdru::'          
  }

  build_data()
  {
    this.create_favicon()                      

    this.link_to_load     =   new deep_link_react(this.thm)

    this.code             +=   this.link_to_load.code
  }

}

exports.links_react = links_react
