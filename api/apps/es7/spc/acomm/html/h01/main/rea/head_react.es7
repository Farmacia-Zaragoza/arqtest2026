var     cons             =   require(  "/brqx/rcode/es7/com/agen/constants.es7"          )

const  { common_head } 	 = require( cons.JS_ACO7 + 'html/h01/main/comm/common_head.es7'			      ),		
       { links_react } = require( cons.JS_ACO7 + 'html/h01/main/rea/links_react.es7'    ),
       { common_meta }   = require( cons.JS_ACO7 + 'html/h01/main/comm/common_meta.es7'    );


class head_react extends common_head  {

  constructor (     arroba                )
  {   

    super(          arroba  )              

    this.n              =  'head_react::'                    

  }

  //   <div id="logo">
  create_metas()
  {
    // External Metas

    this.meta_01          =  new common_meta( this.arroba  ) 
    
    this.content          +=  this.meta_01.code                      
  }


  create_links()
  {
    // External links
    this.link_01          =  new links_react(this.arroba)            
  
    this.content          +=  this.link_01.code                      
  }

}

exports.head_react = head_react