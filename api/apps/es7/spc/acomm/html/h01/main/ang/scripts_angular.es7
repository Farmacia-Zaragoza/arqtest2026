var    cons                      =   require(  "/brqx/rcode/es7/com/agen/constants.es7"          )

const   { deep_scripts_angular } =   require(  cons.JS_ACO7 + 'html/h01/deep/scripts/deep_scripts_angular.es7'    ),
        { common_scripts}        =   require(  cons.JS_ACO7 + 'html/h01/main/comm/common_scripts.es7'    );


class scripts_angular extends common_scripts  {

  constructor (     thm                            )
  {   
    super(thm)

    this.n              =  'scripts_angular::'            
    }


  build_data()
  {

    // DEV - requiere primero los otro scripts

    this.script_to_load     =   new deep_scripts_angular(this.thm)

    // MAIN - PRODUCT
    this.code               +=  this.script_to_load.code  

    // this.p('jsarqdruCode : >' + this.code )                       

  }

}

exports.scripts_angular = scripts_angular
