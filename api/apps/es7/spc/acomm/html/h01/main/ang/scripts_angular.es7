define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { deep_scripts_angular } =   require(  path.join(JS_ACO7 , 'html/h01/deep/scripts/deep_scripts_angular.es7'));
        const { common_scripts}        =   require(  path.join(JS_ACO7 , 'html/h01/main/comm/common_scripts.es7'  ));


class scripts_angular extends common_scripts  {

  constructor (     thm                            )
  {
    super(thm)

    this.n              =  'scripts_angular::'
    }


  build_data()
  {

    // DEV - requiere primero los otro scripts

    this.script_to_load     =   new deep_scripts_angular(this.thm)

    // MAIN - PRODUCT
    this.code               +=  this.script_to_load.code

    // this.p('jsarqdruCode : >' + this.code )

  }

}

exports.scripts_angular = scripts_angular
