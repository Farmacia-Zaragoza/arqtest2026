//-------------------------------------------------------------------------------------
// Fast node load - Replace Mysql connections - Taxonomy Class
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
//-------------------------------------------------------------------------------------
// Inheritance Line : 
//-------------------------------------------------------------------------------------
// hcomm_struc > Scom_defs > cache > struct > strings
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// - d- generate_cache_summary_structure-   : Generate Sum checking Cache file
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

var    cons           =   require(  "/brqx/rcode/es7/com/agen/constants.es7"      )

const  { scomm_defs } =   require(  cons.JS_TYF7  + 'a01_load/scomm/s04_defs.es7' ),
       jtest          =   require(  cons.JS_LIB7  + 'file/json_test.es7'          ),
       sctf           =   require(  cons.JS_LIB7  + 'file/save_code_to_file.es7'  );


class hcomm_struc extends scomm_defs {
  constructor(container)  
  {
    super()

    this.n            =   "hcomm_struc::" 
     // arrobasite pasado
    this.container    =   container

    this.s            =   this.container.s
    this.b            =   this.container.b    

    this.htype        =   ''

    // common type
    this.s.cs.uri     =   'uritype'

    this.s.cs.comm    =   'comm'

    // Are html auto generated
    this.s.cs.sub     =   'hdata'
    this.s.cs.ext     =   'hdata'
  
    this.s.b.type_ssl = true
    
    // this.p('s01_passsed_type ' + this.s.t_sub)
    // Generate Cache path
    this.gen()

    this.generate_cache_summary_structure()

    this.run_cache_to_generate_html()

  }

  //---------------------------------------------------------------------------------------------  
  
  generate_cache_summary_structure()
  {
    this.m                  =   "generate_cache_summary_structure"

    
     //Primero se vacia el fichero SIEMPRE
     sctf.create_new_empty_file(this.s.cs.cache_sum)
     sctf.create_new_empty_file(this.s.cs.cache_err)

     var http_struct          = ''
     var line                 = ''
     var file                 = this.s.cs.cache_err
     var http_result_ok       = false


     if (!this.s.b.robot_page)
     {
       // Comm

       // this.p ('h02_TESTING_PATH ' + this.container.s.ms.j_comm_path)
       this.container.s.ms.j_comm_ck_syn = jtest.jsontest(   this.container.s.ms.j_comm_path)  
       http_struct                       = new jtest.jsonuritest(this.container.s.ms.j_comm_url)

       this.container.s.ms.j_comm_ck_uri = http_struct.result
       this.container.s.ms.j_comm_ck_cod = http_struct.code
       this.container.s.ms.j_comm_ck     = this.container.s.ms.j_comm_ck_syn && this.container.s.ms.j_comm_ck_uri

       // this.p ('h02_TESTING_PATH CK ' + this.container.s.ms.j_comm_ck_uri)

       // Spec

       this.container.s.ms.j_spec_ck_syn = jtest.jsontest(   this.container.s.ms.j_spec_path)  
       http_struct                       = new jtest.jsonuritest(this.container.s.ms.j_spec_url)

       this.container.s.ms.j_spec_ck_uri = http_struct.result
       this.container.s.ms.j_spec_ck_cod = http_struct.code
       this.container.s.ms.j_spec_ck     = this.container.s.ms.j_spec_ck_syn && this.container.s.ms.j_spec_ck_uri

       // this.p ( 'h02_test_spec ' + http_struct.code + '  ' + http_struct.result )

       // Cont

       this.container.s.ms.j_cont_ck_syn  = jtest.jsontest(   this.container.s.ms.j_cont_path)  
       http_struct                        = new jtest.jsonuritest(this.container.s.ms.j_cont_url)

       this.container.s.ms.j_cont_ck_uri = http_struct.result
       this.container.s.ms.j_cont_ck_cod = http_struct.code
       this.container.s.ms.j_cont_ck     = this.container.s.ms.j_cont_ck_syn && this.container.s.ms.j_cont_ck_uri


       http_result_ok  = this.container.s.ms.j_comm_ck  &&  this.container.s.ms.j_spec_ck && this.container.s.ms.j_cont_ck

       if ( http_result_ok ) file = this.s.cs.cache_sum
       else                  file = this.s.cs.cache_err

       // Nunca generamos un fichero sum si la url no es de jsons     
       if (this.b.only_json_page) file = this.s.cs.cache_err

     }
     
     sctf.update_file_with_code(this.s.cs.cache_sum, 'Fecha ' + this.s.pg.today)             

     line = jtest.create_json_line(   this.container.s.ms.j_comm_ck     , 
                                      this.container.s.ms.j_comm_ck_cod ,
                                      this.container.s.ms.j_comm_ck_syn ,
                                      this.container.s.ms.j_comm_ck_uri )

     this.container.s.ms.j_comm_line = line + ' ' +  this.container.s.ms.j_comm_url

     sctf.update_file_with_code(file, this.container.s.ms.j_comm_line)    

     line = jtest.create_json_line(   this.container.s.ms.j_spec_ck     , 
                                      this.container.s.ms.j_spec_ck_cod ,
                                      this.container.s.ms.j_spec_ck_syn ,
                                      this.container.s.ms.j_spec_ck_uri )

     this.container.s.ms.j_spec_line = line + ' ' +  this.container.s.ms.j_spec_url

     sctf.update_file_with_code(file, this.container.s.ms.j_spec_line)    

     
     line = jtest.create_json_line(   this.container.s.ms.j_cont_ck     , 
                                      this.container.s.ms.j_cont_ck_cod ,
                                      this.container.s.ms.j_cont_ck_syn ,
                                      this.container.s.ms.j_cont_ck_uri )

     this.container.s.ms.j_cont_line = line + ' ' +  this.container.s.ms.j_cont_url

     sctf.update_file_with_code(file, this.container.s.ms.j_cont_line)    



     sctf.update_file_with_code(file, this.container.s.ms.j_comm_path)    
     sctf.update_file_with_code(file, this.container.s.ms.j_spec_path)    
     sctf.update_file_with_code(file, this.container.s.ms.j_cont_path)    
    
  }

}

exports.hcomm_struc = hcomm_struc