const { JS_TYP7  } = require(path.join(process.cwd(),'api/apps/paths.js'));

const { printlog }           =   require(  cons.JS_TYP7  + 'logs/printlog.es7'                  ),
      { arroba_htype_react } =   require(  cons.JS_ACO7  + 'html/h03/h02_arroba_htype_react.es7');

class theme_react extends printlog
{
  constructor(container = '')
  {
    super()
    this.n                  =   "theme_react::"

    this.container          =   container

    // Generate common html file
    // Lo mismo hay que ver si existe el fichero
    // si existe hay que obtenerlo y devolverlo
    this.hcontent           =   new arroba_htype_react(this.container)

    this.code               =   this.hcontent.htype.hobject.code

  }


} // end Class

exports.theme_react = theme_react
