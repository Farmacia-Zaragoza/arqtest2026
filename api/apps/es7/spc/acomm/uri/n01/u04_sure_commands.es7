global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			);

const   { uri }             =   require(    path.join(global.JS_TYP7    , 'uri/u01_obj.es7'         )   )

class site_common_sure_commands extends uri {

  constructor(site = '' , ir = '' )
  {
    super(  site, ir )

    // Here we create uri
    this.gen_url_structure()

    this.n               =   'site_common_sure_commands::'
  }

  //---------------------------------------------------------------------------------------------
  // This method depends of site
  sure_common_commands()
  {
     this.m                  = 'sure_common_commands'

     // this.p('u03_sc_Arguments: ' + this.uri_args_sorted.length)

     switch(this.s.cs.page_name)
     {

      case "product":
        // Solo tres argumentos
        // article/a12 - en/article/a12
        if (this.uri_args_sorted.length > 3 )
        {
          this.p ('u03_Pagina incorrecta. demasiados argumentos')
          this.manage_front()
        }
        break;

      // Misma idea de drupal gneneramos los cuerpos de los articulos para el json
      case "articles":
        // solo 1 argumento
        if (this.uri_args_sorted.length > 0 )
        {
          this.p ('Pagina incorrecta. demasiados argumentos')
          this.manage_front()
        }
        break;

      case "fivearticles":
        // solo 1 argumento
        if (this.uri_args_sorted.length > 0 )
        {
          this.manage_front()
          this.p ('Pagina incorrecta. demasiados argumentos')
        }
        break;

      case "search":
        // Pendiente

        // this.p ('Pagina_busqueda__params: ' + this.uri_args_sorted.length)

        if (this.uri_args_sorted.length > 5 )
        {
          this.manage_front()
          this.p ('Pagina incorrecta. demasiados argumentos')
        }
        break;
    } // End switch
  }

}

exports.site_common_sure_commands = site_common_sure_commands

