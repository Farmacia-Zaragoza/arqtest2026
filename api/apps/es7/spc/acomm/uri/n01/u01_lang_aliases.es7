global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			);

const _mod_safe_1 = require( path.join(global.JS_ACO7  , 'uri/n01/u02_site_commands.es7' ); const site_common_commands = _mod_safe_1.site_common_commands || _mod_safe_1;);
       const _mod_safe_2 = require(  path.join(global.JS_TYP7  , 'logs/idx_pointers.es7'         ); const idx_pointers = _mod_safe_2.idx_pointers || _mod_safe_2;);

class uri_lang_aliases extends site_common_commands
{
  constructor(site = '' , ir = '' )
  {
    super(  site, ir )
    this.n                  =   "uri_lang_aliases::"
  }

//---------------------------------------------------------------------------------------------

  manage_lang_aliases(arroba)
  {

     this.m                    = 'manage_lang_aliases'

     this.arr = arroba.arr

     // this.start_position_array       =   this.start_position_array + 1

     // Tenemos definida una posicion para aliasas
     var index = '000v005'

     var idx          = new idx_pointers(index)
     this.arroba_attribs_cats(idx)

     // Alias definido a000
     // this.p('u07_arqdru_First Alias ' + this.arr['en']['j000v005'][0] )
     /// this.p('u07_arqdru_First Alias JA ' + this.gethash_keylang( idx.iindex , 1 ) )

     // this.p('u07_site_uri_SITEALIAS: ' + this.old_uri)
     // this.p('u07_site_uri_SITEALIAS: ' + this.uri)
     // let cats           = this.arr[this.s.ms.main_lang][idx.jindex]
    var iterations           = this.last_element

    this.p('u01_NumsAliasesFOUND ' + iterations)

    var possible_product_uri = path.dirname(this.uri)

    // this.p('u07_DefLang ' + this.s.ms.default_lang)

    // let keys = Object.keys(this.cats);

    // let nextIndex = keys.indexOf(theCurrentItem) +1;
    // let nextItem = keys[nextIndex];

    let c = 0
    // TENGO DUDAS SI ES MAS RAPIDO ESTO O UN FOR
    // NO SOLO DUDAS DEL WHILE TAMBIEN EL ARRAY QUE ITERA ES EL COMUN PARA TODO LOS IDIOMAS
    // while (!this.b.lang_aliases_already_managed &&
    //   (c < this.last_element)               )
    for (var pos in this.cats)
    {
    // STA_Nivel 02 WHILE
    // for (var pos in this.cats)
    //  pos = this.keys[c]

      // gethash_keylang tampoco la tengo
      // Casos reglas_de_oro y es/reglas_de_oro
      this.arroba_attribs(idx , pos)

      // this.p('u07_ComparingX ' + this.s.ms.main_lang + ' _ ' + this.uri + ' = ' + this.value )

      this.arroba_attribs_main_lang(idx,pos)

      if ( !this.b.lang_aliases_already_managed &&
         ( (this.value    != "" ) ||
           (this.value_en != "" ) ) )
      {
      // STA_Nivel 03 IF
      // Value es el nombre del alias
        this.p('u01_langali E ' + pos + ' elem ' + this.value)
        this.rmultispace_debug(this.value)

        var lower_result        = this.result.toLowerCase()

        this.langitem           = lower_result
        this.item               = lower_result

        // Necesitamos gestionar tanto es/item como item
        // Y vamos a quitar los espacios

        this.rmultispace(this.value_en)
        this.mainitem           = this.result.toLowerCase()

        // Def Num && Def anchor
        // EN h tenemos los numeros
        this.manage_pg_anchor(this.hover_en)

        // El numero puede ser normal o una pagina y un anchor
        //
        // Manage item  es/item
        //       if (this.s.ms.default_lang != this.s.ms.lang)
        this.langitem     = this.s.ms.lang + '/' + this.value
        this.langmainitem = this.s.ms.lang + '/' + this.value_en

        // this.p('u07_ComparingY ' + this.langitem + ' = ' + this.uri )

        // Hay 4 casos :

        // zh/gold_rules ---> load product
        // gold_rules    ---> load product
        // zh/黄金法则    ---> load product
        // 黄金法则       ---> load product

        // Managing full uris for lists
        if ( (this.uri == this.value        )    ||
             (this.uri == this.langitem     )    ||
             (this.uri == this.mainitem     )    ||
             (this.uri == this.langmainitem )    )
          {
            // STA_Nivel 04_If_Match
            this.p ('u01_lang_FOUND_ALIAS' + this.value + ' T ' + this.dhild)
            // Ya no hay que hacerlo
            //// this.recover_front()

            // Esto siempre es alias
            // T -> Alias D -> product | list
            switch (this.dhild)
            {
              case "product":
                this.enable_alias_as_a_product()
                this.url_page_load_drupal_node(this.num)
                break;
              case "list": this.url_page_set_list(this.num) ; break;
              case "photo":
                this.p('Managing_PHOTO ' + this.num)
                // this.p('Managing_PHOTO ' + this.item)
                // this.p('Managing_PHOTO ' + this.langitem)
                // this.p('Managing_PHOTO ' + this.mainitem)
                // this.p('Managing_PHOTO ' + this.langmainitem)

                // Photos are in position 30
               this.enable_alias_as_a_photo()
               this.url_page_load_drupal_node(this.num, '30')
               break;
            } // End Switch

            this.b.lang_aliases_already_managed  = true

            // Que pasa si es chino u otro idioma raro
            if (this.b.is_strange_lang)
            {
              this.s.cs.dash_sub_query = this.s.ms.main_lang + this.s.ms.lang + '_' + this.mainitem
              // de esta tengo dudas
              this.s.cs.slash_sub_query = this.s.ms.main_lang + this.s.ms.lang + '/' + this.mainitem
            }
          }
          else if ( (possible_product_uri == this.value        )    ||
                  (  possible_product_uri == this.langitem     )    ||
                  (  possible_product_uri == this.mainitem     )    ||
                  (  possible_product_uri == this.langmainitem )    )
          {
            // Managing full uris for products. NO PUEDE SER LISTA

            this.p ('u01_lang_FOUND_PRODUCT_ALIAS' + this.value + ' T ' + this.dhild)
            // Ya no hay que hacerlo
            //// this.recover_front()

            // Esto siempre es alias
            // T -> Alias D -> product | list

            // Como en los alias no hemos comprobado el numero debemos obtenerlo de la uri
            // Igual hay que convertirlo
            // HAY QUE CONVERTRLO , TENEMOS a2 y necesitamos 2

            this.page_iargs = path.basename(this.uri)
            this.manage_uri_page_number()
            // this.p('u01_langali_manage_page ' + this.s.cs.page)

            switch (this.dhild)
            {
              case "product":
                this.enable_alias_as_a_product()
                this.url_page_load_drupal_node(this.s.cs.page)
                break;
              case "photo":
                this.p('Managing_PHOTO ' + this.num)
              // this.p('Managing_PHOTO ' + this.item)
              // this.p('Managing_PHOTO ' + this.langitem)
              // this.p('Managing_PHOTO ' + this.mainitem)
              // this.p('Managing_PHOTO ' + this.langmainitem)

              // Photos are in position 30
                this.enable_alias_as_a_photo()
                this.url_page_load_drupal_node(this.s.cs.page, '30')
                break;
              default:
                this.enable_alias_as_a_product()
                this.url_page_load_drupal_node(this.s.cs.page,  '20')

            } // End Switch

            this.b.lang_aliases_already_managed  = true

            // Que pasa si es chino u otro idioma raro
            if (this.b.is_strange_lang)
            {
              this.s.cs.dash_sub_query = this.s.ms.main_lang + this.s.ms.lang + '_' + this.mainitem
              // de esta tengo dudas
              this.s.cs.slash_sub_query = this.s.ms.main_lang + this.s.ms.lang + '/' + this.mainitem
            }

          } // END_Nivel 04_If_Match

        } // STA_Nivel 03 IF

     // this.p ('u01_lang_NOTFOUND_ALIAS' + this.uri)

     // this.p('u07_Managing ' + this.cat + ' '  +  '  ' + this.num)
     // if ( this.cat == 'a203')
     // {
      // site_uri::manage_commands - u07_ComparingES ja/ゴールドルール = gold_rules
      // if (1 == 2 && this.b.is_strange_lang)
      // {
      // this.p('u07_ComparingA ' + this.s.ms.lang      + '_' + this.uri + ' = ' + this.langmainitem )
      // this.p('u07_ComparingB ' + this.s.ms.main_lang + '_' + this.uri + ' = ' + this.langitem )
      // this.p('u07_ComparingC ' + this.s.ms.main_lang + '_' + this.uri + ' = ' + this.item )
      // this.p('u07_ComparingD ' + this.s.ms.main_lang + '_' + this.uri + ' = ' + this.mainitem )
      // }
     // }
     c++
   } // END_Nivel 02 WHILE
   // Si no es ningun alias - es el front
   if (!this.b.lang_aliases_already_managed)
   {
      // Cargando el front
      this.p('u07_Cargamos el front_en_el_idioma_indicado')
      this.manage_front()
   }

  } // End Method

} // end Class

exports.uri_lang_aliases = uri_lang_aliases


module.exports = uri_lang_aliases;
module.exports.uri_lang_aliases = uri_lang_aliases;
