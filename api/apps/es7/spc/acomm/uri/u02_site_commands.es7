//-------------------------------------------------------------------------------------
// Fast node load - Replace Mysql connections - Taxonomy Class
//-------------------------------------------------------------------------------------
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// - d-manage_common_commands-            : Check command type based on uri and site
// - d-enable_as_a_product-               : Enable Alias Type to be a product
// - d-enable_alias_as_a_product-         : Enable Alias Type to be a product
// - d-enable_alias_as_a_photo-           : Enable Alias Type to be a photo

// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			)))

const { common_post_process_commands } =   require( path.join(JS_ACO7 , 'uri/u03_common_post_process_commands.es7' )))

class site_common_commands extends common_post_process_commands {

  constructor(site = '' , ir = '' )
  {
    super(  site, ir )
    this.n               =   'site_common_commands::'
  }

  //---------------------------------------------------------------------------------------------

  enable_as_a_product()
  {
    this.b.page_product        =   true
    this.b.intelligent_command =   false
    this.s.cs.page_name        =   'product'
  }

  //---------------------------------------------------------------------------------------------

  enable_alias_as_a_product()
  {
    this.b.page_is_alias       =   true
    this.b.page_product        =   true
    this.b.intelligent_command =   false
    this.s.cs.page_name        =   'product'

  }

  //---------------------------------------------------------------------------------------------

  enable_alias_as_a_photo()
  {
    this.b.page_is_alias       =   true
    this.b.intelligent_command =   false
    this.s.cs.page_name        =   'photo'

  }

  //---------------------------------------------------------------------------------------------
  // This method depends of site
  manage_common_commands()
  {

     this.m                    = 'manage_commands'

     // this.p('u01_sc_Comando para analizar: B ' + this.page_command)

     switch(this.page_command)
     {
      // Multi Lang article
      case "article":        this.url_page_set_product()  ;      break;
      case "artigo":         this.url_page_set_product()  ;      break;
      case "artikel":        this.url_page_set_product()  ;      break;
      case "articolo":       this.url_page_set_product()  ;      break;
      case "articulo":       this.url_page_set_product()  ;      break;
      case "articles":       this.url_page_set_product()  ;      break;


      // Multi Lang photo

      case "foto":           this.url_page_set_photo()       ;      break;

      // Misma idea de drupal gneneramos los cuerpos de los articulos para el json
      case "teasers":
        this.b.page_teaser        =   true
        this.s.cs.page_name       =  'teasers'
        this.s.cs.teaser_type	  =  'full'   // Tipo de presentacion por defecto
        this.s.cs.loadtype        =  'position'
        this.s.cs.position        =  '20'
        break;;

      // Spanish policy - debe generar el articulo 24
      case "politica":        this.url_page_set_policy()   ;         break;;

      // German policy
      case "politik":         this.url_page_set_policy()    ;          break;

      // French policy
      case "polique":         this.url_page_set_policy()   ;        break;

      case "fivearticles":
        this.b.page_teaser       =   true
        this.s.cs.page_name           =  'rand'
        this.s.cs.teaser_type	     =  'full'
        break;;

      case "kb":       this.url_page_set_kb()  ;      break;

      case "search":
        // La busqueda que va a generar una pagina debe tener el json completo
        this.b.page_search     =   true
        this.s.cs.page_name         =  'search'
        this.s.cs.search_type	   =  'full'
        this.b.page_list       =   true

        // Arroba load
        // this.s.cs.loadtype	   =  'full'

        break;;

      case "searchapi":
        this.b.page_search_api =   true
        this.s.cs.page_name         =  'search'
        break;;

      case "rest":
        this.b.page_search_rest =   true
        this.s.cs.page_name         =  'search'
        break;;

      case "restfast":

        this.b.page_search_rest_fast =   true
        this.s.cs.page_name         =  'search'
        break;;

      case "searchapifull":
        this.b.page_search_api =   true
        this.s.cs.page_name         =  'search'
        this.s.search_type	   =  'full'
        break;;

      case "restfull":
        this.b.page_search_rest =   true
        this.s.cs.page_name         =  'search'
        this.s.search_type	   =  'full'
        break;;

      case "restfastfull":

        this.b.page_search_rest_fast =   true
        this.s.cs.page_name         =  'search'
        this.s.search_type	   =  'full'

        break;;

      default:

        this.manage_general_commands()
    }

  }

}

exports.site_common_commands = site_common_commands
