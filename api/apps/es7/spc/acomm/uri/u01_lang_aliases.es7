// Inheritance Line :
//-------------------------------------------------------------------------------------
// LanAliases > Site_Common_Commands
// @Common_Uri > @Uri > @Array > @Strings > @Printlog
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { site_common_commands } =   require( path.join(JS_ACO7  , 'uri/u02_site_commands.es7'),
       const { idx_pointers }        =   require(  path.join(JS_TYP7  , 'logs/idx_pointers.es7'     ));

class uri_lang_aliases extends site_common_commands
{
  constructor(site = '' , ir = '' )
  {
    super(  site, ir )
    this.n                  =   "uri_lang_aliases::"
  }

//---------------------------------------------------------------------------------------------

  manage_lang_aliases(arroba)
  {

     this.m                    = 'manage_commands'

     this.arr = arroba.arr

     // this.start_position_array       =   this.start_position_array + 1

     // Tenemos definida una posicion para aliasas
     var index = '000v005'

     var idx          = new idx_pointers(index)



     let cats         = this.getarr(this.s.ms.main_lang, idx.jindex)                              ;

     // Alias definido a000
     // this.p('u07_arqdru_First Alias ' + this.arr['en']['j000v005'][0] )
     /// this.p('u07_arqdru_First Alias JA ' + this.getkeylang( idx.iindex , 1 ) )

     // this.p('u07_site_uri_SITEALIAS: ' + this.old_uri)
     // this.p('u07_site_uri_SITEALIAS: ' + this.uri)


     // let cats           = this.arr[this.s.ms.main_lang][idx.jindex]
    var iterations           = Object.keys(cats).length - 1

    this.p('u01_NumsElemsFOUND ' + iterations)

    // this.p('u07_DefLang ' + this.s.ms.default_lang)

    for (var pos in cats)
    {
      // getkeylang tampoco la tengo
      // Casos reglas_de_oro y es/reglas_de_oro

      this.cat                = cats[pos]

      // Obtiene el item en el idioma ( espanol )
      this.item               = this.getkeylang( idx.iindex , pos)


      this.rmultispace(this.item)

      var lower_result        = this.result.toLowerCase()
      this.langitem           = lower_result
      this.item               = lower_result

      // Necesitamos gestionar tanto es/item como item
      // Y vamos a quitar los espacios

      this.mainitem           = this.getkeymain( idx.iindex , pos)

      this.typeitem           = this.getkeymain( idx.dindex , pos)


      this.rmultispace(this.mainitem)
      this.mainitem           = this.result.toLowerCase()

      this.num                = this.getkeymain( idx.hindex , pos)

      // Manage item  es/item
//       if (this.s.ms.default_lang != this.s.ms.lang)
      this.langitem = this.s.ms.lang + '/' + this.item
      this.langmainitem = this.s.ms.lang + '/' + this.mainitem

      // Hay 4 casos :

      // zh/gold_rules ---> load product
      // gold_rules    ---> load product
      // zh/黄金法则    ---> load product
      // 黄金法则       ---> load product


      if (!this.b.lang_aliases_already_managed)
      {
        // Managing full uris
        if ( (this.uri == this.item         )    ||
        	 (this.uri == this.langitem     )    ||
        	 (this.uri == this.mainitem     )    ||
        	 (this.uri == this.langmainitem )    )
        {
          // this.p ('u01_lang_FOUND_ALIAS' + this.typeitem)
          // Ya no hay que hacerlo
          //// this.recover_front()

          if (this.typeitem == 'product')
          {
            this.enable_alias_as_a_product()
          	this.url_page_load_drupal_node(this.num)

          }
          else if (this.typeitem == 'list')
          {
            this.url_page_set_list()
          }

          else if (this.typeitem == 'photo')
          {
            this.p('Managing_PHOTO ' + this.num)
            // this.p('Managing_PHOTO ' + this.item)
            // this.p('Managing_PHOTO ' + this.langitem)
            // this.p('Managing_PHOTO ' + this.mainitem)
            // this.p('Managing_PHOTO ' + this.langmainitem)

            // Photos are in position 30
            this.enable_alias_as_a_photo()
          	this.url_page_load_drupal_node(this.num, '30')
          }

          this.b.lang_aliases_already_managed  = true

          // Que pasa si es chino u otro idioma raro
          if (this.b.is_extrange_lang)
            this.s.cs.dash_sub_query = this.s.ms.main_lang + this.s.ms.lang + '_' + this.mainitem
        }
/*        else
        {
          // es/photo/novia
        // Managing part uris
          if (this.typeitem == 'photo')
          {
            // this.p('Managing_PHOTO ' + this.num)
            // this.p('Managing_PHOTO ' + this.item)
            // this.p('Managing_PHOTO ' + this.langitem)
            // this.p('Managing_PHOTO ' + this.mainitem)
            // this.p('Managing_PHOTO ' + this.langmainitem)

            // Photos are in position 30
            this.enable_alias_as_a_photo()
          	this.url_page_load_drupal_node(this.num, '30')
          }

          // this.p ('u01_lang_NOTFOUND_ALIAS' + this.uri)
        }
*/
     }


     // this.p ('u01_lang_NOTFOUND_ALIAS' + this.uri)

     // this.p('u07_Managing ' + this.cat + ' '  +  '  ' + this.num)
     // if ( this.cat == 'a203')
     // {
      // site_uri::manage_commands - u07_ComparingES ja/ゴールドルール = gold_rules

      // this.p('u07_Comparing ' + this.s.ms.lang      + '_' + this.uri + ' = ' + this.item )
      // this.p('u07_Comparing ' + this.s.ms.main_lang + '_' + this.uri + ' = ' + this.langitem )
     // }

   }
   // Si no es ningun alias - es el front
   if (!this.b.lang_aliases_already_managed)
   {
      // Cargando el front
      this.p('u07_Cargamos el front')
      this.manage_front()

   }

  }

} // end Class

exports.uri_lang_aliases = uri_lang_aliases
