define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { a01_idx_list } =   require(  path.join(JS_TYP7  , 'arroba/aindex/b_list/a01_idx_list.es7' ) );
	    const shtf = require(  path.join(JS_LIB7  , 'file/save_hash_to_file.es7' 	) );
	    const satf = require(  path.join(JS_LIB7  , 'file/save_hash1d_to_file.es7' )	);

class an03_general_index_arroba extends a01_idx_list {

  constructor (arroba = '' )
  {
    super(arroba)

    this.n                  =   'an03_general_index_arroba::'
  }

  //---------------------------------------------------------------------------------------------

  generate_common_index(pos = 20)
  {

    this.pos = pos

    // this.p('jn20-Generating Search  ' + pos )

    this.cat            =   this.arr[this.s.ms.main_lang]['jmain'][this.pos]
    this.index          =   this.arr[this.s.ms.main_lang]['dmain'][this.pos]

    this.word_arr       =   Array()
    this.articles_arr   =   Array()
    this.texts_arr      =   Array()
    this.links_arr      =   Array()

    // jn20_cat articles - false
    // this.p('an03_DEFINING_ARRAYS_LOAD jn20_cat ' + this.cat + ' PD ' + this.s.b.page_product)

    // Esta ya generandose el fichero. Aqui habria que igual filtrar las palabras de busqueda primero

    // =============================================================================
    // HAY QUE REVISAR PARA QUE GENERE LOS INDICES EN LOS DOS IDIOMAS
    // article/idx ---> Sin idioma
    // =============================================================================

    // De momento no es un JSON

    if (this.s.b.page_product)
    {
      // 020
      this.p('an03_jn20_cat PRDUCT DEBUG_INDEX' + this.index)

      this.save_arroba_index_page_to_file(
                this.index                ) // Categories lang/ES Name

    }
    else
    {
      // this.p('an03_jn20_cat LIST DEBUG_INDEX' + this.index + '  ' + this.arroba.j.categories)
      this.save_arroba_index_list_to_file(
                this.index                ) // Categories lang/ES Name

    }

    // GeneringIDX_LOAD   :/brqx/cache/emp/shop/arqshop/uritype/idx/nodef/nohuman/nouser/nocode/notrans/nosync/en_idx_arroba_ssl.idx
    // GeneringIDX_LOADRU :/brqx/cache/emp/shop/arqshop/uritype/idx/nodef/nohuman/nouser/nocode/notrans/nosync/ru_idx_arroba_ssl.idx

    // this.p('an03_GeneringIDX_LOAD    : ' + this.s.cs.idx[this.s.ms.main_lang] )
    // this.p('an03_GeneringIDX_LOADRU  : ' + this.s.cs.lang + ' ' + this.s.cs.idx[this.s.cs.lang] )

    // GENERATED_NX_INDEX
    // Falta el Lang
    if ( this.s.cs.lang == this.s.ms.main_lang )
      satf.save_hash1d_to_file(	this.s.cs.idx[this.s.ms.main_lang]   , // 01. File
								this.word_arr						 , // 02. Words
								this.articles_arr                    , // 03. Info
								this.s.cs.position					 , // 04. Position
								''						             , // 05. Page
								this.s.ms.main_lang                  ) // 06. Lang
    else
      satf.save_hash1d_to_file(	this.s.cs.idx[this.s.cs.lang]        , // 01. File
								this.word_arr						 , // 02. Words
								this.articles_arr                    , // 03. Info
								this.s.cs.position					 , // 04. Position
								''						             , // 05. Page
								this.s.cs.lang                       ) // 06. Lang

  }

}

exports.an03_general_index_arroba = an03_general_index_arroba

