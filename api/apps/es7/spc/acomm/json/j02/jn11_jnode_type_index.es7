const  { jn50_idx_json }     =   require(  path.join(JS_ACO7  , 'json/j01/n02/jn50_generate_idx_json.es7'  )   );
       const { printlog } = require(  path.join(JS_TYP7  , 'logs/printlog.es7'                        )   );

class jnode_type_index extends printlog {
  constructor(    arroba           )
  {
    super()

    this.n                  =   "jnode_type_comm::"
    this.m                  =   "cons"

        this.arroba             =   arroba
    this.s                  =   this.arroba.s
    this.a                  =   this.arroba.a

    this.arr                =   this.arroba.a.arr
    this.jobject            =   ''

    // Print PATH for JSONS ( Comm - Spec )
    // this.p('jn11_type_Page + this.s.cs.page_type + ' Pt ' + this.s.cs.cache_path)

    // this.p('jn11_jnotype_IDX_50  ' + this.s.ms.lang)
    this.jobject          =   new jn50_idx_json(this.arroba)

  }
  //---------------------------------------------------------------------------------------------
  rungen_json()
  {
    // this.p('jn01_jntyp_RUNNING_RUNGEN')
    this.jobject.process_array_and_generate_json_file()

  }

}

exports.jnode_type_index = jnode_type_index

