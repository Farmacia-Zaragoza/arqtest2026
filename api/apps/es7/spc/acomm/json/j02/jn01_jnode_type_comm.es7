const { JS_TYP7  } = require(path.join(process.cwd(),'api/apps/paths.js'));

const  { jn01_common_json }  =   require(  cons.JS_ACO7  + 'json/j01/n02/jn01_generate_common_json.es7'  ),
       { jn11_spec_json }    =   require(  cons.JS_ACO7  + 'json/j01/n02/jn11_generate_spec_json.es7'    ),
       { jn20_search_json }  =   require(  cons.JS_ACO7  + 'json/j01/n02/jn20_generate_search_json.es7'  ),
       { jn50_idx_json }     =   require(  cons.JS_ACO7  + 'json/j01/n02/jn50_generate_idx_json.es7'  ),
       { jn40_kb_json }      =   require(  cons.JS_ACO7  + 'json/j01/n02/jn40_generate_kb_json.es7'      ),
       { jn46_fs_json }      =   require(  cons.JS_ACO7  + 'json/j01/n02/jn46_generate_fs_json.es7'      ),
       { jn03_product_json } =   require(  cons.JS_ACO7  + 'json/j01/n02/jn03_generate_product_json.es7' ),
       { jn13_photo_json }   =   require(  cons.JS_ACO7  + 'json/j01/n02/jn13_generate_photo_json.es7'   ),
       { jn04_teasers_json } =   require(  cons.JS_ACO7  + 'json/j01/n02/jn04_generate_teasers_json.es7' ),
       { jn05_rands_json }   =   require(  cons.JS_ACO7  + 'json/j01/n02/jn05_generate_rands_json.es7'   ),
       { jn06_list_json }    =   require(  cons.JS_ACO7  + 'json/j01/n02/jn06_generate_list_json.es7'    ),
       { printlog }          =   require(  cons.JS_TYP7  + 'logs/printlog.es7'                           );


class jnode_type_comm extends printlog {
  constructor(    arroba           )
  {
    super()

    this.n                  =   "jnode_type_comm::"
    this.m                  =   "cons"

        this.arroba             =   arroba
    this.s                  =   this.arroba.s
    this.a                  =   this.arroba.a

    this.arr                =   this.arroba.a.arr
    this.jobject            =   ''

  }

  //---------------------------------------------------------------------------------------------

  manage_switch_page_type()
  {

    // Print PATH for JSONS ( Comm - Spec )
    this.p('jn01_type_Page ' + this.s.cs.page_type + ' Pt ' + this.s.cs.cache_path)
    this.p('jn01_type_PageName ' + this.s.cs.page_name)

    switch(this.s.cs.page_type)
    {
      case "spec"   : this.jobject          =   new jn11_spec_json(this.arroba)   ;      break;
      case "comm"   : this.jobject          =   new jn01_common_json(this.arroba) ;      break;
      case "content": this.manage_switch_page_name_common() ;          break;
    }
  }

  //---------------------------------------------------------------------------------------------

  manage_switch_page_name_common()
  {
    switch(this.s.cs.page_name)
    {
      case "nodef":    this.jobject   =   new jn01_common_json(this.arroba)  ;  break;

      case "blanc":    this.jobject   =   new jn03_product_json(this.arroba) ;  break;

      case "front":    this.jobject   =   new jn03_product_json(this.arroba) ;  break;

      case "product":  this.jobject   =   new jn03_product_json(this.arroba) ;  break;

      // case "idx":      this.jobject   =   new jn50_idx_json(this.arroba)     ;  break;

      case "kb":       this.jobject   =   new jn40_kb_json(this.arroba)      ;  break;

      case "fs":       this.jobject   =   new jn46_fs_json(this.arroba)      ;  break;

      case "photo":
            this.p('jn01_jnotype - Generating_photo_as_A_product')
            // Ojo que photo carga product y product considera teaser or no
            this.jobject          =   new jn03_product_json(this.arroba)
            break;

      case "slide":

            this.jobject          =   new jn03_product_json(this.arroba)
            break;

      case "gallery":

            this.jobject          =   new jn03_product_json(this.arroba)
            break;

      case "allinone":
            // Ojo : puede ser list - gallery - tab - slide
            this.p('jn01_jtype - T E A S E R S ')
            this.jobject          =   new jn04_teasers_json(this.arroba)
            break;

      case "list":
             // Ojo : puede ser list - gallery - tab - slide
            this.jobject          =   new jn06_list_json(this.arroba)
            break;

      case "rand":
            // Ojo : puede ser list - gallery - tab - slide
            // Deberia implementarse a nivel de cliente
            this.jobject          =   new jn05_rands_json(this.arroba)
            break;

      case "search":
            // Entra aqui -- Carga todos los articulos
            // this.p ("jn01_jntype_Aqui tenemos la busqueda")
            // Ahora ha cambiado puesto que debemos cargar el idx correspondiente

            this.jobject          =   new jn20_search_json(this.arroba)
            break;

    }

  }
  //---------------------------------------------------------------------------------------------
  rungen_json()
  {
    // this.p('jn01_jntyp_RUNNING_RUNGEN')
    this.jobject.process_array_and_generate_json_file()

  }


}

exports.jnode_type_comm = jnode_type_comm
