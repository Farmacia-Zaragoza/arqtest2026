define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { jns01_json_recursive } =   require(  path.join(JS_TYP7  , 'json/jsearch/j01/jns01_recursive.es7' ))

class jn02_general_search_json extends jns01_json_recursive {

  constructor (arroba = '' )
  {
    super(arroba)

    this.n                  =   'jn02_general_search_json::'
  }

  //---------------------------------------------------------------------------------------------

  generate_common_search(pos = 20)
  {

    this.pos = pos

    // this.p('jn20-Generating Search  ' + pos )

    this.cat          =   this.arr[this.s.ms.main_lang]['jmain'][this.pos]
    this.index        =   this.arr[this.s.ms.main_lang]['dmain'][this.pos]

    // jn20_cat articles
    // this.p('jn20_cat ' + this.cat)

    this.k.save_header(this.cat)

    // Esta ya generandose el fichero. Aqui habria que igual filtrar las palabras de busqueda primero

    this.save_json_search_recursive_array_to_file(
                this.index                , // Index of array
                this.arroba.j.categories  ) // Categories lang/ES Name

    this.k.end_corch()




  }

}

exports.jn02_general_search_json = jn02_general_search_json
