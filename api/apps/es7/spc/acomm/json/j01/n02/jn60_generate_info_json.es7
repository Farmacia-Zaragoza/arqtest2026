//-------------------------------------------------------------------------------------
// Methods:
//-------------------------------------------------------------------------------------
// - d-process_array_and_generate_json_file-          : Prepare Json Path
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { jn10_index_site }   =   require(  path.join(JS_ACO7  , 'json/j02/jn10_jnode_index_site.es7'),
	    shtf  			= 	require(  path.join(JS_LIB7  , 'file/save_hash_to_file.es7'));

class jn60_info_json extends jn10_index_site {

  constructor (arroba = '' )
  {
    super(arroba)

    this.n                  =   'jn60_info_json::'
  }

  //---------------------------------------------------------------------------------------------
  process_array_and_generate_json_file()
  {
    this.m                  =   'process_json'

    // this.p('jn20-Generating Search NO LLEGA  ' + this.j.full_path )
    this.p('jn20-Generating IDX  ' + this.u.bars_sub_query )

    // De momento no es un JSON
    // this.j.save_top()

    // Grabar la info del site

    this.p('js60_Full List ' + this.s.cs.cache_path)

    // Position normalizado a 3 digitos
    this.p('js60_Fast ListEN   ' + this.s.cs.list['en'])
    this.p('js60_Fast ListLANG ' + this.s.cs.list[this.s.cs.lang])

    this.p('js60_Fast IdxEN   ' + this.s.cs.idx['en'])
    this.p('js60_Fast IdxLANG ' + this.s.cs.idx[this.s.cs.lang])

    // /brqx/cache/arq/drupal/arqdru/uritype/
    // content/list/nohuman/nouser/nocode/notrans/nosync/en_position_20_arroba_ssl.idx

    // hay que pasarle la pagina o el articulo

    let filter = this.s.cs.position_norm

    // GENERATING_INDEX_FOR_REST

    if (this.s.cs.loadtype == "page")
      filter += 'v' + this.s.cs.page_norm + "(v[0-9][0-9][0-9])*"
    else (this.s.cs.loadtype == "position")
    {
      // this.p('jn60 - Ojo_POSITION___LIST ' + this.s.cs.teaser_type)

      if (this.s.cs.teaser_type == "detailed")
      {
        // this.p('jn60 - Ojo_loADTYPE_FULLSITE')
        filter += "(v[0-9][0-9][0-9])*(v[0-9][0-9][0-9])*"

      }
    }
    // 020v001
    this.p('js60_Filter ' + filter)
    // ggggggggggggg


	shtf.save_hash_to_file(	    this.s.cs.list[this.s.ms.main_lang]		       ,
								this.arr[this.s.ms.main_lang]                     ,
                                filter                             )
	shtf.save_hash_to_file(	    this.s.cs.list[this.s.cs.lang]		       ,
								this.arr[this.s.cs.lang]                     ,
                                filter                             )


  }


}

exports.jn60_info_json = jn60_info_json
