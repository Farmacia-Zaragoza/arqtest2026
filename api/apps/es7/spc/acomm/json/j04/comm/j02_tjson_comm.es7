// -------------------------------------------------------------------------------------
// Inheritance Line :
// -------------------------------------------------------------------------------------
// Theme_Json (spc) > Printlog
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
// -------------------------------------------------------------------------------------
// - d-generate_content_json-            : Generate content json structure
// - d-manage_index_json_page-           : Generate index json structure

// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { printlog }        =   require(  path.join(JS_TYP7  , 'logs/printlog.es7'            ) );
        const { container } = require(  path.join(JS_TYP7  , 'container/c01_cont.es7'       ) );

class tjson_comm extends printlog
{
  constructor(arroba = '')
  {
    super()
    this.n                  =   "theme_json::"

    this.arroba             =   arroba

    this.jcontent           =   ''
    this.u                  =   this.arroba.u
    this.s                  =   this.arroba.s
  }

//---------------------------------------------------------------------------------------------

  manage_index_json_page()
  {
    if (this.s.b.index_page)
    {
       // this.p('j02_jmjson_ENTER_INDEX')
       // INDEX GENERATION - NO OUTPUT NEEDED
       this.s.b.index_ready = true
       this.s.cs.ext        = 'idx'
       this.s.cs.sub        = 'arroba'

       // Generrate Index Arroba
       this.generate_index_json()
       // - this.jcontent.rungen_index()

       // Generate Search Information Arroba
       this.generate_info_json()
       // - this.jcontent.rungen_info()

    }

    // EN IDX Section --- > ENABLE AFTER DEBUGGING
    this.s.cs.ext        = 'json'
    this.s.cs.sub        = 'arroba'

  }

  generate_content_json()
  {

    // 01 CONTENT TYPE - GENERIC FOR ANY PAGE

    // Con content siempre se genera el fichero pues se supone que nunca sera comun a otras paginas
    this.jcontent.rungen_content()

    this.jcontent.s.ms.j_cont_path        =  this.jcontent.s.cs.cache_path
    this.jcontent.s.ms.j_cont_url         =  this.jcontent.s.cs.http_domainbar + this.jcontent.s.cs.cache_url

    this.arroba.copy ( this.jcontent)

  }

  generate_index_json()   {     this.jcontent.rungen_index()         }

  generate_info_json()    {     this.jcontent.rungen_info()         }

} // end Class

exports.tjson_comm = tjson_comm

