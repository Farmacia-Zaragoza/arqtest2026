      const _mod_safe_2 = require(  path.join(global.JS_TYP7  , 'logs/idx_pointers.es7'                ); const idx_pointers = _mod_safe_2.idx_pointers || _mod_safe_2;);
      const _mod_safe_3 = require(  path.join(global.JS_TYF7  , 'a01_load/lindex/i01_arroba_lindex.es7' ); const arroba_lindex = _mod_safe_3.arroba_lindex || _mod_safe_3;);

class tindex_comm extends printlog
{
  constructor(arroba = '')
  {
    super()
    this.n                  =   "tindex_comm::"

    this.arroba             =   arroba
    this.acontent           =   arroba
    this.u                  =   this.arroba.u
    this.s                  =   this.arroba.s
  }

  //-------------------------------------------------------------------------------------
  manage_index_page_name()
  {

    // Desde aqui el tipo de pagina es content
    this.s.cs.page_type = 'content'

    // No llega
    this.p('j10_LOADINDEXING ' +  this.s.cs.lang + ' ' + this.s.cs.page_name + ' N: ' + this.s.cs.page)
    // this.p('j10_LOADINDEXINA  ' +  this.arroba.s.cs.lang + ' ' + this.s.cs.page_name)

    // Checking switch
    // Aqui lo que se trata es de cargar el contenido por tanto igual search e index no tienen sentido

    if (this.s.b.index_page)
    {
        // LOAD INFORMATION

        this.p('j10_LOADINDEXING ' +  this.s.b.index_page)

        this.acontent     =  new arroba_lindex(this.arroba)

        // GET FROM ARROBA
        this.arr          =  this.arroba.arr
        this.s            =  this.arroba.s
        this.u            =  this.arroba.u
    }

    this.s = this.arroba.s

  }

} // end Class

exports.tindex_comm = tindex_comm


module.exports = tindex_comm;
