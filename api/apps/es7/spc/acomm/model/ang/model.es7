// comm - spec - content
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
//-------------------------------------------------------------------------------------
// Used Entities :
//-------------------------------------------------------------------------------------
// e-container-         : Arroba container
// e-arroba_jtype-      : Arroba JType
// e-theme_data-        : Theme Data
//-------------------------------------------------------------------------------------
// Class:
//-------------------------------------------------------------------------------------
// c-angular_model-     : Angular Class Model
//-------------------------------------------------------------------------------------
// Methods:
//-------------------------------------------------------------------------------------
//- d-run_site-  : Carga el modelo para todas la paginas
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
//-------------------------------------------------------------------------------------
// Inheritance Line :
//-------------------------------------------------------------------------------------
// Site_Model > Common_Model > Rest Model > Index_fast > Index
// @Model > @Index > @Log
//-------------------------------------------------------------------------------------
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

const path = require('path');

// Usar las rutas globales ya configuradas o resolver de forma segura sin asignar global directo
const js_aco7_path = global.JS_ACO7 || path.join(global.ROOT || '', 'api/apps/es7/spc/acomm/');

const { common_model }  = require( path.join(js_aco7_path, 'model/comm/common_model.es7') );
const { site_uri }      = require( path.join(js_aco7_path, 'uri/n02/u01_site_uri.es7') );
const { arroba_jtype }  = require( path.join(js_aco7_path, 'json/j03/j01_arroba_type.es7') );
const { theme_data }    = require( path.join(js_aco7_path, 'json/j04/ang/j01_theme_data.es7') );

class angular_model extends common_model
{
  constructor(pmt = '' )
  {
    super( pmt )
    this.n                 = 'angular_model::'
  }

  //---------------------------------------------------------------------------------------------
  run_site()
  {
    // Generate common json file
    this.commjson         =   new arroba_jtype(this.acomm  ,'comm')
    this.run_comm_model()

    this.arroba.s.cs.page_type = 'spec'

    // Generate spec json file
    this.specjson         =   new arroba_jtype(this.arroba , 'spec')
    this.run_spec_model()

    if (this.b.page_could_be_alias)
    {
      this.uspc.manage_lang_aliases(this.arroba)
    }

    // Pasamos U a arroba
    this.arroba.u         =   this.uspc

    this.thmdata          =   new theme_data(this.arroba)

    this.code             =   this.thmdata.code

  }

} // end Class

exports.angular_model = angular_model;
