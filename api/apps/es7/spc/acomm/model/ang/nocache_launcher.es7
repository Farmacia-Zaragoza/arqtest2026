const path = require('path');

let angular_model, site_uri, arroba_rest, rs01_object_search_main, r02_main, site_mcomm;

try {
  ({ angular_model }           = require( path.join(global.JS_ACO7 , 'model/ang/model.es7') ));
  ({ site_uri }                = require( path.join(global.JS_ACO7 , 'uri/n02/u01_site_uri.es7') ));
  ({ arroba_rest }             = require( path.join(global.JS_TYF7 , 'a01_load/lindex/i03_arroba_rest.es7') ));
  ({ rs01_object_search_main } = require( path.join(global.JS_TYP7 , 'arroba/rest/rs01_search_main.es7') ));
  ({ r02_main }                = require( path.join(global.JS_TYP7 , 'rest/r01_main/r02_main.es7') ));
  ({ site_mcomm }              = require( path.join(global.JS_TYF7 , 'a01_load/mcomm/m02_site_comm.es7') ));
} catch (err) {
  console.log("\n================ ERROR EXACTO DETECTADO ================");
  console.log("MENSAJE:", err.message);
  console.log("TRAZA COMPLETA:\n", err.stack);
  console.log("========================================================\n");
  throw err;
}

class angular_no_cache extends angular_model
{
  constructor(pmt = '' )
  {
    super( pmt )
    this.n                 = 'angular_no_cache::'

    var pos = this.strpos(this.ir.uri, "rest")

    if (pos !== false)
    {
      this.p('nocache_launcher - rest call')
      this.run_rest()
    }
    else
      this.run_method()
  }

  run_method()
  {
    this.m                 = 'run_method'

    this.comm               = new site_mcomm(this.s, this.s.ms.comm_positions)
    this.copy_model()
    this.uspc               = new site_uri(this.comm.s, this.ir)

    this.acomm.s.cs.http_domainbar = this.comm.s.cs.http_domainbar
    this.run_site()
  }

  run_rest()
  {
    this.uspc               = new site_uri(this.s, this.ir)
    this.s.cs.uri          = "uritype"

    this.arroba.copy_uri(this.uspc)
    this.acontent          = new arroba_rest(this.arroba)

    this.arroba.arr        = this.acontent.a.arr
    this.arroba.s          = this.acontent.a.s

    this.rest             = new r02_main(this.s.b.page_search)
    this.restgen          = new rs01_object_search_main(this.arroba, this.rest)

    this.restgen.gen_rest_search_main()

    this.p('nocacheload ' + this.s.cs.loadtype)

    let longi = Object.keys(this.rest.arr).length - 1
    this.parr(this.rest.arr[1])
    this.p('cache_arrlen  ' + longi)

    this.rest             = this.restgen.rest
    this.p('rest output  ' + this.rest.count)
  }

} // end Class

exports.angular_no_cache = angular_no_cache;

module.exports = angular_no_cache;
module.exports.angular_no_cache = angular_no_cache;
