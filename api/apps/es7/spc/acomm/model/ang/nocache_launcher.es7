//-------------------------------------------------------------------------------------
// Inheritance Line :
//-------------------------------------------------------------------------------------
// Angular_NoCache > Angular_Model > Comm_Model > Index_fast > Index
// @Model > @Index > @Log
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// d-run_method-
//-------------------------------------------------------------------------------------
// Used Entities :
//-------------------------------------------------------------------------------------
// e-site_mcomm-   : Multi position site to load arrobas
// e-site_uri-     : Url for non cached
//-------------------------------------------------------------------------------------
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

const path = require('path');

// 1. Obtener la raíz del proyecto
const ROOT = global.ROOT || process.cwd();

// 2. Declarar define globales para el resto del framework
define("JS_ACO7", path.join(ROOT, 'api/apps/es7/spc/acomm/'));
define("JS_TYP7", path.join(ROOT, 'api/apps/es7/com/ctyp/t01/'));
define("JS_TYF7", path.join(ROOT, 'api/apps/es7/com/ctyp/t02/'));

// 3. Declarar constantes locales para el uso en este archivo
const JS_ACO7 = path.join(ROOT, 'api/apps/es7/spc/acomm/');
const JS_TYP7 = path.join(ROOT, 'api/apps/es7/com/ctyp/t01/');
const JS_TYF7 = path.join(ROOT, 'api/apps/es7/com/ctyp/t02/');

let angular_model, site_uri, arroba_rest, rs01_object_search_main, r02_main, site_mcomm;

try {
  const mod_ang  = require( path.join(JS_ACO7 , 'model/ang/model.es7') );
  angular_model  = mod_ang.angular_model || mod_ang;

  const mod_uri  = require( path.join(JS_ACO7 , 'uri/n02/u01_site_uri.es7') );
  site_uri       = mod_uri.site_uri || mod_uri;

  const mod_arr  = require( path.join(JS_TYF7 , 'a01_load/lindex/i03_arroba_rest.es7') );
  arroba_rest    = mod_arr.arroba_rest || mod_arr;

  const mod_rs   = require( path.join(JS_TYP7 , 'arroba/rest/rs01_search_main.es7') );
  rs01_object_search_main = mod_rs.rs01_object_search_main || mod_rs;

  const mod_r02  = require( path.join(JS_TYP7 , 'rest/r01_main/r02_main.es7') );
  r02_main       = mod_r02.r02_main || mod_r02;

  const mod_mcom = require( path.join(JS_TYF7 , 'a01_load/mcomm/m02_site_comm.es7') );
  site_mcomm     = mod_mcom.site_mcomm || mod_mcom;

} catch (err) {
  console.error("❌ ERROR DETALLADO AL CARGAR MODULOS EN NOCACHE_LAUNCHER:");
  console.error(err.message);
  console.error(err.stack);
  throw err;
}

class angular_no_cache extends angular_model
{
  //---------------------------------------------------------------------------------------------
  constructor(pmt = '' )
  {

    super( pmt )

    this.n                 = 'angular_no_cache::'

    var pos = this.strpos(this.ir.uri, "rest")

    if (pos !== false)
    {
      this.p('nocache_launcher - rest call')
      this.run_rest()
    }
    else
      this.run_method()
  }

  //---------------------------------------------------------------------------------------------

  run_method()
  {
    this.m                 = 'run_method'

    this.comm               = new site_mcomm(this.s,
                                              this.s.ms.comm_positions)

    this.copy_model()

    this.uspc              =  new site_uri( this.comm.s   ,
                                              this.ir       )

    this.acomm.s.cs.http_domainbar = this.comm.s.cs.http_domainbar

    this.run_site()

  }

  // en/rest/search/architecture/method
  run_rest()
  {
    this.uspc              =  new site_uri( this.s   ,
                                            this.ir       )

    this.s.cs.uri          =  "uritype"

    this.arroba.copy_uri(this.uspc)

    this.acontent     = new arroba_rest(this.arroba)

    this.arroba.arr          = this.acontent.a.arr

    this.arroba.s            = this.acontent.a.s

    this.rest         = new r02_main(this.s.b.page_search)

    this.restgen      = new rs01_object_search_main(this.arroba , this.rest)

    this.restgen.gen_rest_search_main()

    this.p('nocacheload ' + this.s.cs.loadtype)

    let longi = Object.keys(this.rest.arr).length -1

    this.parr(this.rest.arr[1])

    this.p('cache_arrlen  ' + longi)

    this.rest         = this.restgen.rest

    this.p('rest output  ' + this.rest.count)

  }

} // end Class

exports.angular_no_cache = angular_no_cache
