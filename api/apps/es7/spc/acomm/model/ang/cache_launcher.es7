const path = require('path');

const   { angular_model }   =   require(  path.join(JS_ACO7  , 'model/ang/model.es7'     ) ) ;
        const { fast_uri } = require(  path.join(JS_ACO7  , 'uri/n02/u10_fast_uri.es7'     ) );
        const { site_mcomm } = require(  path.join(JS_TYF7  , 'a01_load/mcomm/m02_site_comm.es7' ) );

class angular_cache extends angular_model
{
  constructor(pmt = '' )
  {
    super(  pmt )

    // this.pmt = new params()
    // this.pmt.copy (pmt)

    this.pmt = pmt

    this.n                =  'angular_cache::'

    if (this.b.cache)
      this.uspc         = new fast_uri(this.s, this.ir)

    // this.p('arqdru_cache_Ready to choose : ' + this.b.cache )

    // cache sum solo existira si los json se han generado bien
    // Si hay cache y ya existe el fichero se carga

    // this.p('acache sum ' + this.uspc.c.s.cs.cache_sum)
    // this.p('acache pat ' + this.uspc.c.s.cs.cache_path)

    // Common Cache method
    this.cache_model()
  }

  //---------------------------------------------------------------------------------------------

  // NO CACHE CODE
  no_cache_launcher_code()
  {
      // NO CACHE CODE
      //-------------------------------------------------------------------------------------

      // this.p('arq_che_page PASO_A01 ' + this.s.cs.page_type +  ' nAM ' + this.s.cs.page_name )

      this.comm              =  new site_mcomm(this.s, this.s.ms.comm_positions)

      //this.p('arq_che_page X02 ' + this.comm.s.cs.page_type +  ' nAM ' + this.comm.s.cs.page_name )
      this.copy_model()

      //this.p('arq_che_page X03 ' + this.acomm.s.cs.page_type +  ' nAM ' + this.acomm.s.cs.page_name )

      // Common Site Method
      this.run_site()
  }

} // end Class

exports.angular_cache = angular_cache

