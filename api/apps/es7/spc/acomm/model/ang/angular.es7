const path = require('path');

const { angular_no_cache } = require( path.join(global.JS_ACO7, 'model/ang/nocache_launcher.es7') );
const { angular_cache }    = require( path.join(global.JS_ACO7, 'model/ang/cache_launcher.es7') );
const { printlog }         = require( path.join(global.JS_TYP7, 'logs/printlog.es7') );

class angular extends printlog
{
  constructor(pmt = '' )
  {
    super()

    this.n = 'angular::'

    if (pmt.cache)        this.model          = new angular_cache(    pmt  )
    else                  this.model          = new angular_no_cache( pmt  )
  }
} // end Class

exports.angular = angular;
