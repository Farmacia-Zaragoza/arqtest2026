const path = require('path');

JS_ACO7: path.join(ROOT, 'api/apps/es7/spc/acomm/'		),

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))
define("JS_ACO7" , 	path.join(global.ROOT, 'api/apps/es7/spc/acomm/'			))


const   { angular_no_cache } =   require(  path.join(JS_ACO7  , 'model/ang/nocache_launcher.es7') ),
        { angular_cache }    =   require(  path.join(JS_ACO7  , 'model/ang/cache_launcher.es7')   ),
        { printlog }         =   require(  path.join(JS_TYP7  , 'logs/printlog.es7')              );

class angular extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                =  'angular::'

    if (pmt.cache)        this.model          = new angular_cache(    pmt  )
    else                  this.model          = new angular_no_cache( pmt  )
  }
} // end Class

exports.angular = angular
