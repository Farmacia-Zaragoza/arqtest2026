// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

var     cons                 =   require(  "/brqx/rcode/es7/com/agen/constants.es7"         )

const   { angular_no_cache } =   require(  cons.JS_ACO7  + 'model/ang/nocache_launcher.es7'),
        { angular_cache }    =   require(  cons.JS_ACO7  + 'model/ang/cache_launcher.es7'  ),
        { printlog }         =   require(  cons.JS_TYP7  + 'logs/printlog.es7'                      );

class angular extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                =  'angular::'

    if (pmt.cache)        this.model          = new angular_cache(    pmt  )
    else                  this.model          = new angular_no_cache( pmt  )
  } 
} // end Class

exports.angular = angular
