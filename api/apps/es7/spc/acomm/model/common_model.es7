const path = require('path');

global.JS_TYF7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t02/');
global.JS_LIB7 = path.join(global.ROOT, 'api/apps/es7/com/blib/');
global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/');

// [DOCHANGED_ES7]
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Node Js - Common Model Class  [V.0.0.2]  (2019-05-13)
// Spc - Cica_d05 - Home - Index_06 - v0_0_1
// Brqx Group - Agile Farmacia Zaragoza Methodology [ES6]
//-------------------------------------------------------------------------------------
// Objects :
// comm - spec - content
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
//-------------------------------------------------------------------------------------
// Used Entities :
//-------------------------------------------------------------------------------------
// e-container-         : Arroba container
//-------------------------------------------------------------------------------------
// Methods:
//-------------------------------------------------------------------------------------
//- d-run_comm_model-  : Carga el modelo para todas la paginas
//- d-run_spec_model-  : Carga el modelo especifico
//- d-copy_model-      : Copia un modelo de arroba
//- d-cache_model-     : Ejecuta el site con cache
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
//-------------------------------------------------------------------------------------
// Inheritance Line :
//-------------------------------------------------------------------------------------
// Comm_Model > Index_fast > Index
// @Model > @Index > @Log
//-------------------------------------------------------------------------------------
// Run Line :
//-------------------------------------------------------------------------------------
// Cache_Model > No_Cache_Launcher
// @CacheModel > @Launcher
//-------------------------------------------------------------------------------------

const _mod_safe_1 = require( path.join(global.JS_TYP7, 'fire/i02_index_fast.es7'); const index_fast = _mod_safe_1.index_fast || _mod_safe_1);
const _mod_safe_2 = require( path.join(global.JS_TYP7, 'container/c01_cont.es7'); const container = _mod_safe_2.container || _mod_safe_2);
const _mod_safe_3 = require( path.join(global.JS_TYF7, 'a01_load/mcomm/m01_arroba_comm.es7'); const arroba_mcomm = _mod_safe_3.arroba_mcomm || _mod_safe_3);
const _mod_safe_4 = require( path.join(global.JS_TYF7, 'a01_load/scomm/s01_arroba_comm.es7'); const arroba_scomm = _mod_safe_4.arroba_scomm || _mod_safe_4);
const fs                = require('fs');
const gfc               = require( path.join(global.JS_LIB7, 'file/get_file_code.es7') );

class common_model extends index_fast
{
  constructor(pmt = '' )
  {
    super( pmt )

    this.arroba           = new container()
    this.acomm            = new container()

    // Gestion de uris de robot
    this.robot_uri_management()

    this.n                = 'common_model::'
  }

  check_logo_data()
  {
    let logo_data_check = false

    let logo_file         = this.s.ms.images_path + this.s.ms.logo_mobile.substr(2)
    if (!fs.existsSync(logo_file) )  logo_data_check = true
    if (logo_data_check) this.p('CHECK_MOBILE_LOGO ' +  logo_file)

    logo_file         = this.s.ms.images_path + this.s.ms.logo_tablet.substr(2)
    if (!fs.existsSync(logo_file) )  logo_data_check = true
    if (logo_data_check) this.p('CHECK_TABLET_LOGO ' +  logo_file)

    logo_file         = this.s.ms.images_path + this.s.ms.logo_desktop.substr(2)
    if (!fs.existsSync(logo_file) )  logo_data_check = true
    if (logo_data_check) this.p('CHECK_DESKTOP_LOGO ' +  logo_file)

    logo_file         = this.s.ms.images_path + this.s.ms.logo_4k.substr(2)
    if (!fs.existsSync(logo_file) )  logo_data_check = true
    if (logo_data_check) this.p('CHECK_4k_LOGO ' +  logo_file)

  }

  //-------------------------------------------------------------------------------------

  cache_model()
  {
    if (!this.b.cache)
    {
       this.no_cache_launcher_code()
    }
    else if (gfc.no_zero(this.uspc.c.s.cs.cache_sum))
    {
       this.p('Getting-Cached-Code ' + this.uspc.c.s.cs.cache_path)
       this.code = gfc.get_file_code(this.uspc.c.s.cs.cache_path)
    }
    else
    {
       this.p('Enter-In-No_Cache')

      if (gfc.no_zero(this.uspc.c.s.cs.cache_alias))
      {
        this.code = gfc.get_file_code(this.uspc.c.s.cs.cache_alias)
      }
      else
      {
        this.no_cache_launcher_code()
      }

    }

  }

  //-------------------------------------------------------------------------------------

  copy_model()
  {
    this.arroba.copy( this.comm)
    this.acomm.copy(  this.comm)
  }

//-------------------------------------------------------------------------------------

  run_comm_model()
  {
    this.commjson.rungen()

    this.arroba.copy_uri(this.uspc)

    this.check_logo_data()

    this.arroba.s.ms.j_comm_path           = this.commjson.s.cs.cache_path
    this.arroba.s.ms.j_comm_url            = this.uspc.s.cs.http_domainbar + this.commjson.s.cs.cache_url

    this.gcomm    = new arroba_mcomm(this.arroba , this.s.ms.spec_positions)

    this.arroba.copy( this.gcomm)
  }

//-------------------------------------------------------------------------------------

  run_spec_model()
  {
    this.m                = 'run_spec_model'

    this.specjson.rungen()

    this.arroba.s.ms.j_spec_path         = this.specjson.s.cs.cache_path
    this.arroba.s.ms.j_spec_url          = this.uspc.s.cs.http_domainbar + this.specjson.s.cs.cache_url

  }

} // end Class

exports.common_model = common_model;

module.exports = common_model;
module.exports.common_model = common_model;
