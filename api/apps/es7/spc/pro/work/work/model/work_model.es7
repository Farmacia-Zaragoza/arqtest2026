// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { work_no_cache }  =   require(  path.join(JS_PRO7, 'work/work/model/work_nocache_launcher.es7') ),
        { work_cache }     =   require(  path.join(JS_PRO7, 'work/work/model/work_cache_launcher.es7')),
        { printlog }       =   require(  path.join(JS_TYP7, 'logs/printlog.es7'));

class work extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                 =  'work::'

    if (pmt.cache)      this.model           = new work_cache(    pmt  )
    else                this.model           = new work_no_cache( pmt  )
  }

} // end Class

exports.work = work
