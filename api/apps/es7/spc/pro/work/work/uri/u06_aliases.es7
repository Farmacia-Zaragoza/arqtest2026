define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const { site_common_commands } =   require(path.join(JS_ACO7, 'uri/u01_site_commands.es7'))


class uri_aliases extends site_common_commands
{
  constructor(site = '' , ir = '' )
  {
    super(  site, ir )
    this.n                  =   "site_uri::"
  }

//---------------------------------------------------------------------------------------------

  manage_aliases()
  {

     this.m                    = 'manage_commands'

     // this.start_position_array       =   this.start_position_array + 1

     // Piensa que aqui no se ha procesado la Uri pero slash no tiene el idioma ya
     // /en/intelligent_scroll

//     this.p('u01_site_uri_SITEALIAS KB A : ' + this.slash_ideal_uri )


     switch(this.slash_ideal_uri)
     {

      // KB 000
      case "funcs/":                    this.url_page_load_drupal_node('0')  ;  break;
      // KB 001
      case "drupal_architecture/":      this.url_page_load_drupal_node('1')  ;  break;
      case "ad/":                       this.url_page_load_drupal_node('1')  ;  break;
      case "arqdru/":                   this.url_page_load_drupal_node('1')  ;  break;
      case "garldru/":                  this.url_page_load_drupal_node('1')  ;  break;
      case "mamun/":                    this.url_page_load_drupal_node('1')  ;  break;

      // KB 002
      case "current_society/":          this.url_page_load_drupal_node('2')  ;  break;
      case "sa/":                       this.url_page_load_drupal_node('2')  ;  break;
      case "social/":                   this.url_page_load_drupal_node('2')  ;  break;
      case "onil/":                     this.url_page_load_drupal_node('2')  ;  break;

      // KB 003
      case "wedding/":                  this.url_page_load_drupal_node('3')  ;  break;
      case "bd/":                       this.url_page_load_drupal_node('3')  ;  break;
      case "boda/":                     this.url_page_load_drupal_node('3')  ;  break;
      case "masud/":                    this.url_page_load_drupal_node('3')  ;  break;

      // KB 008
      case "dog/":                  this.url_page_load_drupal_node('3')  ;  break;
      case "ed/":                       this.url_page_load_drupal_node('3')  ;  break;
      case "edu/":                     this.url_page_load_drupal_node('3')  ;  break;
      case "mykola/":                    this.url_page_load_drupal_node('3')  ;  break;

      default:
        this.p('u06_aliases_manage_front')
        this.manage_front()

    }

  }

} // end Class

exports.uri_aliases = uri_aliases

