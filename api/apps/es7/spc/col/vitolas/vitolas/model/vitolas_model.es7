// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { common_model }  =   require(  path.join(JS_SPC7, 'acomm/model/common_model.es7')              ),
        { site_mcomm }    =   require(  path.join(JS_TYF7, 'a01_load/mcomm/m02_site_comm.es7')          ),
        { arroba_jtype }  =   require(  path.join(JS_SPC7, 'vitolas/json/j03/j01_arroba_type.es7') ),
        { site_uri }      =   require(  path.join(JS_SPC7, 'vitolas/uri/u01_site_uri.es7')               ),
        { theme_data }    =   require(  path.join(JS_SPC7, 'vitolas/json/j04/j01_theme_data.es7'));

class vitolas extends common_model
{
  constructor(pmt = '' )
  {
    // Debe generar la estructura sin basarse en la URL

    super(  pmt )

    this.n                =  'vitolas::'

    //1. Multi Position EN -
    // Specific final comm
    this.comm             =  new site_mcomm(this.s, '0 2 4 5 12 14 15 16')
    this.copy_model()

    //2. URI SPECIFIC VERSION FOR ARQDRU - WILL MANAGE REAL COMMANDS
    this.uspc             =   new site_uri( this.comm.s   ,
                                           this.ir       )

    // Generate common json file - Forced type so we knew is another page
    this.commjson         =   new arroba_jtype(this.acomm   ,'comm')
    this.run_comm_model()

    // Generate common json file - Forced type so we knew is another page
    this.specjson         =   new arroba_jtype(this.arroba , 'spec')
    this.run_spec_model()

    this.thmdata          =   new theme_data(this.arroba)


  }

} // end Class

exports.vitolas = vitolas
