       fs                    =   require(  'fs'                                                      );  

class arroba_jtype extends arroba_jtype_comm {
  constructor(    arroba           , 
                  passed_type = 'comm' )  
  {
    super(arroba, passed_type)
    this.n                  =   "arroba_jtype::"
  }

  //---------------------------------------------------------------------------------------------  
  create_jnode_type()
  {
    this.m                  =   "run_cache"
    // Generate Cache path
    this.gen()

    this.m                  =   "run_cache"

    // /brqx/pers/cache/arqdru/uritype/comm/policy/nohuman/nouser/nocode/notrans/nosync/
    //  es_position_6_json.json
    // this.p('j02_arroba_gen ' + this.s.cs.cache_path )

    if       ( !this.b.cache                    )                  
    {
      // GENERAMOS JNODE
      // this.p('j02_JnodeNotCAche') 
      this.jtype            =   new jnode_type( this.arroba      )
    }
    else  if ( !fs.existsSync(this.s.cs.cache_path))  
    {
      // GENERAMOS JNODE
      // this.p('j02_Jnode') 
      this.jtype            =   new jnode_type( this.arroba      )
    }
	else
    {
      // CARGAMOS JFAST 
      // Ya existe que necesitamos generar ? 
      // La estructura del site
      this.p('j02_Jfast')
      // this.j = new jfast(      this.arroba      )
    }
  }

}

exports.arroba_jtype = arroba_jtype