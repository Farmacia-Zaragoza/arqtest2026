define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { printlog }         =   require(path.join(JS_TYP7, 'logs/printlog.es7'))
       const { arroba_htype } = require(path.join(JS_SPC7, 'vitolas/html/h03/hcomm/h01_arroba_htype.es7'))

class theme_html extends printlog
{
  constructor(container = '')
  {
    super()
    this.n                  =   "theme_data::"

    this.container                  =   container

    // Generate common html file
    this.hcontent       =   new arroba_htype(this.container)

    this.code               = this.hcontent.htype.hobject.code

  }

} // end Class

exports.theme_html = theme_html

