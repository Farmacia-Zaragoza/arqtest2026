global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			);

const 	{ html_style } 					= 	require(path.join(global.JS_BASE, 'com/objects/html/html_style.es6'))
		const { svg_style } = require(path.join(global.JS_BASE, 'com/objects/html/svg_style.es6'))
		const { scr01_js_vitolas } = require(path.join(global.JS_SPC7, 'vitolas/html/h01/main/scr01_js_vitolas.es7'))
		const { ifnojs } = require(path.join(global.JS_BASE, 'com/objects/html/ifnojs.es6'))
		const minify = require(	'html-minifier'									).minify;

class bdy01_body_vitolas extends html_style  {

    constructor (     container						)
    {
		let tag_type					=	'body'
		super(tag_type)

		this.n							=	'bdy_vitolas::'
        this.tag_type     				= 	'body'

		this.container					=	container
		this.s                          =   container.s
		this.u                          =   container.u

		// Tenemos que tener como un mapa del site
		this.container.map					= 	'body/'

		// Common Json
		this.jpath_comm					=	this.container.s.ms.j_comm
		this.jpath_spec					=	this.container.s.ms.j_spec

		this.jpath_cont 				=	this.container.s.ms.j_content

    	this.scripts_01					=	''

		this.ifnojs						=	new ifnojs()

		this.approot					=	new html_style('app-root')

		this.pmtscr						=	new html_style('script')

		// this.p('Domain Check SSL :'  + this.thm.u.http_domainbar)

		this.drift_code					=	this.container.s.os.drift

		// External object
		this.script_to_load				=	''

		this.build_data()

    }

	//   <app-root></app-root>
	create_approot()
	{

		this.approot.content				=		''

		this.approot.pcreate()

		this.content					+=		this.approot.code
	}

	// <script>
    // window.APP_DATA = {
    //  activeLang: "spanish",
    //  key: 'value'
  	create_parameter_scripts()
    {

		// this.p(this.thm.jnode.load_from_disk_url_code)

//		let common_json					=	'https://vitolas.vbrqx.com/ang/json/common.json'
//		let lang_common_json			=	'https://vitolas.vbrqx.com/ang/json/langs/en/common.json'

		this.pmtscr.content				=	'window.APP_DATA = {'

		this.pmtscr.content				+=	'lang: "' + this.container.s.ms.lang  +'",'
		this.pmtscr.content				+=	'currency: 1,'

		// Common for any page - for any lang
		// common_json:       " common.json",
		this.pmtscr.content				+=	'comm_json: "' + this.jpath_comm + '",'

		// Common for home page - for any lang
		//spec_json:          " front.json",
		this.pmtscr.content				+=	'spec_json: "' + this.jpath_spec + '",'

		this.pmtscr.content				+=	'content_json: "' + this.jpath_cont + '",'

		// Common for any page - for en (specific lang)
		// lang_common_json:  " en/common.json",

		this.pmtscr.content				+=	'page: {'

     	this.p('HOMEPAGE - is the ' + this.container.s.cs.page_name)
		this.pmtscr.content				+=	'type: "' + this.container.s.cs.page_name +  '"'

		this.pmtscr.content				+=	' } }'

		this.pmtscr.pcreate()

		this.content					+=	this.pmtscr.code
	}

  	create_scripts()
    {
		// Here we have two options
		// Scripts links for dev environment
		// Script tag for live environment

  		this.scripts_01		=
  				new scr01_js_vitolas(	this.container	)

		this.content			+=	this.scripts_01.code
	}

    // <!--[if lt IE 8]>
    //        <p class="vitolasupgrade">You are using an <strong>outdated</strong> vitolas. Please <a href="http://browsehappy.com/">upgrade your vitolas</a> to improve your experience.</p>
    // <![endif]-.

  	create_ifnojs()
    {
		// External links
		this.ifnojs.ifno_complex_mode_02('8' , 'lt' , '<p class="garlandupgrade">You are using an <strong>outdated</strong> vitolas. Please <a href="http://browsehappy.com/">upgrade your vitolas</a> to improve your experience.</p>'  	)

		this.content 			+= 	this.ifnojs.code
	}

    build_data()
    {
	// Structure
	// [FB] [CONTAINER] [SCRIPTS] [SERVER_FOOTER]
		this.content			=	''

		this.create_ifnojs()

		this.create_approot()

        // Disabled while I generate search
		this.create_parameter_scripts()

		this.create_scripts()

		// FINISH BUCLE data-array content

		// Manage Json

		// PENDING

		this.pcreate()

		// Ok [18-02-02]
		// this.p('bdy01:cod ' + this.code)

		// this.p('bdy01:codl ' + this.code.length)

    }

}

exports.bdy01_body_vitolas = bdy01_body_vitolas

