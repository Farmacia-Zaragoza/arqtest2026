var     cons                  =   require(  "/brqx/base/rcode/es7/com/agen/constants.es7"          )

const  { common_head } 			= 	require(	cons.JS_ACO7 + 'html/h01/main/common_head.es7'			      ),		
        { lnk01_link_vitolas }    =   require(  cons.JS_SPC7 + 'vitolas/html/h01/main/lnk01_link_vitolas.es7'    ),
        { met01_meta_vitolas }    =   require(  cons.JS_SPC7 + 'vitolas/html/h01/main/met01_meta_vitolas.es7'    );


class hea01_head_vitolas extends common_head  {

  constructor (     arroba                )
  {   
    super(          arroba  )              

    this.n              =  'hea01_head::'                    
  }


  //   <div id="logo">
  create_metas()
  {
    // External Metas

    this.meta_01          =  new met01_meta_vitolas( this.arroba  ) 
    
    this.content          +=  this.meta_01.code                      
  }

  create_links()
  {
    // External links
      this.link_01          =  new lnk01_link_vitolas(this.arroba)            
  
    this.content          +=  this.link_01.code                      
  }


exports.hea01_head_vitolas = hea01_head_vitolas