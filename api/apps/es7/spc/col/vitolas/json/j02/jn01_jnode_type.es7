// Used Entities :
//-------------------------------------------------------------------------------------
// Site     : Site Object
// Url      : Url Object
// Boolean  : Boolean Object
// JObject  : Jobject Type

// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { printlog }          =   require(  path.join(JS_TYP7, 'logs/printlog.es7')),
       { jn01_common_json }  =   require(  path.join(JS_SPC7, 'vitolas/json/j01/jn01_generate_common_json.es7')),
       { jn02_policy_json }  =   require(  path.join(JS_SPC7, 'vitolas/json/j01/jn02_generate_policy_json.es7')),
       { jn03_product_json } =   require(  path.join(JS_SPC7, 'vitolas/json/j01/jn03_generate_product_json.es7')),
       { jn04_teasers_json } =   require(  path.join(JS_SPC7, 'vitolas/json/j01/jn04_generate_teasers_json.es7')),
       { jn05_rands_json }   =   require(  path.join(JS_SPC7, 'vitolas/json/j01/jn05_generate_rands_json.es7')),
       { jn06_list_json }    =   require(  path.join(JS_SPC7, 'vitolas/json/j01/jn06_generate_list_json.es7'));



class jnode_type extends printlog {

  constructor (arroba = '')
  {
    super()
    this.n                  =   'jn01_jnode_type::'

    this.arroba             =   arroba
    this.s                  =   this.arroba.s
    this.a                  =   this.arroba.a

    this.arr                =   this.arroba.arr
    this.jobject            =   ''


    // this.p('jn01_type_Page ' + this.s.cs.page_name + ' P ' + this.s.cs.cache_path)

    switch(this.s.cs.page_type)
    {
      case "spec":
        // Carga todos los articulos
        this.jobject          =   new jn11_spec_json(this.arroba)
        break;;

      case "comm":

      this.p('jn01_Before_Switch ' + this.s.cs.page_name )

        switch(this.s.cs.page_name)
        {

          case "comm":
            // Carga todos los articulos
            this.jobject          =   new jn01_common_json(this.arroba)
            break;;

          case "nodef":
            // Carga todos los articulos
            this.jobject          =   new jn01_common_json(this.arroba)
            break;;


          case "blanc":
            // Carga todos los articulos
            this.jobject          =   new jn03_product_json(this.arroba)
          break;;

          case "front":

            this.jobject          =   new jn03_product_json(this.arroba)
            break;;

          case "policy":
            // this.p('jn02_type_Policy_generation')
            this.jobject          =   new jn02_policy_json(this.arroba)
            break;;

          case "product":

            this.jobject          =   new jn03_product_json(this.arroba)
            break;;

          case "teaser":
            // Ojo : puede ser list - gallery - tab - slide
            this.jobject          =   new jn04_teasers_json(this.arroba)
            break;;

          case "list":
          // Ojo : puede ser list - gallery - tab - slide
          this.jobject          =   new jn06_list_json(this.arroba)
          break;;

          case "rand":
            // Ojo : puede ser list - gallery - tab - slide
            // Deberia implementarse a nivel de cliente
            this.jobject          =   new jn05_rands_json(this.arroba)
            break;;

          case "search":
            // Entra aqui -- Carga todos los articulos
            this.jobject          =   new jn20_search_json(this.arroba)
            break;;

      }

       break;;
    }


  }

  //---------------------------------------------------------------------------------------------
  rungen()
  {
    this.jobject.process_array_and_generate_json_file()

  }
}

exports.jnode_type = jnode_type
