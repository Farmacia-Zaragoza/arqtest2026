class vitolas extends common_model
{
  constructor(pmt = '' )
  {
    // Debe generar la estructura sin basarse en la URL

    super(  pmt )

    this.n                =  'vitolas::'

    //1. Multi Position EN -
    // Specific final comm
    this.comm             =  new site_mcomm(this.s, '0 2 4 5 12 14 15 16')
    this.copy_model()

    //2. URI SPECIFIC VERSION FOR ARQDRU - WILL MANAGE REAL COMMANDS
    this.uspc             =   new site_uri( this.comm.s   ,
                                           this.ir       )

