define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			)))

const { site_common_commands } =   require( path.join(JS_SPC7, 'acomm/uri/u01_site_commands.es7')))

class site_sure_commands extends site_common_commands {

  constructor(site = '' , ir = '' )
  {
    super(  site, ir )

    this.n               =   'site_commands::'
  }

  //---------------------------------------------------------------------------------------------
  // This method depends of site
  sure_commands()
  {

     // this.p('u03_sc_Arguments: ' + this.uri_args_sorted.length)

     switch(this.s.cs.page_name)
     {

      case "surespecific":
        // Este caso esta pendiente para lo que haga falta
        // article/a12
        if (this.uri_args_sorted.length > 1 )
        {
          this.p ('Pagina incorrecta. demasiados argumentos')
          this.manage_front()
        }
        break;

      default:

        this.sure_common_commands()

    } // End switch
  }

}

exports.site_sure_commands = site_sure_commands
