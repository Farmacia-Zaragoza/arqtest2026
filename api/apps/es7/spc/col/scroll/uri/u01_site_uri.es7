// Methods:
//-------------------------------------------------------------------------------------
// - d-manage_commands-            : Check command type based on uri and site 
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

var     cons                =   require(  "/brqx/base/rcode/es7/com/agen/constants.es7"         )

const { post_process_commands } =   require( cons.JS_SPC7 + 'scroll/uri/u02_post_process_commands.es7' )

class site_uri extends post_process_commands
{
  constructor(site = '' , ir = '' )
  {
    super(  site, ir )
    this.n                  =   "site_uri::"
  } 

//---------------------------------------------------------------------------------------------  
  // This method depends of site
  manage_commands()
  {

     this.m                    = 'manage_commands'

     this.start_position_array       =   this.start_position_array + 1        

     // this.p('u02_sc_Comando para analizar: ' + this.page_command)

     switch(this.page_command)
     {
      // Multi Lang article
      case "specificforpage":
        this.b.page_product       =   true
        this.s.cs.page_name       =   'product'
        break;

      default:

        this.manage_common_commands()
    }

    // this.p('u02_a_sc_page_name: ' + this.page_name)

    // Manage and sort arguments 
    // Hasta este punto no se conoce dash_sub_query
    this.process_commands()

    // Aqui ya se ha generado la uri en su totalidad
    this.post_process_commands()

    this.m                    = 'manage_commands'

    // this.p('u02_b_sc_page_name: ' + this.page_name)

    // This method will assure command is right for page
    this.sure_commands()

    // this.p('u02_c_sc_page_name: ' + this.page_name)

  }  

  


} // end Class

exports.site_uri = site_uri

