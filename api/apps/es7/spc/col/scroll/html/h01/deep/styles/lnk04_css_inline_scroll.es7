global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			);

const 	{ getset } 			= 	require(path.join(global.JS_BASE, 'com/objects/html/getset.es6'))
		const { html_style } = require(path.join(global.JS_BASE, 'com/objects/html/html_style.es6'))
		const scpf = require(path.join(global.JS_BASE, 'com/libs/file/full_path/level_02/save_code_properties_filename.es6'))

class lnk04_css_inline_scroll extends html_style  {

    constructor (     thm	              						)
    {

		let 	tag_name	=	'style'
		super( tag_name )

		this.n							=	'scr01_scroll::'
		this.m							=	'constructor'

		this.thm						=	thm

		this.link_code_path				=	''

		this.build_data()

    }

	// <link rel="stylesheet" href="styles.821fc87c884b09994238.css"></head>
    create_style()
    {
		let css_name 					=	'styles.css'

		this.link_code_path				=
				this.thm.u.site_path + '/dev/' + css_name

		this.content					+=
			scpf.file_get_code(this.link_code_path) + " "
	}

    create_bootstrap()
    {
		let css_name 					=	'bootstrap_v413_min.css'

		this.link_code_path				=
				this.thm.u.site_path + '/fassets/css/' + css_name

		this.content					+=
			scpf.file_get_code(this.link_code_path) + " "
	}

    create_fontawesome()
    {
		let css_name 					=	'fontawesome_v57_min.css'

		this.link_code_path				=
				this.thm.u.site_path + '/fassets/css/' + css_name

		this.content					+=
			scpf.file_get_code(this.link_code_path) + " "
	}

    build_data()
    {

 		this.charset			=	"utf-8"

 		this.title				=	"css_style"
 		this.type				=	"text/css"

		this.create_bootstrap()
		this.create_fontawesome()
		this.create_style()

		this.pcreate()

		// Ok [17-11-02]
		// this.p('Code : >' + this.code )

    }

}

exports.lnk04_css_inline_scroll = lnk04_css_inline_scroll

