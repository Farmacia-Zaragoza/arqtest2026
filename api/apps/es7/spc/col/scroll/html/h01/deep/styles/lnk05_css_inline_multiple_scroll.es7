const _mod_safe_1 = require(path.join(global.JS_BASE, 'com/objects/html/getset.es6'); const getset = _mod_safe_1.getset || _mod_safe_1;)
		const _mod_safe_2 = require(path.join(global.JS_BASE, 'com/objects/html/html_style.es6'); const html_style = _mod_safe_2.html_style || _mod_safe_2;)
		const scpf = require(path.join(global.JS_BASE, 'com/libs/file/full_path/level_02/save_code_properties_filename.es6'))

class lnk05_css_inline_scroll extends getset  {

    constructor (     thm	              						)
    {

		let 	tag_name				=	'style'
		super( tag_name )

		this.n							=	'lnk05_css_inline_scroll::'
		this.m							=	'constructor'

		this.thm						=	thm

		this.link_code_path				=	''

		this.lnk01						=	new html_style('style')

 		this.lnk01.charset				=	"utf-8"
 		this.lnk01.type					=	"text/css"

		this.build_data()

    }

	// <link rel="stylesheet" href="styles.821fc87c884b09994238.css"></head>
    create_style()
    {

		let css_name 					=	'styles.css'

		this.link_code_path				=
				this.thm.u.site_path + '/dev/' + css_name

		this.p('SITE_PATH ' + this.link_code_path )

		this.lnk01.content				=	scpf.file_get_code(this.link_code_path)
		this.lnk01.pcreate()

		// this.p ('CHECK_STYLE_01 ' + this.lnk01.code)

		this.code						+=	this.lnk01.code

	}

	// <link rel="stylesheet" href="fontawesome_v57_min.css"></head>
    create_fontawesome()
    {

		let css_name 					=	'fontawesome_v57_min.css'

		this.link_code_path				=
				this.thm.u.site_path + '/fassets/css/' + css_name

		this.p('SITE_PATH ' + this.link_code_path )

		this.lnk01.content				=	scpf.file_get_code(this.link_code_path)
		this.lnk01.pcreate()

		// this.p ('CHECK_STYLE_01 ' + this.lnk01.code)

		this.code						+=	this.lnk01.code

	}

	// <link rel="stylesheet" href="bootstrap_v413_min.css"></head>
    create_bootstrap()
    {

		let css_name 					=	'bootstrap_v413_min.css'

		this.link_code_path				=
				this.thm.u.site_path + '/fassets/css/' + css_name

		this.p('SITE_PATH ' + this.link_code_path )

		this.lnk01.content				=	scpf.file_get_code(this.link_code_path)
		this.lnk01.pcreate()

		// this.p ('CHECK_STYLE_01 ' + this.lnk01.code)

		this.code						+=	this.lnk01.code

	}

    build_data()
    {

		this.create_bootstrap()
		this.create_fontawesome()
		this.create_style()

		// Ok [17-11-02]
		// this.p('Code : >' + this.code )

    }

}

