define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { common_link }         =   require(  path.join(JS_ACO7, 'html/h01/main/common_link.es7'),
       const { common_link_react } =   require(  path.join(JS_ACO7, 'html/h01/deep/styles/common_link_react.es7'));

class lnk01_link_scroll extends common_link  {

  constructor (     thm                    )
  {

    super(thm)

    this.n              =  'lnk01_link_scroll::'

  }

  build_data()
  {
    this.create_favicon()

    this.link_to_load     =   new common_link_react(this.thm)

    this.code             +=   this.link_to_load.code
  }

}

exports.lnk01_link_scroll = lnk01_link_scroll
