const  { common_head } 			= 	require(path.join(JS_ACO7, 'html/h01/main/common_head.es7'))
        const { lnk01_link_scroll } = require(path.join(JS_SPC7, 'scroll/html/h01/main/lnk01_link_scroll.es7'))
        const { met01_meta_scroll } = require(path.join(JS_SPC7, 'scroll/html/h01/main/met01_meta_scroll.es7'))

class hea01_head_scroll extends common_head  {

  constructor (     arroba                )
  {

    super(          arroba  )

    this.n              =  'hea01_head::'
  }

  //   <div id="logo">
  create_metas()
    {
    // External Metas

    this.meta_01          =  new met01_meta_scroll( this.arroba  )

    this.content          +=  this.meta_01.code
  }

  create_links()
  {
    // External links
      this.link_01          =  new lnk01_link_scroll(this.arroba)

