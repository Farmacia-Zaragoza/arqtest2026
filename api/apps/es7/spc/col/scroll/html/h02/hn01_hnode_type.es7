define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { printlog }          =   require(path.join(JS_TYP7, 'logs/printlog.es7'))
	   const { common_hnode } = require(path.join(JS_ACO7, 'html/h01/main/common_hnode.es7'))
       const { htm01_html_scroll } = require(path.join(JS_SPC7, 'scroll/html/h01/main/htm01_scroll.es7'))

class hnode_type extends printlog {

  constructor (container = '')
  {
    super()
    this.n                   =   'hn01_hnode_type::'

    this.container           =   container
    this.s                   =   this.container.s
    this.u                   =   this.container.u
    this.hobject                   =   ''

    this.hnode               =   new common_hnode(this.container)

    // this.p('jntype_Page ' + this.u.page_name + ' P ' + this.s.cache_path)

    // Aqui podemos gestionar los tipos rest

    switch(this.hnode.s.cs.page_name)
    {
      // Special change to manage search  as a list
      case "search":
        this.hnode.s.cs.page_name = 'list'
        break;;
    }

    switch(this.s.page_type)
    {
        case "html":

          this.hobject          =   new htm01_html_scroll(this.hnode)
          break;;

        case "rest":
          // this.p('jn01_type_Rest_generation')
          // this.h          =   new h02_rest(this.arroba)
          break;;

        default:

          this.hobject          =   new htm01_html_scroll(this.hnode)
          break;;

    }

    // Call to hnode
    this.hobject.process_and_generate_html_file()

    // this.p(this.hobject.code)

  }

}

exports.hnode_type = hnode_type
