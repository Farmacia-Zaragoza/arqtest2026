define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { tdata_comm }       =   require(  path.join(JS_SPC7, 'acomm/json/j04/j01_tdata_comm.es7'));
       const { arroba_scomm }     =   require(  path.join(JS_TYF7, 'a01_load/scomm/s01_arroba_comm.es7'));
       const { arroba_sprod }     =   require(  path.join(JS_TYF7, 'a01_load/sprod/p01_arroba_prod.es7'));
       const { arroba_ecomm }     =   require(  path.join(JS_TYF7, 'a01_load/ecomm/e01_arroba_empty.es7'));

       const { theme_json }       =   require(  path.join(JS_SPC7, 'scroll/json/j04/j02_theme_json.es7'));

class theme_data extends tdata_comm
{
  constructor(arroba = '')
  {
    super(arroba)
    this.n                  =   "theme_data::"

    // scroll
    this.p ('J01_thm_data ' + '  ' + this.s.cs.page_name)


    // Manage ARROBA DATA
    switch(this.s.cs.page_name)
    {
      case "specific":
        // Hay que cargar el 6 de policy
        this.acontent     =  new arroba_scomm(this.arroba, 6)
        break;

      case "search":
        // Hay que cargar todos los articulos y filtrar las palabras de busqueda
        // Idea de drupal. Aqui los cargamos
        // Searching IT
        // this.p('j01_thmdat_SEARCHING  ' + this.s.ms.lang)
        // this.arroba.s.cs.loadtype = 'full'
        this.acontent     =  new arroba_mcomm(this.arroba, '20_40')
        // this.acontent     =  new arroba_fcomm(this.arroba)
        break;

      default:
        this.load_page_content()
        break;
    }

    this.thmjson            =  new theme_json(this.acontent.arroba)

    this.code               =  this.thmjson.code

  }

} // end Class

exports.theme_data = theme_data
