				break;
			case "gorilla":
				this.managebganimal(part)
				break;
			case "hippo":
				this.managebganimal(part)
				break;
			case "hippopotamus":
				this.managebganimal(part)
				break;
			case "hummingbird":
				this.managebganimal(part)
				break;
			case "iguana":
				this.managebganimal(part)
				break;
			case "impala":
				this.managebganimal(part)
				break;
			case "kudu":
				this.managebganimal(part)
				break;
			case "lynx":
				this.managebganimal(part)
