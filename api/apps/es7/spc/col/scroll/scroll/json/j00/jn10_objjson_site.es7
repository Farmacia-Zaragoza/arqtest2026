define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const 	echo 				= 	require(	'node-echo'										),
		sctf 				= 	require( 	path.join(JS_LIB7, 'file/save_code_to_file.es7'),
		{ typejson_object }	= 	require(	path.join(JS_OBJ, 'json/typejson_object.es6'));

class objjson_site extends typejson_object {
	constructor(file_name = '')
	{
		super(file_name)

		this.n 				= 	"objjson_site::"
	}

	managebganimal(part = false)
	{
				this.add_index(					this.index		)
				this.add_type(					this.type		)
				this.add_element( 		'name' , this.item	)
				this.add_element( 		'img' 	, this.photo	)
				if (part)
					this.add_element( 	'clink'	, this.link		)
				else
					this.add_lastelement( 	'clink'	, this.link		)
	}


	managespecifictype(part = false)
	{

	   switch(this.type){

			case "animal":
				this.add_index(					this.index		)
				this.add_type(					this.type		)
				this.add_element( 		'name' , this.item	)
				this.add_element( 		'sound' , this.sound	)
				this.add_element( 		'value' , this.value	)
				if (part)
					this.add_element( 	'clink'	, this.link		)
				else
					this.add_lastelement( 	'clink'	, this.link		)

				break;
			case "aligator":
				this.managebganimal(part)
				break;
			case "antelope":
				this.managebganimal(part)
				break;
			case "bear":
				this.managebganimal(part)
				break;
			case "buffalo":
