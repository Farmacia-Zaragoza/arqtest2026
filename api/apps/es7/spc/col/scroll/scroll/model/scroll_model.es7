// Must to be unique

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { common_model }  =   require(path.join(JS_SPC7, 'acomm/model/common_model.es7'))
        const { site_mcomm } = require(path.join(JS_TYF7, 'a01_load/mcomm/m02_site_comm.es7'))
        const { arroba_jtype } = require(path.join(JS_SPC7, 'scroll/json/j03/j01_arroba_type.es7'))
        const { site_uri } = require(path.join(JS_SPC7, 'scroll/uri/u01_site_uri.es7'))
        const { theme_data } = require(path.join(JS_SPC7, 'scroll/json/j04/j01_theme_data.es7'))

class scroll extends common_model
{
  constructor(pmt = '' )
  {
    // Debe generar la estructura sin basarse en la URL
    // PENDIENTE DE DEPURAR

    super(  pmt )

    this.n                =  'scroll::'

    //1. Multi Position EN -
    // Specific final comm
    this.comm             =   new site_mcomm(this.s, '0 1')
    this.copy_model()

    //2. URI SPECIFIC VERSION FOR ARQDRU - WILL MANAGE REAL COMMANDS
    this.uspc             =   new site_uri( this.comm.s   ,
                                            this.ir       )

    // Generate common json file - Forced type so we knew is another page
    this.commjson         =   new arroba_jtype(this.acomm   ,'comm')
    this.run_comm_model()

    // Generate common json file - Forced type so we knew is another page
    this.specjson         =   new arroba_jtype(this.arroba , 'spec')
    this.run_spec_model()

    this.thmdata          =   new theme_data(this.arroba)

  }

} // end Class

exports.scroll = scroll

