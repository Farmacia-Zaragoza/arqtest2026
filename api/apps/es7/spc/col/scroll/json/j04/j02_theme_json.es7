global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			);

const   { tjson_comm }      =   require(path.join(global.JS_SPC7, 'acomm/json/j04/j02_tjson_comm.es7'))
        const { theme_html } = require(path.join(global.JS_SPC7, 'scroll/html/h04/h01_theme_html.es7'))
        const { arroba_jtype } = require(path.join(global.JS_SPC7, 'scroll/json/j03/j01_arroba_type.es7'))

class theme_json extends tjson_comm
{
  constructor(arroba = '')
  {
    super(arroba)
    this.n                  =   "theme_json::"

    this.jcontent           =   new arroba_jtype(this.arroba)

    this.generate_content_json()

    this.thmhtml            =   new theme_html(this.arroba)
    this.code               =   this.thmhtml.code

  }

} // end Class

exports.theme_json = theme_json

