define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const 	{ getset } 			= 	require(	path.join(JS_BASE, 'com/objects/html/getset.es6')),
		{ html_style } 		= 	require(	path.join(JS_BASE, 'com/objects/html/html_style.es6')),
		scpf				= 	require( 	path.join(JS_BASE, 'com/libs/file/full_path/level_02/save_code_properties_filename.es6'));


class lnk04_css_inline_cinco extends html_style  {

    constructor (     thm	              						)
    {

		let 	tag_name	=	'style'
		super( tag_name )

		this.n							=	'scr01_cinco::'
		this.m							=	'constructor'

		this.thm						=	thm

		this.link_code_path				=	''

		this.link_01 = new html_style('link')

		this.build_data()

    }

    // Pendiente de ver como ponerlo
	create_googlefonts() {

		this.link_01.rel = 'stylesheet'
		this.link_01.type 			= 'text/css'
		// this.link_01.as 			= 'style'

		let url_awesome = 'https://fonts.googleapis.com/css?family=Roboto:300,400,500'

		this.link_01.href = url_awesome

		// this.link_01.href				=
		//	this.thm.u.http_domainbar + 'r_cassets/libs/css/fontawesome/' + css_name

		this.link_01.pcreate()

		this.code += this.link_01.code
	}

	create_fontawesome() {
		let css_name = 'all.css'

		this.link_01.rel = 'stylesheet'
		this.link_01.type 			= 'text/css'
		this.link_01.as 			= 'style'

//		this.link_01.integrity		=
//			"sha384-lZN37f5QGtY3VHgisS14W3ExzMWZxybE1SJSEsQp9S+oqd12jhcu+A56Ebc1zFSJ"
//		this.link_01.crossorigin	=	'anonymous'

		let url_awesome = 'https://use.fontawesome.com/releases/v5.7.2/css/'


		this.link_01.href = url_awesome + css_name

		// this.link_01.href				=
		//	this.thm.u.http_domainbar + 'r_cassets/libs/css/fontawesome/' + css_name

		this.link_01.pcreate()

		this.code = this.link_01.code + this.code
	}

/*
    // this is too long to load
    create_fontawesome()
    {
		let css_name 					=	'fontawesome_v57_min.css'

		this.link_code_path				=
				this.thm.s.cs.site_path + '/fassets/css/' + css_name


		this.content					+=
			scpf.file_get_code(this.link_code_path) + " "
	}
*/
	// <link rel="stylesheet" href="styles.821fc87c884b09994238.css"></head>
    create_style()
    {
		let css_name 					=	'styles.css'

		this.link_code_path				=
				this.thm.s.cs.site_path + '/dev/' + css_name


		this.content					+=
			scpf.file_get_code(this.link_code_path) + " "
	}

	// <link rel="stylesheet" href="styles.821fc87c884b09994238.css"></head>
    create_theme()
    {
		let css_name 					=	'theme.css'

		this.link_code_path				=
				this.thm.s.cs.site_path + '/dev/assets/' + css_name


		this.content					+=
			scpf.file_get_code(this.link_code_path) + " "
	}

    build_data()
    {

 		this.charset			=	"utf-8"

 		this.title				=	"css_style"
 		this.type				=	"text/css"

		// this.create_googlefonts()

		//this.create_bootstrap()
		// this.create_fontawesome()

		this.create_theme()
		this.create_style()

		this.pcreate()

		this.create_fontawesome()

		// Ok [17-11-02]
		// this.p('Code : >' + this.code )

    }

}

exports.lnk04_css_inline_cinco = lnk04_css_inline_cinco
