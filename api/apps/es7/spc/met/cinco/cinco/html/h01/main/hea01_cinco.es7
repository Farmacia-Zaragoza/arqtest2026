const { JS_TYP7  } = require(path.join(process.cwd(),'api/apps/paths.js'));

const  { common_head } 			= 	require(	cons.JS_ACO7 + 'html/h01/main/common_head.es7'			      ),
        { lnk01_link_cinco }    =   require(  cons.JS_MET7 + 'cinco/cinco/html/h01/main/lnk01_link_cinco.es7'    ),
        { met01_meta_cinco }    =   require(  cons.JS_MET7 + 'cinco/cinco/html/h01/main/met01_meta_cinco.es7'    );


class hea01_head_cinco extends common_head  {

  constructor (     arroba                )
  {
    super(          arroba  )

    this.n              =  'hea01_head::'
  }


  //   <div id="logo">
  create_metas()
  {
    // External Metas

    this.meta_01          =  new met01_meta_cinco( this.arroba  )

    this.content          +=  this.meta_01.code
  }

  create_links()
  {
    // External links
      this.link_01          =  new lnk01_link_cinco(this.arroba)

    this.content          +=  this.link_01.code
  }

}

exports.hea01_head_cinco = hea01_head_cinco
