global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			);

const  { common_head } 			= 	require(path.join(global.JS_ACO7, 'html/h01/main/common_head.es7'))
        const { lnk01_link_cinco } = require(path.join(global.JS_MET7, 'cinco/cinco/html/h01/main/lnk01_link_cinco.es7'))
        const { met01_meta_cinco } = require(path.join(global.JS_MET7, 'cinco/cinco/html/h01/main/met01_meta_cinco.es7'))

class hea01_head_cinco extends common_head  {

  constructor (     arroba                )
  {
    super(          arroba  )

    this.n              =  'hea01_head::'
  }

  //   <div id="logo">
  create_metas()
  {
    // External Metas

    this.meta_01          =  new met01_meta_cinco( this.arroba  )

    this.content          +=  this.meta_01.code
  }

  create_links()
  {
    // External links
      this.link_01          =  new lnk01_link_cinco(this.arroba)

    this.content          +=  this.link_01.code
  }

}

exports.hea01_head_cinco = hea01_head_cinco

