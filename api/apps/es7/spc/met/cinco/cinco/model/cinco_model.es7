// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { cinco_no_cache } =   require(path.join(JS_MET7, 'cinco/cinco/model/cinco_nocache_launcher.es7'))
        const { cinco_cache } = require(path.join(JS_MET7, 'cinco/cinco/model/cinco_cache_launcher.es7'))
        const { printlog } = require(path.join(JS_TYP7, 'logs/printlog.es7'))

class cinco extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                =  'cinco::'

    if (pmt.cache)      this.model          = new cinco_cache(    pmt  )
    else                this.model          = new cinco_no_cache( pmt  )
  }

} // end Class

exports.cinco = cinco
