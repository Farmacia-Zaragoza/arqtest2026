define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			)))

const   { tjson_comm }      =   require(  path.join(JS_SPC7, 'acomm/json/j04/j02_tjson_comm.es7'))),
        { theme_html }      =   require(  path.join(JS_MET7, 'cinco/cinco/html/h04/h01_theme_html.es7'))),
        { arroba_jtype }    =   require(  path.join(JS_MET7, 'cinco/cinco/json/j03/j01_arroba_type.es7')));

class theme_json extends tjson_comm
{
  constructor(arroba = '')
  {
    super(arroba)
    this.n                  =   "theme_json::"

    // this.p('j02_thmjson_HERE_Page_type ' + this.arroba.s.cs.page_type )

    this.jcontent           =   new arroba_jtype(this.arroba , 'content')
    this.generate_content_json()

    // Aqui podemos ajustar el contenido para hacer un listado con las busquedas

    // Con cache , aun no se ha generado la arroba
    this.thmhtml            =   new theme_html(this.arroba)

    this.code               =   this.thmhtml.code

  }

} // end Class

exports.theme_json = theme_json
