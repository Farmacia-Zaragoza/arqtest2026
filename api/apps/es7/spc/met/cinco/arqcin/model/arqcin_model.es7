// Must to be unique

global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			);

const  { arqcin_no_cache } =  require(path.join(global.JS_MET7, 'cinco/arqcin/model/arqcin_nocache_launcher.es7'))
        const { arqcin_cache } = require(path.join(global.JS_MET7, 'cinco/arqcin/model/arqcin_cache_launcher.es7'))
        const { printlog } = require(path.join(global.JS_TYP7, 'logs/printlog.es7'))

class arqcin extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                 =  'arqcin::'

    if (pmt.cache)
      this.model           = new arqcin_cache(    pmt  )
    else
      this.model           = new arqcin_no_cache( pmt  )
  }

} // end Class

exports.arqcin = arqcin

