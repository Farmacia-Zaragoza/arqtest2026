// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { common_model }  =   require(path.join(JS_SPC7, 'acomm/model/common_model.es7'))
        const { site_mcomm } = require(path.join(JS_TYF7, 'a01_load/mcomm/m02_site_comm.es7'))
        const { arroba_jtype } = require(path.join(JS_AQD7, 'arqdru/json/j03/j01_arroba_type.es7'))
        const { theme_data } = require(path.join(JS_AQD7, 'arqdru/json/j04/j01_theme_data.es7'))
        const { site_uri } = require(path.join(JS_MET7, 'cinco/arqcin/uri/u01_site_uri.es7'))

class arqcin_no_cache extends common_model
{
  constructor(pmt = '' )
  {

    super(  pmt )

    this.n                =  'arqcin_no_cache::'

	// Necesito mejorar el modelo. El sistema de cache no es optimo
	// Necesito crear un sistema que sea capaz de encontrar el tipo de pagina

    //1. Multi Position EN - Por defecto 0 2 5
    // Specific final comm
    this.comm              =  new site_mcomm(this.s, '0 2 4 5 15 16')
    this.copy_model()

    // Aqui ya lo conoce
    // this.p('arq_model_page X0 ' + this.comm.s.cs.page +  ' Lang ' + this.comm.s.cs.lang )

    //2. URI SPECIFIC VERSION FOR ARQDRU - WILL MANAGE REAL COMMANDS
    // Usando fast uri no funciona
    this.uspc             =   new site_uri( this.comm.s   ,
                                              this.ir       )

    // Generate common json file
    this.commjson         =   new arroba_jtype(this.acomm ,'comm')
    this.run_comm_model()

    // Generate spec json file
    this.specjson         =   new arroba_jtype(this.arroba , 'spec')
    this.run_spec_model()

    // this.p('arq_model_page C ' + this.arroba.s.cs.page +  ' Lang ' + this.arroba.s.cs.lang )

    this.thmdata          =   new theme_data(this.arroba)

    this.code             =   this.thmdata.code

  }

} // end Class

exports.arqcin_no_cache = arqcin_no_cache

