// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { backup_no_cache } =   require(  path.join(JS_MET7, 'backup/backup/model/backup_nocache_launcher.es7') ),
        { backup_cache }    =   require(  path.join(JS_MET7, 'backup/backup/model/backup_cache_launcher.es7'),
        { printlog }        =   require(  path.join(JS_TYP7, 'logs/printlog.es7'));

class backup extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                =  'backup::'

    if (pmt.cache)     this.model          = new backup_cache(    pmt  )
    else               this.model          = new backup_no_cache( pmt  )
  }

} // end Class

exports.backup = backup
