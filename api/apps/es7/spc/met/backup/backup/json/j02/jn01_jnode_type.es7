define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { printlog }          =   require(path.join(JS_TYP7, 'logs/printlog.es7'))
       const { jn01_common_json } = require(path.join(JS_MET7, 'backup/backup/json/j01/jn01_generate_common_json.es7'))
       const { jn11_spec_json } = require(path.join(JS_MET7, 'backup/backup/json/j01/jn11_generate_spec_json.es7'))
       const { jn20_search_json } = require(path.join(JS_MET7, 'backup/backup/json/j01/jn20_generate_search_json.es7'))
       const { jn03_product_json } = require(path.join(JS_MET7, 'backup/backup/json/j01/jn03_generate_product_json.es7'))

       const { jn04_teasers_json } = require(path.join(JS_MET7, 'backup/backup/json/j01/jn04_generate_teasers_json.es7'))
       const { jn05_rands_json } = require(path.join(JS_MET7, 'backup/backup/json/j01/jn05_generate_rands_json.es7'))
       const { jn06_list_json } = require(path.join(JS_MET7, 'backup/backup/json/j01/jn06_generate_list_json.es7'))

class jnode_type extends printlog {

  constructor (arroba = '')
  {
    super()
    this.n                  =   'jn01_jnode_type::'

    this.arroba             =   arroba
    this.s                  =   this.arroba.s
    this.a                  =   this.arroba.a

    this.arr                =   this.arroba.a.arr
    this.jobject            =   ''

    // Print PATH for JSONS ( Comm - Spec )
    // this.p('jn01_type_Page ' + this.s.cs.page_type + ' Pt ' + this.s.cs.cache_path)

    switch(this.s.cs.page_type)
    {
      case "spec":
        // Carga todos los articulos
        this.jobject          =   new jn11_spec_json(this.arroba)
        break;;

      case "comm":

        // Carga todos los articulos
        // this.p('jn01_type_Trying to loading COMM')
        this.jobject          =   new jn01_common_json(this.arroba)
        break;

      case "content":

        // Llega product pero ha generado mal el path
        // this.p('jn01_Before_Switch Content ' + this.s.cs.page_name )

        switch(this.s.cs.page_name)
        {

          case "nodef":
            // Carga todos los articulos
            this.jobject          =   new jn01_common_json(this.arroba)
            break;;

          case "blanc":
            // Carga todos los articulos
            this.jobject          =   new jn03_product_json(this.arroba)
            break;;

          case "front":

            this.jobject          =   new jn03_product_json(this.arroba)
            break;;

          case "policy":
            // this.p('jn02_type_Policy_generation')
            this.jobject          =   new jn02_policy_json(this.arroba)
            break;;

          case "product":

            this.jobject          =   new jn03_product_json(this.arroba)
            break;;

          case "photo":

            this.jobject          =   new jn03_product_json(this.arroba)
            break;;

          case "slide":

            this.jobject          =   new jn03_product_json(this.arroba)
            break;;

          case "gallery":

            this.jobject          =   new jn03_product_json(this.arroba)
            break;;

          case "teasers":
            // Ojo : puede ser list - gallery - tab - slide
            this.jobject          =   new jn04_teasers_json(this.arroba)
            break;;

          case "list":
             // Ojo : puede ser list - gallery - tab - slide
            this.jobject          =   new jn06_list_json(this.arroba)
            break;;

          case "rand":
            // Ojo : puede ser list - gallery - tab - slide
            // Deberia implementarse a nivel de cliente
            this.jobject          =   new jn05_rands_json(this.arroba)
            break;;

          case "search":
            // Entra aqui -- Carga todos los articulos
            // this.p ("jn01_jntype_Aqui tenemos la busqueda")

            this.jobject          =   new jn20_search_json(this.arroba)
            break;;

        }
        break;;
    }

  }

  //---------------------------------------------------------------------------------------------
  rungen_json()
  {
    // this.p('jn01_jntyp_RUNNING_RUNGEN')
    this.jobject.process_array_and_generate_json_file()

  }
}

exports.jnode_type = jnode_type

