define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const { getset } = require(path.join(JS_BASE, 'com/objects/html/getset.es6')),
	{ html_style } = require(path.join(JS_BASE, 'com/objects/html/html_style.es6'));


class scr02_js_scripts_backup extends getset {

	constructor(thm) {

		super()

		this.n = 'scr02_js_scripts_backup::'
		this.m = 'constructor'

		this.thm = thm

		this.script_01 = new html_style('script')

		this.script_02 = new html_style('script')

		this.script_03 = new html_style('script')

		this.build_data()

	}


	//[S_01] <script src="http://backup.vbrqx.com/dev/cassets/js/jquery-3.3.11.min.js"></script>
	//[S_01]<script src="https://code.jquery.com/jquery-3.3.11.min.js" integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8="
	//    crossorigin="anonymous"></script>

	create_jquery() {
		let js_name = 'jquery.min.js'

		// this.script_01.defer = 'defer'

		this.script_01.integrity	= 	"sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo"
		this.script_01.crossorigin	=	'anonymous'

		this.script_01.src =
			"https://code.jquery.com/jquery-3.3.1.slim.min.js"
		// this.thm.u.http_domainbar + 'r_cassets/libs/js/jquery/' + js_name

		this.script_01.pcreate()

		this.code += this.script_01.code
	}

	create_bootstrap() {
		let js_name = 'bootstrap.min.js'

		// this.script_01.defer = 'defer'

		this.script_01.integrity	= 	"sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM"
		this.script_01.crossorigin	=	'anonymous'

		this.script_01.src =
			"https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/" + js_name
		// this.thm.u.http_domainbar + 'r_cassets/libs/js/jquery/' + js_name

		this.script_01.pcreate()

		this.code += this.script_01.code
	}

	create_popper() {
		let js_name = 'popper.min.js'

		// this.script_01.defer = 'defer'

		this.script_01.integrity	= 	"sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1"
		this.script_01.crossorigin	=	'anonymous'

		this.script_01.src =
			"https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/" + js_name
		// this.thm.u.http_domainbar + 'r_cassets/libs/js/jquery/' + js_name

		this.script_01.pcreate()

		this.code += this.script_01.code
	}

	//[S_01]<script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.6.0/slick.min.js"></script>
	create_slick() {
		let js_name = 'slick.min.js'

		// this.script_01.defer = 'defer'


		this.script_01.integrity	= 	""
		this.script_01.src =
			"https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.6.0/slick.min.js"
		// this.thm.u.http_domainbar + 'r_cassets/libs/js/slick/' + js_name

		this.script_01.pcreate()

		this.code += this.script_01.code
	}


	//[S_01] <script type="text/javascript" src="runtime.js"></script>
	create_runtime() {
		this.script_02.defer = ''

		// this.script_01.async				=  	'async'

		let js_name = 'runtime.js'

		let path_pmt = 'dev/'
		// let	path_pmt							=	'ang/vx/'

		this.script_02.src =
			this.thm.s.cs.http_domainbar + path_pmt + js_name


		this.script_02.pcreate()

		this.code += this.script_02.code
	}


	//[S_02] <script type="text/javascript" src="polyfills.js"></script>
	create_polyfills() {
		this.script_02.async = ''

		this.script_02.defer = ''

		let js_name = 'polyfills.js'

		let path_pmt = 'dev/'
		// let	path_pmt							=	'ang/vx/'

		// DomainBAr http://backup.vbrqx.com/ang/vx/favicon.ico


		this.script_02.src =
			this.thm.s.cs.http_domainbar + path_pmt + js_name

		this.script_02.pcreate()

		this.code += this.script_02.code
	}


	//[S_02] <script type="text/javascript" src="polyfills.js"></script>
	create_scripts() {
		this.script_02.async = ''

		this.script_02.defer = ''

		let js_name = 'scripts.js'

		let path_pmt = 'dev/'
		// let	path_pmt							=	'ang/vx/'

		// DomainBAr http://backup.vbrqx.com/ang/vx/favicon.ico


		this.script_02.src =
			this.thm.s.cs.http_domainbar + path_pmt + js_name

		this.script_02.pcreate()

		this.code += this.script_02.code
	}


	//[S_04] <script type="text/javascript" src="main.d05ea5aaed6e4704fb1e.js"></script>
	create_main() {
		this.script_02.async = ''

		this.script_02.defer = ''

		let js_name = 'main.js'

		let path_pmt = 'dev/static/js/'
		// let	path_pmt							=	'ang/vx/'


		this.script_02.src =
			this.thm.s.cs.http_domainbar + path_pmt + js_name

		this.script_02.pcreate()

		this.code += this.script_02.code
	}

	//[S_04] <script type="text/javascript" src="main.d05ea5aaed6e4704fb1e.js"></script>
	create_chunk() {
		this.script_02.async = ''

		this.script_02.defer = ''

		let js_name = 'chunk.js'

		let path_pmt = 'dev/static/js/'
		// let	path_pmt							=	'ang/vx/'


		this.script_02.src =
			this.thm.s.cs.http_domainbar + path_pmt + js_name

		this.script_02.pcreate()

		this.code += this.script_02.code
	}


	build_data() {
		this.create_jquery()
		this.create_popper()
		this.create_bootstrap()

		this.create_chunk()

		this.create_main()


		// Ok [18-06-17]
		// this.p('js_scripts_Code : >' + this.code )

	}

}

exports.scr02_js_scripts_backup = scr02_js_scripts_backup
