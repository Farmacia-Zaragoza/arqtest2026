define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			)))

const  { getset }                    =   require(  path.join(JS_BASE, 'com/objects/html/getset.es6'))),
       { html_style }                =   require(  path.join(JS_BASE, 'com/objects/html/html_style.es6'))),
       { scr02_js_scripts_backup }   =   require(  path.join(JS_MET7, 'backup/backup/html/h01/deep/scripts/scr02_js_scripts_backup.es7'))),
       { scr03_js_minimized_backup } =   require(  path.join(JS_MET7, 'backup/backup/html/h01/deep/scripts/scr03_js_minimized_backup.es7'))),
       { scr05_js_inline_backup }    =   require(  path.join(JS_MET7, 'backup/backup/html/h01/deep/scripts/scr05_js_inline_backup.es7'))),
       { scr06_js_async_backup }     =   require(  path.join(JS_MET7, 'backup/backup/html/h01/deep/scripts/scr06_js_async_backup.es7')));


class scr01_js_backup extends getset  {

  constructor (     thm                            )
  {
    super()

    this.n              =  'scr01_dog::'
    this.m              =  'constructor'

    this.thm            =  thm

    // External object
    this.script_to_load        =  ''

    this.build_data()
    }


  build_data()
  {

      // DEV - requiere primero los otro scripts

    this.p('Checking_LiveOPT ' + this.thm.s.ms.live_opt )
    switch (this.thm.s.ms.live_opt )
    {
      case "script":
        this.script_to_load     =   new scr02_js_scripts_backup(this.thm)
        break;
      case "inline":
        this.script_to_load     =   new scr05_js_inline_backup(this.thm)
        break;
      case "inline_and_save":
        this.script_to_load     =   new scr05_js_inline_backup(this.thm)
        break;

      default:
        this.p('wrong_parameter ' + this.thm.s.ms.live_opt )

      }


      // MAIN - PRODUCT
     this.code                 +=  this.script_to_load.code

    // this.p('jsbackupCode : >' + this.code )

    }

}

exports.scr01_js_backup = scr01_js_backup
