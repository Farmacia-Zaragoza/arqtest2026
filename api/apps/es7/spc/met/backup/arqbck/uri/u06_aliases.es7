class uri_aliases extends site_common_commands
{
  constructor(site = '' , ir = '' )
  {
    super(  site, ir )
    this.n                  =   "site_uri::"
  }

//---------------------------------------------------------------------------------------------

  manage_aliases()
  {

     this.m                    = 'manage_commands'

     // this.start_position_array       =   this.start_position_array + 1

     // Piensa que aqui no se ha procesado la Uri pero slash no tiene el idioma ya
     // /en/intelligent_scroll

//     this.p('u01_site_uri_SITEALIAS KB A : ' + this.slash_ideal_uri )


     switch(this.slash_ideal_uri)
     {
      // Multi Lang article
      // Alias for page

      // Lists
      case "knowledge_information/":
        this.url_page_load_drupal_node('0')
        break;

      case "auto_scroll/":
        this.url_page_load_drupal_node('1')
        break;

      case "multiple_resolutions/":
        this.url_page_load_drupal_node('2')
        break;

      case "list_implementation/":
        this.url_page_load_drupal_node('3')
        break;

      case "regular_expresions/":
        this.url_page_load_drupal_node('4')
        break;

      case "marquee_text/":
        this.url_page_load_drupal_node('5')
        break;

      case "fast_movement_arrows/":
        this.url_page_load_drupal_node('6')
        break;

      case "anchors_in_angular_and_react/":
        this.url_page_load_drupal_node('7')
