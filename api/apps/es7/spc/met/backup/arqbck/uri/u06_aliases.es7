      case "intelligent_scroll/":
        this.url_page_load_drupal_node('8')
        break;

      case "secured_navigation/":
        this.url_page_load_drupal_node('9')
        break;

      case "pretty_print_pages/":
        this.url_page_load_drupal_node('10')
        break;

      default:
        this.p('u06_aliases_manage_front')
        this.manage_front()

    }

  }

} // end Class

