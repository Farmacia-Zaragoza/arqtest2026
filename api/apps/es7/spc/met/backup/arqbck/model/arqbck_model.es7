// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { arqbck_no_cache } =  require(  path.join(JS_MET7, 'backup/arqbck/model/arqbck_nocache_launcher.es7'));
       const { arqbck_cache }    =  require(  path.join(JS_MET7, 'backup/arqbck/model/arqbck_cache_launcher.es7')  ),
       const { printlog }        =  require(  path.join(JS_TYP7, 'logs/printlog.es7'));

class arqbck extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                 =  'arqbck::'

    if (pmt.cache)
      this.model           = new arqbck_cache(    pmt  )
    else
      this.model           = new arqbck_no_cache( pmt  )
  }

} // end Class

exports.arqbck = arqbck
