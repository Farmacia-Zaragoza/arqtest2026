const path = require('path');
global.JS_TYF7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t02/');
global.JS_LIB7 = path.join(global.ROOT, 'api/apps/es7/com/blib/');

// [DOCHANGED_ES7]
