// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

var    cons                =  require(  "/brqx/rcode/es7/com/agen/constants.es7"                         )

const  { arqliq_no_cache } =  require(  cons.JS_MET7  + 'liquid/arqliq/model/arqliq_nocache_launcher.es7'),
        { arqliq_cache }   =  require(  cons.JS_MET7  + 'liquid/arqliq/model/arqliq_cache_launcher.es7'  ),
        { printlog }       =  require(  cons.JS_TYP7  + 'logs/printlog.es7'                              );

class arqliq extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                 =  'arqliq::'

    if (pmt.cache)
      this.model           = new arqliq_cache(    pmt  )
    else
      this.model           = new arqliq_no_cache( pmt  )
  } 

} // end Class

exports.arqliq = arqliq
