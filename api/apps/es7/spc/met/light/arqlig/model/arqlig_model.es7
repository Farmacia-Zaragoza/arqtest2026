// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { arqlig_no_cache } =  require(path.join(JS_MET7, 'light/arqlig/model/arqlig_nocache_launcher.es7'))
        const { arqlig_cache } = require(path.join(JS_MET7, 'light/arqlig/model/arqlig_cache_launcher.es7'))
        const { printlog } = require(path.join(JS_TYP7, 'logs/printlog.es7'))

class arqlig extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                 =  'arqlig::'

    if (pmt.cache)
      this.model           = new arqlig_cache(    pmt  )
    else
      this.model           = new arqlig_no_cache( pmt  )
  }

} // end Class

exports.arqlig = arqlig
