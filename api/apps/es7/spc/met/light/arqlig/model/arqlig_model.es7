// cat package.json  | grep "\^" |cut -d '"' -f2 | tr "\n" " "

// Must to be unique

const { JS_TYP7  } = require(path.join(process.cwd(),'api/apps/paths.js'));

const  { arqlig_no_cache } =  require(  cons.JS_MET7  + 'light/arqlig/model/arqlig_nocache_launcher.es7'),
        { arqlig_cache }   =  require(  cons.JS_MET7  + 'light/arqlig/model/arqlig_cache_launcher.es7'  ),
        { printlog }       =  require(  cons.JS_TYP7  + 'logs/printlog.es7'                              );

class arqlig extends printlog
{
  constructor(pmt = '' )
  {

    super()

    this.n                 =  'arqlig::'

    if (pmt.cache)
      this.model           = new arqlig_cache(    pmt  )
    else
      this.model           = new arqlig_no_cache( pmt  )
  }

} // end Class

exports.arqlig = arqlig
