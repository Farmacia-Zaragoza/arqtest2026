define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			)))

const { post_process_commands } =   require( path.join(JS_MET7, 'light/arqlig/uri/u04_post_process_commands.es7')))


class site_uri_manage_commands extends post_process_commands
{
  constructor(site = '' , ir = '' )
  {
    super(  site, ir )
    this.n                  =   "site_uri_manage_commands::"
  }

//---------------------------------------------------------------------------------------------

  manage_commands()
  {

     this.m                    = 'manage_commands'

     this.start_position_array       =   this.start_position_array + 1

     this.p('u02_Comando para analizar A KB : ' + this.page_command      )

     switch(this.page_command)
     {
      // Multi Lang article
      // Alias for page
      // Enable aliases for architect
      case "knowledge":
        this.b.page_product        =   true
        this.b.intelligent_command =   false
        this.s.cs.page_name        =   'product'

        break;;

      case "kb":
        this.b.page_product       =    true
        this.b.intelligent_command =   false
        this.s.cs.page_name       =   'product'

        break;;

      // Direct Links

      case "knowledge_information":
        this.b.page_product       =   true
        this.b.intelligent_command = false
        this.s.cs.page_name       =   'product'
        break;

      case "auto_scroll":
        this.b.page_product       =   true
        this.b.intelligent_command = false
        this.s.cs.page_name       =   'product'
        break;

      case "multiple_resolutions":
        this.b.page_product       =   true
        this.b.intelligent_command = false
        this.s.cs.page_name       =   'product'
        break;

      case "list_implementation":
        this.b.page_product       =   true
        this.b.intelligent_command = false
        this.s.cs.page_name       =   'product'
        break;

      case "regular_expresions":
        this.b.page_product       =   true
        this.b.intelligent_command = false
        this.s.cs.page_name       =   'product'
        break;

      case "marquee_text":
        this.b.page_product       =   true
        this.b.intelligent_command = false
        this.s.cs.page_name       =   'product'
        break;

      case "fast_movement_arrows":
        this.b.page_product       =   true
        this.b.intelligent_command = false
        this.s.cs.page_name       =   'product'
        break;

      case "intelligent_scroll":
        this.b.page_product       =   true
        this.b.intelligent_command = false
        this.s.cs.page_name       =   'product'
        break;

      case "secured_navigation":
        this.b.page_product       =   true
        this.b.intelligent_command = false
        this.s.cs.page_name       =   'product'
        break;

      case "pretty_print_pages":
        this.b.page_product       =   true
        this.b.intelligent_command = false
        this.s.cs.page_name       =   'product'
        break;

      default:

        // llega blanc
        this.manage_common_commands()
    }

    // product
    // this.p('u02_AFTER page_name: ' + this.s.cs.page_name)

    // this.p('u02_mcomm_uri_SITEALIAS KB 0 : ' + this.slash_ideal_uri + ' = > ' + this.slash_alias_uri)

    // Manage and sort arguments
    // Hasta este punto no se conoce dash_sub_query
    this.process_commands()

    this.m                    = 'manage_commands'

    if (this.b.page_is_alias)
      this.manage_aliases()
    // this.p('u02_b_sc_page_name: ' + this.page_name)

    // Aqui ya se ha generado la uri en su totalidad
    this.post_process_commands()

    // this.p('u01_site_uri_Comando para analizar B: ' + this.page_command + ' ' + this.slash_sub_query)


    // This method will assure command is right for page
    this.sure_commands()

    // this.p('u02_c_sc_page_name: ' + this.page_name)

  }

} // end Class

exports.site_uri_manage_commands = site_uri_manage_commands
