const path = require('path');


function define(name, value) {
    Object.defineProperty(exports, name, {
        value:      value,
        enumerable: true
    });
}

if (!String.prototype.hasOwnProperty('hCode')) {
  Object.defineProperty(String.prototype, 'hCode', {
    value: function() {
      var hash = 0, i, chr;
      for (i = 0; i < this.length; i++) {
        chr   = this.charCodeAt(i);
        hash  = ((hash << 5) - hash) + chr;
        hash |= 0; // Convert to 32bit integer
      }
      return hash;
    },
    writable: true,      // Permite cambiar el valor si fuera necesario
    configurable: true,  // ¡CLAVE! Permite que Node no explote si se intenta redefinir
    enumerable: false    // Las funciones de prototipo no deben aparecer en los bucles for-in
  });
}

// Brqx Alphanumeric Code - Related to Human index
if (!String.prototype.hasOwnProperty('bCode')) {
  Object.defineProperty(String.prototype, 'bCode', {
    value: function() {
      var hash = '';
      var i, chr, part = '', partconv = '';
      for (i = 0; i < this.length; i++) {
        chr = this[i];
        if (chr == "v") {
          partconv = parseInt(part).toString(36);
          if (partconv.length < 2) partconv = "0" + partconv;
          hash += partconv;
          part = "";
        } else {
          part += chr;
        }
      }
      if (part != "") {
        partconv = parseInt(part).toString(36);
        if (partconv.length < 2) partconv = "0" + partconv;
        hash += partconv;
      }
      if (hash.length < 2) hash = "0" + hash;
      return hash;
    },
    writable: true,      // Permite cambios
    configurable: true,  // ¡VITAL! Permite que Vercel no explote al re-ejecutar
    enumerable: false    // No aparecerá en bucles for...in
  });
}


