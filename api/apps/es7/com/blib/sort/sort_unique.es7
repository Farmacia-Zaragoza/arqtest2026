		empty 				=   require(	'is-empty'									),
		util 				=   require(	'util'														),
		os					=	require(	'os'														),
    { printlog }         =   require(  path.join(JS_TYP7  , 'logs/printlog.es7' ));

// Ok [19-05-11]

// Ordena terminos de forma unica
function sort_unique(passed_array)
{

    let output_arr         = Array()
    let numbers_arr       = Array()
    let words_arr         = Array()

    output_arr    =    passed_array.sort()

    // this.p('u06-leneeeen : ' + this.uri_args_sorted.length )

    // Ahora los numeros deben ir al final

    for (var pos in output_arr)
    {
      var elem = output_arr[pos].toLowerCase()
      if (!isNaN(elem))
	  {
		if (!numbers_arr.includes(elem) )
			numbers_arr.push(    elem )
      }
      else
      {
		if (!words_arr.includes(elem) )
			words_arr.push(    elem   )

      }
    }

    if (numbers_arr.length > 0 )
    {
      for (pos in numbers_arr )
      {
        elem = numbers_arr[pos]
        words_arr.push( elem   )
      }
    }

	// Devuelve la lista ordenada. Si no se puede lo vamos a hacer con result
	return words_arr

}


// Ordena terminos de forma unica con una longitud minima ( busquedas )
function sort_unique_min_len(passed_array,min_len = 3)
{
	let notcheck_arr = sort_unique(passed_array)
    let words_arr         = Array()


    for (var pos in notcheck_arr)
    {
      var elem = notcheck_arr[pos]
      if (!isNaN(elem))
	  {
			words_arr.push(    elem )
      }
      else
      {
		if (elem.length > min_len)
			words_arr.push(    elem   )

      }
	}

	return words_arr
}

module.exports.sort_unique 				= 	sort_unique
module.exports.sort_unique_min_len		= 	sort_unique_min_len
