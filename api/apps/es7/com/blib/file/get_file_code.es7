define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			)))

const   fs           =   require(  'fs'                                                  ),
        path         =   require(  'path'                                                ),
        os           =   require(  'os'                                                  ),
        util         =   require(  'util'                                                ),
        empty        =   require(  'is-empty'                            );

//---------------------------------------------------------------------------------------------

function is_comment_line(line)
{
	// Funcion startsWith
	if ( line.lastIndexOf('#', 0) === 0  ||
	     line.lastIndexOf(' ', 0) === 0  ||
	     line.lastIndexOf('//', 0) === 0
	   )
	   return true
	return false

}

//---------------------------------------------------------------------------------------------

function get_file_code(full_file_name_int = '')
{
    // Lo estamos creando. El fichero no puede existir aun

  let code = ''
  if ( no_zero(full_file_name_int ))
	code += fs.readFileSync(full_file_name_int)
  return code
}

//---------------------------------------------------------------------------------------------

function set_file_array_no_comments(full_file_name_int = '')
{
	// echo ('File to read  ' + file_name )

  if ( !empty(full_file_name_int ) && fs.existsSync(full_file_name_int) )
  {
	var temp_arr = fs.readFileSync(full_file_name_int).toString().split('\n')
	this.arr = Array()

	for (pos in temp_arr)
	{
		line = temp_arr[pos]
		// echo('L ' + line)
		if (!is_comment_line(line) )
		{
			this.arr.push(line)
		}

	}
	// echo ('File Length  ' + this.arr.length )

	// Tenemos que devolverlo como objeto. Sino falla. En objetos si funciona pero con funciones y  arrays no
  }
}


//---------------------------------------------------------------------------------------------

function set_file_array_full(full_file_name_int = '')
{
	// echo ('File to read  ' + file_name )

  if ( !empty(full_file_name_int ) && fs.existsSync(full_file_name_int) )
  {
	this.arr = fs.readFileSync(full_file_name_int).toString().split('\n')

	// Tenemos que devolverlo como objeto. Sino falla. En objetos si funciona pero con funciones y  arrays no
  }
}

//---------------------------------------------------------------------------------------------

// Exist and is not zero size
function no_zero(full_file_name_int)
{
  // No es vacio el nombre
  // Existe el padre del fichero
  // fs.existsSync(path.dirname (full_file_name_int) ) &&
  // Existe el fichero
  // Getfile_Size no lo ejecuta

   var nozero = !empty(full_file_name_int )                       &&
                fs.existsSync(full_file_name_int)  &&
                ( get_file_size(full_file_name_int) > 1 )
   return nozero
}

//---------------------------------------------------------------------------------------------

// Don't Exist or  is not zero
// No existe el fichero
function zero(full_file_name_int)
{
   var zero =   !empty(full_file_name_int )         &&
                (
                !fs.existsSync(full_file_name_int) ||
                ( get_file_size(full_file_name_int) < 2 )
                )
   return zero
}

//---------------------------------------------------------------------------------------------

function get_file_size(filename)
{
    const stats = fs.statSync(filename)
    const fileSizeInBytes = stats.size
    return fileSizeInBytes

    console.info('SIZEEE  ' + fileSizeInBytes)
}


//---------------------------------------------------------------------------------------------
module.exports.zero                       = zero
module.exports.no_zero                    = no_zero
module.exports.get_file_size              = get_file_size
module.exports.get_file_code              = get_file_code
module.exports.set_file_array_no_comments = set_file_array_no_comments
module.exports.set_file_array_full        = set_file_array_full
