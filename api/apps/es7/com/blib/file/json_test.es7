define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			)))

const   gfc  			     =   require(  path.join(JS_LIB7, 'file/get_file_code.es7'))),
        validator            =   require(  'is-my-json-valid'            ),
        syncrequest          =   require(  'sync-request'             ),
        fs                   =   require(  'fs'                                                  );



//---------------------------------------------------------------------------------------------
// VAmos a tratarla como una clase
function jsonuritest(uri_to_test)
{
    // No funciona con SSL hay que ajustar la uri
    this.struct         = ''
    this.code           = 0
    this.result         = false

    var uri_no_ssl      = uri_to_test

    this.result = uri_to_test.replace( 'https' , 'http')

    if (uri_no_ssl != this.result )
       uri_no_ssl      = this.result

    // RUNNING URI http://brqx.work/cache/uritype/comm/nodef/nohuman/nouser/nocode/notrans/nosync/page_json.json
    console.info('RUNNING URI '  + uri_no_ssl)

	try
	{
     // El fichero debe no ser vacio
//      this.result            = true
      this.struct            = syncrequest.sync(uri_no_ssl)

      this.code              = this.struct.response.statusCode
      // El codigo es numerico
      this.result            = ( this.code === 200 )
      //this.result            = true
      //console.info('URI : CODE ' + this.code )

    } catch (err)
    {
	  console.info('CATCH :: jsonuritest Uri erronea ' + this.result  +  '  '  + uri_no_ssl)
	}
}

//---------------------------------------------------------------------------------------------

function jsontest(file_path)
{
    // El fichero debe no ser vacio
    var result               =  false
    var zero                 =  gfc.zero(file_path)

    // Si el fichero esta vacio o bien no existe devolvemos falso
    if ( zero ) return result

    var text                 =  fs.readFileSync(file_path , 'utf8')

    // var c1   = text.replace(/(?:^|:|,)(?:\s*\[)+/g,'')
    // var c2   = c1.replace(/"[^"\\\n\r]*"|true|false|null|-?\d+(?:\.\d*)?(?:[eE][+\-]?\d+)?/g, ']')
    // c1       = c2.replace(/\\["\\\/bfnrtu]/g, '@')
    // if (/^[\],:{}\s]*$/.test(c1)

    // Validadmos la sintaxis del json
	try
	{
		var result_int       = validator(text)
		result               =  true
    } catch (err)
    {
		console.info('s01_string JSON ERRONEO '  + file_path)
	}


    return result
}

function  create_json_line(check , code , ck_syn , ck_url)
{
  var res_cod = 'KO '    	        ;  var res_cod_ok  = 'OK '
  var res_syn = '( Syn KO )'        ;  var res_syn_ok  = '[ Syn Ok ]'
  var res_url = '( Url KO )'        ;  var res_url_ok  = '[ Url Ok ]'
  var line    = ''

  // Ok -> ( Syn Ok ) - ( Url OK )
  if (check ) res_cod = res_cod_ok ; line+=res_cod + '( ' + code + ' ) -> '
  if (ck_syn) res_syn = res_syn_ok ; line+=res_syn + ' '
  if (ck_url) res_url = res_url_ok ; line+=res_url + ' '

  return line

}


//---------------------------------------------------------------------------------------------
module.exports.jsontest                       = jsontest
module.exports.jsonuritest                    = jsonuritest
module.exports.create_json_line               = create_json_line
