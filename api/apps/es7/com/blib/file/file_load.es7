const { JS_TYP7  } = require(path.join(process.cwd(),'api/apps/paths.js'));

const   fs           =   require(  'fs'                                                  ),
        path         =   require(  'path'                                                ),
        os           =   require(  'os'                                                  ),
        util         =   require(  'util'                                                ),
        empty        =   require(  cons.NODE_MOD + 'is-empty'                            ),
        trim         =   require(  cons.NODE_MOD + 'trim'                                ),
        mkdirp       =   require(  cons.NODE_MOD + 'mkdirp'                     ),
        del          =   require(  cons.NODE_MOD + 'del'                        );

//---------------------------------------------------------------------------------------------

// No comments 2.0
function is_comment_line(line)
{
	// Funcion startsWith
	if ( line.lastIndexOf('#', 0) === 0   ||
	     line.lastIndexOf('//', 0) === 0  ||
	     (
	     (line.lastIndexOf(' ', 0) === 0 )   &&
	     (line.lastIndexOf(' ') === 0 )
	     )

	   )
	   return true
	return false

}

function properties_from_file (file_name)
{
	// echo ('File to read  ' + file_name )
	var temp_arr = fs.readFileSync(file_name).toString().split('\n')
	this.arr = Array()

	for (pos in temp_arr)
	{
		line = temp_arr[pos]
		// echo('L ' + line)
		if (!is_comment_line(line) )
		{
			this.arr.push(line)
		}

	}
	// echo ('File Length  ' + this.arr.length )

	// Tenemos que devolverlo como objeto. Sino falla. En objetos si funciona pero con funciones y  arrays no
}



//---------------------------------------------------------------------------------------------
module.exports.properties_from_file  = properties_from_file
