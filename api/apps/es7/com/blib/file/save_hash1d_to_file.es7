define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   fs           =   require(  'fs'                                    );
    
    const os = require(  'os'                                    );
    const util = require(  'util'                            );
    const empty = require(  'is-empty'                          );
    const trim = require(  'trim'                            );
    const mkdirp = require(  'mkdirp'                          );
	const echo = require(	'node-echo'									);
   const { printlog } = require(path.join(JS_TYP7, 'logs/printlog.es7'))

// Ck [19-06-03]
// Save Hash2d_to_file --> Guardamos el contenido del hash de 2dim en el fichero
function save_hash1d_to_file(full_file_name_int = ''       , // 01. File
                             arr_words          = ''       , // 02. Words
                             arr_articles       = ''       , // 03. Info
                             position_to_load   = ''       , // 04. Position
                             page_to_load       = ''       , // 05. Page
                             langs              = 'en'     ) // 06. Lang
{
  // OJO QUE ES UN HASH - NO UN ARRAY

  if (page_to_load != "")
    position_to_load += 'v' + page_to_load

  // 102 - 80
  // echo ('Entrando en la HASH1function ' + position_to_load + ' N ' + Object.entries(arr_words).length )

  if ( (Object.entries(arr_words).length > 0 ) )
  {

    // echo ('Es un hash')

    if ( !empty(full_file_name_int ) )
    {
      // echo ( "Creando Fichero " + full_file_name_int )
      // Primero debe existir el padre

      dir =  path.dirname(full_file_name_int)

      if ( !fs.existsSync(dir)       ||
           !fs.lstatSync(dir).isDirectory()     )
      {
        // No Existe el padre --> Lo creamos
        mkdirp.sync(dir)
        fs.chmodSync(dir, 0775)
        let user = os.userInfo().username

        // Solo lo podemos hacer si somos apache
        if (user == 'apache' )
          fs.chownSync(dir, 48 , 48 )
        }

        if ( fs.existsSync(full_file_name_int) )
          // Truncamos uno existente
          fs.closeSync(fs.openSync(full_file_name_int, 'w'))
        else
        {
          // Creamos uno
          fs.openSync(full_file_name_int, 'w')
		  fs.chmodSync(full_file_name_int, parseInt('0674',8))
		}

        // echo ('satf_Antes del for en la function ' + Object.entries(arr_properties).length )

    var num_repeat = ''
    var line_word = ''
    var line_count = ''
    var line_appear = ''
    var articles    = ''

    // Los indices van a ser nx

    // W O R D S
    let c = 0
    for (var word in arr_words)
    {
      num_repeat = arr_words[word]
      //OLD line_word='arr_nxj0'  + position_to_load + '_' + c  + '@' + word
      //NEW Line arr_nxj020_effect@23
      line_word='arr_nxj0'  + position_to_load + '_' + word + '@' + num_repeat

	  if (line_word != "" )
	  {
        input = line_word.replace('/\r\n/g', "")    // DOS style newlines
        input = input.replace('/\r/g', "")
        LNDATA= input + os.EOL
        fs.appendFileSync(full_file_name_int, LNDATA)
        c++
      }

    }

    // I N F O R M A T I O N
    c = 0
    for (var word in arr_words)
    {

      articles = arr_articles[word]
      line_appear='arr_nxi0' + position_to_load + '_' + word  + '@' + articles

	  if (line_appear != "" )
	  {
        input = line_appear.replace('/\r\n/g', "")    // DOS style newlines
        input = input.replace('/\r/g', "")
        LNDATA= input + os.EOL
        fs.appendFileSync(full_file_name_int, LNDATA)
        c++
      }

    }

   } // End If Empty File
  } // End If Arr Properties

}

module.exports.save_hash1d_to_file           = save_hash1d_to_file

