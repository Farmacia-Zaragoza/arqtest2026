define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   fs           =   require(  'fs'                                    );
    const path = require(  'path'                                    );
    const os = require(  'os'                                    );
    const util = require(  'util'                            );
    const empty = require(  'is-empty'                          );
  	const echo = require(	'node-echo'									);
    const trim = require(  'trim'                            );
    const mkdirp = require(  'mkdirp'                          );
    const { printlog } = require(path.join(JS_TYP7, 'logs/printlog.es7'))

// Ck [19-06-03]
// Save Hash_to_file --> Guardamos el contenido del hash de 1dim en el fichero
// Recibe una array de una dimension
function save_hash_to_file(full_file_name_int = ''   ,
                           arr_properties     = ''   ,
                           filter             = ''   )
{
  // OJO QUE ES UN HASH - NO UN ARRAY

  // 44
  // echo ('Entrando en la function ' + Object.entries(arr_properties).length )

  if ( (Object.entries(arr_properties).length > 0 ) )
  {

    // echo ('Es un hash')

    if ( !empty(full_file_name_int ) )
    {
      // echo ( "Creando Fichero " + full_file_name_int )
      // Primero debe existir el padre

      dir =  path.dirname(full_file_name_int)

      if ( !fs.existsSync(dir)       ||
           !fs.lstatSync(dir).isDirectory()     )
      {
        // No Existe el padre --> Lo creamos
        mkdirp.sync(dir)
        fs.chmodSync(dir, 0775)
        let user = os.userInfo().username

        // Solo lo podemos hacer si somos apache
        if (user == 'apache' )
          fs.chownSync(dir, 48 , 48 )
        }

        if ( fs.existsSync(full_file_name_int) )
          // Truncamos uno existente
          fs.closeSync(fs.openSync(full_file_name_int, 'w'))
        else
        {
          // Creamos uno
          fs.openSync(full_file_name_int, 'w')
		  fs.chmodSync(full_file_name_int, parseInt('0674',8))
		}

        // echo ('satf_Antes del for en la function ' + Object.entries(arr_properties).length )

    var DATA = ''
    var TSB = ''
    var regexok = true

    // EXPRESIONES_REGULARES_REGEX_WORKING
    //var regstr = new RegExp("^([a-z]" + filter + "v[0-9][0-9][0-9])$")
    var regstr = new RegExp("^([a-z]" + filter + ")$")

    for (var index1 in arr_properties)
    {

      // Filter j020v000
      if (filter != "" )
      {
        // echo ("hAYfiltroooo " + filter)
        regexok = regstr.exec(index1)
        //regesok = /^([a-z][0-9][0-9][0-9]v[0-9][0-9][0-9])$/.test(index1)
      }

      if (regexok)
      {
       // if (filter != "" )      echo('iNDEXXXXSAVE ' + index1 )

      TSB = arr_properties[index1]

      for (var arr_pos in TSB)
      {
        value =  TSB[arr_pos]

        // How we store STORE
        // en - j000 - 0 - value
	    // this.tsb[index1][arr_pos]		= 	value

        DATA='arr_' + index1 + '_' + arr_pos + '@' + value

        // Aqui tenemos que evitar los ctrl M
        // Est correcto pues hace un reemplazo global con la g

        // satf arr_p000v004_5@r_img/logos/logo_jr_brqx_2012_gold.gif
        // satf arr_i020v001v001_4@Силуэт: культовый. Дизайн: вне времени

        // echo ('satf ' + DATA)

        input = DATA.replace('/\r\n/g', "")    // DOS style newlines
        input = input.replace('/\r/g', "")
        LNDATA= input + os.EOL
        fs.appendFileSync(full_file_name_int, LNDATA)
      } // End For
      } // End Ifregex
    }

   } // End If Empty File
  } // End If Arr Properties

}

module.exports.save_hash_to_file           = save_hash_to_file

