const   path                =   require('path'                                             );

const { JS_TYP7 } = require(path.join(process.cwd()); 'api/apps/paths.js'));
const 	{ strings } 		  =  require(path.join(JS_TYP7 , 'string/s01_strings.es7'));


class arroba_mixarr extends strings {
  constructor() {
    super()
    this.n                          =   "arroba_mixarr::"

    this.current_value                   =   ""
    this.next_value                      =   ""

  }

  manage_right_index(index2)
  {
    this.rightindex2 = index2

    if (!empty(index2) && (index2 != "") )
    {

      this.innerpos = this.strpos(index2, "main")

      if (this.innerpos == false)
      {
        this.innerletter = index2.substr(0,1)
        this.innerrest   = index2.substr(1,index2.length)
        // Hay que preparar el  nuevo indice
        // this.p('a01_setarr ' + index2 + '   P  ' + arr_pos + ' V ' + value)
        if (this.innerletter != "")
        {
          this.rightindex2 = this.innerletter + this.innerrest.bCode()
          // this.p('a01_setarrA ' + this.rest         )
          // this.p('a01_setarrB ' + this.rest.bCode() )
        }
        else
          this.p('a01_setarrC ' + this.innerrest         )
      }
      else
      {
        // Index Encoding
        // this.p('--- Idx Encoding ---------a01_setarrD ' + index2         )
      }

    }
    else
      this.rightindex2 = ""
  }

  //---------------------------------------------------------------------------------------------
  // Crea un hast lang - code
  // Example : en - jmain - value
  mix_lang_arr_pos(index1 , index2 , arr_pos , value)
  {
    if ( !Array.isArray(this.arr) )
    {
      this.arr = Array()
    }

    if ( !Array.isArray(this.arr[index1]) )
    {
        // this.p('Setting Array 01 ' + index1)
        this.arr[index1]              = Array()
		if (index2 != "")
          this.arr[index1][index2]      = Array()
    }
    else
    {
      // Notice: Undefined index: i000v001v004v000v001
        if ( !Array.isArray(this.arr[index1][index2]) )
        {
          this.arr[index1][index2]      = Array()
        }
    }

    // en - j000 - 0 - value
    this.current_value                = this.arr[index1][index2][arr_pos]

	this.next_value                   = this.current_value + ' ' + 	value

	this.arr[index1][index2][arr_pos] = this.next_value

	this.set_tsb_arr_pos(index2 , arr_pos , this.next_value)
  }

}

exports.arroba_mixarr = arroba_mixarr
