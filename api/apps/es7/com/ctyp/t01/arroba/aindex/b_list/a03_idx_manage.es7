  manage_sheet(pos)
  {

    this.replace(this.s.cs.cache_path,'list','product')

    this.replace(this.result,'position','page')

    let pagestring = this.s.cs.position + '_' + pos

    this.replace(this.result,this.s.cs.position,pagestring)

    let file_to_save = this.result

    // this.p ('c01_sheet ' + pos + '   ' + file_to_save )
