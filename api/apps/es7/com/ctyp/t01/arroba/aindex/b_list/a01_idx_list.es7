define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { idx_pointers }                =   require(   path.join(JS_TYP7 , 'logs/idx_pointers.es7'   ));
       const { a02_idx_page } = require(   path.join(JS_TYP7 ,  'arroba/aindex/b_list/a02_idx_page.es7'  ));

// Common Array
class a01_idx_list extends a02_idx_page {

  constructor ()
  {
    super()
    this.n                =  'a01_idx_page::'
  }

  //---------------------------------------------------------------------------------------------
  // Recursive structure
  // Graba todos. Solo tiene sentido si es una lista
  save_arroba_index_list_to_file(
            index                 ,  // Indice
            enbreadcrumb  =   ''  ,  // Breadcrumb en ingles
            depth         =  0    ,
            lang          =   ''  )
  {

    this.m          = 'save_json_search_rcsv'

    var idx = new idx_pointers(index)

    var cats              =   this.gethash_arr(this.s.ms.main_lang, idx.jindex)

    var last_element           = Object.keys(cats).length - 1

    // 30 - j020  - 22 j020
    // this.p('jni_IND_INDEX ' + last_element + '  ' + idx.jindex )

    for (var pos in cats)
    {
      // a0001 .. a0050

      this.arroba_attribs(idx, pos)

      // a0010
      // this.p('a01_idxlist_INDEXXXX   ' +  '    ' + this.item)

      let current_level        = index     + 'v' + this.level
      let current_enbreadcrumb = enbreadcrumb + '/' + accents.remove (this.item ).toLowerCase()

      // add_json block
      this.rvlash_inner(current_level)
      this.index               = this.result

      this.level    =   depth

      // a0010 T sheet yes
      // this.p ("a01_idx_no_rcsv : " + this.item +  ' T '  + this.ntype + ' C ' + this.child )

      if ( this.child == "yes" )
      {
         switch (this.ntype)
         {
           case "branch":
             this.save_arroba_index_list_to_file(
                current_level          ,
                current_enbreadcrumb       ,  // Breadcrumb en ingles
                depth +1            )

             break;

           case "sheet":
             // this.p('an09 cat  Ind ' + this.cat  + ' Cin ' + this.child )

             // Def Current page for aword
             this.current_page = pos

             this.save_arroba_index_sheet_to_file(
                current_level          ,
                current_enbreadcrumb       ,  // Breadcrumb en ingles
                depth +1            )

             this.manage_sheet(pos)

             break;
         }

      }

     }  // End For

  }

}

exports.a01_idx_list = a01_idx_list
