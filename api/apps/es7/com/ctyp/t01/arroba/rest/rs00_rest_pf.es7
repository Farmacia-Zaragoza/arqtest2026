// - d-search_manage_term-          : Get object or array method fro common management
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

const path = require('path');

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { struc_attrib }         =   require(  path.join(JS_TYP7  , 'struc/s09_struc_attrib.es7'          )),
       { r12_product_sheet_pf } =   require(  path.join(JS_TYP7  , 'rest/r02_inner/r12_product_sheet_pf.es7')),
       { r02_product_sheet }    =   require(  path.join(JS_TYP7  , 'rest/r02_inner/r02_product_sheet.es7')),
       { r01_search_sheet }     =   require(  path.join(JS_TYP7  , 'rest/r02_inner/r01_search_sheet.es7' )),
       { r00_simple_sheet }     =   require(  path.join(JS_TYP7  , 'rest/r02_inner/r00_simple_sheet.es7' ));

class rs00_rest_pf extends struc_attrib {

  constructor (arroba = '' , rest = '')
  {
    super()
    this.n                  =  'rs00_rest_pf::'

    this.arroba             =   arroba
    this.arr                =   this.arroba.arr

    this.u					=   this.arroba.u

    this.s					=   this.arroba.s
    this.b					=   this.s.b

    this.rest               =   rest

    this.sheet              =   ''

    this.p('rs00_es_algo ' + this.s.cs.loadtype)
    if ( this.b.page_search)
    {
      this.p('rs00_es_una_busqueda')
      this.sheet              =   new r01_search_sheet()
    }
    else if (this.s.cs.loadtype == "page")
    {
      this.p('rs00_es_un_producto')
      this.sheet              =   new r12_product_sheet_pf()
    }
    else if (this.s.cs.loadtype == "position")
    {
      this.p('rs00_es_una_lista')
      this.sheet              =   new r02_product_sheet()
    }

    this.pf01               =   new r00_simple_sheet()

  }

  //---------------------------------------------------------------------------------------------

  search_manage_term(articles_arr , word)
  {
    this.m            =    'search_manage_term'
    // ALGORITMO

    // Tenemos una lista de articulos

    // Caso 01 : El array no tiene argumentos

    this.p('rs00_processSTR ' + word)

    let articles_pos = this.info[word].split(' ')

    if (!this.start_include)
  	{
      this.start_include = true
      for (var idx in articles_pos)
      {
         let article = articles_pos[idx]
         if (!articles_arr.includes(article) )
           articles_arr.push(article)
      }
  	}
  	else
  	{
  	// Caso 02 : El array tiene argumentos, priorizan los argumentos
  	// Se iteran y si no estan se sacan

      // Primera Iteracion LINEA ARTICULOS
      // Tenemos en array 10 12 25 42

      // Iiteramos 05 10 25

      // Resultado AND -> 25
      for (var line_idx in articles_pos)
      {
         let article = articles_pos[line_idx]
         if (!articles_arr.includes(article) )
             delete articles_pos[article]
      }

      // Iteramos 10 25

      for (var line_idx in articles_arr)
      {
         let article = articles_arr[line_idx]
         if (!articles_pos.includes(article) )
             delete articles_arr[article]
      }

      // Finalmente : 10 25

      // this.parr(articles_arr)
    }
  }

}

exports.rs00_rest_pf = rs00_rest_pf
