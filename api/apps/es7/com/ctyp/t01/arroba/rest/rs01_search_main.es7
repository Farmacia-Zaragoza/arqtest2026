const { JS_TYP7  } = require(path.join(process.cwd(),'api/apps/paths.js'));

const  { rs02_object_search_inner } =   require(  cons.JS_TYP7  + 'arroba/rest/rs02_search_inner.es7'  );

// Comm Object
class rs01_object_search_main extends rs02_object_search_inner {


  constructor (arroba , rest)
  {
    super(arroba , rest)
    this.n                   =  'rs01_object_search_main::'
  }

  //---------------------------------------------------------------------------------------------
  // Recursive structure
  gen_rest_search_main(  position   = '020'   )
  {

    // 020
    this.rest.item       = this.s.cs.loadtype

    // Rest result es si existe el fichero
    if (this.s.b.rest_result )
      this.rest.child      = "yes"
    else
      this.rest.child      = "yes"


    this.rest.type       = "bclink"

    // hmain
    if ( this.b.page_search)
      this.rest.hover      = "Seach hover " + this.u.bars_sub_query

    // this.rest.breadcrumb = ''

    // en/search/wysiwyg/regex/management
    // this.p ('j01_list_main ' + this.rest.item + '  ' + this.rest.hover)
    // this.p ('j01_list_mainURI ' + '  ' + this.u.uri )

    this.rest.link    = this.u.uri

    this.rest.index   = this.get_next_level(position)


    //       this.j.index             =   this.index

      // Procesa atributos del site ( se hace en arroba - aqui habria que eliminarlo)
      // this.process_site_values()                          ;

     var current_level = this.index

     this.p('rs01_Ssearch_mai RESU ' + this.rest.child)

     if ( this.rest.child == "yes" )
     {
       if (     this.s.b.page_search)  this.gen_rest_search_inner(  position           )
       else
       {
         // this.p('rs01_Ssearch_mai ' + this.s.cs.loadtype)
    	 switch(this.s.cs.loadtype)
    	 {
    	   case "position":  this.gen_rest_list_inner()  ;     break ;
    	   case "page":      this.gen_rest_page_inner()      ;      break ;
	     }

	   }

      }

  }

}

exports.rs01_object_search_main = rs01_object_search_main
