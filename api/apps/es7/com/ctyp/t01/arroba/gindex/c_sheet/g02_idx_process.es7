const path = require('path');

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { cache }              =   require(  path.join(JS_TYP7  , 'cache/c01_cache.es7'    )),
        { idx_pointers }         =   require(  path.join(JS_TYP7  , 'logs/idx_pointers.es7'              ));

class anode_gindex_sheet_process extends cache {
  constructor()
  {

    super()
    this.n                        = "anode_gindex_sheet_process::"
  }

  //---------------------------------------------------------------------------------------------
  // Will process all pages
  // MAIN/position/page --> @FORMAT
  current_index_sheet_process(lang                  ,
                  current_subpath       )
  {

    this.m          = 'current_index_list_process'

    this.rvlash( current_subpath )
    let index         = this.result

    // 020 - 001
    var idx = new idx_pointers(index)

    // this.p('g02_sheetProc Lang : ' + lang + ' Path ' +  current_subpath + ' Ind ' + index)

    // Los bucles tienen que ser con el idioma ingles

    // j020v001
    // this.p('an09_jindex ' + idx.jindex)
    let cats = this.gethash_arr(this.s.ms.main_lang, idx.jindex)

  // this.p('g02_sheet j06_Before-pos-bucle1 ' + lang + '  ' + cats.length )
    for (var pos in cats)
    {

      this.arroba_attribs(idx,pos)

      // this.p('g02_sheet ' + this.cat  + ' Cin ' + this.child )

      // this.p('an09 cat ' + index + ' P ' + pos + ' Chi ' + this.child + ' C ' + this.s.cat)

      // if ( lang == "es" )
      //    this.p ('Processing Lang ES ' + this.s.item )

      let next_level    = this.get_next_level(pos)
      let new_level     = index + 'v' + next_level
      let new_subpath   = current_subpath + '/' + 'l' +  next_level

      if ( (this.item  != "" ) || (this.photo != "")  )         this.term_process()

      // Estos ya estan metidos en el array asi que hay que iterar los hijos
      //this.p('LEVEL : ' + index + ' pos ' + pos + ' value: '  + cats[pos] + ' childrens: ' + chld[pos]  )

      // this.p('Pos ' + pos )
      // Si es no termina y se cierra la recursividad
      if ( (this.type == "parragraph"  ) ||  (this.type == "iparragraph" ) )
      {
          this.rvtoslash(index)
          let folder_to_load = this.s.ms.contents_path + 'l' +  this.result
          let pf_to_load         = folder_to_load       + '/' + this.value

          // 020v050 - 020v001
          // paragraph se corresponde con el indice de array 020v001v001
          // por lo que los parrafos internos deben corresponderse con 020v001v001v000

          // /brqx/struc/arq/kb/arqkb/l020/l000/a000_focus_details_en - 020v025v001
          // this.p('s02_sheet_file ' + pf_to_load + '  ' + new_level)

          this.generate_array_from_text_file( lang, pf_to_load, new_level)

	  }

    } // End For

  }

}

exports.anode_gindex_sheet_process = anode_gindex_sheet_process
