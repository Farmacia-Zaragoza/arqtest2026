class anode_gindex_main_load extends anode_gindex_main_process {
  constructor()
  {
    super()
    this.n                        = "anode_gindex_main_load::"
  }


  // Main Position Load --> Load only main position or 1 position of @ file
  main_index_list_load(index  = 'main' )
  {

	// this.p('j03_jno_Loading File_' + this.content_arr['en']['main'])

    // /brqx/struc/arq/kb/arqkb/en_cat
    let file_to_load = this.content_arr[this.s.ms.main_lang][index]

    // this.p('g01_jno ' + file_to_load )

    // El fichero principal para todos los idiomas es vacio menos para el ingles
    if (this.s.ms.lang === this.s.main_lang ) // Generate Array structure from @content
    {
      // this.p('g01_jno EN ' + file_to_load )
  	  this.generate_array_from_file( this.s.ms.main_lang,  file_to_load )
  	  // bb_no_esta_entrando
  	}
    else
      this.set_lang_arr(this.s.ms.lang)

	// this.p('j03_jnmain_Leng ' + this.arr['en']['jmain'].length)

    this.main_index_list_process(index )

  }

  main_index_page_load(index  = 'main' )
  {
    let file_to_load = this.content_arr[this.s.ms.main_lang][index]

    // this.p('g01_jno ' + file_to_load )

    // El fichero principal para todos los idiomas es vacio menos para el ingles
    if (this.s.ms.lang === this.s.main_lang ) // Generate Array structure from @content
    {
      // this.p('g01_jno EN ' + file_to_load )
  	  this.generate_array_from_file( this.s.ms.main_lang,  file_to_load )
  	  // bb_no_esta_entrando
  	}
    else
      this.set_lang_arr(this.s.ms.lang)

	// this.p('j03_jnmain_Leng ' + this.arr['en']['jmain'].length)

    this.main_index_page_process(index )

  }
}

exports.anode_gindex_main_load = anode_gindex_main_load


