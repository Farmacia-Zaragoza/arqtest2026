define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { anode_hsheet_load }  =   require(  path.join(JS_TYP7  , 'arroba/anode/a05_hsheet/an57_load.es7'));
       const { idx_pointers }       =   require(  path.join(JS_TYP7  , 'logs/idx_pointers.es7'                ));

class anode_hbranch_process extends anode_hsheet_load {
  constructor()
  {

    super()
    this.n                        = "anode_hbranch_process::"
  }

  //---------------------------------------------------------------------------------------------
  // Will process all pages
  // MAIN/position/page --> @FORMAT
  current_hbranch_process(lang                          ,
                               array_index_string       ,
                               file_structure_path      ,
                               current_subpath          ,
                               breadcrumb               ,
                               breadcrumb_lang          ,
                               title                    )
  {

    this.m          = 'current_process'

    var idx = new idx_pointers(array_index_string)

    //         j06 Proc Lang : es Path l000/l001/l000 Ind 000v001v000
    // this.p('j49_proc_Index : ' + array_index_string)

    // Los bucles tienen que ser con el idioma ingles

    // this.p('an49_jindex ' + idx.jindex)
    // this.p('an49_main_lang ' + this.s.ms.main_lang + ' '+ lang + '    ' + breadcrumb)

    // Procesamos el idioma ingles
    // Pero si el idioma es el castellano, igual tambien interesa procesarlo

    let cats = this.gethash_arr(this.s.ms.main_lang, idx.jindex)


  // this.p('j06_Before-pos-bucle1 ' + lang + '  ' + cats.length )
    for (var pos in cats)
    {
      if (!this.b.found_breadcrumb)
      {
    // Para cada uno hay que gestionar hijos


        this.arroba_attribs(idx, pos)

        this.arroba_attribs_main_lang(idx, pos)

         // Vamos a ir avanzando por la estructura y esta sera la base
         // Item es la el indice

        var new_breadcrumb      = breadcrumb      + '/' + this.link_en
        var new_breadcrumb_lang = breadcrumb_lang + '/' + this.link

        // this.p('an49 p_cat ' + pos + ' Breadcrumb ' + new_breadcrumb + ' FOUND ' + this.b.found_breadcrumb )

        // if ( lang == "es" )
        //    this.p ('Processing Lang ES ' + this.s.item )


        if ( (this.value  != "" ) ||(this.photo != "")  )this.term_process()

      // Estos ya estan metidos en el array asi que hay que iterar los hijos
      //this.p('LEVEL : ' + index + ' pos ' + pos + ' value: '  + cats[pos] + ' childrens: ' + chld[pos]  )

      // this.p('Pos ' + pos )
      // Si es no termina y se cierra la recursividad
        if ( this.child == "yes" )
        {

          let new_index_string         = array_index_string  + 'v'  +  this.level

          // File Structure
          let new_file_structure_path  = file_structure_path + '/a_' + this.link_en

          // kb/architecture
          let new_subpath              = current_subpath     + '/'   + this.link

          let new_title                = title               + ' ' + this.value
        // this.p('an09_procc_New subpath: ' + new_subpath)
           // Aqui igual necesitamos el titulo del padre
           //

          this.current_hbranch_load(  lang                        ,
                                           new_index_string            ,
                                           new_file_structure_path     ,
                                           new_subpath                 ,
                                           new_breadcrumb              ,
                                           new_breadcrumb_lang         ,
                                           new_title                   )


        } // End If

      }
    } // End For
  }

  //---------------------------------------------------------------------------------------------
  current_hbranch_process_es(lang                     ,
                                 array_index_string       ,
                                 file_structure_path      ,
                                 current_subpath          ,
                                 breadcrumb               ,
                                 breadcrumb_lang          ,
                                 title                    )
  {

    this.m          = 'current_process'

    var idx = new idx_pointers(array_index_string)

    let cats = this.gethash_arr(this.s.ms.main_lang, idx.jindex)

      // PROCESAMIENTO OTRO IDIOMA

    // let cats_es = this.gethash_arr(lang, idx.jindex)


    for (var pos in cats)
    {
      if (!this.b.found_breadcrumb_lang)
      {
         this.arroba_attribs(idx, pos)

         this.arroba_attribs_main_lang(idx, pos)

          // this.breadcrumb = this.gethash_keylang(idx.bindex, pos)

          // this.hover      = this.gethash_keylang(idx.hindex, pos)

         // Vamos a ir avanzando por la estructura y esta sera la base
          var new_breadcrumb      = breadcrumb      + '/' + this.link_en
          var new_breadcrumb_lang = breadcrumb_lang + '/' + this.link

          // this.p('an49 BREADCRUMB_ES ' + new_breadcrumb)

        // this.p('an49 cat ' + index + ' Breadcrumb ' + new_breadcrumb + ' FOUND ' + this.b.found_breadcrumb )

        // if ( lang == "es" )
        //    this.p ('Processing Lang ES ' + this.s.item )

      // Estos ya estan metidos en el array asi que hay que iterar los hijos
      //this.p('LEVEL : ' + index + ' pos ' + pos + ' value: '  + cats[pos] + ' childrens: ' + chld[pos]  )

      // this.p('Pos ' + pos )
      // Si es no termina y se cierra la recursividad
        if ( this.child == "yes" )
        {
          // devolvera la cadena acorde an nivel pero no el nivel actual

          let new_index_string         = array_index_string  + 'v'  +  this.level

          // File Structure
          let new_file_structure_path  = file_structure_path + '/a_' + this.link_en

          // kb/architecture
          let new_subpath              = current_subpath     + '/'   + this.link

          let new_title                = title  + ' ' + this.value
        // this.p('an09_procc_New subpath: ' + new_subpath)
           // Aqui igual necesitamos el titulo del padre
           //

          this.current_hbranch_load_es( lang                        ,
                                             new_index_string            ,
                                             new_file_structure_path     ,
                                             new_subpath                 ,
                                             new_breadcrumb              ,
                                             new_breadcrumb_lang         ,
                                             new_title                   )

        } // End If

      }
    } // End For

  }

}

exports.anode_hbranch_process = anode_hbranch_process
