define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { anode_run_multi } =   require(  path.join(JS_TYP7  , 'arroba/anode/a02_multi/an22_run.es7'));
       const { idx_pointers }    =   require(  path.join(JS_TYP7  , 'logs/idx_pointers.es7'     ));

class anode_main_full_process extends anode_run_multi {
  constructor()
  {
    super()

    this.n                        = "anode_main_full_process::"
  }

  //---------------------------------------------------------------------------------------------
  // Procesa Todo el contenido en idioma ingles
  main_full_process(   lang  = 'en'                ,
                       index = 'main'              ,
                       current_subpath = ''        )
  {

    var idx = new idx_pointers(index)
    let cats = this.gethash_arr(this.s.ms.main_lang, idx.jindex)                              ;

    for (var pos in cats)
    {
      this.arroba_attribs(idx, pos)

      current_subpath  = 'l' +  this.dhild

      // this.p('Pos: ' + pos + ' Item : ' + this.item + ' Child: ' + this.child)

      if ( this.child == "yes" )
      {
        // jn03_jn_main_Cat : search Pat: l050
        // this.p('jn03_jn_main_Cat : ' + this.item + ' Pat: ' + current_subpath)

        this.current_load(lang, current_subpath)
      }

    }
  }


}

exports.anode_main_full_process = anode_main_full_process
