//-------------------------------------------------------------------------------------
// Fast node load - Replace Mysql connections - Taxonomy Class
//-------------------------------------------------------------------------------------
// Cada tipo de archivo debe heredar anode para ser capaz de manejar ficheros de propiedades
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
//- d-run_multi_position_load-   : Load from main only specific position
//- d-run_multi_page_load-       : Load from main only specific page
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
//-------------------------------------------------------------------------------------
// Inheritance Line : 
//-------------------------------------------------------------------------------------
// AnoRunMulti > AnoMultiLoad > AnoMultiProcess >AnoRunPosition
// @Anode >  ...
//-------------------------------------------------------------------------------------
// Execution Line : 
//-------------------------------------------------------------------------------------
// run_multi_position_load > main_multi_position_load >
//-------------------------------------------------------------------------------------

//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

var   cons                  =   require(  "/brqx/rcode/es7/com/agen/constants.es7"         )

const  { anode_multi_load }   =   require(  cons.JS_TYP7  + 'arroba/anode/a02_multi/an24_multi_load.es7'      )

class anode_run_multi extends anode_multi_load {
  constructor()  
  {
    super()

    this.n                  =   "anode_run_multi::"
  }

  //---------------------------------------------------------------------------------------------  
  run_multi_position_load(positions = '')
  {
    this.m                =   'run_multi_position_load'

    // 1. Cargamos la informacion del idioma principal (ingles)
    // this.p('an22_r ms: ' + positions  + '  ' +  this.s.ms.lang + ' cs ' + this.s.cs.lang  )

    let before_lang       =   this.s.ms.lang


    if ( this.b.language_already_loaded == false  )
    {
      this.s.ms.lang           =   'en'
      this.s.cs.lang         =   this.s.ms.lang    
    
      this.main_multi_position_load(positions)    
    }

    this.s.ms.lang           =   before_lang
    this.s.cs.lang           =   this.s.ms.lang    

    this.p('an22_Generating_Lang DE ' + this.s.ms.lang )
    if ( this.s.ms.lang != 'en' )
    {
      this.p('an22_jnod_Loading Multi ' + this.s.ms.lang )
      this.main_multi_position_load(positions)    
      
      // Aqui esta ok 
      if (this.s.ms.lang == 'ja' )
      {
        // this.p('an22_child ' + this.arr['ja']['i000v005'][1])
        // this.p('an22_r ' + this.s.ms.lang + '   ' +  this.getkey( 'ja' , 'i000v005' , 1 ) )
      }      
    }
  }

  //---------------------------------------------------------------------------------------------  
  // Tenemos un nivel Mas : Multipage
  // @Format : Articulos - Positions - Pages
  run_multi_page_load()
  {
    // 1. Cargamos la informacion del idioma principal (ingles)
    let before_lang       =   this.s.ms.lang

    // this.p('an22_langs_check ms: ' + this.s.ms.lang + ' cs: ' + this.s.cs.lang  )

    if ( this.b.language_already_loaded == false  )
    {
       this.s.ms.lang           =   'en'
       this.s.cs.lang         =   this.s.ms.lang    
    
       this.main_multi_page_load()    
       
       // this.p('an22_FOUNDED_TYPE ' + this.s.cs.founded_type)
    }

    this.s.ms.lang           =   before_lang
    this.s.cs.lang         =   this.s.ms.lang    
    
    if ( this.s.ms.lang != 'en' )
    {
      // this.p('j02_jnod_Loading ES')
      this.main_multi_page_load()    
    }
  }

  
}

exports.anode_run_multi = anode_run_multi