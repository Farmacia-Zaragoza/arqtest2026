define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { anode_index_page_load }   =   require(  path.join(JS_TYP7  , 'arroba/anode/a09_index_page/an87_page_load.es7'),
       const { idx_pointers } =   require(  path.join(JS_TYP7  , 'logs/idx_pointers.es7'     ));

class anode_main_index_page_process extends anode_index_page_load {
  constructor()
  {
    super()

    this.n                        = "anode_main_index_page_process::"
  }


  //---------------------------------------------------------------------------------------------
  // Procesa Solo la primera posicion y la primera pagina
  main_index_page_process(   index           = 'main'    ,
                       current_subpath = ''        )
  {

    var idx = new idx_pointers(index)

    // Set Arroba attribs
    this.arroba_attribs(idx, this.s.cs.position)

    // this.p('an76_mp_Cat Lang : ' + this.item + ' Cat ')

    current_subpath  = 'l' +  this.dhild

    //// this.p('an76_jnod_Pos: ' + this.s.position + ' Cat : ' + this.item + ' Child: ' + this.child)

    if ( this.child == "yes" )
    {
      // articles - l20
      // this.p('an76_Cat Lang : ' + this.s.cs.lang + ' Cat '  + this.item + ' Pat: ' + current_subpath)

      this.current_index_page_load(this.s.ms.lang , current_subpath)
    }

  }


}

exports.anode_main_index_page_process = anode_main_index_page_process
