define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { anode_main_position_process } =   require( path.join(JS_TYP7  , 'arroba/anode/a03_position/an36_main_process.es7' ) );


class anode_main_position_load extends anode_main_position_process {
  constructor()
  {
    super()
    this.n                        = "anode_main_position_load::"
  }

  //---------------------------------------------------------------------------------------------
  // Main Position Load --> Load only main position or 1 position of @ file
  main_position_load(index  = 'main' )
  {

	// this.p('j03_jno_Loading File_' + this.content_arr['en']['main'])

    let file_to_load = this.content_arr[this.s.ms.main_lang][index]


    // this.p('j03_jno ' + file_to_load +  ' =+= ' + this.cache_path)

    // El fichero principal para todos los idiomas es vacio menos para el ingles
    if (this.s.ms.lang === this.s.main_lang ) // Generate Array structure from @content
    {
      // this.p('j03_jno EN ' + file_to_load )
  	  this.generate_array_from_file( this.s.ms.main_lang,  file_to_load )
  	}
    else
      this.set_lang_arr(this.s.ms.lang)

	// this.p('j03_jnmain_Leng ' + this.arr['en']['jmain'].length)

    this.main_position_process(index )

  }
}

exports.anode_main_position_load = anode_main_position_load

