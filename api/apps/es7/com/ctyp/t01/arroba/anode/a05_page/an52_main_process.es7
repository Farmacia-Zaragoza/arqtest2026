define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { anode_page_load }   =   require(  path.join(JS_TYP7  , 'arroba/anode/a05_page/an54_page_load.es7'  ) );
       const { idx_pointers } = require(  path.join(JS_TYP7  , 'logs/idx_pointers.es7'     )   );

class anode_main_page_process extends anode_page_load {
  constructor()
  {
    super()

    this.n                        = "anode_main_page_process::"
  }

  //---------------------------------------------------------------------------------------------
  // Procesa Solo la primera posicion y la primera pagina
  main_page_process(   index           = 'main'    ,
                       current_subpath = ''        )
  {

    var idx = new idx_pointers(index)

    this.cat    = this.getkeymain( idx.jindex , this.s.cs.position)
    this.child  = this.getkeymain( idx.cindex , this.s.cs.position)
    this.dhild  = this.getkeymain( idx.dindex , this.s.cs.position)

    // this.p('an06_mp_Cat Lang : ' + this.cat + ' Cat ')

    current_subpath  = 'l' +  this.dhild

    //// this.p('j04_jnod_Pos: ' + this.s.position + ' Cat : ' + this.cat + ' Child: ' + this.child)

    if ( this.child == "yes" )
    {
      // this.p('Cat Lang : ' + this.s.lang + ' Cat '  + this.cat + ' Pat: ' + current_subpath)

      this.page_load(this.s.ms.lang , current_subpath)
    }

  }

}

exports.anode_main_page_process = anode_main_page_process

