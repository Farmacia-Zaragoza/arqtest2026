global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			);

const  { anode_load }       =   require(  path.join(global.JS_TYP7 , 'arroba/anode/a00_comm/an07_load.es7' )     )

class anode extends anode_load {
  constructor(    site   , u = ''            )
  {
    super()

    this.n                          =   "anode::"

    this.s					        =   site
    this.b                          =   this.s.b
    this.u                          =   u

    this.content_arr['en']          = Array()
    this.content_arr['en']['main']	         = this.s.ms.contents_path + 'en_cat'

    // llega es
    this.p('an01_Anode_cons_lNG ' + this.s.cs.lang + ' DD ' + this.s.ms.lang )

    this.reload_lang()

  }

  reload_lang()
  {
    if (this.s.cs.lang != 'en' )
    {
      this.content_arr[this.s.cs.lang] = Array()
      this.content_arr[this.s.cs.lang]['main'] = this.s.ms.contents_path + this.s.cs.lang + '_cat'
    }

  }
}

exports.anode = anode

