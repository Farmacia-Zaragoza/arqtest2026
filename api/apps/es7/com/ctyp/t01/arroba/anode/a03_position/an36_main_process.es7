define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { anode_run_hierarchical } =   require(  path.join(JS_TYP7  , 'arroba/anode/a04_hbranch/an42_run.es7'  )),
       { idx_pointers }           =   require(  path.join(JS_TYP7  , 'logs/idx_pointers.es7'       ));

class anode_main_position_process extends anode_run_hierarchical {
  constructor()
  {
    super()

    this.n                        = "anode_main_position_process::"
  }

  //---------------------------------------------------------------------------------------------
  // Procesa Solo la primera posicion o la pasada
  main_position_process(   index           = 'main'    ,
                           current_subpath = ''        )
  {

    var idx     = new idx_pointers(index)

    this.arroba_attribs(idx, this.s.cs.position)

    current_subpath  = 'l' +  this.dhild

    // this.p('j04_jnod_Pos: ' + this.s.position + ' Item : ' + this.item + ' Child: ' + this.child)

    if ( this.child == "yes" )
    {
      // this.p('an36_Cat Lang : ' + this.s.ms.lang + ' Item '  + this.item + ' Pat: ' + current_subpath)

      this.current_load(this.s.ms.lang , current_subpath)
    }

  }

}

exports.anode_main_position_process = anode_main_position_process
