define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { anode_process } =   require(  path.join(JS_TYP7  , 'arroba/anode/a00_comm/an09_process.es7'    )    )


class anode_load extends anode_process {
  constructor()
  {
    super()
    this.n                        = "anode_load::"
  }

  //---------------------------------------------------------------------------------------------
  current_load(  lang            = 'en' ,
                 current_subpath = ''   )
  {

  // el indice deberi aser un cambio de slash (/) por dash (_)
    this.rslash( current_subpath )

  // Indice para el array de ficheros - Nombres de los archivos
    let content_index = this.result

  // Indice para el array de contenidos - Informacion de los archivos
    this.rvlash( current_subpath )

    let index         = this.result

    // Define el array si no esta definido
  // this.p('j04_index Content Index ' + content_index)

    // ANTES DE GUARDAR LOS ARCHIVOS DEBEMOS SABER SI VAN A SER HOJAS O RAMAS (pendiente)

    // Para el ingles lo generamos aqui

    this.set_lang_content_arr( lang )

    // this.p('j04_Before_ : ' + lang + '  ' + content_index )
    // en -  l000_l001_l000
    this.content_arr[lang][content_index]  = this.s.ms.contents_path +  current_subpath + '/' + lang + '_cat'

  // Generate array of files for fast load
  // En este punto debemos saber si los ficheros son hojas o no

  // Esta parte no se si la vamos a hacer
    ////if ( lang == 'en' )
    ////  this.generate_content_file_langs(content_index , current_subpath)

    // this.p('j04_New File to Load:  '  + this.content_arr[content_index][lang])

    // Cargamos el array con la informacion

    var file_to_load = this.content_arr[lang][content_index]

    // if ( lang == 'es')
    // {
    // Uncomment to see what files we are loading

    // ya esta cargando bien el idioma
    // this.p('an07_file_' + lang + ' F ' + file_to_load)
    // this.p('jn5_subpath ES ' + current_subpath)
    //}
    // /brqx/pers/struc/arqdru/fnode/json_lang_structure/l050/l000/en_cat

    if (this.s.cs.page_type == "content"  && (lang != "en") )
      this.generate_array_from_file_review_size( lang ,  file_to_load)
    else
      this.generate_array_from_file( lang ,  file_to_load)
    // load_file_information - generate

    // if ( index === '000v005' && lang === 'ja' )
    //   this.p('an07_child ' + this.arr['ja']['i000v005'][1])

    // Aqui hay que preparar la recursividad
    this.current_process( lang                        ,
                          current_subpath             )
  }


  // generate content file for any lang
  // Estno no se si es necesario ya (pendiente)
  //---------------------------------------------------------------------------------------------
  generate_content_file_langs(content_index , current_subpath)
  {
    var lang = ''
    for (var pos_lang in this.arr['allowed_langs'] )
    {
      lang = this.arr['allowed_langs'][pos_lang]
      // this.p ('jn04_anode Gen ' + current_subpath + '/' + lang )
      // Se guarda en content_arr (SINGULAR)

      let file_path = this.s.ms.contents_path +  current_subpath + '/' + lang + '_cat'

      this.set_lang_content_arr( lang )

        // /brqx/pers/struc/arqdru/fnode/json_lang_structure/l030/es_cat
    // this.p ('jn04_anode F ' + file_path  )
      this.content_arr[lang][content_index]  = file_path
    }
  }
}

exports.anode_load = anode_load

