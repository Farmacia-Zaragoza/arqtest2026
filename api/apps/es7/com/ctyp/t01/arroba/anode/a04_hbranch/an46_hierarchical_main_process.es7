define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { anode_hbranch_load }  =   require(  path.join(JS_TYP7  , 'arroba/anode/a04_hbranch/an47_load.es7' )  );
       const { idx_pointers } = require(  path.join(JS_TYP7 , 'logs/idx_pointers.es7'       ) );

class anode_hierarchical_main_process extends anode_hbranch_load {
  constructor()
  {
    super()

    this.n                        = "anode_hierarchical_main_process::"
  }

  //---------------------------------------------------------------------------------------------
  // Procesa Solo la primera posicion o la pasada
  main_hierarchical_process(   index               = 'main'    ,
                               array_index_string  = ''        ,
                               file_structure_path = ''        ,
                               current_subpath     = ''        )
  {

    this.m      = 'main_hierarchical_process'

    var idx     = new idx_pointers(index)

    this.arroba_attribs(idx, this.s.cs.position)

    this.arroba_attribs_main_lang(idx , this.s.cs.position)

    // Vamos a ir avanzando por la estructura y esta sera la base
    // kb
    var breadcrumb      = this.breadcrumb_en
    var breadcrumb_lang = this.breadcrumb

    // this.p('an46_breadcrumb_B_DGX ' + breadcrumb)
    // this.p('an46_breadcrumb_L_DGX ' + breadcrumb_lang)

    // El indice inicial es sin la v o sea 040

    array_index_string  = this.dhild

    // l040
    current_subpath     = 'l' +  this.dhild

    file_structure_path = current_subpath

    // this.p('an46_jnod_Pos: ' + this.s.cs.position + ' Item : ' + this.item + ' Child: ' + this.child)

    if ( this.child == "yes" )
    {
      // this.p('an46_Cat Lang : ' + this.s.ms.lang + ' Item '  + this.item + ' Pat: ' + current_subpath)
      // cache::main_hierarchical_process - an36_Cat Lang : en Cat hierarchical_kb Pat: l040
      // cache::main_hierarchical_process - an36_Cat Lang : es Cat hierarchical_kb Pat: l040

      // this.p('an46_call_to_hierarchical_structure ' + this.s.cs.slash_hierarchi)
      // this.p('an46_init_path ' + init_subpath)

      // en l040 kb
      // English Breadcrumbs
      // kb/systems/databases

      let saved_array_index_string  = array_index_string
      let saved_file_structure_path = file_structure_path
      let saved_current_subpath     = current_subpath
      let saved_breadcrumb          = breadcrumb
      let saved_breadcrumb_lang     = breadcrumb_lang

      this.current_hbranch_load(this.s.ms.lang      , // en
                                     array_index_string  , //
                                     file_structure_path , //
                                     current_subpath     , //
                                     breadcrumb          ,
                                     breadcrumb_lang     ) //

      // Espanish breadcrumbs
      // kb/sistemas/basesdedatos

      if (this.s.ms.lang != 'en')
      {
        // this.p ('an46_Entering in LANG BREADCRUMB')
        this.current_hbranch_load_es(this.s.ms.lang      ,
                                          saved_array_index_string  ,
                                          saved_file_structure_path ,
                                          saved_current_subpath     ,
                                          saved_breadcrumb          ,
                                          saved_breadcrumb_lang     )
      }

    }

  }

}

exports.anode_hierarchical_main_process = anode_hierarchical_main_process

