define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			)))

const   { anode_hsheet_process } =   require(  path.join(JS_TYP7  , 'arroba/anode/a05_hsheet/an59_process.es7'     )))


class anode_hsheet_load extends anode_hsheet_process {
  constructor()
  {
    super()
    this.n                        = "anode_hsheet_load::"
  }

  //---------------------------------------------------------------------------------------------
  current_hsheet_load(  lang            = 'en' ,
                              array_index_string  = ''    ,
                              file_structure_path = ''    ,
                              current_subpath     = ''    ,
                              breadcrumb          = 'kb'  ,
                              breadcrumb_lang     = 'kb'  ,
                              title               = ''    )
  {



    // Para el ingles lo generamos aqui
    this.set_lang_content_arr( lang )

    // this.p('j04_Before_ : ' + lang + '  ' + content_index )
    // en -  l000_l001_l000
    this.content_arr[lang][array_index_string]  = this.s.ms.contents_path +  file_structure_path + '/' + lang + '_cat'

  // Generate array of files for fast load
  // En este punto debemos saber si los ficheros son hojas o no


    // Cargamos el array con la informacion

    var file_to_load = this.content_arr[lang][array_index_string]

    // this.p('an57_New File to Load:  '  + this.content_arr[lang][array_index_string])


    if (this.s.cs.page_type == "content"  && (lang != "en") )
      this.generate_array_from_file_review_size( lang ,  file_to_load)
    else
      this.generate_array_from_file( lang ,  file_to_load)

    this.current_hsheet_process( lang                        ,
      	                                 array_index_string          ,
      	                                 file_structure_path         ,
                                         current_subpath             ,
                                         breadcrumb                  ,
                                         breadcrumb_lang             ,
                                         title                       )

  }


  //---------------------------------------------------------------------------------------------
  current_hsheet_load_es(  lang            = 'es' ,
                              array_index_string  = ''    ,
                              file_structure_path = ''    ,
                              current_subpath     = ''    ,
                              breadcrumb          = 'kb'  ,
                              breadcrumb_lang     = 'kb'  ,
                              title               = ''    )
  {



    // Para el ingles lo generamos aqui
    this.set_lang_content_arr( lang )

    // this.p('j04_Before_ : ' + lang + '  ' + content_index )
    // en -  l000_l001_l000
    this.content_arr[lang][array_index_string]  = this.s.ms.contents_path +  file_structure_path + '/' + lang + '_cat'


    // Cargamos el array con la informacion

    var file_to_load = this.content_arr[lang][array_index_string]

    // this.p('an57_New File to Load:  '  + this.content_arr[lang][array_index_string])


    if (this.s.cs.page_type == "content"  && (lang != "en") )
      this.generate_array_from_file_review_size( lang ,  file_to_load)
    else
      this.generate_array_from_file( lang ,  file_to_load)

    this.current_hsheet_process_es( lang                        ,
      	                                 array_index_string          ,
      	                                 file_structure_path         ,
                                         current_subpath             ,
                                         breadcrumb                  ,
                                         breadcrumb_lang             ,
                                         title                       )

  }

}

exports.anode_hsheet_load = anode_hsheet_load
