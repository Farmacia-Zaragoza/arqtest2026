// Class:
//-------------------------------------------------------------------------------------
// c-anode_process-
//-------------------------------------------------------------------------------------
// Methods:
//-------------------------------------------------------------------------------------
//- d-current_hsheet_process-       : Process current sheet for main lang for hierarchical method
//- d-current_hsheet_process_es-    : Process current sheet for spec lang for hierarchical method
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
//-------------------------------------------------------------------------------------
// Inheritance Line :
//-------------------------------------------------------------------------------------
// AnoProcess > AnoTermProcess >
// @Anode >  ...
//-------------------------------------------------------------------------------------
// Execution Line :
//-------------------------------------------------------------------------------------
// CurrProces > CurrLoad > RECURSIVE
//-------------------------------------------------------------------------------------
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { anode_run_fs } =   require(  path.join(JS_TYP7  , 'arroba/anode/a06_fsbranch/an62_run.es7'));
       const { idx_pointers }       =   require(  path.join(JS_TYP7  , 'logs/idx_pointers.es7'              ));

class anode_hsheet_process extends anode_run_fs {
  constructor()
  {
    super()
    this.n                        = "anode_hsheet_process::"
  }

  //---------------------------------------------------------------------------------------------
  // Will process all pages
  // MAIN/position/page --> @FORMAT
  current_hsheet_process(lang                  ,
                              array_index_string  = ''    ,
                              file_structure_path = ''    ,
                              current_subpath     = ''    ,
                              breadcrumb          = 'kb'  ,
                              breadcrumb_lang     = 'kb'  ,
                              title               = ''    )
  {

    this.m          = 'current_process'


    var idx = new idx_pointers(array_index_string)
    //         j06 Proc Lang : es Path l000/l001/l000 Ind 000v001v000
    //// this.p('a09 Proc Lang : ' + lang + ' Path ' +  current_subpath + ' Ind ' + index)

    // Los bucles tienen que ser con el idioma ingles

    // this.p('an09_jindex ' + idx.jindex)
    let cats = this.gethash_arr(this.s.ms.main_lang, idx.jindex)

    // 12
    // this.p('an59_Before-pos-bucle1' + lang + '  ' + array_index_string + ' L ' +  cats.length )

    for (var pos in cats)
    {
      // Para cada uno hay que gestionar hijos

      this.arroba_attribs(idx , pos)
      this.arroba_attribs_main_lang(idx, pos)

      var new_breadcrumb      = breadcrumb      + '/' + this.link_en
      var new_breadcrumb_lang = breadcrumb_lang + '/' + this.link

      if (this.item == "metatags" )       this.s.add_metatag(this.value)

      // process cat prev_item V  Cin
      // this.p('an59_process cat ' + this.item + ' V ' + this.value  + ' Cin ' + this.breadcrumb )

      if ( (this.value  != "") ||(this.photo != "")   )    this.term_process()

      // || (this.hover  != "") --> Nada con hover de momento

      // Estos ya estan metidos en el array asi que hay que iterar los hijos
      //this.p('LEVEL : ' + index + ' pos ' + pos + ' value: '  + cats[pos] + ' childrens: ' + chld[pos]  )


      // Aqui no tiene sentido preguntar por el hijo
      if ( this.child == "yes" )
      {

        // this.p('an09_procc_New subpath: ' + new_subpath)

          let new_index_string         = array_index_string  + 'v'  +  this.level

          // File Structure
          let new_file_structure_path  = file_structure_path + '/a_' + this.link_en

          // kb/architecture
          let new_subpath              = current_subpath     + '/'   + this.link

          let new_title                = title + ' ' + this.value

        this.current_hsheet_load(  lang                        ,
                                           new_index_string            ,
                                           new_file_structure_path     ,
                                           new_subpath                 ,
                                           new_breadcrumb              ,
                                           new_breadcrumb_lang         ,
                                           new_title                   )

        // /brqx/pers/fromfile/farma/fnode/json_lang_structure/l000/fr_cat
      } // End If
      else
      {
        // AHORA_VOLVEMOS
        //// this.p('an09_outside p ' + this.type + ' ' + this.item + ' ' + this.b.page_front + ' ' + this.b.page_product + ' ' + this.b.page_allinone)
        // Si es no termina y se cierra la recursividad

        if ( (this.type == "parragraph"  ) ||
             (this.type == "iparragraph" ) )
        {
          // this.p('an09_p ' + this.b.page_list + ' ' + this.b.page_product)

          let folder_to_load    = this.s.ms.contents_path + file_structure_path
          let pf_to_load        = folder_to_load       + '/' + this.value

          let new_level         = array_index_string  + 'v'  +  this.level


          // 020v050 - 020v001
          // paragraph se corresponde con el indice de array 020v001v001
          // por lo que los parrafos internos deben corresponderse con 020v001v001v000

          // /brqx/struc/arq/kb/arqkb/l020/l000/a000_focus_details_en - 020v025v001
          // inside_p
          // /brqx/struc/arq/kb/arqkb/l040/a_architecture/a_history/a_model/a000_article_details_en
          // 040v000v001v000v001
          // this.p('an59 inside_p  ' + pf_to_load + '  ' + new_level)

          // Aqui podriamos gestionar rutas de ficheros
          if (this.s.cs.page_name == "photo")
            this.generate_array_from_photo_file( lang, pf_to_load, new_level)
          else
            this.generate_array_from_text_file( lang, pf_to_load, new_level)
          // Ojo que aqui leemos los ficheros

          // this.s.add_anchors_to_metatags()

	    }

      }
    } // End For

  }

  //---------------------------------------------------------------------------------------------
  current_hsheet_process_es(lang                  ,
                              array_index_string  = ''    ,
                              file_structure_path = ''    ,
                              current_subpath     = ''    ,
                              breadcrumb          = 'kb'  ,
                              breadcrumb_lang     = 'kb'  ,
                              title               = ''    )
  {

    this.m          = 'current_hsheet_process_es'


    var idx = new idx_pointers(array_index_string)
    //         j06 Proc Lang : es Path l000/l001/l000 Ind 000v001v000
    //// this.p('a09 Proc Lang : ' + lang + ' Path ' +  current_subpath + ' Ind ' + index)

    // Los bucles tienen que ser con el idioma ingles

    // this.p('an09_jindex ' + idx.jindex)
    let cats = this.gethash_arr(this.s.ms.main_lang, idx.jindex)

    // 12
    // this.p('an59_Before-pos-bucle1 ' + lang + '  ' + array_index_string + ' L ' +  cats.length )

    for (var pos in cats)
    {
      // Para cada uno hay que gestionar hijos

      this.arroba_attribs(idx , pos)
      this.arroba_attribs_main_lang(idx, pos)

      var new_breadcrumb      = breadcrumb      + '/' + this.link_en
      var new_breadcrumb_lang = breadcrumb_lang + '/' + this.link

      if (this.item == "metatags" )       this.s.add_metatag(this.value)

      // process cat  prev_item V  Cin
      // this.p('an59_process cat  ' + this.item + ' V ' + this.value  + ' Cin ' + this.breadcrumb )

      if ( (this.value  != "") ||(this.photo != "")   )    this.term_process()

      // || (this.hover  != "") --> Nada con hover de momento

      // Estos ya estan metidos en el array asi que hay que iterar los hijos
      //this.p('LEVEL : ' + index + ' pos ' + pos + ' value: '  + cats[pos] + ' childrens: ' + chld[pos]  )


      // Aqui no tiene sentido preguntar por el hijo
      if ( this.child == "yes" )
      {

        // this.p('an09_procc_New subpath: ' + new_subpath)

        let new_index_string         = array_index_string  + 'v'  +  this.level

          // File Structure
        let new_file_structure_path  = file_structure_path + '/a_' + this.link_en

        // kb/architecture
        let new_subpath              = current_subpath     + '/'   + this.link

        let new_title                = title + ' ' + this.value


        this.current_hsheet_load_es(  lang                        ,
                                           new_index_string            ,
                                           new_file_structure_path     ,
                                           new_subpath                 ,
                                           new_breadcrumb              ,
                                           new_breadcrumb_lang         ,
                                           new_title                   )

        // /brqx/pers/fromfile/farma/fnode/json_lang_structure/l000/fr_cat
      } // End If
      else
      {
        // AHORA_VOLVEMOS
        //// this.p('an09_outside p ' + this.type + ' ' + this.item + ' ' + this.b.page_front + ' ' + this.b.page_product + ' ' + this.b.page_allinone)
        // Si es no termina y se cierra la recursividad

        if ( (this.type == "parragraph"  ) ||
             (this.type == "iparragraph" ) )
        {
          // this.p('an09_p ' + this.b.page_list + ' ' + this.b.page_product)

          let folder_to_load    = this.s.ms.contents_path + file_structure_path
          let pf_to_load        = folder_to_load       + '/' + this.value

          let new_level         = array_index_string  + 'v'  +  this.level


          // 020v050 - 020v001
          // paragraph se corresponde con el indice de array 020v001v001
          // por lo que los parrafos internos deben corresponderse con 020v001v001v000

          // /brqx/struc/arq/kb/arqkb/l020/l000/a000_focus_details_en - 020v025v001
          // inside_p
          // /brqx/struc/arq/kb/arqkb/l040/a_architecture/a_history/a_model/a000_article_details_en
          // 040v000v001v000v001
          // this.p('an59 inside_p  ' + pf_to_load + '  ' + new_level)

          // Aqui podriamos gestionar rutas de ficheros
          if (this.s.cs.page_name == "photo")
            this.generate_array_from_photo_file( lang, pf_to_load, new_level)
          else
            this.generate_array_from_text_file( lang, pf_to_load, new_level)
          // Ojo que aqui leemos los ficheros

          // this.s.add_anchors_to_metatags()

	    }

      }
    } // End For

  }

}

exports.anode_hsheet_process = anode_hsheet_process
