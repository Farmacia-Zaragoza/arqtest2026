const _mod_safe_1 = require( path.join(global.JS_TYP7  , 'arroba/anode/a09_page/an92_main_process.es7' ); const anode_main_page_process = _mod_safe_1.anode_main_page_process || _mod_safe_1;   )

class anode_run_search extends anode_main_page_process {
  constructor()
  {
    super()

    this.n                  =   "anode_run_search::"
  }


  //---------------------------------------------------------------------------------------------
  // Tenemos un nivel Mas : Multipage
  // @Format : Articulos - Positions - Pages
  run_rest_load()
  {
    this.m = 'run_hierarchical_load'

    // 1. Cargamos la informacion del idioma principal (ingles)

    let ask_redirect      = true

    let before_lang       =   this.s.ms.lang

    let local_founded     = false

    // es - es
    // this.p('an52_runhier ms: ' + this.s.ms.lang + ' cs: ' + this.s.cs.lang  )

    // this.p('an52_runREST: ' + this.s.cs.lang + ' cs: ' + this.s.cs.list[this.s.cs.lang]  )
    // this.p('an52_runREST: ' + this.s.cs.idx[this.s.cs.lang]  )
    this.p('an52_runREST: ' + this.s.ms.main_lang + ' ms: ' + this.s.cs.list[this.s.ms.main_lang]  )
    // this.p('an52_runREST: ' + this.s.cs.idx[this.s.ms.main_lang]  )


    // Ajustes Generales
	// this.replace( this.s.cs.list[this.s.cs.lang] ,'content', 'list')
	// this.inreplace( 'product', 'nodef')
  	// this.s.cs.list[this.s.cs.lang]      = this.result


    this.s.ms.lang           =   'en'
    this.s.cs.lang           =   this.s.ms.lang

    if (this.s.b.page_search)
    {
       this.p('a052_Generating_SEARCH_COMBO')
       this.generate_array_from_file( this.s.ms.main_lang                    ,
       	                              this.s.cs.idx[this.s.ms.main_lang]     ,
       	                              ask_redirect                           )
    }

    this.generate_array_from_file( this.s.ms.main_lang                 ,
    	                           this.s.cs.list[this.s.ms.main_lang] ,
    	                           ask_redirect                        )

    // Redirect page
    if (this.s.b.redirect_page)
      this.s.cs.redirect_page = this.s.cs.http_domainbar + this.s.ms.main_lang + '/list/idx'

    // For Index 2556
    // let longi = Object.keys(this.arr['en']['nxj020']).length -1
    // this.p('cache_arrlenNX  ' + longi)

    // let longi = Object.keys(this.arr['en']['j020v001']).length -1
    // this.p('cache_arrlenCA  ' + longi)


    // Si se ha encontrado la rama, la ponemos a false para que busque en el otro idioma

    this.s.ms.lang             =   before_lang
    this.s.cs.lang             =   this.s.ms.lang

    // GENERATE SEARCH INFORMATION FOR MAIN LANG DIFFERENT THAN ENGLISH

    if ( this.s.ms.main_lang != 'en' )
    {
	  this.replace( this.s.cs.list[this.s.ms.main_lang] ,'content', 'list')
	  this.inreplace( 'product', 'nodef')
  	  this.s.cs.list[this.s.ms.main_lang]      = this.result


      this.p('an52_run_Loading MAIN_LANG_RARE')
      if (this.s.b.page_search)
        this.generate_array_from_file( this.s.ms.main_lang ,
        	                           this.s.cs.idx[this.s.ms.lang] ,
        	                           ask_redirect )

      this.generate_array_from_file( this.s.ms.main_lang ,  this.s.cs.list[this.s.ms.lang] ,
        	                           ask_redirect )

      // Redirect page
      if (this.s.b.redirect_page)
        this.s.cs.redirect_page = this.s.cs.http_domainbar + this.s.ms.main_lang + '/list/idx'

    }


    // GENERATE SEARCH INFORMATION FOR LANG DIFFERENT THAN MAIN LANG

    if ( this.s.ms.main_lang != this.s.cs.lang )
    {
	  this.replace( this.s.cs.list[this.s.cs.lang] ,'content', 'list')
	  this.inreplace( 'product', 'nodef')
  	  this.s.cs.list[this.s.cs.lang]      = this.result


      this.p('an52_run_Loading LANG ' + this.s.cs.lang)
      if (this.s.b.page_search)
        this.generate_array_from_file( this.s.cs.lang ,  this.s.cs.idx[this.s.cs.lang] ,
        	                           ask_redirect )

      this.generate_array_from_file( this.s.cs.lang ,  this.s.cs.list[this.s.cs.lang] ,
        	                           ask_redirect )

      // Redirect page
      if (this.s.b.redirect_page)
        this.s.cs.redirect_page = this.s.cs.http_domainbar + this.s.cs.lang + '/list/idx'

    }

  }


}

exports.anode_run_search = anode_run_search


