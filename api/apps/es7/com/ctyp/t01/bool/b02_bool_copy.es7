//Methods:
//-------------------------------------------------------------------------------------
// - d-copy-   : Copy boolean values
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
//-------------------------------------------------------------------------------------
// Inheritance Line :
//-------------------------------------------------------------------------------------
// Bool_Copy > Bool_Defs > Log
// @Bool > @Log
//-------------------------------------------------------------------------------------
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { bool_defs }         =   require(  path.join(JS_TYP7 , 'bool/b03_bool_defs.es7' ))

class bool_copy extends bool_defs {
  constructor()
  {
    super()
    this.n = "bool_copy::"
  }

  // ----------------------------- Copy boolean parameters -----------------------------
  copy(b)
  //-------------------------------- Cache parameters --------------------------------
  {
    // Site parameters
    this.live                            =   b.live
    this.lang                            =   b.lang
    this.lang_uri                        =   b.lang_uri
    this.trans                           =   b.trans
    this.sync                            =   b.sync
    this.cache                           =   b.cache
    this.nocode                          =   b.nocode
    this.max_elems                       =   b.max_elems

    this.managed_params                  =   b.managed_params

    this.anchor_allowed                  =   b.anchor_allowed

    this.anchor_metatag                  =   b.anchor_metatag

    this.intelligent_command             =   b.intelligent_command

    this.site_inline                     =   b.site_inline
    this.site_inlinestyles               =   b.site_inlinestyles
    this.site_inlineimages               =   b.site_inlineimages

    this.language_already_loaded         =   b.language_already_loaded

    // Extrange langs : zh - bn - uk - ru - hi - in
    this.is_strange_lang                =   b.is_strange_lang


    this.page_download                   =   b.page_download
    this.page_search                     =   b.page_search
    this.page_search_api                 =   b.page_search_api
    this.page_search_rest                =   b.page_search_rest

    this.page_search_rest_fast           =   b.page_search_rest_fast

    // Used to manage aliases
    this.page_is_alias                   =   b.page_is_alias
    this.lang_aliases_already_managed    =   b.lang_aliases_already_managed

    this.page_file                       =   b.page_file
    this.page_gallery                    =   b.page_gallery
    this.page_slide                      =   b.page_slide
    this.page_list                       =   b.page_list
    this.page_product                    =   b.page_product
    this.page_cookies                    =   b.page_cookies
    this.page_front                      =   b.page_front
    this.page_multi_parameter            =   b.page_multi_parameter
    this.page_intelligent                =   b.page_intelligent
    this.page_multi_language             =   b.page_multi_language

    this.page_allinone                   =   b.page_allinone

    // Robot page

    this.robot_page                      =   b.robot_page
    this.index_page                      =   b.index_page

    // Redirect page
    this.redirect_page                   =   b.redirect_page

    // Redirect page
    this.anchor_page                     =   b.anchor_page

    this.robot_url_managed               =   b.robot_url_managed

    // Hierarchical Method

    this.found_breadcrumb                =   b.found_breadcrumb


    this.only_json_page                  =   b.only_json_page

    // 16 Types
    this.specs_props                     =   b.specs_props


    this.type_user                       =   b.type_user
    this.type_common                     =   b.type_common
    this.type_human                      =   b.type_human
    this.type_synced                     =   b.type_synced
    this.type_ssl                        =   b.type_ssl
    this.type_url                        =   b.type_url
    this.type_have_properties            =   b.type_have_properties
    this.type_have_specific_properties   =   b.type_have_specific_properties
    this.type_have_code                  =   b.type_have_code
    this.type_have_ascii_code            =   b.type_have_ascii_code
    this.type_have_taxonomy              =   b.type_have_taxonomy
    this.type_is_taxonomy                =   b.type_is_taxonomy
    this.type_translation                =   b.type_translation
    this.type_translated                 =   b.type_translated
    this.type_cache                      =   b.type_cache
    this.type_generated                  =   b.type_generated

    this.drupal_bootstrap                =   b.drupal_bootstrap
    this.file_yaml                       =   b.file_yaml

    this.contents_translated             =   b.contents_translated

    this.ready_to_load                   =   b.ready_to_load

    // Objects
    this.pmt                             =   b.pmt

    // Rest  File load
    this.rest_result                     =   b.rest_result

  }

}

exports.bool_copy = bool_copy
