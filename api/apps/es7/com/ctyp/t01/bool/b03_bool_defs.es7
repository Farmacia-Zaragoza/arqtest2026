define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { printlog }         =   require(  path.join(JS_TYP7  , 'logs/printlog.es7'  )  )

class bool_defs extends printlog {
  constructor() {
    super()
    this.n                    = "bool_defs::"
    this.m                    = "cons"

    // Parameters object
    this.pmt                  =  ''

    //-------------------------------- Site parameters [8] --------------------------------

    this.live                            = false
    this.lang                            = false
    this.lang_uri                        = true
    this.trans                           = false
    this.sync                            = false
    this.cache                           = false
    this.nocode                          = false
    this.max_elems                       = false

    this.managed_params                  = false

    // Gestion de anchors para productos
    this.anchor_allowed                  = false

    // Gestion de anchors para metatag - Si esta activo el anchor es un metatag
    this.anchor_metatag                  = false

    // Gestion de comandos inteligentes - ojo que se pueden confundir con alias
    this.intelligent_command             = true


    this.site_inline                     = false
    this.site_inlinestyles               = false    // Inline styles - as script svg
    this.site_inlineimages               = false    // As script styles - Inline svg

    this.language_already_loaded         = false

    // Extrange langs : zh - bn - uk - ru - hi - in
    this.is_strange_lang                = false

    this.page_download                   = false    // 01
    this.page_search                     = false
    this.page_search_api                 = false				// Generate Json
    this.page_search_rest                = false
    this.page_search_rest_fast           = false    // Jenerate Rest && Fast Rest

    // Used to manage aliases
    this.page_is_alias                   = false

    // Used to avoid multiple alias
    this.lang_aliases_already_managed    = false


    this.page_file                       = false
    this.page_gallery                    = false
    this.page_slide                      = false
    this.page_list                       = false    // 11 Pages
    this.page_product                    = false
    this.page_cookies                    = false
    this.page_front                      = false
    this.page_multi_parameter            = false
    this.page_intelligent                = false    // 10
    this.page_multi_language             = false

    this.page_allinone                   = false    // 11 Pages

    // Robot page

    this.robot_page                      = false

    // Index page
    this.index_page                      = false

    // Redirect page
    // Will be enabled to index site
    this.redirect_page                      = false

    // To manage anchors
    this.anchor_page                      = false

    // this.robot_url_managed               = false

    // Hierarchical Method

    this.found_breadcrumb                = false


    // Control de salida de jsons
    this.only_json_page                  = false

    this.specs_props                     = false

    this.type_user                       = true    // 01
    this.type_common                     = false
    this.type_human                      = false
    this.type_synced                     = false
    this.type_ssl                        = false    //
    this.type_url                        = false    // 16 Types
    this.type_have_properties            = false
    this.type_have_specific_properties   = false
    this.type_have_code                  = false
    this.type_have_ascii_code            = false    // 10
    this.type_have_taxonomy              = false
    this.type_is_taxonomy                = false
    this.type_translation                = false
    this.type_translated                 = false
    this.type_cache                      = false    // 15

    // No lo hemos usado hasta ahora
    this.type_generated                  = false

    this.drupal_bootstrap                = false
    this.file_yaml                       = false

    this.contents_translated             = false

    this.ready_to_load                   = false    // Ready to load page
    this.ready_to_ram                    = false    // Ready to load page

    // Rest - file loag
    this.rest_result                     = false

  }
}

exports.bool_defs = bool_defs

