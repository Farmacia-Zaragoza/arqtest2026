define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const 	{ bool_copy } 			= 	require(	path.join(JS_TYP7 , 'bool/b02_bool_copy.es7' ) 	)

// Change to cbool to be the same than php
class cbool extends bool_copy {
	constructor()
	{
		super()
		this.n 					= 	"bool::"

	}

	load(	pmt = '' )
	{

		this.n 					= 	"bool::"
		this.m 					= 	"load"

		this.pmt				= 	pmt

		// this.p('Passing_cache ' + true +  ' ' + pmt.cache_disk)

		this.cache 		        = 	this.pmt.cache

		this.nocode				= 	this.pmt.nocode
		this.max_elems			= 	this.pmt.max_elems

		this.lang 			    = 	this.pmt.lang
		this.lang_uri 		    = 	this.pmt.lang_uri

		this.live 			    = 	this.pmt.live
		this.trans 	            = 	this.pmt.trans
		this.sync 			    = 	this.pmt.sync

	}

}

exports.cbool = cbool
