global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			);

const _mod_safe_1 = require(  path.join(global.JS_TYP7  , 'rest/r02_inner/r01_search_sheet.es7' ); const r01_search_sheet = _mod_safe_1.r01_search_sheet || _mod_safe_1);
// const _mod_safe_2 = require(  path.join(global.JS_TYP7  , 'logs/printlog.es7'      ); const printlog = _mod_safe_2.printlog || _mod_safe_2);
class r02_product_sheet {
  constructor() {
    // this.n                          =   "r02_product_sheet::"

    this.image        =   ''

    // Links
    this.prev_item         =   ''
    this.next_item   =   ''
    this.first_item        =   ''
    this.last_item        =   ''

    this.metatags        =   ''

    // Numeric values
    this.curr_position        =   ''
    this.last_position        =   ''
  }

  reload()
  {
    this.image                =   ''

    // Links
    this.prev_item         =   ''
    this.next_item   =   ''
    this.first_item        =   ''
    this.last_item        =   ''

    this.metatags        =   ''

    // Numeric values
    this.curr_position    =   ''
    this.last_position    =   ''

    this.arr              = []
  }

  manage_parragraph(link , hover)
  {
  	 this.link             =   link
     this.hover            =   hover
  }

  update(cat , item , link , photo , hover)
  {
    switch (cat)
    {
       case "metatags":              this.metatags = item                ;    break;
       case "sm_meta_og_description":this.sm_meta_og_description = item  ; break ;
       case "image":                 this.image = this.photo                  ;    break;
       case "prev_item":             this.prev_item         =   link     ;    break;
       case "next_item":             this.next_item   =   link           ;    break;
       case "first_item":            this.first_item        =   link     ;    break;
       case "last_item":             this.last_item        =   link      ;    break;
       case "image":                 this.image = photo               ;    break;
       case "parragraph":            this.manage_parragraph(link,hover)    ;    break;
       case "iparragraph":           this.manage_parragraph(link,hover)    ;    break;
       case "current_position":      this.curr_position        =   item  ;    break;
       case "last_position":         this.last_position        =   item  ;    break;
    }

  }

  add(pf)
  {
  	this.arr.push(pf)
  }
}

exports.r02_product_sheet = r02_product_sheet


module.exports = r02_product_sheet;
module.exports.r02_product_sheet = r02_product_sheet;
