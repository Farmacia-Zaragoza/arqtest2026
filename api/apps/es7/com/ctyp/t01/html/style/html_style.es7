      if ( this.y2               != '' ) str    +=  ' y2="'              + this.y2              + '"'
      if ( this.cx               != '' ) str    +=  ' cx="'              + this.cx              + '"'
      if ( this.cy              != '' ) str    +=  ' cy="'              + this.cy              + '"'
      if ( this.r              != '' ) str    +=  ' r="'              + this.r              + '"'
      if ( this.version            != '' ) str    +=  ' version="'          + this.version          + '"'
      if ( this.fill            != '' ) str    +=  ' fill="'            + this.fill            + '"'
      if ( this.viewbox            != '' ) str    +=  ' viewBox="'          + this.viewbox          + '"'
      if ( this.xml_space          != '' ) str    +=  ' xml-space="'          + this.xml_space          + '"'

    // Meta
      if ( this.http_equiv          != '' ) str    +=  ' http-equiv="'          + this.http_equiv          + '"'
      if ( this.mcontent          != '' ) str    +=  ' content="'          + this.mcontent          + '"'

      if ( this.lang            != '' ) str    +=  ' lang="'            + this.lang            + '"'
      if ( this.xml_lang          != '' ) str    +=  ' xml:lang="'          + this.xml_lang          + '"'
      if ( this.xmlns            != '' ) str    +=  ' xmlns="'            + this.xmlns            + '"'
      if ( this.property          != '' ) str    +=  ' property="'          + this.property          + '"'

      if ( this.percents          != '' ) str    +=  ' percents="'          + this.percents          + '"'
      if ( this.resnumbers          != '' ) str    +=  ' resnumbers="'          + this.resnumbers          + '"'

      if ( this.img_name          != '' ) str    +=  ' img-name="'          + this.img_name          + '"'
      if ( this.img_hover          != '' ) str    +=  ' img-hover="'          + this.img_hover          + '"'
      if ( this.img_top            != '' ) str    +=  ' img-top="'          + this.img_top          + '"'
      if ( this.img_bottom          != '' ) str    +=  ' img-bottom="'          + this.img_bottom          + '"'

    if ( this.option_a          != '' ) str    +=  ' option-a="'          + this.option_a          + '"'
    if ( this.option_b          != '' ) str    +=  ' option-b="'          + this.option_b          + '"'
    if ( this.option_c          != '' ) str    +=  ' option-c="'          + this.option_c          + '"'
    if ( this.option_d          != '' ) str    +=  ' option-d="'          + this.option_d          + '"'

        if ( this.defer               != '' ) str    +=  ' '                 + this.defer

        if ( this.async               != '' ) str    +=  ' '                 + this.async

        // Add Code fragments
        if ( this.adds                != '' ) str    +=                                this.adds

    if  ( this.tag_type != "html" )
    {
        // Our Properties - Ojo que tame no es el ultimo
           //if ( this.tame                  != '' ) str    +=  ' tame="'                  + this.tame                 + '" '
              if ( this.tame                  != '' ) str    +=  ''
    }


        if ( this.tag_type == "hidden" ||
       this.tag_type == "img" ||
       this.tag_type == "input"  ||
       this.tag_type == "meta" ||
       this.tag_type == "link")
          str    +='/>'
        else
        {
          str    +='>'

          str    += this.content
          str    +='</' + this.tag_type + '>'
        }

        this.code = str

//      puting_contents='html :code ' +   this.tag_type + ':' + this.code    +  '>'
//      GLOBALS['putcont']+=puting_contents


    }


    show()
    {
        echo ( this.code )
    }

    shon()
    {
        echo ( this.code + "\n" )
    }

}

//
exports.html_style = html_style;

