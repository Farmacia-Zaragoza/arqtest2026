    create(new_content  ='')
    {
        if (new_content != '') this.content = new_content

        let str     =''

        if     ( this.tag_type == "hidden"   )
          str    +='<input type="hidden" '
    else
          str    +='<' + this.tag_type
//      puting_contents='html :id ' +   this.tag_type + ':' + this.id    +  '- >'
//      GLOBALS['putcont']+=puting_contents

    // Async the first
    // <script async src="//platform.twitter.com/widgets.js" charset="utf-8"></script>

    // Defer the last or the first
      // <script src="js0/js3/main3.js" defer></script>


        if ( this.id                  != '' ) str    +=  ' id="'                    + this.id                   + '"'
        if ( this.class               != '' ) str    +=  ' class="'                 + this.class                + '"'
        if ( this.src                 != '' ) str    +=  ' src="'                   + this.src                  + '"'
        if ( this.srcs                 != '' ) str    +=  ' srcs="'                   + this.srcs                  + '"'
        if ( this.href                != '' ) str    +=  ' href="'                  + this.href                 + '"'
        if ( this.alt                 != '' ) str    +=  ' alt="'                   + this.alt                  + '"'
        if ( this.value               != '' ) str    +=  ' value="'                 + this.value                + '"'
        if ( this.title               != '' ) str    +=  ' title="'                 + this.title                + '"'
        if ( this.type                 != '' ) str    +=  ' type="'                 + this.type                  + '"'


        if ( this.data_title          != '' ) str    +=  ' data-title="'            + this.data_title           + '"'
        if ( this.name                != '' ) str    +=  ' name="'                  + this.name                 + '"'
        if ( this.style               != '' ) str    +=  ' style="'                 + this.style                + '"'
        if ( this.rel                 != '' ) str    +=  ' rel="'                   + this.rel                  + '"'

        // Form Properties
        if ( this.action              != '' ) str    +=  ' action="'                + this.action               + '"'
        if ( this.method              != '' ) str    +=  ' method="'                + this.method               + '"'
        if ( this.target              != '' ) str    +=  ' target="'                + this.target               + '"'
        if ( this.media                != '' ) str    +=  ' media="'                + this.media                 + '"'
        if ( this.width                != '' ) str    +=  ' width="'                + this.width                 + '"'
        if ( this.height              != '' ) str    +=  ' height="'                + this.height               + '"'
        if ( this.imgpath              != '' ) str    +=  ' imgFolderName="'            + this.imgpath               + '"'
        if ( this.as                 != '' ) str    +=  ' as="'                  + this.as                  + '"'

      // Events
        if ( this.onload              != '' ) str    +=  ' onload="'                + this.onload               + '"'


        if ( this.placeholder          != '' ) str    +=  ' placeholder="'           + this.placeholder           + '"'

    // Html5 attributes
        if ( this.role                != '' ) str    +=  ' role="'                + this.role               + '"'
        if ( this.data                != '' ) str    +=  ' data="'                + this.data               + '"'

        if ( this.page_type              != '' ) str    +=  ' page-type="'                + this.page_type            + '"'
        if ( this.data_comm              != '' ) str    +=  ' data-comm="'              + this.data_comm            + '"'
        if ( this.data_spec              != '' ) str    +=  ' data-spec="'              + this.data_spec            + '"'
        if ( this.data_content            != '' ) str    +=  ' data-content="'           + this.data_content            + '"'


        if ( this.data_array            != '' ) str    +=  ' data-array="'           + this.data_array            + '"'
        if ( this.data_toggle            != '' ) str    +=  ' data-toggle="'           + this.data_toggle            + '"'
        if ( this.data_trigger            != '' ) str    +=  ' data-trigger="'           + this.data_trigger            + '"'
        if ( this.data_header            != '' ) str    +=  ' data-header="'           + this.data_header            + '"'
        if ( this.data_original_title      != '' ) str    +=  ' data-original-title="'      + this.data_original_title    + '"'

        if ( this.aria_controls           != '' ) str    +=  ' aria-controls="'         + this.aria_controls         + '"'
        if ( this.aria_expanded           != '' ) str    +=  ' aria-expanded="'         + this.aria_expanded          + '"'
        if ( this.aria_hidden             != '' ) str    +=  ' aria-hidden="'         + this.aria_hidden           + '"'
        if ( this.aria_labelledby         != '' ) str    +=  ' aria-labelledby="'       + this.aria_labelledby        + '"'

        if ( this.data_background         != '' ) str    +=  ' data-background="'       + this.data_background        + '"'
        if ( this.data_src             != '' ) str    +=  ' data-src="'           + this.data_src            + '"'
        if ( this.data_src_small        != '' ) str    +=  ' data-src-small="'         + this.data_src_small        + '"'
        if ( this.data_src_medium        != '' ) str    +=  ' data-src-medium="'       + this.data_src_medium      + '"'
        if ( this.data_src_large        != '' ) str    +=  ' data-src-large="'         + this.data_src_large        + '"'
        if ( this.data_src_extra_large    != '' ) str    +=  ' data-src-extra-large="'    + this.data_src_extra_large    + '"'

        if ( this.data_ride           != '' ) str    +=  ' data-ride="'           + this.data_ride          + '"'
        if ( this.data_interval        != '' ) str    +=  ' data-interval="'        + this.data_interval         + '"'
        if ( this.data_slide          != '' ) str    +=  ' data-slide="'          + this.data_slide         + '"'
        if ( this.data_lightbox        != '' ) str    +=  ' data-lightbox="'        + this.data_lightbox        + '"'
        if ( this.data_flex_src        != '' ) str    +=  ' data-flex-src="'        + this.data_flex_src        + '"'
        if ( this.data_flex_src_small      != '' ) str    +=  ' data-flex-src-small="'      + this.data_flex_src_small    + '"'

  // New Twitter Dat attributes
        if ( this.data_lang          != '' ) str    +=  ' data-lang="'          + this.data_lang           + '"'
        if ( this.data_height          != '' ) str    +=  ' data-height="'        + this.data_height         + '"'
        if ( this.data_dnt          != '' ) str    +=  ' data-dnt="'          + this.data_dnt           + '"'
        if ( this.data_theme          != '' ) str    +=  ' data-theme="'          + this.data_theme         + '"'

  // New Facebook Dat attributes
        if ( this.data_href          != '' ) str   +=  ' data-href="'          + this.data_href           + '"'
        if ( this.data_tabs          != '' ) str    +=  ' data-tabs="'          + this.data_tabs           + '"'
        if ( this.data_small_header      != '' ) str    +=  ' data-small-header="'      + this.data_small_header       + '"'
        if ( this.data_adapt_container_width  != '' ) str    +=  ' data-adapt-container-width="'  + this.data_adapt_container_width  + '"'
        if ( this.data_hide_cover        != '' ) str    +=  ' data-hide-cover="'      + this.data_hide_cover       + '"'
        if ( this.data_show_facepile      != '' ) str    +=  ' data-show-facepile="'      + this.data_show_facepile     + '"'
        if ( this.data_layout          != '' ) str    +=  ' data-layout="'        + this.data_layout         + '"'
        if ( this.data_size          != '' ) str    +=  ' data-size="'          + this.data_size           + '"'
        if ( this.data_action         != '' ) str    +=  ' data-action="'        + this.data_action         + '"'
        if ( this.data_show_faces        != '' ) str    +=  ' data-show-faces="'      + this.data_show_faces       + '"'

  // New Linkedin attributes

        if ( this.data_version         != '' ) str    +=  ' data-version="'        + this.data_version         + '"'
        if ( this.data_locale         != '' ) str    +=  ' data-locale="'        + this.data_locale         + '"'
        if ( this.data_type           != '' ) str    +=  ' data-type="'          + this.data_type           + '"'
        if ( this.data_theme           != '' ) str    +=  ' data-theme="'          + this.data_theme         + '"'
        if ( this.data_vanity         != '' ) str    +=  ' data-vanity="'        + this.data_vanity         + '"'


        if ( this.data_speed          != '' ) str    +=  ' data-speed="'          + this.data_speed         + '"'
        if ( this.data_direction        != '' ) str    +=  ' data-direction="'        + this.data_direction       + '"'
        if ( this.data_hover_method       != '' ) str    +=  ' data-hover-method="'      + this.data_hover_method       + '"'

        if ( this.data_caption          != '' ) str    +=  ' data-caption="'        + this.data_caption         + '"'

        if ( this.data_links            != '' ) str    +=  ' data-links="'          + this.data_links           + '"'

        if ( this.data_annotation         != '' ) str    +=  ' data-annotation="'      + this.data_annotation      + '"'
        if ( this.data_counter         != '' ) str    +=  ' data-counter="'        + this.data_counter         + '"'
        if ( this.data_format          != '' ) str    +=  ' data-format="'        + this.data_format         + '"'
        if ( this.data_id             != '' ) str    +=  ' data-id="'          + this.data_id           + '"'
        if ( this.data_rel           != '' ) str    +=  ' data-rel="'          + this.data_rel           + '"'
        if ( this.data_related         != '' ) str    +=  ' data-related="'        + this.data_related         + '"'
        if ( this.data_url            != '' ) str    +=  ' data-url="'          + this.data_url           + '"'
        if ( this.data_width            != '' ) str    +=  ' data-width="'          + this.data_width           + '"'

        if ( this.data_link            != '' ) str    +=  ' data-link="'          + this.data_link           + '"'
        if ( this.text_data            != '' ) str    +=  ' text-data="'          + this.text_data           + '"'
        if ( this.font_data            != '' ) str    +=  ' font-data="'          + this.font_data           + '"'

        if ( this.cite            != '' ) str    +=  ' cite="'            + this.cite             + '"'
        if ( this.page            != '' ) str    +=  ' page="'            + this.page             + '"'
        if ( this.path            != '' ) str    +=  ' path="'            + this.path             + '"'
        if ( this.format            != '' ) str    +=  ' format="'            + this.format           + '"'
        if ( this.ext              != '' ) str    +=  ' ext="'            + this.ext             + '"'

        if ( this.scrolling          != '' ) str    +=  ' scrolling="'          + this.scrolling           + '"'
        if ( this.frameborder          != '' ) str    +=  ' frameborder="'        + this.frameborder         + '"'
        if ( this.allow            != '' ) str    +=  ' allow="'            + this.allow             + '"'
        if ( this.allowTransparency      != '' ) str    +=  ' allowTransparency="'      + this.allowTransparency       + '"'

  // New Script Jquery Attributes

      if ( this.integrity          != '' ) str    +=  ' integrity="'          + this.integrity          + '"'
      if ( this.crossorigin          != '' ) str    +=  ' crossorigin="'        + this.crossorigin        + '"'
      if ( this.charset            != '' ) str    +=  ' charset="'          + this.charset          + '"'
  // Polygon
      if ( this.points            != '' ) str    +=  ' points="'            + this.points            + '"'
      if ( this.x               != '' ) str    +=  ' x="'              + this.x              + '"'
      if ( this.y               != '' ) str    +=  ' y="'              + this.y              + '"'
      if ( this.x1               != '' ) str    +=  ' x1="'              + this.x1              + '"'
      if ( this.y1               != '' ) str    +=  ' y1="'              + this.y1              + '"'
