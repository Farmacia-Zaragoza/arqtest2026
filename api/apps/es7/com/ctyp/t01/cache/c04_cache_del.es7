define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			)))

const   { struc }   =   require(  path.join(JS_TYP7  , 'struc/s01_struc.es7'     ))),
	    fo  		= 	require(  path.join(JS_LIB7  , 'file/file_operations.es7'  )));

class cache_del extends struc {
  constructor()
  {
    super()
    this.n                          =   "cache_gen::"
  }

  //---------------------------------------------------------------------------------------------

  gen_idx_path()
  {
    // Lo generamos si es index o search page
    if (this.s.b.index_page || this.s.b.page_search)
    {
      let old_sub       = this.s.cs.sub
      let old_ext       = this.s.cs.ext
      let old_page_type = this.s.cs.page_type
      let old_lang      = this.s.cs.lang


      this.s.cs.sub            =   'arroba'
      this.s.cs.ext            =   'idx'
      this.s.cs.page_type      =   'idx'
      this.s.cs.lang           =   this.s.ms.main_lang


      this.gen()

      // this.p('cache_arridx_LOADING  :'      + '  Pth ' + this.s.cs.idx)

      this.s.cs.sub            = old_sub
      this.s.cs.ext            = old_ext
      this.s.cs.page_type      = old_page_type
      this.s.cs.lang           = old_lang

    }
  }

  //---------------------------------------------------------------------------------------------
  clean_old_files()
  {
    // Debe eliminar los ficheros viejos de la ruta de cache

    //    this.s.cs.cache_noversion_subpath   = this.s.cs.cache_subpath
  	//this.p('cache_del_remov ' +  this.s.cs.cache_noversion_path)
  	//this.p('cache_ali_remov ' +  this.s.cs.cache_alias)

  	fo.delete_file_pattern(this.s.cs.cache_noversion_path)

  }
}

exports.cache_del = cache_del
