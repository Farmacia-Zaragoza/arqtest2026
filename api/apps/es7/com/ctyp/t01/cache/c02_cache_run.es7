// Spc - Cica_d05 - Home - Index_06 - v0_0_1 [COMMON-ES6]
//-------------------------------------------------------------------------------------
// Fast node load - Manage page cache
//-------------------------------------------------------------------------------------
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
//- d-run-       : Run cache content
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
//-------------------------------------------------------------------------------------
// Inheritance Line :
//-------------------------------------------------------------------------------------
// Cache > Cache_gen > Cache_save > Cacle_del
// Cache > Struc
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--


define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  { cache_gen }   =   require(  path.join(JS_TYP7  , 'cache/c03_cache_gen.es7'      )    )

class cache_run extends cache_gen {
  constructor()
  {
    super()
    this.n                          =   "cache_run::"

  }

  //---------------------------------------------------------------------------------------------
  // Generate Cache File ( only for Arroba format )
  // 3 content types
  run()
  {
    this.n                          =   "cache_run::"

    // page
    // this.p('c01_Entrando en run GENERA: ' + this.s.cs.loadtype + ' Path ' +  this.s.cs.lang)
    // Problema - En spec pagtype llega como content
    // this.p('c02_cr: ' + this.s.cs.loadtype + ' Path ' +  this.s.cs.cache_path)
    // this.p('c02_cr: ' + this.s.cs.page_type + ' ' + this.s.cs.position + ' ' + this.s.cs.page)

    // Tenemos un nivel Mas : Multipage
    // @Format : Articulos - Positions - Pages

    // /brqx/cache/arq/kb/kb/uritype/content/list/nohuman/nouser/nocode/notrans/nosync/en_position_20_000_arroba_ssl.idx

    if (this.s.cs.page_type == "content" || (this.s.cs.page_type == "idx"))
    {
    // CONTENT PAGES
    // ---------------------------------------------------------------------------------------
      if (this.s.b.rest_page)
      {
      // REST ZONE 	--> article - list - search
        this.run_rest_load()
      }
      else
      {
      // NORMAL ZONE
          this.p('c02_cr_CHECK hiera : ' + this.s.cs.loadtype)

    	  switch(this.s.cs.loadtype)
    	  {
            case "hierarchical":
               // Loading only two languages storing same position values
               // this.p('c02_cr JQC' + this.s.cs.slash_hierarchi)
               this.run_hierarchical_load()
               break;

            case "filesystem":
               // Loading only two languages storing same position values
               // this.p('c02_cr JQC' + this.s.cs.slash_hierarchi)
               this.run_fs_load()
               break;

    	    case "position":
              if (this.s.b.index_page && this.s.b.index_ready )
                this.run_index_list_load(this.s.cs.multi_positions)
              else if (this.s.b.page_search && this.s.b.index_ready)
              {
                //this.p('c02_cr : ' + this.s.cs.loadtype)
              	// Ha entrado en search
              	this.run_rest_load()
              }
              else
              {
                // RUNNING LIST
                //this.p('c02_cr LISTNUA')
                this.run_position_load()
                // let counts = '' + Object.keys(this.arr['en']['j020']).length - 1
                // this.p('c01_cache_LISTNUMSEARCH ' + counts  )
              }

    	    break ;
    		case "page":
              if (this.s.b.index_page && this.s.b.index_ready )
                this.run_index_page_load()
              else
                this.run_multi_page_load()

    		break ;
    	  }
        // Generate Cache_path file
        // No tiene sentido en Rest
        this.main_full_content_cache_save()
      }
    // ---------------------------------------------------------------------------------------
    }
    else
    {
    // COMMON PAGES ( Comm && Spec )
    // ---------------------------------------------------------------------------------------
      // this.p('c02_cr_else ' + this.s.cs.loadtype)

      switch(this.s.cs.loadtype)
      {

        case "twolangs":
          // Loading only two languages storing same position values
          // this.p('cache_carga_dos_idiomas')
          this.run_two_load()
          break;
        case "alllangs":
          // Loading all languages storing same position values
          // this.p('Preparando para poder buscar')
          this.run_all_load()
          break;
        case "full":
          // Loading all
          // this.p('Preparando para poder buscar')
          this.run_full_load()
          break;
        case "multiposition":
          this.p ('c02_cr HERE ' + this.s.ms.lang  + ' '  + this.s.cs.multi_positions)
          this.run_multi_position_load(this.s.cs.multi_positions)
          break;
        default:
          // this.p ('c01_cache_loading_posi A ' + this.s.position + ' Lang ' + this.s.cs.lang )

          this.run_position_load()

          // this.p ('c01_cache_loading_posi B ' + this.s.position + ' Lang ' + this.s.cs.lang )
       }

      // Generate Cache_path file
      // No tiene sentido en Rest
      this.main_full_content_cache_save()
    }
    // this.p('c01_cache found : ' + this.s.cs.founded_type)

  }

  //---------------------------------------------------------------------------------------------


}

exports.cache_run = cache_run

