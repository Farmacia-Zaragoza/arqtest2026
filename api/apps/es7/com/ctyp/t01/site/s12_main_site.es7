// Updated Langs: +NodeJs,Ruby,Php
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Agile Node Js - Main Site Definition Common Class  [V.0.0.5]  (2019-11-27)
// Brqx Group - Agile Farmacia Zaragoza Methodology
// Spc - Cica_d05 - Home - Index_06 - v0_0_1 [ES7]
//-------------------------------------------------------------------------------------
// Fast node load - Manage page cache
//-------------------------------------------------------------------------------------
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
//Methods:
//-------------------------------------------------------------------------------------
// - d-copy-   : Copy site values
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
//-------------------------------------------------------------------------------------
// Inheritance Line :
//-------------------------------------------------------------------------------------
// Main_Site> > PrintLog
// @Site > @Log
//-------------------------------------------------------------------------------------
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { printlog }         =   require(  path.join(JS_TYP7  , 'logs/printlog.es7'          ))

class main_site extends printlog {
  constructor() {
    super()
    this.n                   =   "main_site::"

    this.load                =   "disk"

    // Idioma principal de la arquitectura ( actualizable por arroba properties )
    this.main_lang           =   "en"
    this.default_lang        =   "es"

    this.lang                =   "es"
    this.slan                =   "n"      // No Multi Language by default
    this.robot               =   ''

    this.live_opt            =   "minimized"  // inline - script - inline_and_save
    this.cache_opt           =   "nocache"  // nocache - full page cache
    this.lang_opt            =  'nodejs'

    this.position            =   0
    this.page                =   0

    this.ssl_page            =  'nnn'

    // Paths for Json files

    this.j_comm_path         =  ''
    this.j_spec_path         =  ''
    this.j_cont_path         =  ''

    this.j_comm_url         =  ''
    this.j_spec_url         =  ''
    this.j_cont_url         =  ''

    this.j_comm_ck       =   false
    this.j_spec_ck       =   false
    this.j_cont_ck       =   false

    // Syntax checking
    this.j_comm_ck_syn       =   false
    this.j_spec_ck_syn       =   false
    this.j_cont_ck_syn       =   false

    // Url checking
    this.j_comm_ck_url       =   false
    this.j_spec_ck_url       =   false
    this.j_cont_ck_url       =   false

    // Http Code
    this.j_comm_ck_cod       =   0
    this.j_spec_ck_cod       =   0
    this.j_cont_ck_cod       =   0

    this.lnk_generation_type =  ''

    this.allowed_langs       =  ''
    this.allowed_commands    =  ''

    // Default exception
    this.exception           =  'No allowed uri'

    // Idiomas raros que no van a generar ficheros con su nombre
    this.strange_langs      =  'zh ja bn uk ru hi in'

    this.branch              =   ""
    this.prod                =   ""
    this.prodbranch          =   ""

    this.site                =   ""
    this.cached_site         =   ""

    this.title               =   ""
    this.site_title          =   ""
    this.title_hover         =   ""

    this.server              =   ""
    this.env                 =   "dev"

    // ICON - LOGO

    this.icon                =  ""
    this.logo                =  ""
    this.logo_alt            =  ""

    this.logo_tablet         =  ""
    this.logo_mobile         =  ""
    this.logo_desktop        =  ""
    this.logo_4k             =  ""
    this.logo_8k             =  ""

    this.comm_positions      =  ""
    this.spec_positions      =  ""

    // PATHS

    this.base_path           =  ''

    //
    this.photos_link         =  "photos"  // To manage image resolutions - phptos links
    this.photos_path         =  "/ssd/photos"  // To manage image resolutions - phptos links


    this.current_photo_path  =  ""

    this.metatags            =  ""

    // Dat content path (struc)
    this.contents_path       = ''

    // Dat content path (struc)
    this.filesystem_path     = ''

    // Images path r_img - Will change with every project
    this.images_path         = ''

    // Real site path (run path)
    // /mnt/ssd/brqx/run/arq/arqdru
    this.site_path           = ''

    this.general_cache_path  = ''


    this.start_time          =  ''
  }

  //---------------------------------------------------------------------------------------------
  copy(msite) {

    this.load                =   msite.load

    // Idioma principal de la arquitectura
    this.main_lang           =   msite.main_lang
    this.default_lang        =   msite.default_lang

    this.lang                =   msite.lang
    this.slan                =   msite.slan
    this.robot               =   msite.robot

    this.live_opt            =   msite.live_opt
    this.cache_opt           =   msite.cache_opt
    this.lang_opt            =   msite.lang_opt

    this.position            =   msite.position
    this.page                =   msite.page

    this.ssl_page            =   msite.ssl_page

    // Urls Paths for Json files

    this.j_comm_path         =   msite.j_comm_path
    this.j_spec_path         =   msite.j_spec_path
    this.j_cont_path         =   msite.j_cont_path

    this.j_comm_url          =   msite.j_comm_url
    this.j_spec_url          =   msite.j_spec_url
    this.j_cont_url          =   msite.j_cont_url

    this.j_comm_ck           =   msite.j_comm_ck
    this.j_spec_ck           =   msite.j_spec_ck
    this.j_cont_ck           =   msite.j_cont_ck

    // Syntax checking
    this.j_comm_ck_syn       =   msite.j_comm_ck_syn
    this.j_spec_ck_syn       =   msite.j_spec_ck_syn
    this.j_cont_ck_syn       =   msite.j_cont_ck_syn

    // Url checking
    this.j_comm_ck_url       =   msite.j_comm_ck_url
    this.j_spec_ck_url       =   msite.j_spec_ck_url
    this.j_cont_ck_url       =   msite.j_cont_ck_url

    // Http Code
    this.j_comm_ck_cod       =   msite.j_comm_ck_cod
    this.j_spec_ck_cod       =   msite.j_spec_ck_cod
    this.j_cont_ck_cod       =   msite.j_cont_ck_cod

    // Syntax validate result for jsons


    this.lnk_generation_type =   msite.lnk_generation_type

    this.allowed_langs       =   msite.allowed_langs
    this.allowed_commands    =   msite.allowed_commands

    // Idiomas raros que no van a generar ficheros con su nombre
    this.strange_langs      =   msite.strange_langs


    this.exception           =   msite.exception

    this.branch              =   msite.branch
    this.prod                =   msite.prod
    this.prodbranch          =   msite.prodbranch

    this.site                =   msite.site
    this.cached_site         =   msite.cached_site

    this.title               =   msite.title
    this.site_title          =   msite.site_title
    this.title_hover         =   msite.title_hover

    this.server              =   msite.server
    this.env                 =   msite.env

    // ICON - LOGO

    this.icon                =   msite.icon
    this.logo                =   msite.logo
    this.logo_alt            =   msite.logo_alt

    this.logo_tablet         =   msite.logo_tablet
    this.logo_mobile         =   msite.logo_mobile
    this.logo_desktop        =   msite.logo_desktop
    this.logo_4k             =   msite.logo_4k
    this.logo_8k             =   msite.logo_8k

    this.comm_positions      =   msite.comm_positions
    this.spec_positions      =   msite.spec_positions

    this.metatags            =   msite.metatags

    // PATHS

    this.base_path           =   msite.base_path

    this.photos_link         =   msite.photos_link

    this.photos_path         =   msite.photos_path

    // Customized path for current photo
    this.current_photo_path  =   msite.current_photo_path


    this.images_path         =   msite.images_path

    // Dat content path
    this.contents_path       =   msite.contents_path

    // File System path
    this.filesystem_path     =   msite.filesystem_path

    // Real site path
    // /mnt/ssd/brqx/base/react/arqdru
    this.site_path           =   msite.site_path

    this.general_cache_path  =   msite.general_cache_path

    this.start_time          =   msite.start_time
  }

  //---------------------------------------------------------------------------------------------

}

exports.main_site = main_site
