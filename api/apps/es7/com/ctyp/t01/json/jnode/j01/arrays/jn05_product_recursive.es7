// Common Array
class jn05_array_product_recursive extends jn06_commo_json_recursive_call_product {

           
  constructor ()   
  {   
    super()
    this.n                =  'jn05_array_product_recursive::'      
  }

  //---------------------------------------------------------------------------------------------
  // Parent Otype dice de que tipo deben ser todos los ojetos a este nivel
  // Recursive structure
  save_json_recursive_product_array_to_file(  
            index                 ,  // Indice
            enbreadcrumb  =   ''  ,  // Breadcrumb en ingles
            depth         =  0    ,
            parent_otype = "array") 
  {

    this.j.clean()

