    // this.p ('j05_prod Position to check A ' +  index  + ' Idx ' + idx.jindex )

    // this.p ('j05_prod Loading ' + this.s.main_lang + ' ' + this.jindex  )
    let cats         = this.gethash_arr(this.s.ms.main_lang, idx.jindex)                              ;

    // En principio va a llegar 3

    var last_element           = Object.keys(cats).length - 1

    // Convert 0003 to 3

    // this.p('jn06_page_passed ' + this.s.cs.page)
    var pos                    = Number(this.s.cs.page).toString()

      // Set Json attribs
    this.attribs(idx, pos , index, depth)

    
    this.p ('j05_prod Position to check B' + pos  + ' Idx ' + idx.jindex )
    
    // llega 03 y debe ser 3
    

    // this.p ('j05_prod Position to check (must to show a0001) ' + pos +  ' Cat: ' + this.cat )   


    let current_level        = this.j.index

      // add_json block
    this.rvlash_inner(current_level)
    this.j.index               = this.result   
        
    
    // jn05_recursive HOVER articles/a24
    // jn05_recursive CLINK https://dog.vbrqx.com/fr/article/a24

    // this.p('jn05_recursive HOVER ' + this.j.hover)              
    // this.p('jn05_recursive CLINK ' + this.j.link)              

    this.links_management(idx, pos)   
   
    // Siempre se esta insertando el dominio y esto esta mal
    // this.j.link               = this.s.cs.http_domainbar + this.j.link

    let object_type = this.k.otype
    
      
    if ( this.j.child == "yes" )
    {

        // this.p ("jn05_product_Procesando Hijo Nivel Inicial " + this.j.otype + '  ' + current_level )
        // Array u Objeto

        if (parent_otype == "array")
        {
          // this.p ("jn05_ircsv : Generating ARray")
          this.k.createspecificpart(object_type)        
        }
        else
          this.j.createspecificpart(object_type)                


        this.review_childrens_recursive_product(  
          current_level          ,
          enbreadcrumb           ,  // Breadcrumb en ingles
          depth + 1              ,
          object_type           )

        if (parent_otype == "array")
          this.k.end_pull(object_type)
        else
          this.j.end_pull(object_type)
  
    } 
    else
    {
      // AQUI NUNCA ENTRA

      // this.p("Checking Index " + index + '  ' +  this.k.type )

          this.manage_array_parragraphs( current_otype , current_level )

      // this.p('jn05_product_Parrafete end ' + pf_to_load )
    }
    //if (last_element != pos)
    //   this.j.add_separator()
    
 
