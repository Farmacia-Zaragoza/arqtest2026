// Methods:
//-------------------------------------------------------------------------------------
// - d-review_childrens_recursive-                   : Recursive method
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			)))

const  fs                         =   require(  'fs'                                                   ),
       empty                      =   require(  'is-empty'                             ),
       accents                    =   require(  'remove-accents'                       ),
       { idx_pointers }           =   require(  path.join(JS_TYP7, 'logs/idx_pointers.es7'))),
       { jn01_comma_json_simple } =   require(  path.join(JS_TYP7, 'json/jnode/j01/arrays/jn01_simple.es7')));

// Comm Object
class jn05_commo_json_recursive_call extends jn01_comma_json_simple {


  constructor ()
  {
    super()
    this.n                   =  'jn05_commo_json_recursive_call::'
  }

  clean_empty_values(index , depth)
  {
    this.m         =  'review_childrens_recursive_object'

    var idx = new idx_pointers(index)

    let cats                   = this.gethash_arr(this.s.ms.main_lang , idx.jindex)

    for (var pos in cats)
    {
      this.attribs(idx, pos , index , depth)

      if (this.j.value == "")
      {
        // this.p('jn05_obj_Call Ojo alias ' + this.j.item)
        delete cats[pos]
      }
    }
  }


  //---------------------------------------------------------------------------------------------
  review_childrens_recursive(
            index                      ,  // 1.Indice
            enbreadcrumb  =   ''       ,  // 2.Breadcrumb en ingles
            depth         =  0         ,  // 3.
            parent_otype  =  'object'  )  // 4.
  {
    this.m         =  'review_childrens_recursive_object'

    var idx = new idx_pointers(index)

    let cats                   = this.gethash_arr(this.s.ms.main_lang , idx.jindex)
    var iterations             = Object.keys(cats).length - 1

    // Aqui solo entran los metodos generales
    // this.p('jn05_rc ' + this.s.ms.main_lang + ' ' + idx.jindex)
    // this.p('jn05 rc ' + this.arr['en']['j020v000'][0] )
    // this.p('jn05_rc ' + iterations)

    // Hay que hacer una primera pasada limpiando aliases


    for (var pos in cats)
    {
      // Se pone a false siempre pues hay casos que no queremos generar
      this.b.type_generated = false
      // Set Json attribs
      this.attribs(idx, pos , index , depth)

      // Para cada uno hay que gestionar hijos

      let current_level        = this.j.index
      let current_enbreadcrumb = enbreadcrumb + '/' + accents.remove (this.j.item).toLowerCase()

      // Land domain usa this.s.ms.lang

      // Managing Site Title Link
      if (this.j.type == "title" || this.j.type == "logotype") this.j.link = this.s.cs.http_domainbar + this.s.cs.lang

      if (this.j.type == "alias")
      {
		// Si el alias no tiene valor no se genera

	  }

      this.links_management(idx , pos)

      // this.p ("jn05_si_rcsv : " + this.j.item +  ' PT '  + parent_otype + ' T ' + this.j.otype )

      // sg_site_name
      // this.p('j05_Rcsv_callobj ' + this.j.item)

      if ( this.j.child == "yes" )
      {

        // this.p ("jn05_s_ircsv : Have Childrens: " + this.j.item)

        let current_otype = this.j.otype

        // Le pasamos el separador de los hijos
        if (parent_otype == "array")
        {
          // this.p ("jn05_ircsv : Generating ARray")
          this.k.createspecificpart(current_otype)
        }
        else
          this.j.createspecificpart(current_otype)




        this.review_childrens_recursive(
            current_level          ,
            current_enbreadcrumb       ,  // Breadcrumb en ingles
            depth +1            ,
            this.j.otype          )

        // this.p ("Fin Hijo Obj " + this.j.index + '  ' + this.j.otype )

        if (parent_otype == "array")
          this.k.end_pull(current_otype)
        else
          this.j.end_pull(current_otype)

        // Si ha llamado a algun hijo es un tipo ya generado
        this.b.type_generated = true
      }
      else
      {
        // FINAL RECURSIVIDAD - OBJETOS COMPLETOS
        // this.p('jn05_rc ' +  this.j.index + ' ' + this.j.type)
        this.manage_array_parragraphs(parent_otype, this.j.index)

      }

      // Acierta. Va decreciendo el array y solo inserta la coma si no es el ultimo elemento

      if ( (--iterations  >= 0) && (this.b.type_generated) )
        this.j.add_separator()

     }  // End For

  }

}

exports.jn05_commo_json_recursive_call = jn05_commo_json_recursive_call
