// Pendiente de cambiar
class jn02_array_anchor_inner extends jn00_comm_pf {

  constructor ()
  {
    super()
    this.n                         =  'jn02_array_anchor_inner::'
  }

  //---------------------------------------------------------------------------------------------
  save_json_array_anchor_inner(depth)
  {
    // top - bottom

    this.kk.type = 'anchor'
    var anchor_domain = this.s.cs.lang_url + '#'

    // https://dog.vbrqx.com/ca/#
    //this.p('jn06_rcsv_anchor_dom ' + anchor_domain)

     // let current_otype = "this.j.otype"array

    let current_otype = "array"

    var arr_anchors = this.s.arr["pagesep"]

    var arr_anchors_name = this.s.arr["pagesep_name"]

    // "": { "index": "common_features","type": "link","otype": "",
    // "name": "undefined # anchor_list","clink": "undefined#common_features" }

    var iterations           = Object.keys(arr_anchors).length - 1

    this.p('jn02_anchors - iter  ' + iterations )
    this.parr(arr_anchors)

    for (var pos in arr_anchors)
    {
	  this.kk.index   = this.get_next_level(pos)
	  this.kk.item     = arr_anchors[pos]
	  this.kk.value   = arr_anchors_name[this.kk.item]
	  this.kk.link       = anchor_domain + arr_anchors[pos]

      // this.kk.value  = this.jj.site_title + ' # ' + this.jj.item
			 // this.p ('jn06_poslnkA ' + this.j.item)

      if (this.kk.item != "")
      {
        this.kk.createspecifictype(current_otype)
			   // this.p ('jn06_poslnkB ' + this.j.item)

        if (--iterations  >= 0)
          this.kk.add_separator()
	  }
      else
        --iterations
	}

  }

}

exports.jn02_array_anchor_inner = jn02_array_anchor_inner
