const { JS_TYP7  } = require(path.join(process.cwd(),'api/apps/paths.js'));

const  fs                         =   require(  'fs'                                                          ),
       empty                      =   require(  cons.NODE_MOD + 'is-empty'                                    ),
       accents                    =   require(  cons.NODE_MOD + 'remove-accents'                              ),
       { idx_pointers }           =   require(  cons.JS_TYP7  + 'logs/idx_pointers.es7'                       ),
       { jn10_fs_json_simple } =   require(  cons.JS_TYP7  + 'json/jnode/j01/fs/jn10_fs_simple.es7' );


class jn07_comma_json_doble_call extends jn10_fs_json_simple {


  constructor ()
  {
    super()
    this.n                   =  'jn07_comma_json_doble_call::'
  }

  //---------------------------------------------------------------------------------------------
  review_childrens_doble_array(
            index           ,   // Indice
            enbreadcrumb   =   ''  ,  // Breadcrumb en ingles
            depth      =  0  )
  {
    // Cada metodo debe tener su clase indices para evitar regeneraciones

    var idx = new idx_pointers(index)

    let cats         = this.gethash_arr(this.s.ms.main_lang, idx.jindex)                              ;
    var iterations           = Object.keys(cats).length - 1
    // this.p('Before pos bucle ' + cats.length )


    for (var pos in cats)
    {
      // Set Json attribs
      this.attribs(idx, pos)

      let current_level        = this.j.index
      let current_enbreadcrumb = enbreadcrumb + '/' + accents.remove (this.j.item).toLowerCase()



      // add_json block
      this.rvlash_inner(current_level)
      this.index               =  this.result

      // No pasa
      this.p('jn07_GenVslash ' + this.index + ' l ' + current_level)

      this.links_management(idx, pos)

      this.j.index             =   this.index


      if ( (this.k.type == "parragraph"  ) ||  (this.k.type == "iparragraph" ) )
      {
          this.rvtoslash(index)
          let folder_to_load = this.s.ms.contents_path + 'l' +  this.result
          let pf_to_load     = folder_to_load       + '/' + this.j.value

          // this.p('Parrafete a cargar ' + pf_to_load )
      }

      // fallara cuando pase por aqui
      this.manage_parragraphs('array' , pf_to_load )


      if (--iterations  >= 0)
        this.j.add_separator()

     }  // End For

  }

}

exports.jn07_comma_json_doble_call = jn07_comma_json_doble_call
