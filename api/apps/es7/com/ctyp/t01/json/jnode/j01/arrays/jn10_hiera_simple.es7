const path = require(  'path'                                                 );
// [DOCHANGED_NODE ES7_SPACES]
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Agile Node JS Generate Array Json Simple Class  [V.0.0.3]  (2019-06-13)
