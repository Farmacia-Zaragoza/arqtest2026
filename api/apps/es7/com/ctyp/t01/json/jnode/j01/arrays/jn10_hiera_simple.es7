// Fast node load - Replace Mysql connections
//-------------------------------------------------------------------------------------
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// - d-save_json_simple_array_to_file-          : Generate Json Simple
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			);

const  fs                 =   require(  'fs'                                                   );
       const empty = require(  'is-empty'                             );
       const accents = require(  'remove-accents'                       );
       
       const { idx_pointers } = require(path.join(global.JS_TYP7, 'logs/idx_pointers.es7'))
       const { jn14_hiera_json_list } = require(path.join(global.JS_TYP7, 'json/jnode/j01/arrays/jn14_hiera_list.es7'))

class jn10_hiera_json_simple extends jn14_hiera_json_list {

  constructor ()
  {
    super()
    this.n                         =  'jn10_hiera_json_simple::'
  }

  //---------------------------------------------------------------------------------------------
  // Garland Main - Top - Bottom - One Dimension
  save_json_hiera_simple_array_to_file(
            index                      ,   // Indice
            enbreadcrumb    =   ''     ,
            file_structure = ''        ,
            parent_otype    = 'object' ,
            concat_to_links = ''    )  // Breadcrumb en ingles
  {
    // top - bottom

    var  idx = new idx_pointers(index)

    // en
    // this.p('j22_com_simple ' + 'Before_run_bucle ' + this.s.ms.main_lang +   ' J ' +  index  )
	let cats = this.getarr(this.s.ms.main_lang, idx.jindex)															;

    var iterations           = Object.keys(cats).length - 1

    // this.p('jn01_simpl-Num_' + last_element )

    var parent_breadcrumb = this.s.cs.lang_url + '/' +  path.dirname(enbreadcrumb)

    // this.p ('jn10_link ' + parent_breadcrumb )

    for (var pos in cats)
    {

      this.cat                     = cats[pos]

      let next_level               = this.get_next_level(pos)

      let current_level            = index     + 'v' + next_level
      let current_enbreadcrumb     = enbreadcrumb + '/' + accents.remove (this.cat ).toLowerCase()

      this.rvlash_inner(current_level)
      this.index                   =  this.result

      // Aqui no entra
      // this.p ('j22_simple ' + current_level + ' Ind ' + this.index)

      // end add_json block

      this.j.clean()

      this.j.index    =   this.index

      // Set Json attribs
      this.attribs(idx, pos)

      this.j.item     =   this.cat

      this.p('jn10_hiera_item ' + this.j.item)

      this.clink    =  this.getkeylang( idx.lindex , pos)

      if (this.clink != "" )
        this.j.link     =   parent_breadcrumb + this.clink  + concat_to_links

      //---------------------------------------------------------------------------------------------

      if (this.j.item == 'anchor')
      {
         // Estamos manejando un anchor
		 // this.p('jn06_Anchor ' + this.j.value + ' Allowed ' + this.s.b.anchor_allowed )

		 if (!this.s.b.anchor_allowed) this.j.value = ''
      }

      //---------------------------------------------------------------------------------------------

      if (this.j.item == 'anchor_list')
      {

         // Estamos manejando un anchor
		 // this.p('jn06_Anchor ' + this.j.value + ' Allowed ' + this.s.b.anchor_allowed )

         // this.p('jn06_time_to_generate_anchors '+ this.anchor_list)

         if (this.b.robot_page)
         {
           //this.p('jn06_time_to_geanchors_brob '+ this.anchor_list)

           this.j.type = 'link'
           var anchor_domain = this.j.uri_site + '#'

           var arr_lnk = this.anchor_list.split(' ')

           var int_lnk = ''
           let current_otype = this.j.otype

           for (var pos in arr_lnk)
           {
			 this.j.item  = arr_lnk[pos]
             this.j.link  = anchor_domain + arr_lnk[pos]

             this.j.value = this.j.site_title + ' # ' + this.j.item
			 // this.p ('jn06_poslnkA ' + this.j.item)

             if (this.j.item != "")
             {
               this.j.createspecifictype(current_otype)
			   // this.p ('jn06_poslnkB ' + this.j.item)
			 }
		   }

         // Vamos a iterarlo para generar las urls con estos links
           // Desactivamos el tipo para ficheros robot
           this.j.type = 'unlink'

	     }
	     else
	     {
			// JSon
           this.j.value = this.anchor_list

	     }

           // Igual hay que volver a dejar las cosas como antes de poner el link
      }

      //---------------------------------------------------------------------------------------------

      // Este metodo lo vamos a tener que ajustar pues hay atributos que siempre se copian
      this.k.copyvalues(this.j)

      let current_otype = this.j.otype
      // this.p('jn01_concats ' +  this.k.link  + ' TS ' + this.s.cs.teaser_type)

      let pf_to_load = ''

      if ( (this.k.type == "parragraph"  ) ||  (this.k.type == "iparragraph" ) )
      {
         let folder_to_load = this.s.ms.contents_path + '/' + file_structure
         pf_to_load     = folder_to_load       + '/' + this.k.value

         this.p ('jn10_file_to_load ' + pf_to_load)
      }

      this.manage_parragraphs('object', pf_to_load)

      if (--iterations  >= 0)
        this.j.add_separator()

     }  // End For

  }

}

exports.jn10_hiera_json_simple = jn10_hiera_json_simple

