const { JS_TYP7  } = require(path.join(process.cwd(),'api/apps/paths.js'));

const  fs                        =   require(  'fs'                                                   ),
       empty                     =   require(  cons.NODE_MOD + 'is-empty'                             ),
       accents                   =   require(  cons.NODE_MOD + 'remove-accents'                       ),
       { idx_pointers }          =   require(  cons.JS_TYP7  + 'logs/idx_pointers.es7'                ),
       { jn11_object_allinone_main } =   require(  cons.JS_TYP7  + 'json/jnode/j01/lists/jn11_allinone_main.es7'  );


// Pendiente de cambiar
class jn02_array_list_inner extends jn11_object_allinone_main {


  constructor ()
  {
    super()
    this.n                         =  'jn02_array_list_inner::'
  }


  //---------------------------------------------------------------------------------------------
  save_json_array_list_inner(
            index           ,   // Indice
            enbreadcrumb   =   ''  ,
            depth          = 0 ,
            otype = "array")
  {
    // top - bottom

    var idx = new idx_pointers(index)

    let cats         = this.gethash_arr(this.s.ms.main_lang, idx.jindex)

    // We dont put sm_meta_og_description
    var iterations           = Object.keys(cats).length - 2

    // this.p('Num_elem_22_simple_' + last_element )

    for (var pos in cats)
    {

      // Set Json attribs
      this.attribs(idx, pos)


      if (this.j.item != 'sm_meta_og_description')
      {

        let current_level        = this.j.index
        let current_enbreadcrumb = enbreadcrumb + '/' + accents.remove (this.j.item ).toLowerCase()

        // add_json block - replace any occurences
        this.rvlash_inner(current_level)
        this.index               =  this.result

        this.links_management(idx , pos)

        // this.p('jn02_list ' + idx.hindex + '  ' + this.k.hover)

        this.k.index    =   pos


        // Estamos generando esta linea
        // { "index": "0","type": "link","otype": "object","name": "x.- Architectural Focus","clink": "en/article/a00" }
        this.k.createspecifictype()

        if (--iterations  >= 0)
          this.j.add_separator()


     }
   }  // End For

  }

}

exports.jn02_array_list_inner = jn02_array_list_inner
