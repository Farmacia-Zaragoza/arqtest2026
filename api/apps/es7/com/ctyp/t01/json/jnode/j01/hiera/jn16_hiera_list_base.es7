define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			)))

const  fs                        =   require(  'fs'                                                   ),
       empty                     =   require(  'is-empty'                             ),
       accents                   =   require(  'remove-accents'                       ),
       path               =   require(  'path'                                                 ),
       { idx_pointers }          =   require(  path.join(JS_TYP7, 'logs/idx_pointers.es7'))),
       { jn01_object_list_main } =   require(  path.join(JS_TYP7, 'json/jnode/j01/lists/jn01_list_main.es7')));

class jn16_hiera_json_list_base extends jn01_object_list_main {


  constructor ()
  {
    super()
    this.n                         =  'jn16_hiera_json_list_base::'
  }

  //---------------------------------------------------------------------------------------------
  save_json_hiera_list_base_array_to_file(
            index                      ,   // Indice
            enbreadcrumb    =   ''     ,
            file_structure = ''        ,
            category        = ''       ,
            title           = ''       ,
            depth           = 0        )
  {
    // top - bottom

    // this.p('jn16_gettingIDX ' + index)
    var idx               = new idx_pointers(index)

    let cats              = this.gethash_arr(this.s.ms.main_lang, idx.jindex)

    // Siempre van a tener meta_og_description como la ultima
    var iterations        = Object.keys(cats).length - 2

    var parent_breadcrumb = this.s.cs.lang_url + enbreadcrumb + '/'

    // this.p('Num_elem_22_simple_' + last_element )

    for (var pos in cats)
    {

      // Se pone a false siempre pues hay casos que no queremos generar
      this.b.type_generated = false
      // Set Json attribs
      this.attribs(idx, pos , index , depth)

      if (this.j.item != 'sm_meta_og_description')
      {

        // add_json block - replace any occurences

        this.k.index    =   pos

        if (this.k.link != "" )
        {
          this.k.link       =   parent_breadcrumb + this.k.link

          // this.p('jn14_link ' + this.k.link)
        }

        // Creating lists
        this.k.createspecifictype(this.k.otype)

        if (--iterations  >= 0)
          this.j.add_separator()

      }
     }  // End For

  }

}

exports.jn16_hiera_json_list_base = jn16_hiera_json_list_base
