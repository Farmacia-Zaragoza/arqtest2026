define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  fs                        =   require(  'fs'                                                   );
       const empty = require(  'is-empty'                             );
       const accents = require(  'remove-accents'                       );
       const { idx_pointers } = require(path.join(JS_TYP7, 'logs/idx_pointers.es7'))
       const { jn05_array_product_recursive } = require(path.join(JS_TYP7, 'json/jnode/j01/arrays/jn05_product_recursive.es7'))

// Pendiente de cambiar
class jn04_comma_json_simple_list extends jn05_array_product_recursive {

  constructor ()
  {
    super()
    this.n                         =  'jn04_comma_json_simple_list::'
  }

  //---------------------------------------------------------------------------------------------
  save_json_list_array_to_file(
            index           ,   // Indice
            enbreadcrumb   =   ''  )  // Breadcrumb en ingles
  {
    // top - bottom

    var idx = new idx_pointers(index)
    let cats         = this.gethash_arr(this.s.ms.main_lang, idx.jindex)
    var iterations           = Object.keys(cats).length - 1

    // this.p('Num_elem_22_simple_' + last_element )

    for (var pos in cats)
    {

      // Set Json attribs
      this.attribs(idx, pos , index)

      let current_level        = this.j.index
      let current_enbreadcrumb = enbreadcrumb + '/' + accents.remove (this.j.item ).toLowerCase()

      this.k.index    =   pos

      // Creating lists
      this.k.createspecifictype(this.k.otype)

      if (--iterations  >= 0)
        this.j.add_separator()

     }  // End For

  }

}

exports.jn04_comma_json_simple_list = jn04_comma_json_simple_list
