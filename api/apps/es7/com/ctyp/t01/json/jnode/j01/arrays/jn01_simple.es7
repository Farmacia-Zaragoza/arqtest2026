define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  fs                        =   require(  'fs'                                                   );
       const empty = require(  'is-empty'                             );
       const accents = require(  'remove-accents'                       );
       const { idx_pointers } = require(path.join(JS_TYP7, 'logs/idx_pointers.es7'))
       const { jn02_comma_json_doble } = require(path.join(JS_TYP7, 'json/jnode/j01/arrays/jn02_doble.es7'))

// Pendiente de cambiar
class jn01_comma_json_simple extends jn02_comma_json_doble {

  constructor ()
  {
    super()
    this.n                         =  'jn01_comma_json_a_simple::'
  }

  //---------------------------------------------------------------------------------------------
  // Garland Main - Top - Bottom - One Dimension
  save_json_simple_array_to_file(
            index                   ,   // Indice
            enbreadcrumb    =   ''  ,
            concat_to_links = ''    )  // Breadcrumb en ingles
  {
    // top - bottom

    var  idx = new idx_pointers(index)

    // en
    // this.p('j22_com_simple ' + 'Before_run_bucle ' + this.s.ms.main_lang +   ' J ' +  index  )
	  let cats = this.gethash_arr(this.s.ms.main_lang, idx.jindex)															;

    var iterations           = Object.keys(cats).length - 1

    // this.p('jn01_simpl-Num_' + last_element )

    for (var pos in cats)
    {
      // Se pone a false siempre pues hay casos que no queremos generar
      this.b.type_generated = false

      // Set Json attribs
      this.attribs(idx, pos, index)

      this.k.link     =   this.k.link  + concat_to_links

      this.manage_array_parragraphs('array', this.k.index)

      if ( (--iterations  >= 0) && (this.b.type_generated) )
        this.j.add_separator()

     }  // End For

  }

}

exports.jn01_comma_json_simple = jn01_comma_json_simple

