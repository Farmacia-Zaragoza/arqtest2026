//-------------------------------------------------------------------------------------
// - d-save_json_sidebar_doble_object_to_file-          : Generate doble Json
// - d-review_childrens_doble_object-                   : 2nd level method
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

const { JS_TYP7  } = require(path.join(process.cwd(),'api/apps/paths.js'));

const  fs                            =   require(  'fs'                                                       ),
       empty                         =   require(  cons.NODE_MOD + 'is-empty'                                 ),
       accents                       =   require(  cons.NODE_MOD + 'remove-accents'                           ),
       { idx_pointers }              =   require(  cons.JS_TYP7  + 'logs/idx_pointers.es7'                    ),
       { jn03_commo_json_recursive } =   require(  cons.JS_TYP7  + 'json/jnode/j01/objects/jn03_recursive.es7');

// Common Objects
class jn02_commo_json_doble extends jn03_commo_json_recursive {


    constructor ()
    {
    super()
    this.n                   =  'jn02_commo_json_doble::'
    }

  //---------------------------------------------------------------------------------------------
  // Used to generate Left and Right Menus
  // Recursive structure
  save_json_sidebar_doble_object_to_file(
            index           ,   // Indice
            enbreadcrumb   =   ''  ,  // Breadcrumb en ingles
            depth      =  0  )
  {

    var idx = new idx_pointers(index)

    let cats         = this.gethash_arr(this.s.ms.main_lang, idx.jindex)                              ;

    var iterations           = Object.keys(cats).length - 1

    this.p ("jn02_d_" )

    for (var pos in cats)
    {
      // Se pone a false siempre pues hay casos que no queremos generar
      this.b.type_generated = false
      // Set Json attribs
      this.attribs(idx, pos , index , depth)

      let current_level  = this.j.index
      let current_enbreadcrumb  = enbreadcrumb + '/' + accents.remove (this.j.item ).toLowerCase()


      // this.p('Managingg ' + this.j.type + '  - ' + this.j.child)

      let object_type = this.j.otype

      if ( this.j.child == "yes" )
      {

        // this.p ("Procesando Hijo " + this.cat )

        // falta aqui el tipo
        this.j.createspecificpart(object_type)

        // Escribir la parte


        this.review_childrens_doble_object(
          current_level          ,
          enbreadcrumb       ,  // Breadcrumb en ingles
          depth + 1          ,
          this.j.otype            )


        this.j.end_pull(object_type)
        // Si ha llamado a algun hijo es un tipo ya generado
        this.b.type_generated = true
      }
      else
      {
        // Run Parragraphs


          this.manage_array_parragraphs('object', this.j.index)

      }

      if ( (--iterations  >= 0) && (this.b.type_generated) )
        this.j.add_separator()

     }  // End For

  }

}

exports.jn02_commo_json_doble = jn02_commo_json_doble
