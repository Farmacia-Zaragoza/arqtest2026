global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			);

const  fs                            =   require(  'fs'                                  );
       const empty = require(  'is-empty'                        );
       const accents = require(  'remove-accents'                    );
       const _mod_safe_1 = require(path.join(global.JS_TYP7, 'logs/idx_pointers.es7'); const idx_pointers = _mod_safe_1.idx_pointers || _mod_safe_1;)
       const _mod_safe_2 = require(path.join(global.JS_TYP7, 'json/jnode/j01/arrays/jn03_recursive.es7'); const jn03_comma_json_recursive = _mod_safe_2.jn03_comma_json_recursive || _mod_safe_2;)

class jn02_comma_json_doble extends jn03_comma_json_recursive {

  constructor ()
  {
    super()
    this.n                   =  'jn02_comma_json_doble::'
  }

  //---------------------------------------------------------------------------------------------
  // Used to generate Left && Right Menus
  // Recursive structure
  save_json_sidebar_doble_array_to_file(
            index           ,   // Indice
            enbreadcrumb   =   ''  ,  // Breadcrumb en ingles
            depth      =  0  )
  {

    var idx                    = new idx_pointers(index)

    let cats                   = this.gethash_arr(this.s.ms.main_lang, idx.jindex)                              ;

    var iterations           = Object.keys(cats).length - 1

    // 006 - en
    // this.p ("jn02_Dbl_index " + index + ' Lang ' + this.s.ms.main_lang  )

    for (var pos in cats)
    {
      // Set Json attribs
      this.attribs(idx, pos , index, depth)

      let current_level        = this.j.index
      let current_enbreadcrumb = enbreadcrumb + '/' + accents.remove (this.j.item ).toLowerCase()

      // add_json block
      this.rvlash_inner(current_level)
      this.index               = this.result

      this.j.index             =   this.index

      if ( this.j.child == "yes" )
      {

        // this.p ("jn02_doble_Procesando Hijo " + this.cat )

        let object_type     =  this.k.otype

        this.k.createspecificpart(object_type)

        // Escribir la parte

        this.review_childrens_doble_array(
          current_level          ,
          enbreadcrumb       ,  // Breadcrumb en ingles
          depth + 1          ,
          this.j.otype                    )

        // Finalizar la parte

        this.k.end_pull(object_type)
      }
      else
      {
//        if ( this.s.cs.teaser_type	   ==  'full')
//        {
          let pf_to_load = ''
          if ( (this.k.type == "parragraph"  ) ||  (this.k.type == "iparragraph" ) )
          {
            this.rvtoslash(index)
            let folder_to_load = this.s.ms.contents_path + 'l' +  this.result
            let pf_to_load     = folder_to_load       + '/' + this.k.value

            // this.p('jn02_dbl_Parrafete a cargar ' + pf_to_load )
          }

          this.manage_parragraphs('array', pf_to_load)
//        }
      }

      if ( (--iterations  >= 0) && (this.b.type_generated) )
        this.j.add_separator()

     }  // End For

  }

}

exports.jn02_comma_json_doble = jn02_comma_json_doble


module.exports = jn02_comma_json_doble;
module.exports.jn02_comma_json_doble = jn02_comma_json_doble;
