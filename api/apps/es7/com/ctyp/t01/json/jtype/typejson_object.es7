global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			);

const _mod_safe_1 = require(path.join(global.JS_TYP7, 'json/jtype/blkjson_object.es7'); const blkjson_object = _mod_safe_1.blkjson_object || _mod_safe_1;)
		const sctf = require(path.join(global.JS_LIB7, 'file/save_code_to_file.es7'))

class typejson_object extends blkjson_object {
	constructor(file_name = '')
	{
		super(file_name )
		this.n 				= 	"typejson::"
	}

	createspecifictype()
	{

		this.managespecifictype(false)

		this.create()

		this.code = '"' +  this.item + '": '  + this.code

		sctf.update_file_with_code(this.full_path, this.code)

		this.clean()
	}

	createspecificpart(object_type = "object" )
	{

		this.content = '"' +  this.item + '": {'

		this.managespecifictype(true)

		//this.add_separator()

		this.add_childrens(	this.child				)

		if (object_type == 'array')
			this.add_pull(		this.level , '['				)
		else
			this.add_pull(		this.level , '{'				)

		sctf.update_file_with_code(this.full_path, this.content)

		this.clean()
	}

	createcommonpart(object_type)
	{
		// Add {

		this.content = '"' +  this.item + '": {'

		this.managecommontype(true)

		//this.add_separator()

		this.add_childrens(	this.child				)

		if (object_type == 'array')
			this.add_pull(		this.level , '['				)
		else
			this.add_pull(		this.level , '{'				)

		sctf.create_update_full_filename(this.full_path, this.content)
		this.clean()
	}

	createcommontype()
	{
		// Works fine
		this.managecommontype(false)

		this.create()
		this.code = '"' +  this.item + '": '  + this.code

		sctf.create_update_full_filename(this.full_path, this.code)
		this.clean()
	}

	managethemeelem(part)
	{
        // Index es la J y si ees un objeto no hace falta ponerlo de nuevo
		// this.add_index(						this.index		)
		this.add_type(						this.type		)
		this.add_element( 		'value' 	, this.value	)
		this.add_element( 		'bgcolor' 	, this.bgcolor	)

		if (part)
			this.add_element( 	'clink'		, this.link		)
		else
			this.add_lastelement( 	'clink'	, this.link		)

	}

}

exports.typejson_object = typejson_object


module.exports = typejson_object;
module.exports.typejson_object = typejson_object;
