//BlkJson  Block Json Style Class  [V.0.0.4]  (2019-04-17)
//------------------------------------------------------------------------------------
//Methods:
//- d-save_simple_header            : Add simple header to json structure
//- d-save_header_array             : Add array header to json structure
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   echo              =   require(  'node-echo'                                         );
        const sctf = require(path.join(JS_LIB7, 'file/save_code_to_file.es7'))
		const { blkjson } = require(path.join(JS_TYP7, 'json/jtype/blkjson.es7'))

class blkjson_array extends blkjson {
  constructor(file_name = '')
  {
    super(file_name)
  }

  save_simple_header(header)
  {
    let code   =  '"' +  header + '" : '
    sctf.create_update_full_filename(this.full_path, code)

    this.clean()
  }

  save_header(header)
  {
    this.save_header_array(header)
  }

  save_header_array(header)
  {
    let code   =  '"' +  header + '" : [ '
    sctf.create_update_full_filename(this.full_path, code)

    this.clean()
  }

}

exports.blkjson_array = blkjson_array

