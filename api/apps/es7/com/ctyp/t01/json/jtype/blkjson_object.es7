global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			);

const 	echo 				= 	require(	'node-echo'													);
        const sctf = require(path.join(global.JS_LIB7, 'file/save_code_to_file.es7'))
		const _mod_safe_1 = require(path.join(global.JS_TYP7, 'json/jtype/blkjson.es7'); const blkjson = _mod_safe_1.blkjson || _mod_safe_1;)

class blkjson_object extends blkjson {
	constructor(file_name = '')
	{
		super(file_name)
		this.n 				= 	"blkjson_object::"
	}

	save_keyheader(header)
	{
		let code 	=	'"' +  header + '" : {'
		sctf.create_update_full_filename(this.full_path, code)

		this.clean()
	}

	save_nokeyheader(header)
	{
		let code 	=	'"' +  header + '" : '
		sctf.create_update_full_filename(this.full_path, code)

		this.clean()

	}

	save_header(header) {
		this.save_keyheader(header)
	}

}

exports.blkjson_object = blkjson_object


module.exports = blkjson_object;
module.exports.blkjson_object = blkjson_object;
