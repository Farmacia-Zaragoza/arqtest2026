define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   echo             =   require(  'node-echo' );
       const { json_copy } = require(path.join(JS_TYP7, 'json/jtype/json_copy.es7'))

class json  extends json_copy {
  constructor()
  {
    super()
    this.n         = "json::"
  }

  create(name = "")
  {
    this.code = "{ "
    if (name != "" )
    {
      this.code += name
    }
    else
    {
      this.code += this.content
    }
    this.code += " } " + this.deb
  }

  // "topMenu": [ c ]
  create_block(name , pair_code = '')
  {
    this.create_lastblock(name , pair_code)
    this.code += ","
  }

  // "topMenu": [ c ]
  create_lastblock(name , pair_code = '')
  {
    this.code += "\"" + name + "\": " + "[ "

    if (pair_code != "" )
      this.code += pair_code
    else
      this.code += this.content

    this.code += " ]"
  }

  //  "index": "01",
  // "index": "01",
  create_element(name , pair_code = '')
  {
    this.create_lastelement(name , pair_code)
    this.code += ","
  }

  // "index": "01"
  create_lastelement(name , pair_code = '' )
  {
    this.code += "\"" + name + "\": " + "\""

    if (pair_code != "" )
      this.code += pair_code
    else
      this.code += this.content

    this.code += "\""
  }

  add_element(name , pair_code = '')
  {
    this.add_lastelement(name , pair_code)
    this.content += ","
  }

  // "index": "01"
  add_lastelement(name , pair_code = '' )
  {
    this.content += "\"" + name + "\": " + "\""

    this.content += pair_code

    this.content += "\""
  }

  add_boolean(name , pair_code = '')
  {
    this.add_lastboolean(name , pair_code)
    this.content += ","
  }

  add_lastboolean(name , pair_code = '' )
  {
    this.content += "\"" + name + "\": "
    this.content += pair_code
  }

  add_value(name) {
    this.content += "" + name + ", "
  }

  add_strvalue(name) {
    this.content += "\"" + name + "\","
  }

  add_lastvalue(name) {
    this.content += "" + name
  }

  add_laststrvalue(name) {
    this.content += "\"" + name + "\""
  }

  clean()
  {
    this.code       = ""
    this.content     = ""
  }

}

exports.json = json
