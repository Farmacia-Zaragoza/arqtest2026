define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			)))

const   { printlog }     =   require(  path.join(JS_TYP7, 'logs/printlog.es7')));


class json_def  extends printlog {
  constructor()
  {
    super()
    this.n              = "json_def::"

    //Symbol for fast debug Enable | Disable
    //this.deb          =   '>'             ;
    this.deb            = ""
    this.tame           = ""
    this.code           = ""
    this.content        = ""

    // Object Definition

    this.cat            =  ''

    this.index          =  ''
    this.id             =  ''
    this.type           =  ''
    this.item           =  ''
    this.photo          =  ''
    this.hover          =  ''

    this.breadcrumb     =  ''
    this.tags           =  ''


    this.link           =  ''

    // Relative Link type (absolute | relative | coomposed)
    this.rtype          =  ''

    this.child          =  ''
    this.flag           =  ''
    this.sound          =  ''
    this.value          =  ''

    this.otype          =  ''

    this.ratio          =  ''
    this.cart           =  ''

    // Location Definitions

    this.categories     =  ''

    // Terms y MainTems son arrays ya definidos

    this.country        =  ''
    this.city           =  ''
    this.location       =  ''

    this.place          =  ''
    this.year           =  ''
    this.date           =  ''
    this.resolution     =  ''

    // Faltan los plurales para hacer el filtro

    this.countries      =  ''
    this.cities         =  ''
    this.locations      =  ''

    this.places         =  ''
    this.years          =  ''
    this.dates          =  ''
    this.resolutions    =  ''

    this.html_type      =  ''

    this.level          =  0
  }
}

exports.json_def = json_def
