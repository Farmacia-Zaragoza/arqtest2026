// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const  fs                   =   require(  'fs'                                                   );
       const empty = require(  'is-empty'                             );
       const accents = require(  'remove-accents'                       );
       const { idx_pointers } = require(path.join(JS_TYP7, 'logs/idx_pointers.es7'))
       const { jn00_search_pf } = require(path.join(JS_TYP7, 'json/jsearch/j00/jn00_search_pf.es7'))

// Comm Object
class jns02_json_recursive_call extends jn00_search_pf {

  constructor ()
  {
    super()
    this.n                   =  'jns02_json_recursive_call::'
  }

  //---------------------------------------------------------------------------------------------
  review_childrens_search_recursive(
            index                      ,  // 1.Indice
            enbreadcrumb  =   ''       ,  // 2.Breadcrumb en ingles
            depth         =  0         ,  // 3.
            parent_otype  =  'object'  )  // 4.
  {
    this.m         =  'review_childrens_search_rcsv'

    var idx = new idx_pointers(index)

    // this.p('jn22R_Jindex ' + this.s.main_lang + ' ' + this.jindex)

    // this.p('jn22R_First ' + this.arr['en']['j020v000'][0] )

    let cats                   = this.getarr(this.s.ms.main_lang , idx.jindex)

    // Object.keys(myObj).length
    var last_element           = Object.keys(cats).length - 1
    var cont                   = 0

    // this.p ('jn05_Last_Element ' + last_element)

    for (var pos in cats)
    {

      // Para cada uno hay que gestionar hijos

      this.cat                 = cats[pos]

      let next_level           = this.get_next_level(pos)

      let current_level        = index     + 'v' + next_level
      let current_enbreadcrumb = enbreadcrumb + '/' + accents.remove (this.cat).toLowerCase()

      this.rvlash_inner(current_level)
      this.index               =  this.result

      this.clink    =  this.getkeylang( idx.lindex , pos)

      if ( (empty(this.clink)) ||
         (this.s.ms.lnk_generation_type === "composed"    ) )
        this.clink    =  current_enbreadcrumb

      // end add_json block

      this.j.clean()

      this.j.index    =   this.index

      // Set Json attribs
      this.attribs(idx, pos)

      this.j.item     =   this.cat
      this.j.link     =   this.u.s.ms.lang + '/' + this.clink
      this.j.level    =   depth

      // Este metodo lo vamos a tener que ajustar pues hay atributos que siempre se copian
      this.k.copyvalues(this.j)

      // this.p('jn05_WE_ARE_HERE ' + this.cat)

      if ( this.j.child == "yes" )
      {

        // this.p ("jn05_s_ircsv : Have Childrens: " + this.j.item)

        let current_otype = this.j.otype

        this.review_childrens_search_recursive(
            current_level          ,
            current_enbreadcrumb       ,  // Breadcrumb en ingles
            depth +1            ,
            this.j.otype          )

        this.j.clean()
        this.k.clean()

        // this.p ("Fin Hijo Obj " + this.j.index + '  ' + this.j.otype )

        // Si ha llamado a algun hijo hay que regenerar los indices

      }
      else
      {
        // FINAL RECURSIVIDAD - OBJETOS COMPLETOS
        if ( this.s.cs.teaser_type	   ==  'full')   //
        {
          let pf_to_load = ''
          if ( (this.k.type == "parragraph"  ) ||  (this.k.type == "iparragraph" ) )
          {
          // Change v to slash-l
            this.rvtoslash(index)
            let folder_to_load = this.s.ms.contents_path + 'l' +  this.result
            pf_to_load     = folder_to_load       + '/' + this.j.value

            // this.p ("jns02_si_rcsv L : " + this.j.link)

            var result = this.search_json_parragraph_from_file(pf_to_load )

            if (result)
            {
              // this.p ('jns02-qry  ' + this.u.slash_sub_query + ' Result ' + result)

              if (this.separator)
              {
                  // this.p('jns02_adding separator')
                  this.j.add_separator()
              }
              // Debe usar hover link y cont
              // this.p ("jns02_si_rcsv L : " + this.j.link)
              // this.p ("jns02_si_rcsv I : " + this.j.hover)

              this.k.clean()

              this.k.type = 'search'

              this.k.index = cont

              this.k.createspecifictype()
              cont++
              this.separator = true

             }
	      }

          // esto igual hay que pensarlo
          // this.j.add_separator()

          // this.p('jn05_to_load ' +  pf_to_load)

        }
      }

     }  // End For

  }

}

exports.jns02_json_recursive_call = jns02_json_recursive_call

