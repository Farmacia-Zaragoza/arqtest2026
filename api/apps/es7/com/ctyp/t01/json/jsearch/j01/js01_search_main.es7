// Comm Object
class jn01_object_search_main extends jn02_object_search_inner {

  constructor ()
  {
    super()
    this.n                   =  'jn01_object_search_main::'
  }

  //---------------------------------------------------------------------------------------------
  // Recursive structure
  save_json_search_main(
            position   = 20        ,   // Indice
            enbreadcrumb   =   ''  ,  // Breadcrumb en ingles
            depth      =  0  )
  {

    // 020

    var index = 'main'
    var idx = new idx_pointers(index)

    // h020
    // this.p('LIST_IPAGE ' + idx.iindex + ' ' + idx.hindex )

    // this.p('LIST_MAIN_BREADC ' + position)

    this.j.clean()
    this.k.clean()

    // Needed to have articles name

    this.j.item       = 'articles'

    // Obtenemos list
    this.j.value   = this.j.item

    this.j.child      = "yes"
    this.j.type       = "bclink"
    this.j.otype      = "array"

    // hmain
    this.j.hover      = "Seach hover " + this.u.bars_sub_query

    this.j.breadcrumb = 'search/' + this.u.dash_sub_query_no_dash

    this.p ('js1_search_main_Breadcrumb ' + this.j.breadcrumb)

    // Barra de busqueda
    this.j.link  = this.s.cs.lang_url  +  this.j.breadcrumb

