class jn01_checking_search_words extends cache {

  constructor (arroba)
  {
    super()

    this.arroba = arroba
    this.s      = this.arroba.s

    this.a                  =  this.arroba.a

    this.arr                =  this.arroba.a.arr


    this.n                         =  'jn01_checking_search_words::'
  }

  //---------------------------------------------------------------------------------------------
  // Garland Main - Top - Bottom - One Dimension
  are_words_right_for_search(
            index                   ,   // Indice
            filter    =   ''  )  // Breadcrumb en ingles
  {
    // top - bottom

    var iindex     = 'i' + index    //   Information

    // Llegan ya con barras
    // jn01_checking_search_words:: - jn01_ck_+clienti|parola|variante+
    let filter_arr = filter.trim().split ('|')


    // this.p('j01_check_words ' + 'Before_run_bucle ' + this.s.cs.main_lang +   ' I ' +  iindex  )

	var words = this.gethash_arr("all", iindex)															;

    // 378 - 757
    // var last_element           = Object.keys(words).length - 1
    // this.p('jn01_check_Num_elem_' + last_element )
    // return key in words

    // Iteramos el filtro
    // son todo palabras en ingles
    // for (var pos in words)
    //    this.p ( 'jn01_ck  ' + filter  + '  ' +  words[pos])


    // Check externo para comprobar multiples palabras
    let result = true

    // Check interno para verificar el for sobre el hash
    let word_in_array = false

    // Iteramos el filtro
    for (var pos in filter_arr)
    {
      // Itera todas las palabras mirando que esten permitidas

      let word_to_check           = filter_arr[pos]
      word_in_array = false

      // this.p('jn01_ck_+'  + word_to_check + "+" )

      // Review word - Si una existe es true
      for (var intpos in words)
         if  ( words[intpos] == word_to_check )  word_in_array = true


      result = result && word_in_array

      // No funciona

    }  // End For

    // if (result)         this.p ('jn01_ck_Las palabras se pueden buscar  :  ' + filter)
    // else        this.p ('jn01_ck_Las palabras no se pueden buscar ' + filter)

    return result
  }



}

