  save_json_search_inner_to_file(
            index                      )
  {
    this.m         =  'save_json_search_inner_to_file'

    let search = true
    var articles_arr = Array()

    // arr_nxj020_32@w_make
    var idx = new idx_pointers(index,'nx')

    this.p('js02_search_inner_SEARCHING ' + this.s.ms.main_lang)

    this.generate_search_inner_lang(index, this.s.ms.main_lang , articles_arr , search)

    // this.generate_search_inner_lang(index, this.s.ms.lang , articles_arr , search)

    this.generate_search_inner_lang(index, this.s.cs.lang , articles_arr , search)
    this.p('js02_search_inner_SEARCHING ' + this.s.cs.lang)

    this.p('js02_search ' + articles_arr.length )

    // Si es un solo encuentro aqui la longitud da 1
    if (search)
      search = (Object.keys(articles_arr).length - 1 ) >= 0

    var enbreadcrumb = ''

    if (search)
    {
      idx = new idx_pointers(index)

      // this.p('jn01_Jindex ' + this.s.ms.main_lang + ' ' + idx.jindex)
      this.cats                   = this.gethash_arr(this.s.ms.main_lang , idx.jindex)

      // Object.keys(myObj).length
      var last_element           = Object.keys(this.cats).length - 1
      var cont                   = 0

      this.p ('jn05_Last_ElementZ ' + index + ' L ' + last_element)

      // We dont put sm_meta_og_description
      var iterations           = Object.keys(articles_arr).length - 1


      for (var pos in articles_arr)
      {

        let article_num = articles_arr[pos]

        let next_level           = this.get_next_level(article_num)

        let current_level        = index     + 'v' + next_level
        let current_enbreadcrumb = enbreadcrumb + '/' + accents.remove (this.cat).toLowerCase()

        this.rvlash_inner(current_level)
        this.index               =  this.result

        // end add_json block

        this.j.clean()
        this.k.clean()

        this.j.index    =   this.index

        // Set Json attribs
        this.attribs(idx, article_num)

        this.j.item     =   this.cat
        this.j.level    =   0

        // Este metodo lo vamos a tener que ajustar pues hay atributos que siempre se copian
        this.k.copyvalues(this.j)

        // this.p('jn05_WE_ARE_HERE ' + this.cat)


              // this.p ('jns02-qry  ' + this.u.slash_sub_query + ' Result ' + result)

              // Debe usar hover link y cont
              // this.p ("jns02_si_rcsv L : " + this.j.link)
              // this.p ("jns02_si_rcsv I : " + this.j.hover)

       this.k.index = article_num

       this.k.createspecifictype()

       if (--iterations  >= 0)
        this.j.add_separator()
     }


    } // End For

  }

}

exports.jn02_object_search_inner = jn02_object_search_inner
