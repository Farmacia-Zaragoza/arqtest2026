//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
//-------------------------------------------------------------------------------------
// Used Entities :
//-------------------------------------------------------------------------------------
// Site     : Site Object
// Url      : Url Object
// Boolean  : Boolean Object
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
//- d-copyall-       : Copy any entities
//- d-copy_uri-       : Copy uri entity
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { printlog }     =   require(  path.join(JS_TYP7  , 'logs/printlog.es7'               )    );
        const { cbool } = require(  path.join(JS_TYP7  , 'bool/b01_bool.es7'               )    );
        const { site } = require(  path.join(JS_TYP7  , 'site/s01_site.es7'               )    );
        const { uri } = require(  path.join(JS_TYP7  , 'uri/u01_obj.es7'                 )    );
        const { index_req } = require(  path.join(JS_TYP7  , 'fire/index_req.es7'              )    );

class container extends printlog {
  constructor(b = "" )
  {
    super()

    this.n               = "container::"
    this.b               = new cbool()
    this.s               = new site(this.b)
    this.ir              = new index_req()
    this.u               = new uri(this.s , this.ir)

    // Anode type
    this.a               = ''

    // Pendiente
    this.j               = ''
  }

  copyall(arrobatype)
  {
  	this.copy(arrobatype)
  	this.copy_uri(arrobatype.u)
  }

  copy(arrobatype)
  {

     this.b.copy(                           arrobatype.b        )
     this.s.copy(                           arrobatype.s        )
     this.copy_arr(                         arrobatype.arr      )

     // Guardamos el Anode
  	 this.a        = arrobatype.a

  }

  // PENDIENTE - NO SE SI ES CORRECTO
  copyj(arrobatype)
  {

     this.copy(arrobatype)
     // Ojito que genera nuevos ficheros
     this.j             =   new jnode_type( arrobatype)

  }

  copy_uri(uritype)
  {
     this.u.copy(uritype)
     this.s             = uritype.s
  }

  copy_arr(arr)
  {
     var elem = ''
  	 for (var pos in arr)
     {
       elem = arr[pos]
  	   this.arr[pos] = elem
  	 }

  }

}

exports.container = container

