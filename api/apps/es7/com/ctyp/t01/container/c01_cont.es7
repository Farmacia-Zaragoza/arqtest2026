global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			);

const _mod_safe_1 = require(  path.join(global.JS_TYP7  , 'logs/printlog.es7'               ); const printlog = _mod_safe_1.printlog || _mod_safe_1;    );
        const _mod_safe_2 = require(  path.join(global.JS_TYP7  , 'bool/b01_bool.es7'               ); const cbool = _mod_safe_2.cbool || _mod_safe_2;    );
        const _mod_safe_3 = require(  path.join(global.JS_TYP7  , 'site/s01_site.es7'               ); const site = _mod_safe_3.site || _mod_safe_3;    );
        const _mod_safe_4 = require(  path.join(global.JS_TYP7  , 'uri/u01_obj.es7'                 ); const uri = _mod_safe_4.uri || _mod_safe_4;    );
        const _mod_safe_5 = require(  path.join(global.JS_TYP7  , 'fire/index_req.es7'              ); const index_req = _mod_safe_5.index_req || _mod_safe_5;    );

class container extends printlog {
  constructor(b = "" )
  {
    super()

    this.n               = "container::"
    this.b               = new cbool()
    this.s               = new site(this.b)
    this.ir              = new index_req()
    this.u               = new uri(this.s , this.ir)

    // Anode type
    this.a               = ''

    // Pendiente
    this.j               = ''
  }

  copyall(arrobatype)
  {
  	this.copy(arrobatype)
  	this.copy_uri(arrobatype.u)
  }

  copy(arrobatype)
  {

     this.b.copy(                           arrobatype.b        )
     this.s.copy(                           arrobatype.s        )
     this.copy_arr(                         arrobatype.arr      )

     // Guardamos el Anode
  	 this.a        = arrobatype.a

  }

  // PENDIENTE - NO SE SI ES CORRECTO
  copyj(arrobatype)
  {

     this.copy(arrobatype)
     // Ojito que genera nuevos ficheros
     this.j             =   new jnode_type( arrobatype)

  }

  copy_uri(uritype)
  {
     this.u.copy(uritype)
     this.s             = uritype.s
  }

  copy_arr(arr)
  {
     var elem = ''
  	 for (var pos in arr)
     {
       elem = arr[pos]
  	   this.arr[pos] = elem
  	 }

  }

}

exports.container = container


module.exports = container;
module.exports.container = container;
