// Class
//-------------------------------------------------------------------------------------
// - c-idx_pointers-  :   Class IDX pointers
//-------------------------------------------------------------------------------------
// Methods
//-------------------------------------------------------------------------------------
// - d-reload_idx_pointers-  :   Reload pointers to array structure

// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

class idx_pointers
{
  constructor(index = '' , preindex = '')
  {
     this.reload_idx_pointers(index ,preindex)
  }

  // Reload index pointeres
  // arr_nxn020_17@4
  reload_idx_pointers(index = '' , preindex = '')
  {
    this.jindex     =  preindex + 'j' + index    //  Index - Category Name
    this.cindex     =  preindex + 'c' + index    //  Childrens
    this.tindex     =  preindex + 't' + index    //   Type

    this.nindex     =  preindex + 'n' + index    //   Node Type ( sheet | branch )

    this.dindex     =  preindex + 'd' + index    //   Main Data

    this.iindex     =  preindex + 'i' + index    //   Information
    this.lindex     =  preindex + 'l' + index    //   Link

    this.pindex     =  preindex + 'p' + index    //   Photo
    this.hindex     =  preindex + 'h' + index    //   Photo Hover

    this.bindex     =  preindex + 'b' + index    //   BgColor
    this.sindex     =  preindex + 's' + index    //   Subject Id
    this.oindex     =  preindex + 'o' + index    //   Object Type

    this.rindex     =  preindex + 'r' + index    //   Relative Type Indicator ( relative | absolute )

    this.zindex     =  preindex + 'z' + index    //   Object Type

  }


}  // End Class

exports.idx_pointers = idx_pointers
