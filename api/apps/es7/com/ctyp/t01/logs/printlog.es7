// Methods
//-------------------------------------------------------------------------------------
// - d-l-                    :   Log print
// - d-p-                    :   Fast print
// - d-parr-                 :   Arrays print (used for debug)
//-------------------------------------------------------------------------------------
// - d-arroba_attribs_main_lang- : Set common attributes for main lang
// - d-arroba_attribs-           : Set common atributes for arroba object

// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

const path = require('path');

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { savelog }     =   require( path.join(JS_TYP7, 'logs/savelog.es7' ));


class printlog extends savelog
{

  constructor()
  {
  super()
  }

  l (msg)
  {
    // echo don't need EOL
    echo(msg)
  }

  gen_current_level(pos, parent_index , current_index , breadcrumb)
  {
    let next_level                  = this.get_next_level(pos)
    this.local_current_level        = parent_index     + 'v' + next_level
    this.local_current_enbreadcrumb = breadcrumb + '/' + accents.remove (current_index).toLowerCase()
  }


  // Get information for Main lang
  arroba_attribs_main_lang(idx , pos)
  {
    // Managed : J - C - D - I - B - T  --  P - H - N - S - O - R

    // Used in lang aliases
    this.item_en           =   this.gethash_keymain( idx.jindex , pos )

    this.value_en          =   this.gethash_keymain( idx.iindex , pos )

    this.breadcrumb_en     =   this.gethash_keymain( idx.bindex , pos )

    this.photo_en          =   this.gethash_keymain( idx.pindex , pos )
    this.hover_en          =   this.gethash_keymain( idx.hindex , pos )

    this.link_en           =   this.gethash_keymain( idx.lindex , pos )

    this.id_en             =   this.gethash_keymain( idx.sindex , pos )

  }

  //---------------------------------------------------------------------------------------------

  arroba_attribs_cats(idx)
  {
    // Managed : cats - last_element

    this.cats              =   this.gethash_arr(this.s.ms.main_lang, idx.jindex)
    this.keys              =   Object.keys(this.cats)
    // this.maps              =   new Map(Object.entries(this.cats))
    this.last_element      =   this.keys.length - 1


  }

  //---------------------------------------------------------------------------------------------

  arroba_attribs(idx , pos , index, subpath)
  {
    // Managed : J - C - D - I - B - T  --  P - H - N - S - O - R

    // INDEX ---> Se genera
    this.item              =   this.gethash_keymain( idx.jindex , pos )
    // this.cat               =   this.item

    this.level             =   this.get_next_level(pos)

    // Current Index and Subpath
    this.index             =   index  + 'v' + this.level
    this.subpath           =   subpath  + '/l' + this.level


    this.child             =   this.gethash_keymain( idx.cindex , pos )
    this.dhild             =   this.gethash_keymain( idx.dindex , pos )

    // ITEM == VALUE ---> HAY QUE SOLUCIONARLO

    this.value             =   this.gethash_keylang( idx.iindex , pos )

    this.breadcrumb        =   this.gethash_keylang( idx.bindex , pos )

    this.type              =   this.gethash_keymain( idx.tindex , pos )

    this.link              =   this.gethash_keylang( idx.lindex , pos )

    this.photo             =   this.gethash_keylang( idx.pindex , pos )

    this.hover             =   this.gethash_keylang( idx.hindex , pos )

    this.ntype             =   this.gethash_keymain( idx.nindex , pos )
    this.otype             =   this.gethash_keymain( idx.oindex , pos )

    this.id                =   this.gethash_keylang( idx.sindex , pos )

  }


  p (msg)
  {
  // let puting_contents  = this.n + this.m + ' - ' + msg  + os.EOL             ;
    let puting_contents  = this.n + this.m + ' - ' + msg

    // echo don't need EOL
    echo(puting_contents)
  }

  // Debug array - forEach javascript
  parr(a_passed)
  {
    // Extends printlog
     // super()
    // this.p('Entrando')

    // Check if is array
    if ( Array.isArray(a_passed) )
      for (var index in a_passed )
      {
        let elem = a_passed[index]
        //this.p(pos   + ' - ' + elem )
        this.p(index   + ' - ' + elem )
        // printlog.p(pos   + ' - ' + elem )
      }

  }

  // Php strpos function
  //---------------------------------------------------------------------------------------------
  strpos (haystack, needle, offset)
  {
      var i = (haystack+'').indexOf(needle, (offset || 0));
    return i === -1 ? false : i;
  }

}  // End Class

exports.printlog = printlog
