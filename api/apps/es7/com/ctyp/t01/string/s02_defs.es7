define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { printlog }         =   require(  path.join(JS_TYP7  , 'logs/printlog.es7'     )   )


class strings_defs extends printlog
{
  constructor()
  {
    super()
    this.n                   =  "strings_defs::"

    this.result              =  ''

    this.replace_source      =  ''
    this.replace_target      =  ''

    this.dot                 =  '.'
    this.dash                =  '_'
    this.slash               =  '/'
    this.space               =  ' '
    this.hyphen              =  '-'

    this.openkeys            =  '{'
    this.closekeys           =  '}'

    this.doublequote         =  '"'
    this.escaped_doublequote =  '\\"'

    this.triplebar           =  '\\\\\\"'
    this.zzz                 =  'ZZZ'

    this.simplebar           =  '\\"'



    this.escaped_openkeys    =  '\\{'
    this.escaped_closekeys   =  '\\}'



    this.windows_bar         =  '\\'
    this.escaped_bar         =  '&#92;'

  }


}

exports.strings_defs = strings_defs

