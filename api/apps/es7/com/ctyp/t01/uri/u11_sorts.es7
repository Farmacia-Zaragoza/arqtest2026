// Brqx Group - Agile Farmacia Zaragoza Methodology
// Spc - Cica_d05 - Home - Index_06 - v0_0_1 [COMMON-ES6]
//-------------------------------------------------------------------------------------
// Fast node load - Replace Mysql connections - Taxonomy Class
//-------------------------------------------------------------------------------------
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// - d-sort_url-               : Sort Url parameters checking options
// - d-sort_url_manage_kb-     : Manage kb for hierarchical structures
// - d-sort_url_manage_others- : Manage kb for common non ordered structures

// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			)))

const { uri_page_string } =   require(  path.join(JS_TYP7 , 'uri/u12_page_string.es7' ))),
      sort		          =   require(  path.join(JS_LIB  , 'sort/sort_unique.es6'	)));

class uri_sorts extends uri_page_string {

  constructor()
  {
    super()
    this.n               =   'uri_sorts::'
  }

  //---------------------------------------------------------------------------------------------

  sort_url_manage_kb()
  {
    // --------------- HIERARCHICAL ZONE ------------------

    var str_to_manage      = 'kb'
    var str_to_test      = this.s.ms.contents_path + 'l040'

    var str_to_manage_dash = 'kb'


    for (var pos in this.uri_args_sorted)
    {
      str_to_manage      += '/' + this.uri_args_sorted[pos]
      str_to_test      += '/a_' + this.uri_args_sorted[pos]
      str_to_manage_dash += '_' + this.uri_args_sorted[pos]
    }

    str_to_test +=  '/' + this.s.ms.lang + '_cat'

    // Si no existe la ruta deber cargar el front
    this.p('u08_sort ' + str_to_test )

    // Aqui comprobamos el idioma ingles
    // Pero la ruta puede ser para otro idioma como
    // kb/sistemas/servidoresweb

    var exist_english_path = true

    if (this.s.ms.lang == 'en')
      exist_english_path = fs.existsSync(str_to_test)


    if (!exist_english_path )
    {
        this.b.cache              =   false
        this.manage_front()
    }
    else
    {
      this.s.cs.slash_hierarchi   = str_to_manage
      this.s.cs.dash_hierarchi    = str_to_manage_dash

      // Se define aqui para KB HS
      // Ojo que aqui tiene el idioma !!!! ites/kb/systems/

      this.bar_slash_ideal_uri    = '/' + str_to_manage
    }
    // --------------- HIERARCHICAL ZONE ------------------
  }

  //---------------------------------------------------------------------------------------------

  sort_url_manage_others()
  {
    var str_to_manage      = ''

    this.uri_args_sorted      =  sort.sort_unique(this.uri_args_sorted)

    let count_no_repe        =  this.uri_args_sorted.length
    let new_dash_uri         =  ''
    let new_sash_uri         =  ''
    let new_bars_uri         =  ''


    let new_dash_args        =  ''
    let new_sash_args        =  ''


    let cont             =  0

    // this.p('u06-sort_lenen : ' + this.uri_args_sorted.length )

    // hhhhh
    // article/a01    --> [1]
    // es/article/a01 --> [2]
    // this.p('u06_sort_checking_format: ' + this.start_position_array )

    for (var pos in this.uri_args_sorted)
    {
      str_to_manage = this.uri_args_sorted[pos]

      /// this.p('u06_sort_managing ' + str_to_manage)

      new_dash_uri  +=   str_to_manage
      new_sash_uri  +=   str_to_manage
      new_bars_uri  +=   str_to_manage


      if ((pos   >=  0           )  &&
         (pos   <   count_no_repe )  )
      {
        new_dash_uri+=  '_'
        new_sash_uri+=  '/'
        new_bars_uri+=  '|'

      }

      if  (pos   >=  0 )
        {
          new_dash_args  +=   str_to_manage
          new_sash_args  +=   str_to_manage

        }

        if  ((pos   >=  2           )  &&
           (pos   <   count_no_repe )  )
        {
          new_dash_args+=  '_'
          new_sash_args+=  '/'
        }

        cont++

    }


    this.slash_sub_query         =   new_sash_uri
    this.dash_sub_query          =   new_dash_uri
    this.bars_sub_query          =   new_bars_uri.slice(0,-1)


    this.page_args               =  new_sash_args
    this.page_iargs              =  new_sash_args

    let slash_ideal_uri          =   this.slash_sub_query
    let dash_ideal_uri           =   this.dash_sub_query

    // this.p('u06_currdash: ' + this.page_iargs + ' ' + this.start_position_array )



    switch(this.start_position_array)
    {
      case 0:
        // No hay idiomas ni comandos
        // this.p('NO HAY IDIOMA NI COMANDO')
        break;
      case 1:
        // this.p('HAY IDIOMA O COMANDO ')
            slash_ideal_uri           =   this.page_command + '/' + this.slash_sub_query
            dash_ideal_uri             =   this.page_command + '_' + this.dash_sub_query

        break;
      case 2:
        // Hay idioma y comando
        // this.p('U06-iDIOMA Y comandO ' + this.count_lang_uri_arr )
          let con_idioma_slash    =   this.s.lang + '/' + this.page_command
          let con_idioma_dash      =   this.s.lang + '_' + this.page_command

          let sin_idioma        =  this.page_command
          slash_ideal_uri         =   sin_idioma + '/' + this.slash_sub_query
          dash_ideal_uri           =   sin_idioma + '_' + this.dash_sub_query
        break;
      default:
        this.p('u06_nuevo_caso ' + this.start_position_array)

    }


    this.slash_ideal_uri        =   slash_ideal_uri
    this.dash_ideal_uri         =   dash_ideal_uri

    // Esto no esta funcionando
    this.bar_slash_ideal_uri    =  "/" +  slash_ideal_uri

    // this.p('u05_idioma   : ' + this.s.lang )
    // this.p('u05_comando  : ' + this.page_command )
    // this.p('u06_sorts_ideal uri: ' + this.s.cs.slash_hierarchi )

  }

  //---------------------------------------------------------------------------------------------
  sort_url()
  {

    if (this.page_command == 'kb')
      this.sort_url_manage_kb()
    else
      this.sort_url_manage_others()

  }

}

exports.uri_sorts = uri_sorts
