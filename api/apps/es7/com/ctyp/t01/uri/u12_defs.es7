define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { arroba_getarr }     =   require(  path.join(JS_TYP7  , 'array/a02_arroba_getarr.es7'     )   );

class uri_defs extends arroba_getarr
{

  constructor()
  {
    super()
    this.n                    =   'uri_defs::'

  // Objects

    this.b                    =   ''              // Boolean object
    this.s                    =   ''              // Site object

    this.ir                   =   ''              // Index Request

    this.pg                   =  ''              // Page Generated


    // Multi domain - fast parallel load structure
    // En Javascript hay que declarar todos los que vayamos a usar
    this.arr['url']           =  Array()

    this.uri_arr              =  Array()
    this.uri_arr_lang         =  Array()
    this.uri_arr_lang_command =  Array()

    this.uri_args_sorted      =  Array()

    this.start_position_array =  0

    this.count_uri_arr        =  0
    this.count_lang_uri_arr   =  0


    this.domain               =  ''             // Domain with dots
    this.domainbar            =  ''             // Domain with dots

    this.dash_domain          =  ''             // Clean domain with slash
    this.http_domain          =  ''             // Clean domain with slash
    this.http_domainbar       =  ''             // Clean domain with slash

    this.port                 =   ''             // Server port

    this.server_protocol      =  ''             // For HTTPS - SSL will be HTTP/2

    this.ssl_page             =  'nnn'           // By default is not ssl

  // M E T H O D  T O   L O A D

  // Pagination - Search
    this.beg_pg               =  ''             // Beggining pagination
    this.end_pg               =  ''             // End pagination - Page size

    this.zero_pg              =  0             // Asumimos 0 como inicio de las busquedas
    this.full_pg              =  100000           // Asumimos 100000 como numero maximo de resultados en una busqueda


  // esta propiedad creo que no es de la url
    this.user_type           =  'anonymous'


    this.sep                  =  '@'

    this.page_type            =  'public'         // Paginas pueden ser publicas o privadas
    this.lang_site            =  ''         // Paginas pueden ser publicas o privadas

  // Intelligent URI

    this.page_command         =  'n'             // command for page (No command by default)

    // this.p('u10_Defining Page Command ' +  this.page_command )

    this.page_args            =  ''             // passed args
    this.page_iargs           =  ''             // sorted intelligent args

    this.old_page_command     =  'n'             // command for page (No command by default)

    this.page_name            =  'blanc'           // command for page args

  // Cadena UNICA que refleja la pagina a cargar. Debe ser unica por lo que puede ser un indice de mongo db
    this.page_string          =  ''

    this.url_parameter_type   =  'simple'

    this.url_method           =  ''
    this.search_method        =  ''

  // Uri Aliases management

    this.slash_ideal_uri      =  ''
  //  this.slash_alias_uri      =  ''


  // Public Start time

    this.start_time           =  ''               // start page loading
    this.stop_time            =  ''               // end page loading

    this.total_time           =  ''               // total time page loading

  }

  copy(u)
  {

    // Objects

    this.s                    =  u.s
    this.ir                   =  u.ir
    this.pg                   =  u.pg
    this.b                    =  u.b


    this.start_position_array =  u.start_position_array

    this.count_uri_arr        =  u.count_uri_arr
    this.count_lang_uri_arr   =  u.count_lang_uri_arr


    this.domain               =  u.domain
    this.domainbar            =  u.domainbar

    this.dash_domain          =  u.dash_domain
    this.http_domain          =  u.http_domain

    this.port                 =  u.port

    this.server_protocol      =  u.server_protocol

    this.ssl_page             =  u.ssl_page

  // M E T H O D  T O   L O A D

  // Pagination - Search
    this.beg_pg               =  u.beg_pg
    this.end_pg               =  u.end_pg

    this.zero_pg              =  u.zero_pg
    this.full_pg              =  u.full_pg


    this.user_type           =  u.user_type

    this.page_type            =  u.page_type
    this.lang_site            =  u.lang_site

  // Intelligent URI

    this.page_command         =  u.page_command
    this.page_args            =  u.page_args
    this.page_iargs           =  u.page_iargs

    this.old_page_command     =  u.old_page_command

    this.page_string          =  u.page_string

    this.url_parameter_type   =  u.url_parameter_type

    this.url_method           =  u.url_method
    this.search_method        =  u.search_method

    // strings

    this.uri                  =  u.uri
    this.robot_uri            =  u.robot_uri

    this.dash_uri             =  u.dash_uri

    this.old_uri              =  u.old_uri
    this.old_dash_uri         =  u.old_dash_uri

    this.dash_url             =  u.dash_url

    this.slash_ideal_uri      =  u.slash_ideal_uri
    this.dash_ideal_uri       =  u.dash_ideal_uri

    this.slash_sub_query      =  u.slash_sub_query
    this.dash_sub_query       =  u.dash_sub_query

    // Usada para patrones multiples donde se busca cualquiera de ellos
    this.bars_sub_query       =  u.bars_sub_query

    this.bar_slash_ideal_uri  =  u.bar_slash_ideal_uri

    this.lang                 =  u.lang
    this.lang_uri             =  u.lang_uri

    // Arguments

    this.uri_args_sorted      =  u.uri_args_sorted

  }

}

exports.uri_defs = uri_defs

