define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { uri_cache }    =   require(  path.join(JS_TYP7 , 'uri/u03_cache.es7'           )   );

class uri_ports extends uri_cache {

  constructor()
  {
    super()
    this.n               =   'uri_ports::'
  }

  manage_ports()
  {

    this.domain          = this.ir.domain
    this.uri             = this.ir.uri

    this.robot_uri       = this.ir.robot_uri

    this.port            = this.ir.port
    this.server_protocol = this.ir.protocol

    // Replace dot by dash
    this.rdot(this.domain)

    this.dash_domain     = this.result

    // req.secure
    // this.p('PAGE_IS_SSL_LALAL ' + this.ir.protocol)


    var isSecure = false

    if ( this.server_protocol == "https" ) isSecure = true


    if (isSecure)
    {
      // this.p('PAGE_IS_SSL_LALAL_SSL')
      this.s.ms.ssl_page     = "ssl"
      this.http_domain   = "https://" + this.domain
    }
    else
    {
      this.s.ms.ssl_page     = "nnn"
      this.http_domain   = "http://"  + this.domain
    }

    // To change for siteurl
    this.s.cs.http_domainbar   = this.http_domain + '/'

    // this.p('u02_ports defining_Domain ' + this.s.cs.http_domainbar )

    if (  this.port == 80 || this.s.ms.ssl_page == "nnn")
    {
        this.dash_port = "_" + "http" + "_"
    }
    else if (this.port == 443 || this.s.ms.ssl_page == "ssl")
    {
        this.dash_port = "_" + "https" + "_"
    }
    else
        this.dash_port = "_" + this.port + "_"

  }

}

exports.uri_ports = uri_ports

