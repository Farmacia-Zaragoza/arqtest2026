//-------------------------------------------------------------------------------------
// - d-sort_url_manage_kb-     : Manage kb for hierarchical structures
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const { uri_page_string } =   require(  path.join(JS_TYP7 , 'uri/u11_page_string.es7' ) );


class uri_sorts_kb extends uri_page_string {

  constructor()
  {
    super()
    this.n               =   'uri_sorts_kb::'
  }

  //---------------------------------------------------------------------------------------------

  sort_url_manage_kb()
  {
    // --------------- HIERARCHICAL ZONE ------------------

    var str_to_manage      = 'kb'
    var str_to_test      = this.s.ms.contents_path + 'l040'

    var str_to_manage_dash = 'kb'


    for (var pos in this.uri_args_sorted)
    {
      str_to_manage      += '/'   + this.uri_args_sorted[pos]
      str_to_test        += '/a_' + this.uri_args_sorted[pos]
      str_to_manage_dash += '_'   + this.uri_args_sorted[pos]
    }

    str_to_test +=  '/' + this.s.ms.lang + '_cat'

    // Si no existe la ruta deber cargar el front
    // this.p('u08_sort ' + str_to_test )

    // Aqui comprobamos el idioma ingles
    // Pero la ruta puede ser para otro idioma como
    // kb/sistemas/servidoresweb

    var exist_english_path = true

    if (this.s.ms.lang == 'en')
      exist_english_path = fs.existsSync(str_to_test)


    if (!exist_english_path )
    {
        this.b.cache              =   false
        this.manage_front()
    }
    else
    {
      this.s.cs.slash_hierarchi   = str_to_manage
      this.s.cs.dash_hierarchi    = str_to_manage_dash

      // Se define aqui para KB HS
      // Ojo que aqui tiene el idioma !!!! ites/kb/systems/

      this.bar_slash_ideal_uri    = '/' + str_to_manage
    }
    // --------------- HIERARCHICAL ZONE ------------------
  }


  //---------------------------------------------------------------------------------------------

  sort_url_manage_fs()
  {
    // --------------- FILE SYSTEM ZONE ------------------

    // No ponemos fs hasta que lo podamos comprobar
    var str_to_manage      = ''
    var str_to_manage_dash = ''
    var elem               = ''

    var iterations           = Object.keys(this.uri_args_sorted).length - 1

    for (var pos in this.uri_args_sorted)
    {
      elem = this.uri_args_sorted[pos]
      str_to_manage      +=  this.uri_args_sorted[pos]
      str_to_manage_dash +=  this.uri_args_sorted[pos]

      if (--iterations  >= 0 )
      {
        str_to_manage      +=   '/'
        str_to_manage_dash +=   '_'

      }

    }

    // fs/o14_waterfalls
    // en/fs/o14_waterfalls/0160x0200
    this.p('u10_sorts_fs URI ' + str_to_manage)

    var exist_english_path = true

    var str_to_test = this.s.ms.fs_path + '/' + str_to_manage

    // this.p('u10_sorts_fs URITest ' + str_to_test)


    if (this.s.ms.lang == 'en')
      exist_english_path = fs.existsSync(str_to_test)

    // Desctivamos la comprobacion exacta de ruta
    if (!exist_english_path && ("B" == "A") )
    {
        this.b.cache              =   false
        this.manage_front()
    }
    else
    {

      if ( str_to_manage != "")
      {
        str_to_manage      = 'fs' + '/' + str_to_manage
        str_to_manage_dash = 'fs' + '_' + str_to_manage_dash
      }
      else
      {
        str_to_manage      = 'fs'
        str_to_manage_dash = 'fs'
      }

      this.s.cs.slash_hierarchi   = str_to_manage
      this.s.cs.dash_hierarchi    = str_to_manage_dash

      // this.p('u10_sorts_fs sla ' + this.s.cs.slash_hierarchi)
      // this.p('u10_sorts_fs das ' + this.s.cs.dash_hierarchi)


      // Se define aqui para KB HS
      // Ojo que aqui tiene el idioma !!!! ites/kb/systems/

      this.bar_slash_ideal_uri    = '/' + str_to_manage
    }
    // --------------- FILE SYSTEM ZONE ------------------
  }

}

exports.uri_sorts_kb = uri_sorts_kb

