// Fast node load - Replace Mysql connections - Taxonomy Class
//-------------------------------------------------------------------------------------
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// - d-url_page_load_drupal_node-     : Load product page
// - d-url_page_set_product-          : Set urls to be managed as a product
// - d-url_page_set_photo-            : Set urls to be managed as a photo
// - d-manage_general_commands-       : Call to manage commands
// - d-process_commands-              : Call to process commands
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			);

const _mod_safe_1 = require(  path.join(global.JS_TYP7 , 'uri/u07_sorts.es7'   ); const uri_sorts = _mod_safe_1.uri_sorts || _mod_safe_1);
class uri_commands extends uri_sorts {

  constructor()
  {
    super()
    this.n               =   'uri_commands::'
  }

  // architect/ricardocabellotorres  -> article XX
  //---------------------------------------------------------------------------------------------
  // Local Method - This method depends of site
  url_page_load_drupal_node(page_number)
  {
    // this.p('u04_aliases_Comando para analizar: ' + this.uri)

    this.b.page_product       =   true
    this.s.cs.page_type	      =  'content'
    this.s.cs.page_name       =  'product'
    this.s.cs.loadtype        =  'page'
    this.s.cs.teaser_type	  =  'full'
    this.s.cs.position        =  '20'
    this.s.cs.page            =  page_number

  }

  //---------------------------------------------------------------------------------------------
  // Ojo que pone position a 9
  url_page_set_product(pos = 20)
  {
    this.b.page_product       =   true
    this.s.cs.page_type	      =  'content'
    this.s.cs.page_name       =  'product'
    this.s.cs.loadtype        =  'page'
    this.s.cs.teaser_type	  =  'full'
    this.s.cs.position        =  pos
  }

  //---------------------------------------------------------------------------------------------

  url_page_set_photo(pos = '30')
  {
    this.b.page_product       =   true
    this.s.cs.page_type	      =  'content'
    this.s.cs.page_name       =  'photo'
    this.s.cs.loadtype        =  'page'
    this.s.cs.teaser_type	  =  'full'
    this.s.cs.position        =  pos
  }

  //---------------------------------------------------------------------------------------------

  url_page_set_list(pos = '20')
  {
    this.b.page_list          =   true
    this.s.cs.page_type	      =  'content'
    this.s.cs.page_name       =  'list'
    this.s.cs.loadtype        =  'position'
    this.s.cs.teaser_type	  =  'slim'   // Tipo de presentacion por defecto
    this.s.cs.position        =  pos
  }

  //---------------------------------------------------------------------------------------------

  //---------------------------------------------------------------------------------------------

  // Se llamara desde manage_commands
  manage_general_commands()
  {
    this.m                    =   'manage_general_commands'

     // articulo
    this.p('u05_Comando para analizar: ' + this.page_command)

    switch(this.page_command)
    {
      case "jsons":
        // Nunca hay cache si se ejecuta la pagina de jsons
        // Switch para las paginas del chequeo de los jsons
        this.b.only_json_page     =   true
        this.b.cache              =   false
        this.manage_front()

        break;;

      case "product":
        this.url_page_set_product()
        break;;

      case "list":
        this.url_page_set_list()
        break;;

      case "gal":
        this.s.cs.page_type	      =  'content'

        this.b.page_gallery       =   true
        this.s.cs.page_name       =  'gallery'
        this.s.cs.loadtype        =  'position'
        this.s.cs.teaser_type	  =  'slim'   // Tipo de presentacion por defecto
        break;;

      case "slide":
        this.s.cs.page_type	      =  'content'

        this.b.page_slide         =   true
        this.s.cs.page_name       =  'slide'
        this.s.cs.loadtype        =  'position'
        this.s.cs.teaser_type	  =  'slim'   // Tipo de presentacion por defecto
        break;;

      case "cookies":
        this.url_page_load_drupal_node(24)
        break;;

      case "policy":
        // this.p('u05_LOADING_POLICY')
        this.url_page_load_drupal_node(24)
        break;;

      case "blanc":
        // con un idioma llega blanc /it
        // this.manage_front()
        this.s.cs.page_name       =  'front'
        this.s.cs.loadtype        =  'page'
        this.s.cs.position        =  '20'
        this.s.cs.page            =  '0'
        break;;

      default:
        // Text
        // this.p('Caso_por_Defecto - Hay que cargar el front')
		// Podra ser pagina de busqueda por defecto
        // Activamos el caso de que sea un alias
        this.p('u06_Puede_ser_Un_Alias')
        this.b.page_could_be_alias = true
        this.s.cs.page_name       =  'product'
        this.s.cs.page_type       =  'content'

        // this.s.cs.page_command    =  this.uri
        this.s.cs.dash_sub_query  =  this.dash_uri
        // this.manage_front()

    }

    this.process_commands()

  }

  //---------------------------------------------------------------------------------------------
  process_commands()
  {
    this.m                    =    'process_commands'

    // Ahora hay que gestionar la url para comandos inteligents

    // que pasa si es esta uri : intelligent_scroll
    if ( this.b.intelligent_command        &&
        (this.page_command.substr(0,1) == 'i' )  )
    {
      this.b.page_intelligent     =   true
      this.page_command           =  this.page_command.substr(1)
    }

    // Por defecto es el mismo y luego vemos casos
    this.uri_args_sorted        =  this.uri_arr

    // this.p('u05_possarray: ' +  ' ' + this.start_position_array )

    // Comando + Idioma --> 1

    // Igual hay que restar o sumar el numero de argumentos - la posicion inicical

    let contador_posiciones = this.count_lang_uri_arr - this.start_position_array

    switch(this.start_position_array)
    {
      case 0:
        // No hay idiomas ni comandos
        // this.p('NO HAY IDIOMA NI COMANDO')
        break;;
      case 1:
        // Hay idioma o comando - Hay que ver los elementos que tiene el array
        // this.p('HAY IDIOMA O COMANDO ')
        // Que pasa si es un solo comando : list el array estara vacio
          this.uri_args_sorted  =  this.uri_arr_lang

        break;;
      case 2:
        // Hay idioma y comando
        // this.p('HAY IDIOMA Y COMANDO ' +  contador_posiciones)
          this.uri_args_sorted  =  this.uri_arr_lang_command
        break;;

    }

    this.sort_url()

  }

}

exports.uri_commands = uri_commands


module.exports = uri_commands;
module.exports.uri_commands = uri_commands;
