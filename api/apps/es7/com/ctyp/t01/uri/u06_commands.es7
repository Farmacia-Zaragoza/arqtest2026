const path = require('path');

// [DOCHANGED_NODE_ES6_SPACES]
// Updated_Langs:NodeJs+,Ruby,Php
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
