define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { uri_paths }     =   require(  path.join(JS_BASE , 'com/objects/drupal/uri/u08_paths.es6'  )  );
        const match = require(  path.join(JS_BASE  , 'com/libs/string/match.es6'         ) );
        const starr = require(  path.join(JS_BASE  , 'com/libs/string/string_array.es6'  ) );

class uri_fast extends uri_paths {
  constructor(s , ir)
  {
  super()
  this.n                =  "uri::"

  this.s                =  s
  this.ir               =  ir    // Index request
  //this.sch              =  sch    // Scheme

  //this.pg               =  this.s.pg

  this.b                =  this.s.b
  this.c                =  this.s.c
  this.site_path        =  path.resolve(".")

  // this.manage_ports()
  this.port				=  80
  this.server_protocol  =  'http'

  this.domain     = this.ir.domain

    // Global replace works

  this.replace(this.domain , '.' , "_" )

  this.dash_domain   = this.result

  this.ssl_page     = "nnn"
  this.http_domain   = "http://" + this.domain
  this.http_domainbar   = this.http_domain + '/'
  this.dash_port = "_" + "http" + "_"

  // this.manage_front()
  this.dash_uri        =  'front'                           // Main home
    // This could to change with language
  this.uri          =   'front'

  this.compouri        =  ''

  this.slash_ideal_uri      =   this.uri
  this.dash_ideal_uri        =   this.uri

  this.page_command        =  'blanc'
  this.page_name          =  'blanc'

  // Create Paths for human or for robot
  this.create_paths("page", 'human')
  }

}

exports.uri_fast = uri_fast
