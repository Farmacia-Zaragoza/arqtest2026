  //---------------------------------------------------------------------------------------------
  load(req = '')
  {
    this.method    =  req.method    // GET
    this.url    =  req.url      // uri

    // dont contain protocol nor domain /
    this.uri    =  req.url      // uri

    this.method   =  req.method

    // Here is the uri - not th url
    // Esta llegando esto Url_Passed: /bn/%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE

    this.url_encoded = this.uri
    this.uri_decoded = decodeURIComponent(this.uri)

    if ( this.url_encoded != this.url_decoded)
      this.uri = this.uri_decoded

    this.p('ir_Url_Passed: ' + this.uri)
    // this.p('ir_Url_PassedDecoded : ' + decodeURIComponent(this.uri))



    // Only works if we pass https
    // this.p('Protocol Passed ' + req.protocol )
    // this.p('Protocol Headers ' + req.headers['x-forwarded-proto'] )

    if (req.secure)   this.protocol = 'https'   // http | https
    // subdomain or domain
    this.domain    =  req.hostname
    this.server_ip  =  req.socket.remoteAddress

    // Falta recargar el site

  }

