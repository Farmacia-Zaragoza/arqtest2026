const _mod_safe_6 = require(  path.join(global.JS_TYP7  , 'fire/index_req.es7'            ); const index_req = _mod_safe_6.index_req || _mod_safe_6);
class index_fast extends index
{

  constructor(  pmt = '' )
  {
  // Atributos
    super()
    this.n           =   'index_fast::'

    this.pmt           =   pmt         // Parameters

    // this.p('Ifast_Cache ' + this.pmt.cache + ' ' + true )

    this.req           =  this.pmt.req
  // Usaremos ir - index request
    this.ir            =  new index_req()

    if (!empty(this.req))
    {
      this.p('LOAD_ES7 ')
      this.load()
    }
    else
    {
      this.simul()
      this.p('SIMUL_ES7 ' + this.pmt.env + ' ' +  this.pmt.live_opt + ' [' +  this.pmt.nocode + ' ]' )
    }

    // Log Debug
    global.start_time     =   this.starttimer

    this.puting_contents   =   "index:start:" + this.starttimer + ">"

    this.d           =   new printlog()

    this.d.d_start(this.puting_contents)

    // Could to pass reload strings

    this.b           =   new cbool()
    this.b.load(this.pmt)

    this.s           =   new site(this.b )

    // this.p('Ifast2_Cache ' + this.b.cache + ' ' + true )

  }

}  // End Class

exports.index_fast = index_fast


