//-------------------------------------------------------------------------------------
// Used Entities :
//-------------------------------------------------------------------------------------
// e-index_req-    : Class to manage real and invented requests
// e-printlog-     : Class to manage log messages
// e-cbool-        : Boolean class
// e-site-         : Site Class
//-------------------------------------------------------------------------------------
// Class :
//-------------------------------------------------------------------------------------
// c-index_fast-
// ==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

const { JS_TYP7  } = require(path.join(process.cwd(),'api/apps/paths.js'));

const   { index }      =   require(  cons.JS_TYP7  + 'fire/index.es7'                 ),
        { printlog }     =   require(  cons.JS_TYP7  + 'logs/printlog.es7'             ),
        { cbool }          =   require(  cons.JS_TYP7  + 'bool/b01_bool.es7'           ),
        { site }           =   require(  cons.JS_TYP7  + 'site/s01_site.es7'           ),
        { uri }            =   require(  cons.JS_TYP7  + 'uri/u01_obj.es7'             ),
        { index_req }      =   require(  cons.JS_TYP7  + 'fire/index_req.es7'                 ),
        empty              =   require(  'is-empty'   );


class index_fast extends index
{

  constructor(  pmt = '' )
  {
  // Atributos
    super()
    this.n           =   'index_fast::'


    this.pmt           =   pmt         // Parameters

    // this.p('Ifast_Cache ' + this.pmt.cache + ' ' + true )

    this.req           =  this.pmt.req
  // Usaremos ir - index request
    this.ir            =  new index_req()

    if (!empty(this.req))
    {
      this.p('LOAD_ES7 ')
      this.load()
    }
    else
    {
      this.simul()
      this.p('SIMUL_ES7 ' + this.pmt.env + ' ' +  this.pmt.live_opt + ' [' +  this.pmt.nocode + ' ]' )
    }


    // Log Debug
    global.start_time     =   this.starttimer

    this.puting_contents   =   "index:start:" + this.starttimer + ">"

    this.d           =   new printlog()

    this.d.d_start(this.puting_contents)

    // Could to pass reload strings

    this.b           =   new cbool()
    this.b.load(this.pmt)

    this.s           =   new site(this.b )

    // this.p('Ifast2_Cache ' + this.b.cache + ' ' + true )

  }

}  // End Class

exports.index_fast = index_fast
