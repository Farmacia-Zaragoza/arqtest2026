define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const { html_style } 	= 	require(	path.join(JS_TYP7 , 'html/style/html_style.es7'			)  );
      const { json_copy } = require(  path.join(JS_TYP7 , 'json/jtype/json_copy.es7'                 )    );

class robot  extends json_copy {
  constructor()
  {
    super()
    this.n         = "robot::"

    this.l         = new html_style('a')

  }

  manage_rbt_anchors()
  {
    this.result = this.value

    var regex_pos  = this.strpos(this.value, "$:")

    if (regex_pos !== false )
    {
      // REGEX MANAGEMENT - SOLO SE ANALIZAN LAS EXPRESIONES REGULARES

      // this.p('s04_mng AA ' + this.result)

      let first_corch       =   this.result.indexOf('[')
      let left_str          =   this.result.substr(0,first_corch)

      let curr_str          =   this.result.substr(first_corch + 1 , this.result.length)

      let last_corch        =   curr_str.lastIndexOf(']')
      let right_str         =   curr_str.substr(0,last_corch )

      // this.p('s04_mng BB ' + right_str)

      var dual_anchor_pos = this.strpos(right_str, "##")

      var page_anchor_pos = this.strpos(right_str, "#-#")

      var anchor_pos = this.strpos(right_str, "#")
      var arroba_pos = this.strpos(right_str, "@")

      var include_pos = this.strpos(left_str, "FF")

      if ( arroba_pos !== false)
      {
        // TIENE ARROBA - SOLO PODEMOS MANEJAR ANCHOR EN LA DERECHA
        let uri_arr_pre          =   right_str.split('@')
        right_str                =   uri_arr_pre[1]

      }

      if ( anchor_pos !== false)
      {
        // Tiene solo Anchor - NO TIENE ARROBA
        // $:S[Common Features#common_features]: MRIF - RDM - LDA
        //#anchor content_management@Architecture Frontend Link - Content Management

        var pf_anchor = ''

         // Tenemos un anchor
        let uri_arr_pre          =   right_str.split('#')

        let count_positions      =  uri_arr_pre.length -1

        if ( count_positions == 1)
        {
          let str = uri_arr_pre[1]
          pf_anchor = str.substr(0, str.length)

          this.value = uri_arr_pre[0]
          // this.p('HAY COMANDO_CACHE')

          // Comprobamos que es un anchor permitido
          // Lo lo insertamos
          this.p('s04_sgt_anchor ' + pf_anchor)

        }

        // Es una taxonomia
        if ( dual_anchor_pos !== false)
        {
          let str = uri_arr_pre[2]
          pf_anchor = str.substr(0, str.length)

          this.p ('s07_value_metatag_ '  + str)

          this.value = uri_arr_pre[0]

          this.p ('s07_value_metatag_ '  + pf_anchor)

          this.p ('s07_value_metatag_ '  + this.value)

	    }

        if ( page_anchor_pos !== false )
        {
          let str = uri_arr_pre[2]
          pf_anchor = str.substr(0, str.length)

          this.p ('s07_value_sep_ '  + str)

          // Only page separators
          this.value = uri_arr_pre[0]

          this.p ('s07_value_sep_anchor '  + pf_anchor)

          this.p ('s07_value_sep value  '  + this.value)

	    }

        this.l.href            = this.domain_site + this.uri_site + '#' + pf_anchor

        this.l.content         = this.site_title + '-' + this.value
        this.l.title           = this.hover

        this.type = 'link'

	   }

      }

  }

  create(name = "")
  {
    this.code = ""
    // this.p('Creando el link' + this.type + ' ' + this.link)

    // Si es una imagen hay que ajustarla

    if (this.type == 'link'  )
    {
       this.l.pcreate()
       this.code = this.l.code
    }
  }

  add_element(name , pair_code = '')   {  }

  add_lastelement(name , pair_code = '' )  {  }

  clean()
  {
    this.code       = ""
    this.content     = ""
  }

}

exports.robot = robot
