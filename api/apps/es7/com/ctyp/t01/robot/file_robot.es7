define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const 	{ blkrobot } 		= 	require(	path.join(JS_TYP7   , 'robot/blkrobot.es7'));
		sctf 				= 	require( 	path.join(JS_LIB7 	, 'file/save_code_to_file.es7'  ));


class file_robot extends blkrobot {
	constructor(  file_name        = ''   ,
                  site_title       = ''   ,
	              domain_site      = ''   ,
	              langdomain_site  = ''   ,
	              uri_site         = ''   ,
	              resolutions_line = ''   )
	{
		super(file_name)

        this.m                =   'cons'
        this.n                =   'file_robot::'

		this.site_title       =   site_title
		this.uri_site         =   uri_site
		this.domain_site      =   domain_site
		this.langdomain_site  =   langdomain_site
		this.resolutions_line =   resolutions_line

        // blkrobot:: - fr01_pass_Tit ArqSeo Versioni: ArqSeo - Garldru
        // blkrobot:: - fr01_pass_Uri it/article/a29
        // blkrobot:: - fr01_pass_Lan https://dog.vbrqx.com/it/
        // blkrobot:: - fr01_pass_Dom https://dog.vbrqx.com/

        // this.p('fr01_pass_Tit ' + this.site_title)
        // this.p('fr01_pass_Uri ' + this.uri_site)
        // this.p('fr01_pass_Lan ' + this.langdomain_site)
        // this.p('fr01_pass_Dom ' + this.domain_site)
	}

    manage_resolutions_for_image()
    {
       var res_arr = this.resolutions_line.split(' ')

       for (pos in res_arr)
       {
		  // Hay que reemplazar RESOLUTION por cada resolucion
		  this.s.replace(this.photo, 'RESOLUTION' , res_arr[pos])
		  // this.p('file_robot_IMG' + this.s.result )
          this.l.href              = this.domain_site + this.s.result

          this.s.ruri(this.s.result)
          this.l.content         = this.s.result
		  this.create()
		  sctf.update_file_with_code(this.full_path, this.code)
	   }

    }

	createspecifictype()
	{
        this.resolution = ''

		this.managespecifictype(false)

        if (this.resolution == "RESOLUTION")
        {
          // this.p('file_robot_RESOLUTIONS A')
          this.manage_resolutions_for_image()
        }
		else
		{
		  this.create()
          // sctf.update_file_with_code_no_break_line(this.full_path, this.code)
          sctf.update_file_with_code(this.full_path, this.code)
		}
	}

	createspecificpart(object_type = "object" )
	{

        this.resolution = ''

		this.managespecifictype(true)

        if (this.resolution == "RESOLUTION")
          this.p('file_robot_RESOLUTIONS B')


		this.add_childrens(	this.child				)

		this.clean()
	}


	createcommonpart(object_type)
	{
        this.resolution = ''

		this.managecommontype(true)

        if (this.resolution == "RESOLUTION" )
          this.p('file_robot_RESOLUTIONS C')


		this.add_childrens(	this.child				)

		this.clean()
	}

	createcommontype()
	{
        this.resolution = ''

		// Works fine
		this.managecommontype(false)

        if (this.resolution == "RESOLUTION")
          this.p('file_robot_RESOLUTIONS D')

		this.create()

		sctf.create_update_full_filename(this.full_path, this.code)
		//sctf.create_update_full_filename_no_break_line(this.full_path, this.code)

		this.clean()
	}

	managespecifictype(part = false)
	{

	   switch(this.type){

			case "search":
                // Generar el link con los parametros
				this.add_index(					this.index		)
				this.add_type(					this.type		)
				this.add_element( 		'name' , this.hover	)
				// this.add_element( 		'hover' , this.hover	)
				if (part)
					this.add_element( 	'clink'	, this.link		)
				else
					this.add_lastelement( 	'clink'	, this.link		)

				break;
			default:
				this.managecommontype(part)
		}
	}



	managethemeelem(part) 	{	}
	managebranchelem(part)	{	}

}

exports.file_robot = file_robot
