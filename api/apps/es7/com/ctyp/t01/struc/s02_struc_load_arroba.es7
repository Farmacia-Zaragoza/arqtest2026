const path = require('path');
global.JS_LIB7 = path.join(global.ROOT, 'api/apps/es7/com/blib/');

// [DOCHANGED_ES7_SPACES]
// Updated_Langs:NodeJs+,Ruby,Php
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Agile Node Js - Struc Class  [V.0.1.0]  (2020-02-06)
// Brqx Group - Agile Farmacia Zaragoza Methodology
// Spc - Cica_d05 - Home - Index_06 - v0_0_1 [ES7]
//-------------------------------------------------------------------------------------
// Fast node load - Replace Mysql connections - Taxonomy Class
//-------------------------------------------------------------------------------------
// Cada tipo de archivo debe heredar struc para ser capaz de manejar ficheros de propiedades
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Process:
//-------------------------------------------------------------------------------------
// @content_file --> contents[] --> arr[]
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Class:
//-------------------------------------------------------------------------------------
// c-struc-                          : Main Struc Class
//-------------------------------------------------------------------------------------
// Methods:
//-------------------------------------------------------------------------------------
//- d-set_file-                      : Set file parameter
//- d-load_file_information-         : Load from file && save in contents array
//- d-generate_array_from_file-      : Generate arr from arroba file
//- d-generate_array_from_text_file- : Generate array from text file
//- d-mix_array_from_file-           : Generate array mixing
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
//-------------------------------------------------------------------------------------
// Inheritance Line :
//-------------------------------------------------------------------------------------
// Struc > Struc_gen > Struc_attrib > scomm_defs
// @Struc > @String > @Cache > @log
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			);

const { struc_load_folder }        =   require(  path.join(global.JS_TYP7  , 'struc/s03_struc_load_folder.es7' ));
		const ffi = require(	path.join(global.JS_LIB7 , 'file/file_load.es7') 	);

class struc_load_arroba extends struc_load_folder {
  constructor()
  {
    super()
    this.n                        = "struc_load_arroba::"
  }

  //---------------------------------------------------------------------------------------------
  set_file(file = '')   {   	this.file = file   }

  // Load contents with information of file
  //---------------------------------------------------------------------------------------------
  load_file_information(file = '')
  {
	// File to load struct
	//
    this.m         = 'load_file_information'

    if (file != "")
  		this.file = file

  	if ( fs.existsSync(	this.file ) )
  	{
	  // this.p('s01_struc_File ExisT ' + this.file)
      // Valta vaciar el array

      // Tenemos estructura de arroba lista

      this.b.exist_arroba_structure = true

      this.contents = []

	    var ff_arr = ''

      // this.p ('s01_struc FILARR ' + this.file)

	    ff_arr = new ffi.properties_from_file(this.file)

      let contents = ff_arr.arr
      let value    = ''

      // No puede tener lineas en blanco pues sino no sabemos cuando finalizar los bucles
      for (var pos in contents)
      {
      	 value = contents[pos]

         // this.p ('s01_struc_load_arroba ARR ' + value)

         if (!empty(value) )
  	        this.contents.push(value)
	    }
	  }
	  else
	  {
        // Enable Redirect
		  this.p('s01_struc_File_dont_exist IDX ' + this.file)
		  this.b.rest_result = false
      this.b.exist_arroba_structure = false
    }
  }

}

exports.struc_load_arroba = struc_load_arroba

