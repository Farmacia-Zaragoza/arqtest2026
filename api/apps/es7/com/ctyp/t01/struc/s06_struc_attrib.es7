// Inheritance Line :
//-------------------------------------------------------------------------------------
// Struc_attrib > scomm_defs
// @Struc > @Array > @String > @Cache > @log
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			);


const   { struc_defs }    =   require(  path.join(global.JS_TYP7  , 'struc/s07_struc_defs.es7'  )  )


class struc_attrib extends struc_defs {
  constructor()
  {
    super()
    this.n                        = "struc_attrib::"
  }


  //---------------------------------------------------------------------------------------------
  // Generate array with contents information
  // Basado en this.contents
  attribs(idx , pos , index = '' , depth = '')
  {
    // Managed : C - T - B - P - G - H - I - S - O - R
    // ME voy a cargar this.j.cat y this.j.item

    //  item                 index
    // "general": {"index": "v000","otype": "object","type": "branch","childrens": true,"pull02": {

    this.j.clean()

    // this.p('s05_sa ' + idx.jindex)

    this.j.item              =   this.getkeylang( idx.jindex , pos )

    // El index no se obtiene de la estructura. Se genera
    this.j.parent_index      =   index

    // Indice de los hijos - No se obtiene - se pasa
    this.j.index             =   index  + 'v' + this.get_next_level(pos)

    this.j.child             =   this.getkeymain( idx.cindex , pos )
    this.j.type              =   this.getkeymain( idx.tindex , pos )
    this.j.breadcrumb        =   this.getkeylang( idx.bindex , pos )
    this.j.photo             =   this.getkeymain( idx.pindex , pos )
    this.j.rtype             =   this.getkeymain( idx.rindex , pos )
    this.j.dtype             =   this.getkeymain( idx.dindex , pos )

    this.j.ntype             =   this.getkeymain( idx.ndindex , pos )

    this.j.tags              =   this.getkeymain( idx.gindex , pos )

    let prehover             =   this.getkeylang( idx.hindex , pos )
    this.quotescape(prehover )
    this.j.hover             =  this.result


    this.j.id                =   this.getkeymain( idx.sindex , pos )      // S - Subject Id

    this.j.sound             =   this.j.id

    let prevalue             =   this.getkeylang( idx.iindex , pos )    // I - Information - Value
    this.quotescape(prevalue )
    this.j.value   =  this.result


    this.j.otype             =   this.getkeymain( idx.oindex , pos )

    this.j.link              =   this.getkeylang( idx.lindex , pos )

    if (depth != "" )
      this.j.level = depth
    else
      this.j.level = 0

    // Both for Objects && arrays

    this.k.index             =   this.j.index

    this.k.child             =   this.j.child
    this.k.type              =   this.j.type
    this.k.breadcrumb        =   this.j.breadcrumb
    this.k.photo             =   this.j.photo
    this.k.rtype             =   this.j.rtype
    this.k.dtype             =   this.j.dtype

    this.k.ntype             =   this.j.ntype

    this.k.tags              =   this.j.tags

    this.k.hover             =   this.j.hover

    this.k.id                =   this.j.id

    this.k.sound             =   this.j.id

    this.k.value             =   this.j.value
    this.k.item              =   this.j.item

    this.k.otype             =   this.j.otype

    this.k.link              =   this.j.link

    this.k.level             =   this.j.level


  }

}

exports.struc_attrib = struc_attrib

