//Brqx Group - Agile Farmacia Zaragoza Methodology
//Spc - Cica_d05 - Home - Index_06 - v0_0_1 [ES7]
//-------------------------------------------------------------------------------------
//Fast node load - Replace Mysql connections - Taxonomy Class
//-------------------------------------------------------------------------------------
// Cada tipo de archivo debe heredar struc para ser capaz de manejar ficheros de propiedades
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Process:
//-------------------------------------------------------------------------------------
// @content_file --> contents[] --> arr[]  ( structured array of contents )
//                              --> tsa[]  ( To Save Array )   ( @format array of content )
//                              --> tsb[]  ( To Save Array B ) ( @format array of unique content )
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
//Class:
//-------------------------------------------------------------------------------------
//- c-struc_gen-      : Recover informatino from @ file
//-------------------------------------------------------------------------------------
//Methods:
//-------------------------------------------------------------------------------------
//- d-generate-       : Recover informatino from @ file
//-------------------------------------------------------------------------------------
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
//-------------------------------------------------------------------------------------
// Inheritance Line :
//-------------------------------------------------------------------------------------
// Struc_gen > Struc_attrib > Struc_defs
// @Struc > @SetArray @String > @Cache > @log
//-------------------------------------------------------------------------------------
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

define("JS_TYP7" , 	path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			))

const   { struc_attrib }   =   require(  path.join(JS_TYP7  , 'struc/s03_struc_attrib.es7'   )   )


class struc_gen extends struc_attrib {
  constructor()
  {
    super()
    this.n                        = "struc_gen::"
  }

  //---------------------------------------------------------------------------------------------
  // Generate array with contents information
  // Basado en this.contents
  generate(lang ='en')
  {
	var arr_divs = Array()
	for (var pos in this.contents)
  	{
		var sLine	=	this.contents[pos]

		// this.p('stru_line ' + sLine )
        // Cada linea tiene el formato
        // propiedad    @    valor
        // El separador debe serl la arroba pues las clases css tienen dos puntos y almoadillas
        // Habra que estar muy atento a estos valores
        let html_arr      		 	=   sLine.split("@")
        let prop     	      		=   html_arr[0].trim()   // Obtiene el CN

		let arr_divs 				=   prop.split ('_')

		let arr_name 				=   ''
		let arr_pos 				=   ''


		// arr_sua4_4@
        let arr_prop				=	arr_divs[0]
		let count_arr_divs 			=   arr_divs.length

        if (count_arr_divs >1)
        {
        	arr_name				=	arr_divs[1]

        }

        if (count_arr_divs >2)
			arr_pos                =  	arr_divs[2]

		// if ( arr_prop 	== "arr" 	)
		// this.p('Arr' + arr_prop  + ' Nam ' + arr_name + 'Pos' + arr_pos)

        let value         					=   ''

        let len_arr        					= html_arr.length

        if (len_arr > 1 )
        	value     						=   html_arr[1].trim()   // Obtiene la clase

		if ( 	 arr_prop 	== "arr" 				    )
		{
			// Enable | Disable to check array elements
			// ANames Lang: en Name i000v004 pos 0
            // Set lang arr && tsb

            // this.p('s02_stru LOADING_aRR ' + arr_name)
            // se define una posicion asociativa para contemplar todos los idiomas en el array all
            let curr_pos = arr_pos + lang
			this.set_lang_arr_pos(lang , arr_name , arr_pos , value)

            // NOFILE i020v050   P  10
            // this.p('s02_stru_NOFILE ' + arr_name + '   P  ' + arr_pos)
			this.set_lang_arr_pos('all' , arr_name , curr_pos , value)
		}


  	} // End foreach

  }

  //---------------------------------------------------------------------------------------------

  // Basado en this.contents
  generate_text_file(lang ='en' , index = "")
  {

	var value = ""

	var common_name = ""
	var arr_name = ""
	var arr_value = ""

	// this.p('s02_Length ' + this.contents.length )

    common_name = index

	for (var pos in this.contents)
  	{
		value	=	this.contents[pos]

        // this.p('s02_text FFILE ' + pos + ' V ' + value)

        let curr_pos   = pos + lang
        let next_level = this.get_next_level(pos)

        // J

        arr_name  = 'j' + common_name
        arr_value = 'text_' + next_level

        // j020v001v001 pos 6
        // this.p('s02_stru_FFILE ' + arr_name + '   P  ' + pos)

	    this.set_lang_arr_pos(lang  , arr_name , pos , arr_value)
		this.set_lang_arr_pos('all' , arr_name , curr_pos , arr_value)

        // I

        arr_name  = 'i' + common_name
        arr_value = value

        // an07_child ' + this.arr['ja']['i000v005']

        // i020v001001 pos 5
        // this.p('s02_stru_FFILE ' + arr_name + '  P ' + pos + ' V ' + arr_value)

	    this.set_lang_arr_pos(lang  , arr_name , pos , arr_value)
		this.set_lang_arr_pos('all' , arr_name , curr_pos , arr_value)

  	} // End foreach


    // this.parr(this.arr['en']['j020v000v001'])

    // VAmos a entender lo que estamos guardando



  }


}

exports.struc_gen = struc_gen

