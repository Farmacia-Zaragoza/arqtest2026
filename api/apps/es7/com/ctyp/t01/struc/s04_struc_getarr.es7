// Fast node load - Manage page cache
//-------------------------------------------------------------------------------------
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--
// Methods:
//-------------------------------------------------------------------------------------
// - d-getkeylang-          : Get key for current lang
// - d-getkeymain-          : Get key for main lang
//==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--

const { JS_TYP7  } = require(path.join(process.cwd(),'api/apps/paths.js'));

const   { struc_setarr }  =   require(  cons.JS_TYP7  + 'struc/s05_struc_setarr.es7'    )

class struc_getarr extends struc_setarr {
  constructor() {
    super()
    this.n                          =   "struc_getarr::"

  }

  //---------------------------------------------------------------------------------------------
  getkeylang(index , key)
  {
    let value     = this.getkey(this.s.ms.lang      , index, key )

    if ( value == '' )
		value     = this.getkey(this.s.ms.main_lang , index, key )

	return value
  }

  //---------------------------------------------------------------------------------------------
  getkeymain(index , key)
  {
	let value = this.getkey(this.s.ms.main_lang,index,key)
	return value
  }


  // Necesaria para evitar indices vacios.
  // a.Devolvera una cadena vacia si no existe el indice

  //---------------------------------------------------------------------------------------------
  getkey(lang, index , key)
  {
    // Notice: Undefined index: i000v001v004v000v001
    let current_arr = this.getarr(lang,index)

      // solution for array_key_exist de php
    if(key in current_arr)
        return current_arr[key]
    else
        return ''
  }

  //---------------------------------------------------------------------------------------------
  // Nueva version 3 argumentos
  getarr(lang, index)
  {
    let empty_arr = Array()

    if ( Array.isArray(this.arr) )
	  if ( Array.isArray(this.arr[lang]) )
        if ( Array.isArray(this.arr[lang][index]) )
    // Notice: Undefined index: i000v001v004v000v001
          return this.arr[lang][index]
        else
          return empty_arr
      else
        return empty_arr
    else
      return empty_arr
  }

  //---------------------------------------------------------------------------------------------
  // Nueva version 1 argumento
  getarrmain(index)   {      return this.getarr(this.s.main_lang)    }

  //---------------------------------------------------------------------------------------------
  // Nueva version 1 argumento
  getarrlang(index)   {      return this.getarr(this.s.lang)    }

  //---------------------------------------------------------------------------------------------
  // Crea un hast lang - code
  // Example : en - jmain - value
  set_lang_arr(index1 , index2 = '')
  {
    if ( !Array.isArray(this.arr) )
    {
      this.arr = Array()
    }

    if ( !Array.isArray(this.arr[index1]) )
    {
        // this.p('Setting Array 01 ' + index1)
        this.arr[index1]              = Array()
		if (index2 != "")
          this.arr[index1][index2]      = Array()
    }
    else
    {
      // Notice: Undefined index: i000v001v004v000v001
        if ( !Array.isArray(this.arr[index1][index2]) )
        {
          this.arr[index1][index2]      = Array()
        }
    }
  }

  //---------------------------------------------------------------------------------------------
  set_lang_content_arr(index1)
  {
    if ( !Array.isArray(this.content_arr) )
    {
      this.content_arr = Array()
    }

    if ( !Array.isArray(this.content_arr[index1]) )
    {
        // this.p('Setting Array 01 ' + index1)
        this.content_arr[index1]              = Array()
    }
  }

  //---------------------------------------------------------------------------------------------
  array_to_string(name, sep = ' ')
  {
    var result = ''
    var term = ''

    for (var pos in this.arr[name] )
    {
     term = this.arr[name][pos]
     result += term + sep
    }
    return result.trim()
  }


}

exports.struc_getarr = struc_getarr
