const  { scomm_struc }        =   require(  path.join(global.JS_TYF7  , 'a01_load/scomm/s03_struc.es7'  ) )

// Hierarchical strucure
class arroba_hiera extends scomm_struc {
  constructor(arroba)
  {

    super()

    this.n                  =   "arroba_hiera::"
    this.m                  =   "cons"

    this.arroba             =   arroba
    this.arr                =   this.arroba.arr

    this.u					=   this.arroba.u

    this.a                  =   this.arroba.a

    this.s					=   this.arroba.s
    this.b					=   this.s.b


    this.s.b.language_already_loaded = false

    // Prepare arroba type

    this.s.cs.sub            =   'arroba'
    this.s.cs.ext            =   ''

    // En hierarchical no tiene sentido la pagina - 40
    this.p('h01_hiera_before ' +  this.s.cs.position)

    // Llama a generar el anode. Pero cuando se ha generado la ruta de cache
    this.use_current_cache()
    // Call to gen() - rundef() [asocial el site]  - run()

    this.p('h01_hiera_page ' +  this.s.cs.slash_hierarchi   + '  Pth ' + this.s.cs.cache_path)
    // this.p('p01_prodcache_load ' +  this.s.cs.loadtype + '  Pty ' + this.s.cs.page_type)

    // /brqx/pers/cache/arqdru/
    // uritype/comm/product/nohuman/nouser/nocode/notrans/nosync/
    // es_page_20_a1_arroba
  }

}

exports.arroba_hiera = arroba_hiera

