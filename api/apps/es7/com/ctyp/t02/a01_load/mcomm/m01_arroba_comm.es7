global.JS_TYP7 = path.join(global.ROOT, 'api/apps/es7/com/ctyp/t01/'			);

const  { scomm_struc }      =   require(  path.join(global.JS_TYF7  , 'a01_load/scomm/s03_struc.es7'      )    )

// Multi positions Load from arroba
class arroba_mcomm extends scomm_struc {
  constructor( arroba , positions = '0 2 5' )
  {
    super()

    this.n                  =   "arroba_mcomm::"
    this.m                  =   "cons"

    this.arroba             =   arroba
    this.arr                =   this.arroba.arr

    this.u					=   this.arroba.u

    // Arroba Anode
    this.a                  =   this.arroba.a

    this.s					=   this.arroba.s

    // this.p('arroba_mcomm_cache_path' + this.s.cs.cache_path)

    this.b					=   this.s.b

    this.s.cs.lang          =   this.s.ms.lang

    // El tipo de carga el que tenga  ya
    let old_loadtype                  = this.s.cs.loadtype
    let old_page                      = this.s.cs.page
    let old_position                  = this.s.cs.position


    this.s.cs.loadtype                =   'multiposition'

    this.s.cs.uri                     =   'uritype'
    this.s.cs.comm                    =   'comm'
    this.s.cs.sub                     =   'arroba'
    this.s.cs.ext                     =   ''

    this.s.cs.multi_positions         =   positions


    this.s.b.language_already_loaded  = false

    // Si ha cambiado el idioma debe generar la nueva url
    this.use_current_cache()
    // gen - a.rundef - a.run

    // Tenemos el contenido  del array en a
    this.arroba.arr = this.a.arr

    // this.p('m01_comm_First Alias**JA ' + this.a.gethash_keylang( 'i000v005' , 1 ) )
    // Arroba path
    // this.p('m01_comm_Checking Cache Path ' + this.s.cs.cache_path )

    this.s.cs.loadtype                = old_loadtype
    this.s.cs.position                = old_position
    this.s.cs.page                    = old_page


  }

}

exports.arroba_mcomm = arroba_mcomm

