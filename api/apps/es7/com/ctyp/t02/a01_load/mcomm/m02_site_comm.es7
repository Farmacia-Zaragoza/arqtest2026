const _mod_safe_1 = require( path.join(global.JS_TYF7, 'a01_load/scomm/s03_struc.es7'); const scomm_struc = _mod_safe_1.scomm_struc || _mod_safe_1);
const _mod_safe_2 = require( path.join(global.JS_TYP7, 'site/s10_cache_site.es7'); const cache_site = _mod_safe_2.cache_site || _mod_safe_2);
// Multi positions Load. Generate a new arr
class site_mcomm extends scomm_struc {
  constructor( site, positions = '0 2 5')
  {
    super()

    this.n                           =   "site_mcomm::"
    this.m                           =   "cons"

    this.s                           =   site
    this.b                           =   this.s.b

    // common type

    // Aqui se regeneran todos los valores de cs
    // this.s.cs                        =   new cache_site()

    let old_loadtype                 =   this.s.cs.loadtype
    let old_lang                     =   this.s.cs.lang
    let old_page                     =   this.s.cs.page
    let old_position                 =   this.s.cs.position

    // Necesitamos multiposition para cargar los valores
    this.s.cs.loadtype               =   'multiposition'
    this.s.cs.lang                   =   this.s.ms.default_lang

    this.s.b.specs_props             =   true

    // Vamos a generar una ruta sin uri y sin lang
    // Comm no lo necesita

    this.s.cs.uri                      =   'uritype'
    this.s.cs.comm                     =   'comm'
    this.s.cs.sub                      =   'arroba'

    this.s.cs.multi_positions         =   positions

    // Define a(Anode) && run ( load @node && save)
    this.run_cache()

    this.arr                         = this.a.arr
    this.s.b.language_already_loaded = true

    this.s.cs.loadtype               = old_loadtype
    this.s.cs.lang                   = old_lang
    this.s.cs.page                   = old_page
    this.s.cs.position               = old_position

  }

}

exports.site_mcomm = site_mcomm;

module.exports = site_mcomm;
module.exports.site_mcomm = site_mcomm;
