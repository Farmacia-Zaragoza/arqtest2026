const { JS_TYP7  } = require(path.join(process.cwd(),'api/apps/paths.js'));

const  { jcomm_struc }      =   require(  cons.JS_TYF7  + 'b02_save/jcomm/j02_struc.es7'          )

class arroba_jcomm extends jcomm_struc {
  constructor(    arroba  )
  {
    super()

    this.n                  =   "arroba_jcomm::"
    this.m                  =   "cons"

    // arrobasite pasado
    this.arroba             =   arroba

    this.s					=   arroba.s
    this.b					=   this.s.b

    this.s.cs               =   new cache_site()

    // common type
    this.s.cs.uri            =   'uritype'

    this.s.cs.comm           =   'comm'


    this.s.cs.sub            =   'json'
    this.s.cs.ext            =  'json'


    this.arroba.s           =   this.s

    // this.p('s01_passsed_type ' + this.s.t_sub)

    this.run_cache_to_generate_json()

  }

}

exports.arroba_jcomm = arroba_jcomm
