{
  "functions": {
     "api/**/*.*": {
       "includeFiles": "api/apps/**"
     }
   },
  "routes": [

     {
       "src": "/api/(.*)",
       "dest": "/api/index.js"
     },
     {
       "src": "/api/apps/(.*)",
       "dest": "/api/index.js"
     },
     {
       "src": "/(.*)",
       "dest": "/api/index.js"
     }
   ]
}
